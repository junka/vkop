# Export artifacts: multi-GB weight blobs, graphs, and the scattered per-tensor
# files torch.onnx.export leaves behind. The exporters themselves are tracked
# (qwen2_moe_export_onnx.py, moe_ckpt.py, make_moe_variant.py); what they write
# is not.
llm/exporter/export/*.onnx
llm/exporter/export/*.bin
llm/exporter/export/*.weight
llm/exporter/export/*.bias
llm/exporter/export/*.data
llm/exporter/export/onnx__*
llm/exporter/export/moe_ckpt
__pycache__/

# Model-scope exports written next to the exporters instead of under export/.
llm/exporter/*.onnx
llm/exporter/*.vkopbin
llm/exporter/*.weights.bin
llm/exporter/embed_tokens.bin
# Tokenizer blobs serialized by tokenizer_to_bin.py from a local checkpoint.
llm/tokenizer/*.bin

# Build trees, including CMake's in-source leftovers (CMakeFiles/,
# CMakeCache.txt) when a build directory is accidentally configured in-tree.
/build/
/build_*/
/CMakeFiles/
/CMakeCache.txt
/.cache/
# ONNX models and scratch inputs pulled down for one-off conversions; the
# committed fixtures live under model/ (add_conv_model.onnx etc.).
/onnx_models/
/optimized_resnet18.onnx
/dog.jpg
# Run logs and compiler leftovers.
/log
*.obj
