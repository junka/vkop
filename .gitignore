*.bak
*.old

# Ignore IDE specific files
.idea/
.vscode/
*.code-workspace

# Ignore Git-specific files
*.orig

# Ignore Claude Code session/agent state
.claude/

# Ignore ad-hoc testing scratch
/Testing/

# Python bytecode + build dirs
__pycache__/
*.pyc
llm/tokenizer/build/

# LLM model artifacts (multi-GB weights, converted binaries, runtime dumps) —
# never commit; regenerate via onnx2vkop / dump_llm_inputs.py
*.weights.bin
*.onx
llm/exporter/inputs_dump/
llm/exporter/decode_dump/
llm/exporter/chat_prefill_dump/
llm/exporter/raw13_dump/
# 无路径前缀：按名匹配任意层级。写成 llm/exporter/embed_tokens.bin 时漏掉了
# text_qwen3/ 等子目录，742MB 产物因此被提交进历史、撞 GitHub 100MB 单文件上限。
embed_tokens.bin
llm/exporter/synth224.png
llm/exporter/p.py
llm/tokenizer/*.bin

# Image-gen artifacts (ORT reference tensors, dumped latents, profiling logs)
