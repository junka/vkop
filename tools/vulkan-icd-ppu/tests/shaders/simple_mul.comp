#version 450 core

// Test kernel for the SPIR-V -> PPU path through the Vulkan ICD.
//
// Deliberately tiny and easy to check on the host:
//   out[i] = a[i] * b[i] + scaler        for i < total
//
// It exercises the parts of the emitter the ICD depends on: three storage
// buffers, a push-constant block, gl_GlobalInvocationID and a bounds check.
// Keep the interface in sync with tests/spirv_dispatch.cpp.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    float data[];
} o;
layout(set = 0, binding = 1) readonly buffer A {
    float data[];
} a;
layout(set = 0, binding = 2) readonly buffer B {
    float data[];
} b;

layout(push_constant) uniform PC {
    uint total;
    uint scaler;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) {
        return;
    }
    o.data[i] = a.data[i] * b.data[i] + float(pc.scaler);
}
