// VK_EXT_shader_float8, storage-buffer form: float -> E4M3 -> float.
// Exercises OpTypeFloat 8 Float8E4M3EXT and the explicit conversion
// constructors, i.e. the part of the extension that works without a
// cooperative matrix.
#version 460
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer In { float in_val[]; };
layout(std430, binding = 1) buffer F8 { floate4m3_t f8_val[]; };
layout(std430, binding = 2) buffer Out { float out_val[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    // float -> E4M3 (round to nearest even, as the extension specifies),
    // then back. Both directions are hardware conversions.
    floate4m3_t q = floate4m3_t(in_val[i]);
    f8_val[i] = q;
    out_val[i] = float(q);
}
