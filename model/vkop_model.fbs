// vkop model binary format — FlatBuffers schema (single source of truth).
//
// Generated with flatc 25.12.19. Regenerate:
//   flatc --cpp --gen-mutable --gen-object-api --reflect-names \
//         -o model/generated model/vkop_model.fbs
//   flatc --python -o model/pypi/onnx2vkop/generated model/vkop_model.fbs
//
// Layout notes:
//  - All `offset` fields are absolute byte offsets into `Model.initializer_blob`,
//    computed by the Python writer with 64-byte alignment. The C++ reader never
//    computes offsets — it memmaps the file and points `initializer_memory`
//    directly at the blob (zero-copy).
//  - `UnifiedMeta` / `RGBAConversionMeta` are FlatBuffers structs (inline,
//    fixed 32-byte layout: 8x int32) matching the legacy
//    load::UnifiedMetadata / RGBAConversion C++ structs, so they can be read
//    field-by-field via direct indexing (no memcpy into a temp vector).

namespace vkop.model;

file_identifier "VKOP";
file_extension "vkopbin";

enum AttrType : byte {
  String = 0,
  Int64 = 1,
  Float32 = 2,
  Ints = 3,
  Floats = 4,
  Tensor = 5,
  Bool = 6,
}

struct UnifiedMeta {
  dtype: int;
  name_len: int;
  offset: int;
  size: int;
  dims: [int: 4];
}

struct RGBAConversionMeta {
  dtype: int;
  name_len: int;
  offset: int;
  size: int;
  dims: [int: 4];
}

table ShapeRef {
  name: string;
  // -1 = dynamic sentinel (symbolic dim_param the converter couldn't resolve;
  // runtime substitutes the concrete value). 0 = genuinely empty (e.g.
  // kv_len=0 at round0 prefill). Initializer/Attribute dims stay [uint] since
  // they are always concrete.
  dims: [int];
  dtype: string;
  // True when this tensor's ELEMENT VALUES vary across decode rounds (i.e. the
  // value depends on a dynamic graph-input dim such as kv_len). Only meaningful
  // for int64 shape-meta tensors consumed as a shape/axes input (Reshape/
  // Unsqueeze/Slice/etc. inputs[1]). When false, the runtime may cache the
  // readback-derived values across rounds and skip the per-round copyToCPU.
  // Converter sets this via producer-chain trace; default false (static) is the
  // safe cacheable case — uncertain tensors must be marked true (dynamic).
  value_dynamic: bool = false;
}

table TensorData {
  dtype: string;
  dims: [uint];
  data: [ubyte];
}

table Attribute {
  key: string;
  type: AttrType;
  sval: string;
  ival: long;
  fval: float;
  ints: [uint];
  floats: [float];
  bval: bool;
  tval: TensorData;
}

table InitializerEntry {
  name: string;
  // ONNX TensorProto DataType name ("float32", "float16", "int8", "bool",
  // "int32", "int64"). This string is authoritative for what the bytes mean:
  // the runtime parses it against the whitelist in core/DType.hpp and refuses
  // anything unrecognized or recognized-but-kernel-less (bfloat16, float8*,
  // *int4/fp4), so a quantized checkpoint fails at load instead of being read
  // through a float kernel. `size` must equal prod(dims) * bits / 8 — checked,
  // not derived, because a packed format holds several elements per byte.
  dtype: string;
  dims: [uint];
  offset: ulong;
  size: ulong;
}

table Node {
  op_type: string;
  name: string;
  attributes: [Attribute];
  inputs: [ShapeRef];
  outputs: [ShapeRef];
  dependencies: [string];
  dependents: [string];
  // Index into Model.kernel_plans: which shaders this node may ask the runtime
  // to launch. -1 (the default, and what every file written before this field
  // existed reads back as) means "no plan": the runtime falls back to its own
  // OpType -> key table, which is what libvkop did for every model until now.
  // Appended last: FlatBuffers addresses fields by declaration order.
  plan: int = -1;
}

table ConcurrentLevel {
  nodes: [string];
}

// The kernel selection, frozen into the file. One row per distinct op_type
// that has a GPU shader; Node.plan indexes it.
//
// Why it is here: the runtime used to *derive* each op's archive key from its
// own OpType -> name table (core/ShaderKeys.hpp), and the converter derived
// the same key independently (model/pypi/onnx2vkop/shader_map.py) to decide
// which shaders to embed. Two independent derivations of one decision, and
// with VKOP_STRIP_BUILTIN_SHADERS=ON (the default) a disagreement is no
// longer a silent fallback to a linked-in C array — it is a hard failure at
// pipeline creation. Writing the converter's answer down removes the second
// derivation: onnx2vkop embeds exactly these keys, and the runtime looks up
// exactly these keys.
//
// The four columns are the key per (backend, precision) *as resolved*, i.e.
// they already fold in the two rules that used to live in shader_key_for():
//   - an op with no variant on the requested backend uses the other backend's
//     basename (and that backend's prefix: an image-only op asked for on the
//     buffer backend resolves to "image_<name>", never "buffer_<name>");
//   - an op whose variant is not in DUAL_FP16_SHADERS resolves to the same key
//     for fp16 and fp32, so `buffer` == `buffer_fp16` for it rather than the
//     fp16 cell being empty.
// An empty cell means the op genuinely has no shader for that (backend,
// precision) pair — for an op in the table that only happens when neither
// backend has one, otherwise the fallback above fills it.
//
// `variants` lists the secondary pipelines the op may build *by literal key*
// through Operator::resolve_spv() (Matmul's coop/coop16/coop_i8/pack, the
// int64 twin of Expand/Concat/Gather/Equal/Where, ...). Which of them runs is
// a device-feature or input-dtype question the converter cannot answer, so the
// list is over-inclusive on purpose (the same reason `image` and `buffer` are
// both filled for a graph that will only ever use one) — but it is what the
// embedded archive was built from, so a missing variant is now reportable as
// "not converted in" instead of "stub SPIR-V".
table KernelPlan {
  op_type: string;
  image: string;
  image_fp16: string;
  buffer: string;
  buffer_fp16: string;
  variants: [string];
}

table Model {
  magic: uint = 0x504F4B56;
  version: ubyte = 3;
  inputs: [ShapeRef];
  outputs: [ShapeRef];
  nodes: [Node];
  initializers: [InitializerEntry];
  initializer_blob: [ubyte];
  unified: bool = false;
  rgba: bool = false;
  unified_meta: [UnifiedMeta];
  unified_names: string;
  rgba_meta: [RGBAConversionMeta];
  rgba_names: string;
  unified_blob_offset: ulong;
  concurrent_levels: [ConcurrentLevel];
  // SPIR-V archive (VKSP format, tools/spv_to_archive.py): the per-model
  // subset of the build's vkop_shaders.bin holding exactly the shaders this
  // graph can dispatch. When present the .vkopbin is self-contained and
  // Runtime::LoadModel takes every op's SPIR-V from here -- on a libvkop built
  // with VKOP_STRIP_BUILTIN_SHADERS=ON (the default) that is the only source,
  // since there is no run-time override by design. Empty for models written by
  // an older writer, which then fall back to the C arrays linked into libvkop.
  //
  // Appended last on purpose: FlatBuffers addresses fields by declaration
  // order, so a new field may only be added at the end -- inserting one
  // earlier would renumber every field after it and silently misread every
  // already-converted .vkopbin in the field.
  shader_archive: [ubyte];

  // Kernel selection for every op_type in this graph (Node.plan indexes it).
  // Appended last for the same reason as shader_archive; also read as empty by
  // every file written before it existed, which is exactly the "no plan, use
  // the built-in OpType table" behaviour.
  kernel_plans: [KernelPlan];
}

root_type Model;
