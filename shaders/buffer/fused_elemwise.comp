#version 450 core

// Fused elementwise SSBO op: executes a CHAIN of N elemwise ops in ONE
// dispatch (one thread per output element), instead of N separate dispatches.
// This is the kernel-fusion engine — collapses chains like the 9-op SwiGLU
// block (Add Sqrt Div Mul Cast Mul Sigmoid Mul Mul) into a single launch to
// amortize the ~0.3ms Intel ARL iGPU kernel-launch overhead that dominates
// the decode loop (3270 fragmented dispatches/round).
//
// Model: a small register machine. Each thread owns ONE output element and
// runs the same op program. Inputs are either a bound SSBO element (with
// ONNX right-aligned broadcasting) or a per-op scalar constant.
//
// Bindings:
//   0           output SSBO (write)
//   1..K        input SSBOs (read), K = nInputs (≤ MAX_INPUTS)
//   K+1         program SSBO (read): int[] encoding the op list + per-input
//               broadcast shapes + scalar constants. Layout (see host
//               FusedElemwisePC + build_program_buffer):
//                 [0]      nOps
//                 [1]      nInputs
//                 [2]      nScalars
//                 [3]      rank            (common rank for nd<->linear)
//                 [4..4+rank)             OUTPUT dims (left-aligned)
//                 [4+rank..4+rank*(1+nInputs))  input dims: input k at
//                                          offset (k+1)*rank (right-aligned)
//                 [...]    input dtypes: nInputs ints, 0=fp32, 1=fp16
//                                          (per-input load stride; enables
//                                          fusion across dtype-crossing Cast)
//                 [...]    op words: 4 ints/op {op, dst, a, b}
//                 [...]    scalar constants (float-as-uint), 1 int each
//
// Push constant: total (output element count) + sizes only — all shape/program
// detail lives in the program SSBO to stay within the 128B PC limit for long
// chains.
//
// Registers: reg[0..MAX_REGS-1]. reg[0..nInputs-1] are preloaded with the
// broadcast input elements for this thread's output index. Op dst writes a
// register; op a/b operands encode (register index). The chain's final result
// must land in a known output register (op program ensures the last op writes
// reg 0, which is stored — see host builder).
//
// fp16: like the other elemwise shaders, one thread per uint WORD (two packed
// half elements), read-modify-write the half2 — safe because each output word
// is owned by exactly one thread (contiguous index range).
//
// Mixed-dtype inputs (fusion across Cast): each input SSBO has its own dtype
// flag in the program. The fp16 BUILD still packs the OUTPUT two-per-word, but
// a fp32 input is read at element stride (uintBitsToFloat) while a fp16 input
// is read at word stride (unpackHalf2x16). All math is fp32 in registers, so a
// Cast op inside the chain is a register no-op — the dtype conversion happens
// at the load/store boundary based on the per-input/output dtype.

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define MAX_INPUTS 8
#define MAX_REGS   16
#define MAX_OPS    32

// Op codes. Unary ops read a; b is unused. Binary ops read a and b.
#define OP_ADD     1
#define OP_SUB     2
#define OP_MUL     3
#define OP_DIV     4
#define OP_POW     5
#define OP_SQRT    6   // unary
#define OP_SIGMOID 7   // unary
#define OP_NEG     8   // unary
#define OP_EXP     9   // unary
#define OP_TANH    10  // unary
#define OP_CAST    11  // unary, no-op (same-dtype chain only — host skips dtype-crossing casts)
#define OP_WHERE   12  // ternary: b ? a : (next-reg) — handled specially below
#define OP_ERF     13  // unary, erf(a) — the GELU primitive (see FusedElemwise.hpp)
#define OP_SILU    14  // unary, a * sigmoid(a) — silu/gelu-swish in ONE word
#define OP_MIN     15  // binary min(a, b)
#define OP_MAX     16  // binary max(a, b)

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaUintBuf {
    uint data[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaIntBuf {
    int data[];
};
layout(set = 0, binding = 0) readonly buffer BdaTable {
    BdaUintBuf b0;
    BdaUintBuf b1;
    BdaUintBuf b2;
    BdaUintBuf b3;
    BdaUintBuf b4;
    BdaUintBuf b5;
    BdaUintBuf b6;
    BdaUintBuf b7;
    BdaUintBuf b8;
    BdaIntBuf b9;
} uBdaTable;
#define uOutput (uBdaTable.b0)
#define uIn0 (uBdaTable.b1)
#define uIn1 (uBdaTable.b2)
#define uIn2 (uBdaTable.b3)
#define uIn3 (uBdaTable.b4)
#define uIn4 (uBdaTable.b5)
#define uIn5 (uBdaTable.b6)
#define uIn6 (uBdaTable.b7)
#define uIn7 (uBdaTable.b8)
#define uProg (uBdaTable.b9)
#else
layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;

// Input SSBOs. GLSL forbids indexing an array of buffer blocks by a runtime
// variable, so we declare a fixed set and select by if-ladder (small K).
layout(set = 0, binding = 1) readonly buffer In0 { uint data[]; } uIn0;
layout(set = 0, binding = 2) readonly buffer In1 { uint data[]; } uIn1;
layout(set = 0, binding = 3) readonly buffer In2 { uint data[]; } uIn2;
layout(set = 0, binding = 4) readonly buffer In3 { uint data[]; } uIn3;
layout(set = 0, binding = 5) readonly buffer In4 { uint data[]; } uIn4;
layout(set = 0, binding = 6) readonly buffer In5 { uint data[]; } uIn5;
layout(set = 0, binding = 7) readonly buffer In6 { uint data[]; } uIn6;
layout(set = 0, binding = 8) readonly buffer In7 { uint data[]; } uIn7;

// Program SSBO. Binding = MAX_INPUTS + 1 = 9.
layout(set = 0, binding = 9) readonly buffer Prog {
    int data[];
} uProg;
#endif

layout(push_constant) uniform PC_uPC {
    int total;     // output element count
    int nInputs;   // number of bound input SSBOs (≤ MAX_INPUTS)
    int nOps;      // number of ops in the program
    int nScalars;  // number of scalar constants appended to the program
    int _pad0;
    int _pad1;
    int _pad2;
    int _pad3;
} uPC;

// Read input `k` at linear element index `lin` (already broadcast-mapped by
// the caller). `isFp16` selects the load stride: fp16 inputs are packed
// two-per-uint-word (read by unpackHalf2x16), fp32 inputs are one-per-uint
// (uintBitsToFloat). The if-ladder is necessary because GLSL buffer blocks
// can't be indexed by a dynamic variable. Mixed-dtype inputs let a chain
// fuse across a dtype-crossing Cast (the Cast is a register no-op; the
// conversion happens here at the load boundary).
float load_input_raw(int k, int lin, bool isFp16) {
    if (k == 0) {
        return isFp16 ? unpackHalf2x16(uIn0.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn0.data[lin]);
    } else if (k == 1) {
        return isFp16 ? unpackHalf2x16(uIn1.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn1.data[lin]);
    } else if (k == 2) {
        return isFp16 ? unpackHalf2x16(uIn2.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn2.data[lin]);
    } else if (k == 3) {
        return isFp16 ? unpackHalf2x16(uIn3.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn3.data[lin]);
    } else if (k == 4) {
        return isFp16 ? unpackHalf2x16(uIn4.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn4.data[lin]);
    } else if (k == 5) {
        return isFp16 ? unpackHalf2x16(uIn5.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn5.data[lin]);
    } else if (k == 6) {
        return isFp16 ? unpackHalf2x16(uIn6.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn6.data[lin]);
    } else {
        return isFp16 ? unpackHalf2x16(uIn7.data[lin >> 1])[lin & 1]
                      : uintBitsToFloat(uIn7.data[lin]);
    }
}

float apply_op(int oc, float av, float bv) {
    if (oc == OP_ADD)      return av + bv;
    if (oc == OP_SUB)      return av - bv;
    if (oc == OP_MUL)      return av * bv;
    if (oc == OP_DIV)      return av / bv;
    if (oc == OP_POW)      return pow(av, bv);
    if (oc == OP_SQRT)     return sqrt(av);
    if (oc == OP_SIGMOID)  return 1.0 / (1.0 + exp(-av));
    if (oc == OP_NEG)      return -av;
    if (oc == OP_EXP)      return exp(av);
    if (oc == OP_TANH)     return tanh(av);
    if (oc == OP_ERF)      return buffer_erf(av);
    // x*sigmoid(x) as one word: exp(-x) overflows to +inf for x <= -88,
    // giving x/inf = 0, the correct limit.
    if (oc == OP_SILU)     return av / (1.0 + exp(-av));
    if (oc == OP_CAST)     return av; // dtype change happens at load/store
    // WHERE fallback: select against 0 (cond in b).
    if (oc == OP_WHERE)    return (bv != 0.0) ? av : 0.0;
    if (oc == OP_MIN)      return min(av, bv);
    if (oc == OP_MAX)      return max(av, bv);
    return 0.0;
}

// Input k's element index for output element `lin`. Fast path: the host
// classified the input's broadcast as affine, inLin = (lin / div) % mod
// (same shape: div 1, mod total; scalar: mod 1; trailing-suffix broadcast:
// div 1, mod suffix; per-row: div inner, mod rows). mod == 0 means the
// broadcast is not affine and the general N-d decomposition is used.
int input_index(int k, int lin, int bcBase, int dimsBase, int rank) {
    int dv = uProg.data[bcBase + 2 * k];
    int md = uProg.data[bcBase + 2 * k + 1];
    if (md != 0) {
        int q = (dv == 1) ? lin : lin / dv;
        return (md == 1) ? 0 : q % md;
    }
    IArr8 outDims;
    IArr8 inDims;
    for (int i = 0; i < 8; ++i) { outDims.v[i] = 1; inDims.v[i] = 1; }
    for (int i = 0; i < rank && i < 8; ++i) {
        outDims.v[i] = uProg.data[dimsBase + i];
        inDims.v[i] = uProg.data[dimsBase + (k + 1) * rank + i];
    }
    return broadcast_index(lin, outDims, inDims, rank);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int nOps     = uPC.nOps;
    int nInputs  = uPC.nInputs;
    int nScalars = uPC.nScalars;
    int rank     = uProg.data[3];

    // Program layout: [4 .. 4+rank*(1+nInputs)) dims (slot 0 = output,
    // slot k+1 = input k, right-aligned), then nInputs dtype flags, then
    // 4 ints/op, then scalars, then 2 ints/input broadcast descriptors.
    int dimsBase    = 4;
    int dtypesBase  = dimsBase + rank * (1 + nInputs);
    int opsBase     = dtypesBase + nInputs;
    int scalarsBase = opsBase + 4 * nOps;
    int bcBase      = scalarsBase + nScalars;

    // fp16 build: one thread per output WORD, both halves computed together
    // in vec2 registers and stored with a single packed write (no
    // read-modify-write of the output). fp32 build: one element per thread;
    // .y lanes mirror .x and are dropped at the store.
#ifdef FP16
    int nwords = (uPC.total + 1) / 2;
    if (gid >= nwords) return;
    int i0 = 2 * gid;
    int i1 = min(2 * gid + 1, uPC.total - 1);
#else
    if (gid >= uPC.total) return;
    int i0 = gid;
    int i1 = gid;
#endif

    vec2 reg[MAX_REGS];
    for (int i = 0; i < MAX_REGS; ++i) reg[i] = vec2(0.0);

    for (int k = 0; k < nInputs && k < MAX_INPUTS; ++k) {
        bool inFp16 = uProg.data[dtypesBase + k] != 0;
        int a0 = input_index(k, i0, bcBase, dimsBase, rank);
        int a1 = input_index(k, i1, bcBase, dimsBase, rank);
        float v0;
        float v1;
        if (inFp16 && a1 == a0 + 1 && (a0 & 1) == 0) {
            // Both halves sit in one word: one load.
            uint w;
            if (k == 0) w = uIn0.data[a0 >> 1];
            else if (k == 1) w = uIn1.data[a0 >> 1];
            else if (k == 2) w = uIn2.data[a0 >> 1];
            else if (k == 3) w = uIn3.data[a0 >> 1];
            else if (k == 4) w = uIn4.data[a0 >> 1];
            else if (k == 5) w = uIn5.data[a0 >> 1];
            else if (k == 6) w = uIn6.data[a0 >> 1];
            else w = uIn7.data[a0 >> 1];
            vec2 h = unpackHalf2x16(w);
            v0 = h.x;
            v1 = h.y;
        } else {
            v0 = load_input_raw(k, a0, inFp16);
            v1 = (a1 == a0) ? v0 : load_input_raw(k, a1, inFp16);
        }
        reg[k] = vec2(v0, v1);
    }

    for (int op = 0; op < nOps && op < MAX_OPS; ++op) {
        int oc  = uProg.data[opsBase + op * 4 + 0];
        int dst = uProg.data[opsBase + op * 4 + 1];
        int a   = uProg.data[opsBase + op * 4 + 2];
        int b   = uProg.data[opsBase + op * 4 + 3];
        // Operand encoding: [0, MAX_REGS) register, >= 100 scalar constant.
        vec2 av = vec2(0.0);
        vec2 bv = vec2(0.0);
        if (a >= 100) {
            av = vec2(uintBitsToFloat(uProg.data[scalarsBase + (a - 100)]));
        } else if (a >= 0 && a < MAX_REGS) {
            av = reg[a];
        }
        if (b >= 100) {
            bv = vec2(uintBitsToFloat(uProg.data[scalarsBase + (b - 100)]));
        } else if (b >= 0 && b < MAX_REGS) {
            bv = reg[b];
        }
        vec2 r = vec2(apply_op(oc, av.x, bv.x), apply_op(oc, av.y, bv.y));
        if (dst >= 0 && dst < MAX_REGS) reg[dst] = r;
    }

    // The host guarantees the last op writes reg 0 (the output register).
#ifdef FP16
    // An odd total's last word: the high half is past the end; store 0
    // there (the word is still owned by this thread alone).
    vec2 o = reg[0];
    if (2 * gid + 1 >= uPC.total) o.y = 0.0;
    uOutput.data[gid] = packHalf2x16(o);
#else
    uOutput.data[gid] = floatBitsToUint(reg[0].x);
#endif
}
