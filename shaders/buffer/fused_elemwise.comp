vec2 apply_op2(int oc, vec2 av, vec2 bv) {
    if (oc == OP_ADD)      return av + bv;
    if (oc == OP_SUB)      return av - bv;
    if (oc == OP_MUL)      return av * bv;
    if (oc == OP_DIV)      return av / bv;
    if (oc == OP_POW)      return pow(av, bv);
    if (oc == OP_SQRT)     return sqrt(av);
    if (oc == OP_SIGMOID)  return 1.0 / (1.0 + exp(-av));
    if (oc == OP_NEG)      return -av;
    if (oc == OP_EXP)      return exp(av);
    if (oc == OP_TANH)     return tanh(av);
    if (oc == OP_ERF)      return vec2(buffer_erf(av.x), buffer_erf(av.y));
    if (oc == OP_SILU)     return av / (1.0 + exp(-av));
    if (oc == OP_CAST)     return av;
    if (oc == OP_WHERE)    return vec2(bv.x != 0.0 ? av.x : 0.0, bv.y != 0.0 ? av.y : 0.0);
    if (oc == OP_MIN)      return min(av, bv);
    if (oc == OP_MAX)      return max(av, bv);
    return vec2(0.0);
}

vec2 spec_operand(int x, vec2 reg[MAX_REGS], int scalarsBase) {
    if (x >= 100) return vec2(uintBitsToFloat(uProg.data[scalarsBase + (x - 100)]));
    if (x >= 0 && x < MAX_REGS) return reg[x];
    return vec2(0.0);
}

// Element index of input k for output element lin, by broadcast kind.
int spec_index(int kind, int k, int lin, int bcBase, int dimsBase, int rank) {
    if (kind == 0) return lin;
    if (kind == 1) return 0;
    if (kind == 2) {
        int dv = uProg.data[bcBase + 2 * k];
        int md = uProg.data[bcBase + 2 * k + 1];
        return (lin / dv) % md;
    }
    return input_index(k, lin, bcBase, dimsBase, rank);
}

vec2 spec_load0(int gid, int i0, int i1, int bcBase, int dimsBase, int rank) {
    bool f16 = SC_DT0 != 0;
    bool bf = SC_DT0 == 2;
#ifdef FP16
    if (SC_BK0 == 0 && f16) return dec16(uIn0.data[gid], bf);
#endif
    if (SC_BK0 == 1) {
        float s = f16 ? dec16(uIn0.data[0], bf).x : uintBitsToFloat(uIn0.data[0]);
        return vec2(s);
    }
    int a0 = spec_index(SC_BK0, 0, i0, bcBase, dimsBase, rank);
    int a1 = spec_index(SC_BK0, 0, i1, bcBase, dimsBase, rank);
    if (f16) {
        if (a1 == a0 + 1 && (a0 & 1) == 0) return dec16(uIn0.data[a0 >> 1], bf);
        float v0 = dec16(uIn0.data[a0 >> 1], bf)[a0 & 1];
        float v1 = (a1 == a0) ? v0 : dec16(uIn0.data[a1 >> 1], bf)[a1 & 1];
        return vec2(v0, v1);
    }
    float v0 = uintBitsToFloat(uIn0.data[a0]);
    float v1 = (a1 == a0) ? v0 : uintBitsToFloat(uIn0.data[a1]);
    return vec2(v0, v1);
}
vec2 spec_load1(int gid, int i0, int i1, int bcBase, int dimsBase, int rank) {
    bool f16 = SC_DT1 != 0;
    bool bf = SC_DT1 == 2;
#ifdef FP16
    if (SC_BK1 == 0 && f16) return dec16(uIn1.data[gid], bf);
#endif
    if (SC_BK1 == 1) {
        float s = f16 ? dec16(uIn1.data[0], bf).x : uintBitsToFloat(uIn1.data[0]);
        return vec2(s);
    }
    int a0 = spec_index(SC_BK1, 1, i0, bcBase, dimsBase, rank);
