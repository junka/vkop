#version 450 core

// RotaryEmbedding (RoPE) SSBO (buffer backend). Half-split (non-interleaved)
// rotation. rotary_dim == head_dim 时整维旋转；rotary_dim < head_dim 时是 partial
// rotary —— 前 rotary_dim 维参与旋转（配对距离 rotary_dim/2），其余维直通。
//
// Replaces the per-layer decomposed HF apply_rotary_pos_emb subgraph:
//   rotate_half(x) = Concat(Neg(x[second_half]), x[first_half])
//   q_rot = x * cos + rotate_half(x) * sin
// which expands (with cos/sin half-repeated across the full head_dim, i.e.
// cos[d] == cos[d + half]) to:
//   d <  half: q_rot[d] = x[d]*cos[d] - x[d+half]*sin[d]   (real)
//   d >= half: q_rot[d] = x[d]*cos[d] + x[d-half]*sin[d]   (imag)
// mathematically equivalent to the ONNX RotaryEmbedding real/imag formula.
//
// cos/sin are pre-broadcast to [B, 1, S, rotary_dim] by /rotary_emb/* + the
// shared Unsqueeze (axis=1). They broadcast across the heads dim, so their
// linear index has NO head axis:  cs_idx = (b * S + s) * rotary_dim + d
// (cos[d] == cos[d - rotary_dim/2] 的第二半，所以按裸 d 索引是对的。)
//
// THREAD MODEL: differs by build to avoid the fp16 read-modify-write race
// ([[expand-fp16-race]]):
//   - fp16: one thread per OUTPUT WORD (2 packed half elements). Each thread
//     computes BOTH elements of its word and writes the whole word once via
//     packHalf2x16 -- no read-modify-write, no race. Dispatch = ceil(total/2).
//   - fp32: one thread per element. BUF_STORE is a plain single write (no
//     read-modify-write), so there is no race; dispatch = total.
// (total is always even: head_dim is even and is the fastest axis.)

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InX {
    uint data[];
} uInputX;
layout(set = 0, binding = 2) readonly buffer InCos {
    uint data[];
} uInputCos;
layout(set = 0, binding = 3) readonly buffer InSin {
    uint data[];
} uInputSin;

layout(push_constant) uniform PC {
    int total;      // Y element count = B * num_heads * seq * head_dim (even)
    int head_dim;   // full head dim (rotary_embedding_dim), e.g. 128
    int num_heads;  // heads dim of X (broadcast over cos/sin; used as the
                    // seq/divisor only in seq_major mode)
    int seq;        // sequence len of X (for cos/sin (b*seq+s) index)
    int input_untransposed; // 1 = X is laid out as [B, seq, num_heads, head_dim]
                            // (a Transpose(perm=[0,2,1,3]) was folded into RE);
                            // 0 = X is [B, num_heads, seq, head_dim] (default)
    int seq_major;    // 1 = X is [seq, num_heads, head_dim] (rank 3, vision
                      // encoder): the seq axis leads the head axis, so the
                      // cos/sin row is gid/(head_dim*num_heads)
    int rotary_dim;   // 旋转区间宽度 = cos/sin 每行的列数；== head_dim 是整维旋转
                      // (Qwen/DiT)，< head_dim 是 partial rotary (Phi-4: 128 维里
                      // 只转前 96 维)。0 按 head_dim 处理。
    int cs_fp32;      // 1 = cos/sin 是 fp32（X 可以是 fp16）。视觉塔的导出把 RoPE
                      // 整个放在 fp32 域里（HF 的 tensor.float()/.to(orig_dtype)
                      // 被 trace 成了 Cast 对），而激活是 fp16；这个标志让 fp16
                      // build 按真实步长读 cos/sin，两种 build 的 fp32 内部运算
                      // 因此逐位相同。0 = cos/sin 与 X 同为 fp16（LLM 的 MRoPE）。
    int comp;         // >= 0: X 是视觉塔 qkv 的 [seq, C, num_heads, head_dim]
                      // 张量，本轮只读第 comp 个分量（C 是 qkv 的 3），Y 仍是
                      // rank-3 [seq, num_heads, head_dim]。converter 的
                      // fuse_qkv_components 把 Transpose([N,C,H,D]->[C,N,H,D]) +
                      // Split(axis=0) + Squeeze 折成这个寻址：那些节点只为让
                      // Split 落在 axis 0（连续字节范围 → 零拷贝 view）而存在，
                      // head_dim 在两种布局里都是最内维，所以读点只多一个
                      // stride 项。 -1 = 关闭（默认）。
    int in_seq_stride; // comp >= 0 时的 X 相邻 seq 行距离（元素 =
                       // C*num_heads*head_dim）。X 是 [seq, C, H, D] 而 Y 是
                       // [seq, H, D]，所以 xidx = gid + s*(in_seq_stride - H*D)
                       // + comp*(H*D)。comp < 0 时不用。
} uPC;

// cos/sin 的读取视 cos/sin 自身的 dtype 而定，与 X 无关：fp16 build 里 X 走
// BUF_LOAD（半精度打包），cos/sin 走这里按 cs_fp32 选。fp32 build 两者同一表达式，
// 编译器会把分支折掉。
#ifdef FP16
#define BUF_LOAD_CS(data, idx) (uPC.cs_fp32 != 0 \
        ? uintBitsToFloat((data)[(idx)]) \
        : unpackHalf2x16((data)[(idx) >> 1])[(idx) & 1])
#else
#define BUF_LOAD_CS(data, idx) uintBitsToFloat((data)[(idx)])
#endif

// 旋转区间宽度：cos/sin 每行有多少列。== head_dim 就是整维旋转（Qwen / DiT），
// < head_dim 是 partial rotary（Phi-4：head_dim 128 里只转前 96 维，后 32 维
// 原样直通）。0 按 head_dim 处理。
int rotary_width() {
    return uPC.rotary_dim > 0 ? uPC.rotary_dim : uPC.head_dim;
}

// Decode (b, s, d) from an output gid in [B, num_heads, seq, head_dim] layout.
// h is not needed for cos/sin (they broadcast across heads). When
// input_untransposed is set, the INPUT X is [B, seq, num_heads, head_dim], so
// reading x at the "same" linear position requires remapping gid -> gid_in:
//   gid_in = b*(seq*num_heads*head_dim) + s*(num_heads*head_dim) + h*head_dim + d
// head_dim is the fastest axis in BOTH layouts, so gid_in +/- half_dim still
// addresses d +/- half within the same head (correct for the real/imag pair).
//
// When `comp` is set the INPUT is [seq, C, num_heads, head_dim] and the output
// stays the rank-3 seq-major [seq, num_heads, head_dim], so gid already carries
// (s, h, d) and only the seq and component strides differ:
//   gid_in = s*(C*H*D) + comp*(H*D) + h*D + d
//          = gid + s*(in_seq_stride - H*D) + comp*(H*D)
// Same argument for the pair: head_dim is the fastest axis here too, so
// +/- half_dim lands in the same head row of the same component.
int in_index(int gid, int b, int s, int d, int head_dim, int seq, int num_heads) {
    if (uPC.comp >= 0) {
        int hd = num_heads * head_dim;
        return gid + s * (uPC.in_seq_stride - hd) + uPC.comp * hd;
    }
    if (uPC.input_untransposed == 0) return gid;
    int h = (gid / (head_dim * seq)) % num_heads;
    return b * (seq * num_heads * head_dim)
         + s * (num_heads * head_dim)
         + h * head_dim + d;
}

// Rotate one element at linear index `gid` (d decoded from gid).
float rotate_one(int gid, int d, int half_dim, int head_dim, int seq,
                 int num_heads) {
    // seq_major: X is [seq, num_heads, head_dim] (vision encoder, batch axis
    // squeezed away and seq leading). No batch term, head axis sits between
    // seq and head_dim. A component read implies the same output layout, so it
    // selects this branch too rather than depending on the host to also set
    // seq_major (a disagreement here would silently read the wrong row).
    int b = 0;
    int s;
    if (uPC.seq_major != 0 || uPC.comp >= 0) {
        s = (gid / head_dim) / num_heads;
    } else {
        b = gid / (head_dim * seq * num_heads);
        s = (gid / head_dim) % seq;
    }
    // cos/sin 每行只有 rotary_width() 列：越过这一段就是 partial rotary 的直通维，
    // 原样拷贝，绝不能用 head_dim 去索引 cos/sin（会读到下一行甚至越界）。
    int rd = rotary_width();
    int xidx = in_index(gid, b, s, d, head_dim, seq, num_heads);
    float x = BUF_LOAD(uInputX.data, xidx);
    if (d >= rd) return x;
    int cs_idx = (b * seq + s) * rd + d;
    float cos_v = BUF_LOAD_CS(uInputCos.data, cs_idx);
    float sin_v = BUF_LOAD_CS(uInputSin.data, cs_idx);
    if (d < half_dim) {
        // real: x[d]*cos[d] - x[d+half]*sin[d]
        float x2 = BUF_LOAD(uInputX.data, xidx + half_dim);
        return cos_v * x - sin_v * x2;
    } else {
        // imag: x[d]*cos[d] + x[d-half]*sin[d]
        float x1 = BUF_LOAD(uInputX.data, xidx - half_dim);
        return sin_v * x1 + cos_v * x;
    }
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int total = uPC.total;
    int head_dim = uPC.head_dim;
    int seq = uPC.seq;
    int num_heads = uPC.num_heads;
    int half_dim = rotary_width() / 2;

#ifdef FP16
    // fp16: one thread per OUTPUT WORD (2 packed elements). gid is a word index.
    int words = (total + 1) / 2;
    if (gid >= words) return;
    int e0 = gid * 2;
    int d0 = e0 % head_dim;
    float r0 = rotate_one(e0, d0, half_dim, head_dim, seq, num_heads);
    int e1 = e0 + 1;
    if (e1 < total) {
        int d1 = e1 % head_dim;
        float r1 = rotate_one(e1, d1, half_dim, head_dim, seq, num_heads);
        uOutput.data[gid] = packHalf2x16(vec2(r0, r1));
    } else {
        // Odd tail (head_dim even => total even; guard only).
        BUF_STORE(uOutput.data, e0, r0);
    }
#else
    // fp32: one thread per element. gid is an element index.
    if (gid >= total) return;
    int d = gid % head_dim;
    float r = rotate_one(gid, d, half_dim, head_dim, seq, num_heads);
    BUF_STORE(uOutput.data, gid, r);
#endif
}
