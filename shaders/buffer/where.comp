#version 450

layout(local_size_x = 256, local_size_y = 1) in;

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaUintBuf {
    uint data[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaBoolBuf {
    bool data[];
};
layout(set=0, binding = 0) readonly buffer BdaTable {
    BdaUintBuf b0;
    BdaBoolBuf b1;
    BdaUintBuf b2;
    BdaUintBuf b3;
} uBdaTable;
#define bufferOut (uBdaTable.b0)
#define condition (uBdaTable.b1)
#define bufferX (uBdaTable.b2)
#define bufferY (uBdaTable.b3)
#else
layout(set=0, binding = 0) writeonly buffer BufferOut {
    uint data[];
} bufferOut;

layout(set=0, binding = 1) readonly buffer conditionBuffer {
    bool data[];
} condition;

layout(set=0, binding = 2) readonly buffer BufferX{
    uint data[];
} bufferX;

layout(set=0, binding = 3) readonly buffer BufferY {
    uint data[];
} bufferY;
#endif

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (condition.data[index]) {
        bufferOut.data[index] = bufferX.data[index];
    } else {
        bufferOut.data[index] = bufferY.data[index];
    }
}