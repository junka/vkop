#version 450 core

// int64 Concat: same indexing logic as concat.comp, but the OUTPUT (binding 0)
// and INPUT (binding 1) are int64 tensors bound as ivec2[] (8 bytes/elem — the
// established pattern, see gather_int64.comp). The device has no shaderInt64
// feature, so int64 SSBOs are viewed as ivec2 and copied verbatim (both words).
// Concat is a strided indexed copy — no 64-bit math is needed.
//
// Per-input submit (host binds this input + the shared output and dispatches
// UP_DIV(in_total,256)). For each input element, map its nd-coords and copy to
// out_nd with out_nd[axis] += offset. Same ConcatPC layout as concat.comp.
//
// Replaces the int64 CPU path in ConcatBuffer::execute (copyToCPU per input +
// host strided-copy loop + copyToGPU = N+1 sync stalls, ~1940ms/round — the #1
// decode bottleneck after Shape/Gather were GPU-ified). Downstream int64 CPU
// readers (Reshape/Slice/Range) call copyToCPU themselves to read this op's
// GPU output (valid: this op's level already submitted by the time they run).

layout(set = 0, binding = 0) writeonly buffer Output {
    ivec2 data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    ivec2 data[];
} uInput;

struct IArr8 { int v[8]; };

layout(push_constant) uniform PC_ConcatInt64 {
    int axis;
    int rank;
    IArr8 inDims;
    IArr8 outDims;
    int offset;
    int _pad0;
    int _pad1;
    int _pad2;
} uConcat;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

int concat_total(IArr8 shape, int rank) {
    int size = 1;
    for (int i = 0; i < rank; ++i) size *= shape.v[i];
    return size;
}

IArr8 concat_linear_to_nd(int linear, IArr8 dims, int rank) {
    IArr8 coord;
    for (int i = 0; i < 8; ++i) coord.v[i] = 0;
    for (int i = rank - 1; i >= 0; --i) {
        coord.v[i] = linear % dims.v[i];
        linear /= dims.v[i];
    }
    return coord;
}

int concat_nd_to_linear(IArr8 coord, IArr8 dims, int rank) {
    int linear = 0;
    int stride = 1;
    for (int i = rank - 1; i >= 0; --i) {
        linear += coord.v[i] * stride;
        stride *= dims.v[i];
    }
    return linear;
}

// Map an input element index to the output element index (axis offset added).
int concat_elem(int gid) {
    IArr8 in_coord = concat_linear_to_nd(gid, uConcat.inDims, uConcat.rank);
    IArr8 out_coord;
    for (int i = 0; i < 8; ++i) out_coord.v[i] = in_coord.v[i];
    out_coord.v[uConcat.axis] += uConcat.offset;
    return concat_nd_to_linear(out_coord, uConcat.outDims, uConcat.rank);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int rank = uConcat.rank;
    int in_total = concat_total(uConcat.inDims, rank);
    if (gid >= in_total) return;
    int out_linear = concat_elem(gid);
    // Copy the int64 element (both words of the ivec2) verbatim.
    uOutput.data[out_linear] = uInput.data[gid];
}
