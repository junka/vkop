// Odd-N fallback: one thread per output element, fp32 result to scratch;
// matmul_pack.comp does the half2 pack afterwards.
void matmul16_odd_n() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = load_a(a_base + i * uPC.K + k);
        float b = load_b(b_idx);
        sum += a * b;
    }

    // The attention QK^T epilogue must ride along here too: prefill/decode
    // with an odd kv_len lands on this kernel, and matmul_pack.comp only
    // converts fp32->half2 -- it never applies scale/bias. Skipping it wrote
    // raw QK^T where scaled+masked scores belonged.
    if (uPC.epi_bias != 0) {
        sum = sum * uPC.epi_scale + epi_bias_at(n, i, j);
    }
    uScratch.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}

