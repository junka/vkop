#version 450 core

// MatMul SSBO reduce pass (fp32 + fp16). Computes C = A @ B.
// fp32: one thread per output element, fp32 store to uOutput.
// fp16, three modes picked by the host (see MatMulBuffer::execute):
//   - tiled (uPC.tile): shared-memory 64x64x16 GEMM for large-M / compute-bound
//     calls, needs K % 16 == 0 and handles both B layouts.
//   - even N: one thread per output half2 WORD (two adjacent columns of the
//     same row, A load shared) packed straight into uOutput — single pass, no
//     scratch.
//   - odd N: half2 words straddle row boundaries (word ownership would race
//     across threads), so we fall back to reduce-into-fp32-scratch + a
//     SEPARATE pack dispatch (buffer/matmul_pack.comp, kept for that case; the
//     separate pipeline also avoids Intel ANV push-constant interference
//     between dispatches of the same pipeline).
// int8 weight-only B (uPC.weight_int8) is a fourth mode: with even N it keeps a
// single pass that writes the packed half2 output directly (one thread per two
// columns, or per four columns when uPC.w8_quad, see below), and only odd N
// falls back to one thread per output element in reduce->pack form. Byte
// packing changes how a weight is LOADED, not who owns an output word.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;
// Per-output-column dequant scale for int8 weight-only B (binding 4), inert
// otherwise. The optimizer stores scale = amax/127 per column of C as fp32 and
// MatMulBuffer::execute refuses any other scale format.
layout(set = 0, binding = 4) readonly buffer Scale {
    uint data[];
} uScale;

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;
    int transB; // 1 = B is laid out as [batch, N, K] (transposed); read B[j*K+k]
    int tile;   // 1 = shared-memory tiled GEMM (grid is x=N/64, y=M/64, z=batch)
    int weight_int8; // 1 = B is packed int8 bytes, dequant via uScale[j]
    int w8_quad;     // 1 = int8 B, N % 4 == 0 and B is [batch, K, N]: one thread
                     // owns four columns (the host sizes the grid to match)
} uPC;

#ifdef FP16
float load_a(int idx) {
    return unpackHalf2x16(uInputA.data[idx >> 1])[idx & 1];
}
float load_b(int idx) {
    return unpackHalf2x16(uInputB.data[idx >> 1])[idx & 1];
}
#endif

// One int8 weight byte as a float. The sign bit is XOR-ed out of the word
// first so every lane is a plain unsigned byte-to-float convert plus a constant
// subtract: a uint-to-int conversion of a value above INT_MAX is
// implementation-defined, and an arithmetic right shift of a signed int is not
// something to bet a kernel on across drivers either.
float load_w8(int idx) {
    uint word = uInputB.data[idx >> 2] ^ 0x80808080u;
    return float((word >> ((idx & 3) * 8)) & 0xFFu) - 128.0;
}

// The four int8 weights of one word, low byte first.
vec4 unpack_w8(uint word) {
    word ^= 0x80808080u;
    return vec4(float(word & 0xFFu), float((word >> 8) & 0xFFu),
                float((word >> 16) & 0xFFu), float(word >> 24)) -
           128.0;
}

#ifdef FP16
// Odd-N int8 lands in the fp32 scratch and matmul_pack.comp halves it; the
// fused even-N path below writes the output word itself.
#define W8_STORE(idx, val) uScratch.data[idx] = floatBitsToUint(val)

// int8 weight-only, N % 4 == 0 and B is [batch, K, N] (transB == 0): one thread
// per output DWORD, i.e. four adjacent columns of one row. For this layout the
// four columns of a given K are the four bytes of one word, so a single 32-bit
// weight load feeds four FMAs and successive threads read successive words of
// the same row (coalesced) while the A element broadcasts. That is the LLM
// decode shape: A is one row, the weight stream is the whole cost, and the
// byte-by-byte walk it replaces was one load plus one unpack per tap, which
// made int8 read half the bytes yet run slower than fp16.
void matmul16_w8_quad() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 4;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    // N % 4 == 0 makes every row start 4-aligned, so (k*N + ja) is 4-aligned for
    // every k: the quad needs no per-tap alignment test.
    int b_row = n * uPC.K * uPC.N + ja;

    vec4 wsc = vec4(uintBitsToFloat(uScale.data[ja]),
                    uintBitsToFloat(uScale.data[ja + 1]),
                    uintBitsToFloat(uScale.data[ja + 2]),
                    uintBitsToFloat(uScale.data[ja + 3]));

    vec4 s = vec4(0.0);
    // K even => a_off is even, so two consecutive A elements are one word.
    if ((uPC.K & 1) == 0) {
        for (int k = 0; k < uPC.K; k += 2) {
            vec4 w0 = unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
            vec4 w1 =
                unpack_w8(uInputB.data[(b_row + (k + 1) * uPC.N) >> 2]);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            s += load_a(a_off + k) *
                 unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
        }
    }

    vec4 v = s * wsc;
    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

// int8 weight-only, even N, two columns per thread: single pass straight into
// the output half2 word, same ownership as the fp16 even-N kernel. Nothing
// about a byte-packed weight touches the OUTPUT alignment (the column pair
// ja, ja+1 is word-aligned because N is even), only how B gets read, so int8
// keeps the fused store instead of paying a second dispatch per GEMM.
// Under transB a weight column is contiguous, so with K % 4 == 0 four taps of a
// column come out of one 32-bit word: one B load per four FMAs.
void matmul16_w8_even_n() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    int b_base = n * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // Constant along K, so both column scales leave the loop.
    float wsc0 = uintBitsToFloat(uScale.data[ja]);
    float wsc1 = uintBitsToFloat(uScale.data[jb]);

    float s0 = 0.0, s1 = 0.0;
    // b0 (and therefore every b0 + k) is 4-aligned when K % 4 == 0, because
    // b_base = n*K*N and ja*K are multiples of K then.
    if (uPC.transB != 0 && (uPC.K & 3) == 0) {
        for (int k = 0; k < uPC.K; k += 4) {
            vec4 w0 = unpack_w8(uInputB.data[(b0 + k) >> 2]);
            vec4 w1 = unpack_w8(uInputB.data[(b1 + k) >> 2]);
            vec2 a01 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a23 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            s0 += a01.x * w0.x + a01.y * w0.y + a23.x * w0.z + a23.y * w0.w;
            s1 += a01.x * w1.x + a01.y * w1.y + a23.x * w1.z + a23.y * w1.w;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            float a = load_a(a_off + k);
            s0 += a * load_w8(b0);
            s1 += a * load_w8(b1);
            b0 += b_step;
            b1 += b_step;
        }
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(vec2(s0 * wsc0, s1 * wsc1));
}

// One thread owns output word (n, i, {ja, ja+1}) of an even-N C. ja is even
// and n*M*N + i*N is even when N is even, so the pair is word-aligned.
void matmul16_even_n() {
    int p = int(gl_GlobalInvocationID.x); // column-pair (= word) index in a row
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    // transB: B is [batch, N, K] so element (n, col, k) is at col*K + k
    // (k-step 1); otherwise B is [batch, K, N], element (n, k, col) is at
    // k*N + col (k-step N). Hoisting this out of the K loop removes the
    // per-iteration branch and keeps both column walks linear.
    int b_base = n * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // K even => a_off, b0 and b1 are even element indices (K even makes every
    // row start word-aligned; under transB the B rows are contiguous too), so
    // each k-pair is one 32-bit word per stream. Four accumulators break the
    // serial FMA dependency chains.
    float s0a = 0.0, s0b = 0.0, s1a = 0.0, s1b = 0.0;
    int k = 0;
    if ((uPC.K & 1) == 0) {
        if (uPC.transB != 0) {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                vec2 v0 = unpackHalf2x16(uInputB.data[(b0 + k) >> 1]);
                vec2 v1 = unpackHalf2x16(uInputB.data[(b1 + k) >> 1]);
                s0a += a.x * v0.x;
                s0b += a.y * v0.y;
                s1a += a.x * v1.x;
                s1b += a.y * v1.y;
            }
        } else {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                s0a += a.x * load_b(b0);
                s0b += a.y * load_b(b0 + uPC.N);
                s1a += a.x * load_b(b1);
                s1b += a.y * load_b(b1 + uPC.N);
                b0 += 2 * uPC.N;
                b1 += 2 * uPC.N;
            }
        }
    }
    // Odd-K tail: scalar walk (also covers K == 0 -> nothing).
    for (; k < uPC.K; ++k) {
        float a = load_a(a_off + k);
        s0a += a * load_b(b0);
        s1a += a * load_b(b1);
        b0 += b_step;
        b1 += b_step;
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] =
        packHalf2x16(vec2(s0a + s0b, s1a + s1b));
}

// Tiled GEMM for the compute-bound regime (M big enough that the naive path
// stops being bandwidth-bound). A 16x16 workgroup stages 64x64 A/B tiles in
// shared memory and every thread owns a 4x4 sub-tile, so each global element
// read feeds 4x4 outputs instead of ~2: the naive path re-reads the weight
// rows for every output row, which is what caps it at ~2.7 TFLOP/s.
// Both B layouts are covered; K % TILE_K == 0 keeps every tile word aligned
// and removes all in-loop bounds tests. Grid: x = N/64, y = M/64, z = batch,
// so a block never straddles a batch boundary.
#define TILE_M 64
#define TILE_N 64
#define TILE_K 16
// Words per [tile-row][k-pair] shared row: TILE_K/2 packed halves + 1 pad.
// The pad breaks the 32-bank aliasing a power-of-2 stride causes across the
// 16 lane threads (each thread's 4 columns start 4 words apart).
#define SROW (TILE_K / 2 + 1)
// Words per [k][column-pair] shared row, used when B is [batch, K, N].
#define SBROW (TILE_N / 2)

// glslang only accepts `shared` at global scope; the tiled path is the sole
// user, and the naive paths never touch these.
shared uint sA[TILE_M * SROW];
// Sized for the wider of the two stagings: transB keeps [col][k-pair] (9 words
// per row), [batch,K,N] keeps [k][col-pair] (32 words per row, 64 k-rows).
shared uint sB[TILE_N * SBROW];

int tile_tid() {
    return int(gl_LocalInvocationID.x) + int(gl_LocalInvocationID.y) * 16;
}

// A tile: 64 rows x 8 k-pair words, packed along K. Identical for both B
// layouts, and always coalesced (consecutive threads walk one row).
void tile_load_a(int b, int row0, int kw, int halfK) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int row = l >> 3;
        int kt = l & 7;
        sA[row * SROW + kt] = (row0 + row < uPC.M)
                                  ? uInputA.data[(b * uPC.M + row0 + row) *
                                                     halfK + kw + kt]
                                  : 0u;
    }
}

// transB: B is [batch, N, K], so a weight column is a contiguous row and the
// tile keeps the same [row][k-pair] packing as A.
void tile_load_b_t(int b, int col0, int kw, int halfK) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int row = l >> 3;
        int kt = l & 7;
        sB[row * SROW + kt] = (col0 + row < uPC.N)
                                  ? uInputB.data[(b * uPC.N + col0 + row) *
                                                     halfK + kw + kt]
                                  : 0u;
    }
}

// B is [batch, K, N]: keep global's [k][column-pair] packing so the copy is a
// straight word-for-word transfer (N even => every column pair is one word).
void tile_load_b_n(int b, int col0, int kk, int halfN) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int kr = l >> 5;
        int cp = l & 31;
        sB[kr * SBROW + cp] =
            (col0 + cp * 2 + 1 < uPC.N)
                ? uInputB.data[(b * uPC.K + kk + kr) * halfN + (col0 >> 1) + cp]
                : 0u;
    }
}

// One k-pair per thread, transB: a B word carries the two K values of one
// column.
void tile_fma_t(inout float acc[4][4], int lr, int lc) {
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        vec2 b0 = unpackHalf2x16(sB[(lc + 0) * SROW + kt]);
        vec2 b1 = unpackHalf2x16(sB[(lc + 1) * SROW + kt]);
        vec2 b2 = unpackHalf2x16(sB[(lc + 2) * SROW + kt]);
        vec2 b3 = unpackHalf2x16(sB[(lc + 3) * SROW + kt]);
#pragma unroll
        for (int c = 0; c < 4; ++c) {
            vec2 bv = c == 0 ? b0 : (c == 1 ? b1 : (c == 2 ? b2 : b3));
            acc[0][c] += a0.x * bv.x + a0.y * bv.y;
            acc[1][c] += a1.x * bv.x + a1.y * bv.y;
            acc[2][c] += a2.x * bv.x + a2.y * bv.y;
            acc[3][c] += a3.x * bv.x + a3.y * bv.y;
        }
    }
}

// B is [batch, K, N]: a B word carries two adjacent columns at one K, so the
// thread's 4 columns come from 2 words per K.
void tile_fma_n(inout float acc[4][4], int lr, int lc) {
    int cp = lc >> 1;
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        int w0 = (2 * kt) * SBROW + cp;
        int w1 = (2 * kt + 1) * SBROW + cp;
        vec2 p0 = unpackHalf2x16(sB[w0]);
        vec2 p1 = unpackHalf2x16(sB[w0 + 1]);
        vec2 q0 = unpackHalf2x16(sB[w1]);
        vec2 q1 = unpackHalf2x16(sB[w1 + 1]);
#pragma unroll
        for (int r = 0; r < 4; ++r) {
            vec2 av = r == 0 ? a0 : (r == 1 ? a1 : (r == 2 ? a2 : a3));
            acc[r][0] += av.x * p0.x + av.y * q0.x;
            acc[r][1] += av.x * p0.y + av.y * q0.y;
            acc[r][2] += av.x * p1.x + av.y * q1.x;
            acc[r][3] += av.x * p1.y + av.y * q1.y;
        }
    }
}

void matmul16_tiled() {
    // Workgroup (not invocation) ids: each block owns one 64x64 tile, so the
    // local offset must not be folded into the tile origin.
    int b = int(gl_WorkGroupID.z);
    int row0 = int(gl_WorkGroupID.y) * TILE_M;
    int col0 = int(gl_WorkGroupID.x) * TILE_N;
    if (row0 >= uPC.M || col0 >= uPC.N) return;

    int lr = int(gl_LocalInvocationID.y) * 4; // this thread's tile origin
    int lc = int(gl_LocalInvocationID.x) * 4;
    int halfK = uPC.K >> 1;
    int halfN = uPC.N >> 1;

    float acc[4][4];
    for (int r = 0; r < 4; ++r)
        for (int c = 0; c < 4; ++c)
            acc[r][c] = 0.0;

    // The two layouts differ only in how B is staged and read, so each gets
    // its own loop nest instead of a branch per k-step. transB is
    // workgroup-uniform, so the barriers stay convergent.
    if (uPC.transB != 0) {
        for (int kk = 0; kk < uPC.K; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_t(b, col0, kk >> 1, halfK);
            barrier();
            tile_fma_t(acc, lr, lc);
            barrier();
        }
    } else {
        for (int kk = 0; kk < uPC.K; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_n(b, col0, kk, halfN);
            barrier();
            tile_fma_n(acc, lr, lc);
            barrier();
        }
    }

    // N even => col0 + lc is even, so each column pair is one word; the pair
    // can never straddle the row end (that only happens with odd N).
    for (int r = 0; r < 4; ++r) {
        int grow = row0 + lr + r;
        if (grow >= uPC.M) break;
        int base = (b * uPC.M + grow) * uPC.N + col0 + lc;
        if (col0 + lc + 1 < uPC.N)
            uOutput.data[base >> 1] =
                packHalf2x16(vec2(acc[r][0], acc[r][1]));
        if (col0 + lc + 3 < uPC.N)
            uOutput.data[(base + 2) >> 1] =
                packHalf2x16(vec2(acc[r][2], acc[r][3]));
    }
}

// Odd-N fallback: one thread per output element, fp32 result to scratch;
// matmul_pack.comp does the half2 pack afterwards.
void matmul16_odd_n() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = load_a(a_base + i * uPC.K + k);
        float b = load_b(b_idx);
        sum += a * b;
    }

    uScratch.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}
#endif

#ifndef FP16
float load_a(int idx) {
    return uintBitsToFloat(uInputA.data[idx]);
}
// fp32 build has no scratch: the reduce is the whole kernel.
#define W8_STORE(idx, val) uOutput.data[idx] = floatBitsToUint(val)
#endif

// int8 weight-only B, odd N (and every fp32-build call). One thread per output
// element, fp32 accumulate over the raw weight bytes, then one multiply by this
// column's dequant scale (the scale is constant along K, so folding it out of
// the loop is both cheaper and rounding-wise no worse than a per-tap dequant).
// The shared-memory tiled nest is the remaining mode int8 does not use: its B
// loaders stage half2 words straight from global, which a byte-packed weight
// has no equivalent for — and tiling only pays at m >= 12, far from the
// weight-bandwidth-bound regime this kernel exists for.
void matmul_w8() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    float wsc = uintBitsToFloat(uScale.data[j]);
    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        sum += load_a(a_base + i * uPC.K + k) * load_w8(b_idx);
    }

    W8_STORE(n * uPC.M * uPC.N + i * uPC.N + j, sum * wsc);
}

void matmul32() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        // transB: B is [batch, N, K] so element (n,j,k) lives at j*K+k instead
        // of k*N+j. Avoids a separate Transpose dispatch before the MatMul.
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = uintBitsToFloat(uInputA.data[a_base + i * uPC.K + k]);
        float b = uintBitsToFloat(uInputB.data[b_idx]);
        sum += a * b;
    }

    uOutput.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}

void main() {
    // int8 weight-only owns its own kernels: with even N in the fp16 build it
    // keeps the fused single-pass half2 store, otherwise it reduces elementwise
    // (fp32 build: straight to output; fp16 odd N: to scratch, then pack).
    // The host never sets tile for it, so these tests come before the fp16 mode
    // selection.
    if (uPC.weight_int8 != 0) {
#ifdef FP16
        if (uPC.w8_quad != 0) {
            matmul16_w8_quad();
            return;
        }
        if ((uPC.N & 1) == 0) {
            matmul16_w8_even_n();
            return;
        }
#endif
        matmul_w8();
        return;
    }
#ifdef FP16
    if (uPC.tile != 0) {
        matmul16_tiled();
    } else if ((uPC.N & 1) == 0) {
        matmul16_even_n();
    } else {
        matmul16_odd_n();
    }
#else
    matmul32();
#endif
}
