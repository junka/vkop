#version 450 core

// MatMul SSBO reduce pass (fp32 + fp16). Computes C = A @ B.
// fp32: one thread per output element, fp32 store to uOutput.
// fp16, three modes picked by the host (see MatMulBuffer::execute):
//   - tiled (uPC.tile): shared-memory 64x64x16 GEMM for large-M / compute-bound
//     calls, needs K % 16 == 0 and handles both B layouts.
//   - even N: one thread per output half2 WORD (two adjacent columns of the
//     same row, A load shared) packed straight into uOutput — single pass, no
//     scratch.
//   - odd N: half2 words straddle row boundaries (word ownership would race
//     across threads), so we fall back to reduce-into-fp32-scratch + a
//     SEPARATE pack dispatch (buffer/matmul_pack.comp, kept for that case; the
//     separate pipeline also avoids Intel ANV push-constant interference
//     between dispatches of the same pipeline).
// A byte-quantized weight-only B (uPC.weight_int8, fp8 when uPC.fp8) is a fourth
// mode: with even N it keeps a single pass that writes the packed half2 output
// directly (one thread per two columns, or per four columns when uPC.w8_quad,
// see below), and only odd N falls back to one thread per output element in
// reduce->pack form. Byte packing changes how a weight is LOADED, not who owns
// an output word. From the sizes where the tiled nest pays (m >= 12, host
// picked) a byte weight joins it too: the tile stages the decoded value, so the
// byte -> float step runs once per weight per 64-row block instead of once per
// output element.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;
// Per-output-column dequant scale for a quantized weight-only B (binding 4),
// inert otherwise. int8 and fp8 store scale = absmax / the format's largest
// finite value (127, 448, 57344) per column as fp32; the 4-bit formats store one
// scale per (K group, column), laid out [n_groups, N] row-major so a
// thread's columns of one group are contiguous -- as fp32 for int4 and nf4, as
// fp8 e4m3 bytes for NVFP4 (one byte per 16-value block, times uGlobal).
// MatMulBuffer refuses any other scale format or count.
layout(set = 0, binding = 4) readonly buffer Scale {
    uint data[];
} uScale;
// NVFP4's second scale level: one fp32 factor for the whole tensor, held as a
// 1-element input so it travels with the weight instead of being a readback.
// Inert for every other format (the host binds a dummy).
layout(set = 0, binding = 5) readonly buffer GlobalScale {
    uint data[];
} uGlobal;

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;
    int transB; // 1 = B is laid out as [batch, N, K] (transposed); read B[j*K+k]
    int tile;   // 1 = shared-memory tiled GEMM (grid is x=N/64, y=M/64, z=batch)
    int weight_int8; // 1 = B is one byte per quantized value, dequant via
                     // uScale[j]; fp8 when uPC.fp8, int8 otherwise
    int w8_quad;     // 1 = a byte-quantized B, N % 4 == 0 and B is [batch, K, N]:
                     // one thread owns four columns (the host sizes the grid to
                     // match)
    int ksplit; // 1 = split-K GEMV: a block covers ksplit_q column quads and
                // splits K over the lanes the single A row leaves idle (grid is
                // x = N/4/ksplit_q, y = batch*M). Host picks it, see
                // MatMulBuffer.
    int ksplit_q; // column quads per block for the split-K GEMV. The block's
                // 256 lanes are laid out flat as quad = lane % ksplit_q, k
                // slice = lane / ksplit_q, so ksplit_q trades column coverage
                // for K parallelism: a narrow-N layer (down_proj N=896) put only
                // 14 blocks on the device at q=16 and ran at 21 GB/s, while
                // lm_head (2374 blocks) reached 25. Host sets it; 16 reproduces
                // the original layout.
    int w4;     // 1 = B is a packed 4-bit weight (two nibbles per byte, low one
                // first) with a per-group scale: N % 8 == 0, transB == 0 and
                // K % group == 0 are all host-checked (see MatMulBuffer).
    int nf4;    // 1 = the nibble is an unsigned index into the NF4 codebook
                // instead of a signed int4 value. Only meaningful with w4.
    int group;  // with w4: values of K sharing one scale row (K / n_groups),
                // even and a divisor of K. Unused otherwise.
    int fp8;    // 1 = the weight_int8 bytes are fp8, not two's complement: one
                // value per byte, decoded by reassembling its exponent and
                // mantissa (uPC.e5m2 picks the layout). Same per-column scale
                // and same kernels as int8.
    int e5m2;   // 1 = the fp8 bytes are E5M2 (5 exponent, 2 mantissa bits)
                // instead of E4M3. Only meaningful with fp8.
    int nvfp4;  // 1 = a w4 payload whose nibble is an E2M1 code, scaled by an
                // e4m3 byte per (16-value K block, column) at binding 4 and one
                // fp32 per-tensor factor at binding 5. Also fixes group to 16.
    int uint4;  // 1 = the w4 nibble is an unsigned value in [0, 15] scaled by
                // the group scale (the unsigned counterpart of the signed int4
                // grid), instead of a signed [-8, 7] two's-complement nibble.
                // Only meaningful with w4; nvfp4/nf4 take precedence over it.
} uPC;

#ifdef FP16
float load_a(int idx) {
    return unpackHalf2x16(uInputA.data[idx >> 1])[idx & 1];
}
float load_b(int idx) {
    return unpackHalf2x16(uInputB.data[idx >> 1])[idx & 1];
}
#endif

// ---- byte-per-value quantized weights ---------------------------------
// int8 and fp8 share everything below: one byte per weight, one fp32 scale per
// output column, and therefore a scale that folds out of the K loop. Only the
// byte-to-float step differs, and it is the whole of both kernels' difference,
// so the four byte-shaped paths (quad, split-K, even-N and the fp32 build's
// per-element one) stay single implementations.

// One int8 weight byte as a float. The sign bit is XOR-ed out first so every
// lane is a plain unsigned byte-to-float convert plus a constant subtract: a
// uint-to-int conversion of a value above INT_MAX is implementation-defined, and
// an arithmetic right shift of a signed int is not something to bet a kernel on
// across drivers either.
float w8_val(uint b) { return float(b ^ 0x80u) - 128.0; }

// One fp8 byte as a float. There is no hardware path on this stack -- MoltenVK's
// device extensions stop at VK_KHR_shader_float16_int8, so VK_EXT_shader_float8
// is absent -- which leaves reassembling the fields by hand. With the sign
// stripped, a normal fp8 byte's [exp|mant] is already the top of an fp32's
// [exp|mantissa] once the two biases agree:
//   E4M3 (bias 7, mantissa lsb 2^-3): bits = (m + (120 << 3)) << 20
//   E5M2 (bias 15, mantissa lsb 2^-2): bits = (m + (112 << 2)) << 21
// Both are exact for every normal byte (checked against all 128 magnitudes).
// Only exponent == 0 needs its own term, because a subnormal there is an integer
// multiple of the smallest step, 2^-9 for E4M3 and 2^-16 for E5M2. The encodings
// past the largest finite value (E4M3 0x7f, E5M2 0x7c..0x7f) are NaN/Inf and are
// deliberately not decoded: a quantized weight cannot reach them, since the
// converter divides by the column absmax over that largest finite value and
// clips to it.
//
// e4m3 is also what NVFP4's block scale is stored as (see scale4), so it stands
// on its own rather than living inside the fp8-weight branch.
float e4m3_val(uint b) {
    uint m = b & 0x7Fu;
    float v =
        m > 7u ? uintBitsToFloat((m + 960u) << 20u) : float(m) * 0.001953125;
    return (b & 0x80u) != 0u ? -v : v;
}

float e5m2_val(uint b) {
    uint m = b & 0x7Fu;
    float v =
        m > 3u ? uintBitsToFloat((m + 448u) << 21u) : float(m) * 1.52587890625e-05;
    return (b & 0x80u) != 0u ? -v : v;
}

float f8_val(uint b) { return uPC.e5m2 != 0 ? e5m2_val(b) : e4m3_val(b); }

float w_val(uint b) { return uPC.fp8 != 0 ? f8_val(b) : w8_val(b); }

// One quantized weight by its index in the logical [K, N] matrix.
float load_w8(int idx) {
    return w_val((uInputB.data[idx >> 2] >> ((idx & 3) * 8)) & 0xFFu);
}

// The four weights of one word, low byte first.
vec4 unpack_w8(uint word) {
    if (uPC.fp8 != 0) {
        return vec4(f8_val(word & 0xFFu), f8_val((word >> 8) & 0xFFu),
                    f8_val((word >> 16) & 0xFFu), f8_val(word >> 24));
    }
    return vec4(w8_val(word & 0xFFu), w8_val((word >> 8) & 0xFFu),
                w8_val((word >> 16) & 0xFFu), w8_val(word >> 24));
}

// ---- 4-bit weight-only payloads ---------------------------------------
// Two values per byte, the even element in the low nibble, so one 32-bit word
// holds the eight columns of one K row that a pair of threads splits.

// The NF4 codebook: the 16 quantiles of a unit-normal distribution, as
// published for bitsandbytes' NF4 and normalized so the extreme codes are
// exactly -1 and +1. A weight is codebook[q] * group_absmax, so the fp32 scale
// table holds the group absmax itself (not absmax/7 like int4/int8).
float nf4_code(int q) {
    const float cb[16] = float[16](
        -1.0, -0.6961928009986877, -0.5250730514526367, -0.3949174189567566,
        -0.2844413814544678, -0.1847814998626709, -0.0910967006323811, 0.0,
        0.0795802986717224, 0.1601973110246658, 0.2447470557689667,
        0.3361703515052795, 0.4407098295211792, 0.5626170039176941,
        0.7229568369388580, 1.0);
    return cb[q];
}

// One signed 4-bit value: bitfieldExtract with a signed result sign-extends the
// nibble, which is the two's-complement conversion without a compare.
float w4_val(uint word, int e) {
    return float(bitfieldExtract(int(word), e * 4, 4));
}

// One UNSIGNED 4-bit value in [0, 15]. Same bits as w4_val, read without the
// sign extension -- the grid is 16 levels below the group absmax rather than a
// symmetric +-7, so the zero point is 0 and the scale carries absmax/15.
float w4u_val(uint word, int e) {
    return float((word >> uint(e * 4)) & 15u);
}

// One E2M1 nibble -- sign, 2 exponent bits, 1 mantissa bit -- so its eight
// magnitudes are 0, .5, 1, 1.5, 2, 3, 4, 6. Same field slide as fp8: with the
// sign stripped, a normal code is an fp32 whose exponent is (code >> 1) - 1 and
// whose mantissa is the low bit, i.e. bits = ((code + 252) >> 1) << 23 with the
// mantissa bit at 1 << 22. `(code + 252) >> 1` is bias-adjusted for both
// mantissas of a pair, so one expression covers the whole normal range; only
// exponent 0 needs its own term, where the value is a multiple of the subnormal
// step 2^-1. There is no Inf or NaN encoding: all 16 nibbles are values.
float e2m1_val(uint c) {
    uint m = c & 7u;
    float v = m > 1u
                  ? uintBitsToFloat((((m + 252u) >> 1u) << 23u) |
                                    ((m & 1u) << 22u))
                  : float(m) * 0.5;
    return (c & 8u) != 0u ? -v : v;
}

// Four consecutive 4-bit weights starting at nibble `base` (0 or 4) of a word.
vec4 unpack_w4(uint word, int base) {
    if (uPC.nvfp4 != 0) {
        word >>= base * 4;
        return vec4(e2m1_val(word & 15u), e2m1_val((word >> 4) & 15u),
                    e2m1_val((word >> 8) & 15u), e2m1_val(word >> 12));
    }
    if (uPC.nf4 != 0) {
        word >>= base * 4;
        return vec4(nf4_code(int(word & 15u)), nf4_code(int((word >> 4) & 15u)),
                    nf4_code(int((word >> 8) & 15u)),
                    nf4_code(int((word >> 12) & 15u)));
    }
    if (uPC.uint4 != 0) {
        return vec4(w4u_val(word, base), w4u_val(word, base + 1),
                    w4u_val(word, base + 2), w4u_val(word, base + 3));
    }
    return vec4(w4_val(word, base), w4_val(word, base + 1),
                w4_val(word, base + 2), w4_val(word, base + 3));
}

// One weight by its index in the logical [K, N] matrix.
float unpack_w4_at(int idx) {
    uint word = uInputB.data[idx >> 3];
    int e = idx & 7;
    if (uPC.nvfp4 != 0) return e2m1_val((word >> (e * 4)) & 15u);
    if (uPC.uint4 != 0) return w4u_val(word, e);
    return uPC.nf4 != 0 ? nf4_code(int((word >> (e * 4)) & 15u))
                        : w4_val(word, e);
}

// The fp32 factor NVFP4 multiplies every block scale by: the one level the
// format carries per tensor rather than per block.
float global_scale() { return uintBitsToFloat(uGlobal.data[0]); }

// This thread's four column scales of one K group.
vec4 scale4(int sw) {
    if (uPC.nvfp4 != 0) {
        // Four adjacent columns' e4m3 block scales are one word: sw is a
        // multiple of 4 because a thread's column start is, and every group row
        // starts 4-aligned because N % 8 == 0.
        uint w = uScale.data[sw >> 2];
        return vec4(e4m3_val(w & 0xFFu), e4m3_val((w >> 8) & 0xFFu),
                    e4m3_val((w >> 16) & 0xFFu), e4m3_val(w >> 24)) *
               global_scale();
    }
    return vec4(uintBitsToFloat(uScale.data[sw]),
                uintBitsToFloat(uScale.data[sw + 1]),
                uintBitsToFloat(uScale.data[sw + 2]),
                uintBitsToFloat(uScale.data[sw + 3]));
}

// One column's group scale, for the fp32 build's per-element path.
float scale1(int sw) {
    if (uPC.nvfp4 != 0) {
        return e4m3_val((uScale.data[sw >> 2] >> ((sw & 3) * 8)) & 0xFFu) *
               global_scale();
    }
    return uintBitsToFloat(uScale.data[sw]);
}

#ifdef FP16
// Odd-N int8 lands in the fp32 scratch and matmul_pack.comp halves it; the
// fused even-N path below writes the output word itself.
#define W8_STORE(idx, val) uScratch.data[idx] = floatBitsToUint(val)

// int8 weight-only, N % 4 == 0 and B is [batch, K, N] (transB == 0): one thread
// per output DWORD, i.e. four adjacent columns of one row. For this layout the
// four columns of a given K are the four bytes of one word, so a single 32-bit
// weight load feeds four FMAs and successive threads read successive words of
// the same row (coalesced) while the A element broadcasts. That is the LLM
// decode shape: A is one row, the weight stream is the whole cost, and the
// byte-by-byte walk it replaces was one load plus one unpack per tap, which
// made int8 read half the bytes yet run slower than fp16.
void matmul16_w8_quad() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 4;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    // N % 4 == 0 makes every row start 4-aligned, so (k*N + ja) is 4-aligned for
    // every k: the quad needs no per-tap alignment test.
    int b_row = n * uPC.K * uPC.N + ja;

    vec4 wsc = vec4(uintBitsToFloat(uScale.data[ja]),
                    uintBitsToFloat(uScale.data[ja + 1]),
                    uintBitsToFloat(uScale.data[ja + 2]),
                    uintBitsToFloat(uScale.data[ja + 3]));

    vec4 s = vec4(0.0);
    // K even => a_off is even, so two consecutive A elements are one word.
    if ((uPC.K & 1) == 0) {
        for (int k = 0; k < uPC.K; k += 2) {
            vec4 w0 = unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
            vec4 w1 =
                unpack_w8(uInputB.data[(b_row + (k + 1) * uPC.N) >> 2]);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            s += load_a(a_off + k) *
                 unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
        }
    }

    vec4 v = s * wsc;
    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

// 4-bit weight-only (int4 or nf4), N % 8 == 0, B is [batch, K, N]: one thread
// per four output columns, same ownership as the int8 quad kernel. N % 8 == 0
// makes every K row start on an 8-nibble boundary, so a thread's four columns
// are half of one word at a fixed nibble offset (consecutive threads share a
// word, which the load broadcasts). Unlike int8 the scale is not constant along
// K, so it cannot be folded out of the loop: the nest walks one K group at a
// time, dequantizes that group's partial sum, and accumulates the result. The
// group's taps are still summed in fp32 before any rounding, which is the
// numerical property group quantization exists for.
void matmul16_w4_quad() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 4;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int b_row = n * uPC.K * uPC.N + ja;
    int nib = ja & 7; // 0 or 4, fixed along K

    vec4 s = vec4(0.0);
    int ngroups = uPC.K / uPC.group;
    for (int g = 0; g < ngroups; ++g) {
        vec4 acc = vec4(0.0);
        int kend = (g + 1) * uPC.group;
        // group even (host-checked) keeps the A pairs word-aligned.
        for (int k = g * uPC.group; k < kend; k += 2) {
            vec4 w0 = unpack_w4(uInputB.data[(b_row + k * uPC.N) >> 3], nib);
            vec4 w1 =
                unpack_w4(uInputB.data[(b_row + (k + 1) * uPC.N) >> 3], nib);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            acc += a.x * w0 + a.y * w1;
        }
        s += acc * scale4(g * uPC.N + ja);
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(s.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(s.zw);
}

// ---- split-K GEMV -------------------------------------------------------
// At decode time A has a single row, so the column-parallel kernels launch a
// 16x16 workgroup in which only the yi == 0 lane survives: 15/16 of every
// workgroup idles, and the surviving threads each walk the whole K serially.
// That is why neither precision gets near the machine's bandwidth (measured on
// GLM-Edge: int8 13.9 GB/s, fp16 26.8 GB/s) -- it is latency-bound, not
// bandwidth-bound. Here the idle lanes take slices of K instead: a workgroup
// covers 16 column quads x 16 K slices, each lane accumulating one vec4 over
// its slice, and the partials fold through shared memory. Total weight bytes
// read are unchanged; what changes is that 16x more lanes are in flight per
// column at any instant, which is what the load has to have to stream.
#define KS 16
// One vec4 per (K slice, column quad) = 4 KB of shared, next to the tiled
// path's staging arrays.
shared vec4 ks_part[KS][16];

// Both variants need K even: it makes a_off = row*K even (so two consecutive A
// elements are one word) and, with the slice length rounded up to an even
// chunk, k0 even as well. The host only selects this path under that condition.
int ks_chunk() { return ((uPC.K + KS - 1) / KS + 1) & ~1; }

void ks_store(vec4 s, int row, int ja) {
    int lx = int(gl_LocalInvocationID.x);
    int ly = int(gl_LocalInvocationID.y);
    ks_part[ly][lx] = s;
    barrier();
    if (ly != 0) return;
    vec4 v = ks_part[0][lx];
    for (int t = 1; t < KS; ++t) v += ks_part[t][lx];
    if (ja >= uPC.N) return;
    int out_idx = row * uPC.N + ja;
    if (uPC.weight_int8 != 0) {
        v *= vec4(uintBitsToFloat(uScale.data[ja]),
                  uintBitsToFloat(uScale.data[ja + 1]),
                  uintBitsToFloat(uScale.data[ja + 2]),
                  uintBitsToFloat(uScale.data[ja + 3]));
    }
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

// int8 weight-only, B is [batch, K, N], N % 4 == 0.
//
// Flat split-K GEMV. The block's 256 lanes are laid out as
//   quad  = lane % ksplit_q        (which column quad this lane owns)
//   slice = lane / ksplit_q        (which slice of K it accumulates)
// so ksplit_q is a pure occupancy knob: it sets both how many column quads a
// block covers (grid x = N/4/ksplit_q) and how deep K is cut (ksplit_q *
// n_slice == 256). The original 16x16 form is ksplit_q == 16. Decode is one A
// row, so the column-parallel kernels leave 15 of every 16 lanes idle; putting
// them on K is the whole point, and the narrow-N projections need the extra
// blocks more than they need the extra K depth -- at q = 16 down_proj (N=896)
// launched 14 blocks and ran at 21 GB/s against lm_head's 25 GB/s at 2374.
//
// The partials fold through one flat shared array indexed slice*ksplit_q +
// quad; a runtime stride into shared is legal, and it keeps the fold code
// identical for every q (the array is sized for the 256-lane block, so the
// q == 4 case uses it exactly).
shared vec4 ks_flat[256];

void ks_store_flat(vec4 s, int row, int ja) {
    int lane = int(gl_LocalInvocationID.y) * 16 + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = 256 / q;
    int quad = lane % q;
    int slice = lane / q;
    ks_flat[slice * q + quad] = s;
    barrier();
    // One folding lane per column quad; the rest of the block is done.
    if (lane >= q) return;
    vec4 v = ks_flat[quad];
    for (int t = 1; t < n_slice; ++t) v += ks_flat[t * q + quad];
    int cja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    if (cja >= uPC.N) return;
    int out_idx = row * uPC.N + cja;
    if (uPC.weight_int8 != 0) {
        v *= vec4(uintBitsToFloat(uScale.data[cja]),
                  uintBitsToFloat(uScale.data[cja + 1]),
                  uintBitsToFloat(uScale.data[cja + 2]),
                  uintBitsToFloat(uScale.data[cja + 3]));
    }
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

void matmul16_w8_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * 16 + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = 256 / q;
    int quad = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = n * uPC.K * uPC.N + ja;

    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s = vec4(0.0);
    // A quad past the last column reads nothing; ks_store_flat still publishes
    // its zero so the reduction never sees an uninitialized slot.
    if (ja < uPC.N) {
        // Eight k's per trip: every weight word (and the trip's A half2 words)
        // is issued before any is consumed, so the trip's loads are all in
        // flight together. The two-at-a-time form kept only two loads in flight
        // per lane and stalled on DRAM latency -- measured on Qwen2.5-0.5B int8
        // it capped the large projections near 21 GB/s. The addresses within a
        // trip are independent (K rows are N bytes apart), so this is pure
        // memory-level parallelism with identical arithmetic: the same FMAs in
        // the same order, just scheduled wider.
        int k = k0;
        for (; k + 7 < kend; k += 8) {
            uint r0 = uInputB.data[(b_row + (k + 0) * uPC.N) >> 2];
            uint r1 = uInputB.data[(b_row + (k + 1) * uPC.N) >> 2];
            uint r2 = uInputB.data[(b_row + (k + 2) * uPC.N) >> 2];
            uint r3 = uInputB.data[(b_row + (k + 3) * uPC.N) >> 2];
            uint r4 = uInputB.data[(b_row + (k + 4) * uPC.N) >> 2];
            uint r5 = uInputB.data[(b_row + (k + 5) * uPC.N) >> 2];
            uint r6 = uInputB.data[(b_row + (k + 6) * uPC.N) >> 2];
            uint r7 = uInputB.data[(b_row + (k + 7) * uPC.N) >> 2];
            uint aw = (a_off + k) >> 1;
            vec2 a0 = unpackHalf2x16(uInputA.data[aw]);
            vec2 a1 = unpackHalf2x16(uInputA.data[aw + 1]);
            vec2 a2 = unpackHalf2x16(uInputA.data[aw + 2]);
            vec2 a3 = unpackHalf2x16(uInputA.data[aw + 3]);
            s += a0.x * unpack_w8(r0) + a0.y * unpack_w8(r1) +
                 a1.x * unpack_w8(r2) + a1.y * unpack_w8(r3) +
                 a2.x * unpack_w8(r4) + a2.y * unpack_w8(r5) +
                 a3.x * unpack_w8(r6) + a3.y * unpack_w8(r7);
        }
        for (; k + 1 < kend; k += 2) {
            vec4 w0 = unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
            vec4 w1 = unpack_w8(uInputB.data[(b_row + (k + 1) * uPC.N) >> 2]);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    }
    ks_store_flat(s, row, ja);
}

// 4-bit weight-only, B is [batch, K, N], N % 8 == 0: decode slicing over K, but
// the units are whole scale GROUPS, not single k steps — a lane that stopped
// mid-group would have to remember which group its partial belongs to. With
// K = ngroups * group the workgroup's 16 lanes take ceil(ngroups/16) groups
// each, so a small ngroups leaves lanes idle (they still publish their zero).
// Each lane's partial is already dequantized, so ks_store just adds them.
void matmul16_w4_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int ja = (int(gl_WorkGroupID.x) * 16 + int(gl_LocalInvocationID.x)) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = n * uPC.K * uPC.N + ja;
    int nib = ja & 7;

    int ngroups = uPC.K / uPC.group;
    int gps = (ngroups + KS - 1) / KS;
    int g0 = int(gl_LocalInvocationID.y) * gps;
    int gend = min(g0 + gps, ngroups);
    vec4 s = vec4(0.0);
    if (ja < uPC.N) {
        for (int g = g0; g < gend; ++g) {
            vec4 acc = vec4(0.0);
            int kend = (g + 1) * uPC.group;
            for (int k = g * uPC.group; k < kend; k += 2) {
                vec4 w0 = unpack_w4(uInputB.data[(b_row + k * uPC.N) >> 3], nib);
                vec4 w1 =
                    unpack_w4(uInputB.data[(b_row + (k + 1) * uPC.N) >> 3], nib);
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                acc += a.x * w0 + a.y * w1;
            }
            s += acc * scale4(g * uPC.N + ja);
        }
    }
    ks_store(s, row, ja);
}

// fp16 weight, B is [batch, K, N], N % 4 == 0: the same slicing, and a quad is
// two half2 words per K row instead of one int8 word.
void matmul16_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int ja = (int(gl_WorkGroupID.x) * 16 + int(gl_LocalInvocationID.x)) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = n * uPC.K * uPC.N + ja;

    int chunk = ks_chunk();
    int k0 = int(gl_LocalInvocationID.y) * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s = vec4(0.0);
    if (ja < uPC.N) {
        for (int k = k0; k + 1 < kend; k += 2) {
            int bw = (b_row + k * uPC.N) >> 1;
            vec4 w0 = vec4(unpackHalf2x16(uInputB.data[bw]),
                           unpackHalf2x16(uInputB.data[bw + 1]));
            vec4 w1 = vec4(unpackHalf2x16(uInputB.data[bw + uPC.N / 2]),
                           unpackHalf2x16(uInputB.data[bw + uPC.N / 2 + 1]));
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    }
    ks_store(s, row, ja);
}

// int8 weight-only, even N, two columns per thread: single pass straight into
// the output half2 word, same ownership as the fp16 even-N kernel. Nothing
// about a byte-packed weight touches the OUTPUT alignment (the column pair
// ja, ja+1 is word-aligned because N is even), only how B gets read, so int8
// keeps the fused store instead of paying a second dispatch per GEMM.
// Under transB a weight column is contiguous, so with K % 4 == 0 four taps of a
// column come out of one 32-bit word: one B load per four FMAs.
void matmul16_w8_even_n() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    int b_base = n * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // Constant along K, so both column scales leave the loop.
    float wsc0 = uintBitsToFloat(uScale.data[ja]);
    float wsc1 = uintBitsToFloat(uScale.data[jb]);

    float s0 = 0.0, s1 = 0.0;
    // b0 (and therefore every b0 + k) is 4-aligned when K % 4 == 0, because
    // b_base = n*K*N and ja*K are multiples of K then.
    if (uPC.transB != 0 && (uPC.K & 3) == 0) {
        for (int k = 0; k < uPC.K; k += 4) {
            vec4 w0 = unpack_w8(uInputB.data[(b0 + k) >> 2]);
            vec4 w1 = unpack_w8(uInputB.data[(b1 + k) >> 2]);
            vec2 a01 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a23 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            s0 += a01.x * w0.x + a01.y * w0.y + a23.x * w0.z + a23.y * w0.w;
            s1 += a01.x * w1.x + a01.y * w1.y + a23.x * w1.z + a23.y * w1.w;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            float a = load_a(a_off + k);
            s0 += a * load_w8(b0);
            s1 += a * load_w8(b1);
            b0 += b_step;
            b1 += b_step;
        }
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(vec2(s0 * wsc0, s1 * wsc1));
}

// One thread owns output word (n, i, {ja, ja+1}) of an even-N C. ja is even
// and n*M*N + i*N is even when N is even, so the pair is word-aligned.
void matmul16_even_n() {
    int p = int(gl_GlobalInvocationID.x); // column-pair (= word) index in a row
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    // transB: B is [batch, N, K] so element (n, col, k) is at col*K + k
    // (k-step 1); otherwise B is [batch, K, N], element (n, k, col) is at
    // k*N + col (k-step N). Hoisting this out of the K loop removes the
    // per-iteration branch and keeps both column walks linear.
    int b_base = n * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // K even => a_off, b0 and b1 are even element indices (K even makes every
    // row start word-aligned; under transB the B rows are contiguous too), so
    // each k-pair is one 32-bit word per stream. Four accumulators break the
    // serial FMA dependency chains.
    float s0a = 0.0, s0b = 0.0, s1a = 0.0, s1b = 0.0;
    int k = 0;
    if ((uPC.K & 1) == 0) {
        if (uPC.transB != 0) {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                vec2 v0 = unpackHalf2x16(uInputB.data[(b0 + k) >> 1]);
                vec2 v1 = unpackHalf2x16(uInputB.data[(b1 + k) >> 1]);
                s0a += a.x * v0.x;
                s0b += a.y * v0.y;
                s1a += a.x * v1.x;
                s1b += a.y * v1.y;
            }
        } else {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                s0a += a.x * load_b(b0);
                s0b += a.y * load_b(b0 + uPC.N);
                s1a += a.x * load_b(b1);
                s1b += a.y * load_b(b1 + uPC.N);
                b0 += 2 * uPC.N;
                b1 += 2 * uPC.N;
            }
        }
    }
    // Odd-K tail: scalar walk (also covers K == 0 -> nothing).
    for (; k < uPC.K; ++k) {
        float a = load_a(a_off + k);
        s0a += a * load_b(b0);
        s1a += a * load_b(b1);
        b0 += b_step;
        b1 += b_step;
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] =
        packHalf2x16(vec2(s0a + s0b, s1a + s1b));
}

// Tiled GEMM for the compute-bound regime (M big enough that the naive path
// stops being bandwidth-bound). A 16x16 workgroup stages 64x64 A/B tiles in
// shared memory and every thread owns a 4x4 sub-tile, so each global element
// read feeds 4x4 outputs instead of ~2: the naive path re-reads the weight
// rows for every output row, which is what caps it at ~2.7 TFLOP/s.
// Both B layouts are covered; K % TILE_K == 0 keeps every tile word aligned
// and removes all in-loop bounds tests. Grid: x = N/64, y = M/64, z = batch,
// so a block never straddles a batch boundary.
#define TILE_M 64
#define TILE_N 64
#define TILE_K 16
// Words per [tile-row][k-pair] shared row: TILE_K/2 packed halves + 1 pad.
// The pad breaks the 32-bank aliasing a power-of-2 stride causes across the
// 16 lane threads (each thread's 4 columns start 4 words apart).
#define SROW (TILE_K / 2 + 1)
// Words per [k][column-pair] shared row, used when B is [batch, K, N].
#define SBROW (TILE_N / 2)

// glslang only accepts `shared` at global scope; the tiled path is the sole
// user, and the naive paths never touch these.
shared uint sA[TILE_M * SROW];
// Sized for the wider of the two stagings: transB keeps [col][k-pair] (9 words
// per row), [batch,K,N] keeps [k][col-pair] (32 words per row, 64 k-rows).
shared uint sB[TILE_N * SBROW];

int tile_tid() {
    return int(gl_LocalInvocationID.x) + int(gl_LocalInvocationID.y) * 16;
}

// A tile: 64 rows x 8 k-pair words, packed along K. Identical for both B
// layouts, and always coalesced (consecutive threads walk one row).
void tile_load_a(int b, int row0, int kw, int halfK) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int row = l >> 3;
        int kt = l & 7;
        sA[row * SROW + kt] = (row0 + row < uPC.M)
                                  ? uInputA.data[(b * uPC.M + row0 + row) *
                                                     halfK + kw + kt]
                                  : 0u;
    }
}

// transB: B is [batch, N, K], so a weight column is a contiguous row and the
// tile keeps the same [row][k-pair] packing as A.
void tile_load_b_t(int b, int col0, int kw, int halfK) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int row = l >> 3;
        int kt = l & 7;
        sB[row * SROW + kt] = (col0 + row < uPC.N)
                                  ? uInputB.data[(b * uPC.N + col0 + row) *
                                                     halfK + kw + kt]
                                  : 0u;
    }
}

// B is [batch, K, N]: keep global's [k][column-pair] packing so the copy is a
// straight word-for-word transfer (N even => every column pair is one word).
void tile_load_b_n(int b, int col0, int kk, int halfN) {
    int tid = tile_tid();
    for (int t = 0; t < 2; ++t) {
        int l = tid + t * 256;
        int kr = l >> 5;
        int cp = l & 31;
        sB[kr * SBROW + cp] =
            (col0 + cp * 2 + 1 < uPC.N)
                ? uInputB.data[(b * uPC.K + kk + kr) * halfN + (col0 >> 1) + cp]
                : 0u;
    }
}

// Byte-quantized weight, B is [batch, K, N] (the only layout a quantizer can
// emit). One thread stages the four columns of one K row that a single 32-bit
// weight word holds, decodes them, and writes the two half2 words the tile's
// FMA nest already reads -- 256 threads x 2 words exactly cover TILE_K x TILE_N.
// The decode is the whole point: in the column-parallel quad kernel it runs once
// per output element (M*N*K times), here once per weight per 64-row block.
// Nothing about it is approximate: int8 magnitudes are integers up to 128 and
// both fp8 formats sit inside the half range, so the staged tile holds the same
// values the naive kernel accumulates. The column scale is deliberately NOT
// folded in here -- it is constant along K, so the epilogue applies it with one
// multiply per output instead of one per tap.
void tile_load_b_w8(int b, int col0, int kk) {
    int l = tile_tid();
    int kr = l >> 4;        // 16 K rows of the tile
    int quad = l & 15;      // 16 four-column groups = TILE_N columns
    int col = col0 + quad * 4;
    // N % 4 == 0 (host-checked) makes every K row start 4-aligned, so a
    // 4-aligned column always owns its whole byte word.
    vec4 w = vec4(0.0);
    if (col < uPC.N) {
        w = unpack_w8(uInputB.data[((b * uPC.K + kk + kr) * uPC.N + col) >> 2]);
    }
    sB[kr * SBROW + 2 * quad] = (col + 1 < uPC.N) ? packHalf2x16(w.xy) : 0u;
    sB[kr * SBROW + 2 * quad + 1] = (col + 3 < uPC.N) ? packHalf2x16(w.zw) : 0u;
}

// One k-pair per thread, transB: a B word carries the two K values of one
// column.
void tile_fma_t(inout float acc[4][4], int lr, int lc) {
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        vec2 b0 = unpackHalf2x16(sB[(lc + 0) * SROW + kt]);
        vec2 b1 = unpackHalf2x16(sB[(lc + 1) * SROW + kt]);
        vec2 b2 = unpackHalf2x16(sB[(lc + 2) * SROW + kt]);
        vec2 b3 = unpackHalf2x16(sB[(lc + 3) * SROW + kt]);
#pragma unroll
        for (int c = 0; c < 4; ++c) {
            vec2 bv = c == 0 ? b0 : (c == 1 ? b1 : (c == 2 ? b2 : b3));
            acc[0][c] += a0.x * bv.x + a0.y * bv.y;
            acc[1][c] += a1.x * bv.x + a1.y * bv.y;
            acc[2][c] += a2.x * bv.x + a2.y * bv.y;
            acc[3][c] += a3.x * bv.x + a3.y * bv.y;
        }
    }
}

// B is [batch, K, N]: a B word carries two adjacent columns at one K, so the
// thread's 4 columns come from 2 words per K.
void tile_fma_n(inout float acc[4][4], int lr, int lc) {
    int cp = lc >> 1;
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        int w0 = (2 * kt) * SBROW + cp;
        int w1 = (2 * kt + 1) * SBROW + cp;
        vec2 p0 = unpackHalf2x16(sB[w0]);
        vec2 p1 = unpackHalf2x16(sB[w0 + 1]);
        vec2 q0 = unpackHalf2x16(sB[w1]);
        vec2 q1 = unpackHalf2x16(sB[w1 + 1]);
#pragma unroll
        for (int r = 0; r < 4; ++r) {
            vec2 av = r == 0 ? a0 : (r == 1 ? a1 : (r == 2 ? a2 : a3));
            acc[r][0] += av.x * p0.x + av.y * q0.x;
            acc[r][1] += av.x * p0.y + av.y * q0.y;
            acc[r][2] += av.x * p1.x + av.y * q1.x;
            acc[r][3] += av.x * p1.y + av.y * q1.y;
        }
    }
}

void matmul16_tiled() {
    // Workgroup (not invocation) ids: each block owns one 64x64 tile, so the
    // local offset must not be folded into the tile origin.
    int b = int(gl_WorkGroupID.z);
    int row0 = int(gl_WorkGroupID.y) * TILE_M;
    int col0 = int(gl_WorkGroupID.x) * TILE_N;
    if (row0 >= uPC.M || col0 >= uPC.N) return;

    int lr = int(gl_LocalInvocationID.y) * 4; // this thread's tile origin
    int lc = int(gl_LocalInvocationID.x) * 4;
    int halfK = uPC.K >> 1;
    int halfN = uPC.N >> 1;

    float acc[4][4];
    for (int r = 0; r < 4; ++r)
        for (int c = 0; c < 4; ++c)
            acc[r][c] = 0.0;

    // The two layouts differ only in how B is staged and read, so each gets
    // its own loop nest instead of a branch per k-step. transB is
    // workgroup-uniform, so the barriers stay convergent.
    if (uPC.transB != 0) {
        for (int kk = 0; kk < uPC.K; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_t(b, col0, kk >> 1, halfK);
            barrier();
            tile_fma_t(acc, lr, lc);
            barrier();
        }
    } else if (uPC.weight_int8 != 0) {
        for (int kk = 0; kk < uPC.K; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_w8(b, col0, kk);
            barrier();
            tile_fma_n(acc, lr, lc);
            barrier();
        }
    } else {
        for (int kk = 0; kk < uPC.K; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_n(b, col0, kk, halfN);
            barrier();
            tile_fma_n(acc, lr, lc);
            barrier();
        }
    }

    // N even => col0 + lc is even, so each column pair is one word; the pair
    // can never straddle the row end (that only happens with odd N).
    for (int r = 0; r < 4; ++r) {
        int grow = row0 + lr + r;
        if (grow >= uPC.M) break;
        int base = (b * uPC.M + grow) * uPC.N + col0 + lc;
        vec2 v0 = vec2(acc[r][0], acc[r][1]);
        vec2 v1 = vec2(acc[r][2], acc[r][3]);
        // A byte weight's dequant scale is per output column and constant along
        // K, so it leaves the accumulation entirely: one multiply per output, in
        // fp32, before the half pack -- the same shape the quad kernel uses.
        if (uPC.weight_int8 != 0) {
            int c = col0 + lc;
            v0 *= vec2(scale1(c), scale1(c + 1));
            v1 *= vec2(scale1(c + 2), scale1(c + 3));
        }
        if (col0 + lc + 1 < uPC.N)
            uOutput.data[base >> 1] = packHalf2x16(v0);
        if (col0 + lc + 3 < uPC.N)
            uOutput.data[(base + 2) >> 1] = packHalf2x16(v1);
    }
}

// Odd-N fallback: one thread per output element, fp32 result to scratch;
// matmul_pack.comp does the half2 pack afterwards.
void matmul16_odd_n() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = load_a(a_base + i * uPC.K + k);
        float b = load_b(b_idx);
        sum += a * b;
    }

    uScratch.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}
#endif

#ifndef FP16
float load_a(int idx) {
    return uintBitsToFloat(uInputA.data[idx]);
}
// fp32 build has no scratch: the reduce is the whole kernel.
#define W8_STORE(idx, val) uOutput.data[idx] = floatBitsToUint(val)
#endif

// int8 weight-only B, odd N (and every fp32-build call). One thread per output
// element, fp32 accumulate over the raw weight bytes, then one multiply by this
// column's dequant scale (the scale is constant along K, so folding it out of
// the loop is both cheaper and rounding-wise no worse than a per-tap dequant).
// The shared-memory tiled nest is the remaining mode int8 does not use: its B
// loaders stage half2 words straight from global, which a byte-packed weight
// has no equivalent for — and tiling only pays at m >= 12, far from the
// weight-bandwidth-bound regime this kernel exists for.
void matmul_w8() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    float wsc = uintBitsToFloat(uScale.data[j]);
    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        sum += load_a(a_base + i * uPC.K + k) * load_w8(b_idx);
    }

    W8_STORE(n * uPC.M * uPC.N + i * uPC.N + j, sum * wsc);
}

// 4-bit weight-only, one thread per output element: the fp32 build's path (the
// fp16 build uses the quad kernels above, since its gate always gives N % 8 ==
// 0). Walks K by groups because the scale changes with each one.
void matmul_w4() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int ngroups = uPC.K / uPC.group;

    float total = 0.0;
    for (int g = 0; g < ngroups; ++g) {
        float acc = 0.0;
        int kend = (g + 1) * uPC.group;
        for (int k = g * uPC.group; k < kend; ++k) {
            acc += load_a(a_base + i * uPC.K + k) *
                   unpack_w4_at(b_base + k * uPC.N + j);
        }
        total += acc * scale1(g * uPC.N + j);
    }

    W8_STORE(n * uPC.M * uPC.N + i * uPC.N + j, total);
}

void matmul32() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        // transB: B is [batch, N, K] so element (n,j,k) lives at j*K+k instead
        // of k*N+j. Avoids a separate Transpose dispatch before the MatMul.
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = uintBitsToFloat(uInputA.data[a_base + i * uPC.K + k]);
        float b = uintBitsToFloat(uInputB.data[b_idx]);
        sum += a * b;
    }

    uOutput.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}

void main() {
#ifdef FP16
    // Split-K GEMV owns its own selection: the workgroup is laid out over K
    // slices, which none of the column-only kernels below do.
    if (uPC.ksplit != 0) {
        if (uPC.w4 != 0) {
            matmul16_w4_ksplit();
        } else if (uPC.weight_int8 != 0) {
            matmul16_w8_ksplit();
        } else {
            matmul16_ksplit();
        }
        return;
    }
#endif
    if (uPC.w4 != 0) {
#ifdef FP16
        matmul16_w4_quad();
#else
        matmul_w4();
#endif
        return;
    }
    // int8 weight-only owns its own kernels: from the compute-bound sizes it
    // joins the tiled nest, otherwise with even N in the fp16 build it keeps the
    // fused single-pass half2 store, and failing that it reduces elementwise
    // (fp32 build: straight to output; fp16 odd N: to scratch, then pack).
    if (uPC.weight_int8 != 0) {
#ifdef FP16
        // The tiled nest reads the same B through tile_load_b_w8, which stages
        // the decoded value instead of copying a half2 word from global; the
        // host only raises tile on the shapes that loader needs.
        if (uPC.tile != 0) {
            matmul16_tiled();
            return;
        }
        if (uPC.w8_quad != 0) {
            matmul16_w8_quad();
            return;
        }
        if ((uPC.N & 1) == 0) {
            matmul16_w8_even_n();
            return;
        }
#endif
        matmul_w8();
        return;
    }
#ifdef FP16
    if (uPC.tile != 0) {
        matmul16_tiled();
    } else if ((uPC.N & 1) == 0) {
        matmul16_even_n();
    } else {
        matmul16_odd_n();
    }
#else
    matmul32();
#endif
}
