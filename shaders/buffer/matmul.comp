#ifndef FP16
float load_a(int idx) {
    return uintBitsToFloat(uInputA.data[idx]);
}
// fp32 build has no scratch: the reduce is the whole kernel.
#define W8_STORE(idx, val) uOutput.data[idx] = floatBitsToUint(val)
#endif

// int8 weight-only B, odd N (and every fp32-build call). One thread per output
// element, fp32 accumulate over the raw weight bytes, then one multiply by this
// column's dequant scale (the scale is constant along K, so folding it out of
// the loop is both cheaper and rounding-wise no worse than a per-tap dequant).
// The shared-memory tiled nest is the remaining mode int8 does not use: its B
// loaders stage half2 words straight from global, which a byte-packed weight
// has no equivalent for — and tiling only pays at m >= 12, far from the
// weight-bandwidth-bound regime this kernel exists for.
void matmul_w8() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    float wsc = uintBitsToFloat(uScale.data[j]);
    int a_base = n * uPC.M * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        sum += load_a(a_base + i * uPC.K + k) * load_w8(b_idx);
    }

    W8_STORE(n * uPC.M * uPC.N + i * uPC.N + j, sum * wsc);
}

// 4-bit weight-only, one thread per output element: the fp32 build's path (the
// fp16 build uses the quad kernels above, since its gate always gives N % 8 ==
// 0). Walks K by groups because the scale changes with each one.
void matmul_w4() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N;
    int ngroups = uPC.K / uPC.group;

    float total = 0.0;
    for (int g = 0; g < ngroups; ++g) {
        float acc = 0.0;
        int kend = (g + 1) * uPC.group;
        for (int k = g * uPC.group; k < kend; ++k) {
            acc += load_a(a_base + i * uPC.K + k) *
                   unpack_w4_at(b_base + k * uPC.N + j);
        }
        total += acc * scale1(g * uPC.N + j);
    }

    W8_STORE(n * uPC.M * uPC.N + i * uPC.N + j, total);
}

void matmul32() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
        // transB: B is [batch, N, K] so element (n,j,k) lives at j*K+k instead
        // of k*N+j. Avoids a separate Transpose dispatch before the MatMul.
        int b_idx = (uPC.transB != 0) ? (b_base + j * uPC.K + k)
                                      : (b_base + k * uPC.N + j);
        float a = uintBitsToFloat(uInputA.data[a_base + i * uPC.K + k]);
        // A bf16 weight under an fp32 activation: two values per word, like
        // the fp16 build's B, so this one scalar path reads it by half-word.
        float b = uPC.bf16 != 0
                      ? bf16_to_float(uInputB.data[b_idx >> 1] >>
                                      ((b_idx & 1) * 16))
                      : uintBitsToFloat(uInputB.data[b_idx]);
        sum += a * b;
    }

    // fp32 build's one-pass kernel: same attention epilogue obligation as the
    // fp16 even-N path above (the fp32 bias is word-per-element).
    if (uPC.epi_bias != 0) {
        sum = sum * uPC.epi_scale + epi_bias_at(n, i, j);
    }
    uOutput.data[c_base + i * uPC.N + j] = floatBitsToUint(sum);
}

// The -DW8_WIDE build: this file's second fp16 module, entered only by the
// int8/fp8 weight-only WIDE GEMV.
#ifdef W8_WIDE
// MoltenVK's SPIR-V -> MSL backend cannot compile that kernel: as part of the
// general fp16 module this one failure sank EVERY buffer MatMul pipeline
// (vkCreateComputePipelines -> VK_ERROR_INITIALIZATION_FAILED). An entry that
// reaches nothing else keeps the general module alive -- SPIR-V DCE drops this
// kernel from it -- and lets the host probe the wide one on its own and fall
// back to matmul16_w8_ksplit where the driver refuses, see w8_wide_pipeline()
// in ops/Matmul.hpp. Same bindings, push constants and workgroup as the general
// module, so only the pipeline it is bound to differs.
// This module serves two weight kinds: the int8/fp8 WIDE GEMV, and (since the
// 4-bit branch was added) the 8-column int4 WIDE GEMV. Before that branch
// existed, a 4-bit weight that reached this route had its packed nibbles
// decoded by unpackHalf2x16 -- right byte count, garbage values, no error.
// That was the ",,,,," on the first int4 27B run; the selector now guards the
// route as well, but the branch is what makes it usable rather than merely
// excluded. The 8-column shape measures 4.30 ops/MAC against the plain w4
// kernel's 8.00, with no change to payload layout or activation dtype.
void main() {
    if (uPC.w4 != 0) {
        matmul16_w4_ksplit_wide();
    } else {
        matmul16_w8_ksplit_wide();
    }
}
#elif defined(DP4A)
#if !defined(FP16)
#error "the DP4A module needs -DFP16 (its epilogue packs half2)"
#endif
// The -DDP4A build: the packed-dot-product int8 x int8 split-K GEMV. Its own
// module for the module-level reason in the header (OpCapability DotProduct):
// a device without VK_KHR_shader_integer_dot_product rejects the whole module
// at vkCreateComputePipelines, so it can never ride in the general one. SPIR-V
// DCE drops every other kernel from this build and `matmul16_w8a8_dp4a`
// from theirs, which is what keeps the capability out of every other entry.
//
// Same bindings, push constants and 256-lane workgroup as the byte WIDE
// module, and the same launch geometry as the 4-column byte GEMV
// (grid.x = UP_DIV(N/4, ksplit_q), grid.y = batch*M), so the host's
// dispatch_on call is a drop-in for that route's.
void main() { matmul16_w8a8_dp4a(); }
#elif defined(DOWN_ACT)
#if !defined(FP16)
#error "the SwiGLU down-projection module needs -DFP16"
#endif
// The -DDOWN_ACT build: the SwiGLU-folded down projection. Bindings 7/8 are
// declared in this source for every build, but only this module's host
// pipeline has nine descriptors, so a dispatch on any other MatMul pipeline
// must never reach a kernel here. The module is built with -DKSPLIT512: its
// two passes (deposit, fold) share this one entry, selected by uPC.ks_part
// (see GpuMatMulParam), and both take their geometry from it.
void main() {
    if (uPC.ks_part != 0) {
        matmul16_ksplit_fold_down_act();
    } else {
        matmul16_ksplit_down_act();
    }
}
#elif defined(KSPLIT512)
// The -DKSPLIT512 build: a ksplit-only 512-lane module (local_size 32x16,
// KS_LANES above). Its host selects it with VKOP_KSPLIT512=1 only for
// non-w4 ksplit dispatches, so anything else reaching here is a host bug;
// return without writing rather than run a 256-lane kernel's lane math on a
// 512-lane block (w4's ks_part indexing would run off the array).
void main() {
    if (uPC.ksplit == 0 || uPC.w4 != 0) return;
    if (uPC.weight_int8 != 0) {
        matmul16_w8_ksplit();
    } else if (uPC.wide != 0) {
        matmul16_ksplit_wide();
    } else {
        matmul16_ksplit();
    }
}
#elif defined(TILED_KS_SPLIT)
#if !defined(FP16)
#error "the tile-split-K deposit module needs -DFP16"
#endif
// The -DTILED_KS_SPLIT build: the deposit half of the pair. Same selection as
// the general module but with the K range taken from the scratch header, and
// with everything the deposit does not need (ksplit, w4, byte weights) left
// out: the host only enters the pair for a plain fp16 [A, B] tiled shape.
void main() {
    if (uPC.tile != 0) {
        matmul16_tiled();
    }
}
#elif defined(TILED_KS_FOLD)
// The -DTILED_KS_FOLD build: one block per output tile, summing the ks_n
// partials the -DTILED_KS_SPLIT dispatch deposited. The host only enters the
// pair for shapes the tiled kernel takes without a byte weight, so this module
// carries the epilogue that shape needs and nothing else.
void main() {
#ifdef FP16
    ks_fold_tiles();
#endif
}
#else
void main() {
#ifdef FP16
    // Split-K GEMV owns its own selection: the workgroup is laid out over K
    // slices, which none of the column-only kernels below do.
    if (uPC.ksplit != 0) {
        if (uPC.w4 != 0) {
            matmul16_w4_ksplit();
        } else if (uPC.weight_int8 != 0) {
            // A byte weight here is the four-columns-per-lane split-K GEMV even
            // when uPC.wide is set: the sixteen-column variant is not in this
            // module (see the W8_WIDE build above), and the host only raises
            // wide when it has the separate pipeline to dispatch it on.
            // matmul16_w8_ksplit ignores wide, so this stays correct either way.
            matmul16_w8_ksplit();
        } else if (uPC.wide != 0) {
            matmul16_ksplit_wide();
        } else {
            matmul16_ksplit();
        }
        return;
    }
#endif
    if (uPC.w4 != 0) {
#ifdef FP16
        // M > 8: the tiled nest stages the decoded, group-scaled weight once
        // per 64-row block (tile_load_b_w4); the host raises tile only there.
        if (uPC.tile != 0) {
            matmul16_tiled();
            return;
        }
        matmul16_w4_quad();
#else
        matmul_w4();
#endif
        return;
    }
    // int8 weight-only owns its own kernels: from the compute-bound sizes it
    // joins the tiled nest, otherwise with even N in the fp16 build it keeps the
    // fused single-pass half2 store, and failing that it reduces elementwise
    // (fp32 build: straight to output; fp16 odd N: to scratch, then pack).
    if (uPC.weight_int8 != 0) {
#ifdef FP16
        // The tiled nest reads the same B through tile_load_b_w8, which stages
        // the decoded value instead of copying a half2 word from global; the
        // host only raises tile on the shapes that loader needs.
        if (uPC.tile != 0) {
            matmul16_tiled();
            return;
        }
        if (uPC.w8_quad != 0) {
            matmul16_w8_quad();
            return;
        }
        if ((uPC.N & 1) == 0) {
            matmul16_w8_even_n();
            return;
        }
#endif
        matmul_w8();
        return;
    }
#ifdef FP16
    if (uPC.attn_softmax != 0) {
        matmul16_softmax();
        return;
    }
    if (uPC.tile == 2) {
        matmul16_tiled128();
    } else if (uPC.tile != 0) {
        // This build has no fold pass behind it -- the pair is its own two
        // modules -- so a split range must not reach here. KSPLIT_BY is 0 in
        // this module so the kernel would ignore the range anyway; the guard
        // keeps a misrouted grid from depositing partials nobody reduces.
        if (load_krange().n <= 1 || KSPLIT_BY == 0) {
            matmul16_tiled();
        }
    } else if ((uPC.N & 1) == 0) {
        matmul16_even_n();
    } else {
        matmul16_odd_n();
    }
#else
    matmul32();
#endif
}
#endif  // W8_WIDE / KSPLIT512 / general module
