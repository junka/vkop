#version 450 core

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

// Hardware fp8 decode (VK_EXT_shader_float8), the -DFP8_HW build only. This is
// a MODULE-level capability: OpCapability Float8EXT makes a device without the
// extension reject the whole module at vkCreateShaderModule, so it can never be
// a runtime branch inside the general module. The host builds this variant only
// when the device reports shader_float8 enabled (see MatMulBuffer::
// w8_wide_f8_pipeline) and otherwise keeps the software decode below.
//
// GL_EXT_float_e4m3 / GL_EXT_float_e5m2 are the GLSL spellings; the type is
// `floate4m3_t` and the vector is `fe4m3vec4`. They are separate extensions for
// the two formats, unlike the Vulkan-side single VK_EXT_shader_float8.
#ifdef FP8_HW
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_float_e5m2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#endif

// Packed 4x8 integer dot product (VK_KHR_shader_integer_dot_product), the
// -DDP4A build only. Exactly the same module-level trap as FP8_HW above
// (OpCapability DotProduct), only for a different capability: `#extension`
// alone is not enough, the capability has to reach the SPIR-V, and a device
// without the feature then rejects the WHOLE module at pipeline creation
// rather than the one kernel that wanted it. So this is a separate archive
// key, built only behind a compile-time probe of the shader compiler
// (VKOP_GLSLC_HAS_INTEGER_DOT_PRODUCT) and a device gate on the host
// (DeviceTraits::integer_dot_product_packed, i.e. enabled AND accelerated).
//
// The GLSL spelling is GL_EXT_integer_dot_product (NOT
// GL_KHR_shader_integer_dot_product and NOT
// GL_EXT_shader_integer_dot_product -- glslang accepts only this one) and the
// entry points are dotPacked4x8EXT(int,int) / dotPacked4x8AccSatEXT. There is
// no unsigned overload on the two-argument form in glslang 11.x beyond the
// uint/uint one, and the packed signed form is the only one the target device
// accelerates (integerDotProduct4x8BitPackedSignedAccelerated is true there
// while 8BitSignedAccelerated is false, so an i8vec4 spelling would be
// expanded into shifts and adds by the driver).
#ifdef DP4A
#extension GL_EXT_integer_dot_product : require
#endif

#include "../common/subgroup_reduce.comp"

// MatMul SSBO reduce pass (fp32 + fp16). Computes C = A @ B.
// fp32: one thread per output element, fp32 store to uOutput.
// fp16, three modes picked by the host (see MatMulBuffer::execute):
//   - tiled (uPC.tile): shared-memory 64x64x16 GEMM for large-M / compute-bound
//     calls, needs K % 16 == 0 and handles both B layouts.
//   - even N: one thread per output half2 WORD (two adjacent columns of the
//     same row, A load shared) packed straight into uOutput — single pass, no
//     scratch.
//   - odd N: half2 words straddle row boundaries (word ownership would race
//     across threads), so we fall back to reduce-into-fp32-scratch + a
//     SEPARATE pack dispatch (buffer/matmul_pack.comp, kept for that case; the
//     separate pipeline also avoids Intel ANV push-constant interference
//     between dispatches of the same pipeline).
// A byte-quantized weight-only B (uPC.weight_int8, fp8 when uPC.fp8) is a fourth
// mode: with even N it keeps a single pass that writes the packed half2 output
// directly (one thread per two columns, or per four columns when uPC.w8_quad,
// see below), and only odd N falls back to one thread per output element in
// reduce->pack form. Byte packing changes how a weight is LOADED, not who owns
// an output word. From the sizes where the tiled nest pays (m >= 12, host
// picked) a byte weight joins it too: the tile stages the decoded value, so the
// byte -> float step runs once per weight per 64-row block instead of once per
// output element.
// The sixteen-columns-per-lane split-K GEMV for a byte weight is NOT in this
// module: it is reached through a second build of this file (-DW8_WIDE), which
// the host probes on its own because MoltenVK cannot compile that kernel. See
// the entries at the end of the file.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

#ifdef KSPLIT512
layout(local_size_x = 32, local_size_y = 16, local_size_z = 1) in;
#else
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#endif
// Lane geometry of the split-K GEMV kernels: KSG is local_size_x, KS_LANES the
// block's total lane count. The -DKSPLIT512 build keeps ksplit_q's column
// coverage and doubles the K-slice depth (KS_LANES / q slices instead of
// 256 / q) — same experiment as raising ksplit_q, without changing the grid.
// Default is the historical 256-lane block.
#ifdef KSPLIT512
#define KSG 32
#define KS_LANES 512
#else
#define KSG 16
#define KS_LANES 256
#endif

// Scratch header: [0] debug flag, [1] ks_n, [2] k0, [3] kstop, [4 .. 4+2*ks_n)
// the K-slice table (lo, hi pairs tiling [0, K)), then the tile-split-K
// partials. See the deposit/fold pair below.
#define KS_HDR 4

// One output column's per-column group scale, for the fp32 per-element path and
// the byte-weight epilogue. The fold pass below calls it and sits above the
// definition, so the prototype comes first.
float scale1(int sw);

#ifdef BDA
layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf {
    uint data[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Vec4Buf {
    uvec4 data4[];
};
// The BDA build binds ONE address table at binding 0; every data buffer is a
// 64-bit pointer read from it. GpuMatMulParam is already 128 B, so the table is
// the only place the addresses can live. The host keeps this buffer stable and
// rewrites its 80 bytes per recording, so the recorded descriptor binding never
// changes when a tensor buffer moves.
layout(set = 0, binding = 0) readonly buffer Table {
    UintBuf uOutput;
    UintBuf uInputA;
    UintBuf uInputB;
    Vec4Buf uInputB4;
    UintBuf uScratch;
    UintBuf uScale;
    UintBuf uGlobal;
    UintBuf uEpiBias;
    UintBuf uInputB2;
    UintBuf uInputAct;
} uTable;
#define uOutput (uTable.uOutput)
#define uInputA (uTable.uInputA)
#define uInputB (uTable.uInputB)
#define uInputB4 (uTable.uInputB4)
#define uScratch (uTable.uScratch)
#define uScale (uTable.uScale)
#define uGlobal (uTable.uGlobal)
#define uEpiBias (uTable.uEpiBias)
#define uInputB2 (uTable.uInputB2)
#define uInputAct (uTable.uInputAct)
#else
layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
// Aliased 128-bit view of the same B buffer for the wide-load split-K GEMV:
// one uvec4 = eight fp16 columns. Requires 16B element alignment, which the
// host guarantees by picking this kernel only when N % 8 == 0 (so k*N is a
// multiple of 8 elements) and giving each lane a column octet.
layout(set = 0, binding = 2) readonly buffer InB4 {
    uvec4 data4[];
} uInputB4;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;

// Scratch header: [0] debug flag, [1] ks_n, [2] k0, [3] kstop, [4 .. 4+2*ks_n)
// the K-slice table (lo, hi pairs tiling [0, K)), then the tile-split-K
// partials. See the deposit/fold pair below.

// One output column's per-column group scale, for the fp32 per-element path and
// the byte-weight epilogue. The fold pass below calls it and sits above the
// definition, so the prototype comes first.
// Per-output-column dequant scale for a quantized weight-only B (binding 4),
// inert otherwise. int8 and fp8 store scale = absmax / the format's largest
// finite value (127, 448, 57344) per column as fp32; the 4-bit formats store one
// scale per (K group, column), laid out [n_groups, N] row-major so a
// thread's columns of one group are contiguous -- as fp32 for int4 and nf4, as
// fp8 e4m3 bytes for NVFP4 (one byte per 16-value block, times uGlobal).
// MatMulBuffer refuses any other scale format or count.
layout(set = 0, binding = 4) readonly buffer Scale {
    uint data[];
} uScale;
// NVFP4's second scale level: one fp32 factor for the whole tensor, held as a
// 1-element input so it travels with the weight instead of being a readback.
// Inert for every other format (the host binds a dummy).
layout(set = 0, binding = 5) readonly buffer GlobalScale {
    uint data[];
} uGlobal;
// Attention QK^T epilogue bias (binding 6): one fp16/fp32 value per output
// element [batch, M, N] (the causal attention_bias, broadcast over the head
// axis by the host binding a [B,1,q,kv] tensor). Applied as s = s*epi_scale +
// bias at the store when uPC.epi_bias == 1. Inert (dummy) for every MatMul the
// converter did not tag.
layout(set = 0, binding = 6) readonly buffer EpiBias {
    uint data[];
} uEpiBias;

// SwiGLU down-projection fusion. The converter folded
//
//     down = MatMul(Mul(Mul(gate, Sigmoid(gate)), up), Wd)
//
// into one MatMul whose A input (binding 1) is the shared MLP input x and whose
// B input (binding 2) is the down weight Wd [K=N_up, N=hidden]. The two
// projections the fold swallowed ride in here:
//
//   binding 7  uInputB2:  Wg, the gate weight [K_out, N_up], same layout and
//                         dtype rules as binding 2 (transB == 0, [batch, K, N]).
//   binding 8  uInputAct: Wu, the up weight, likewise.
//
// Both are declared in every build on purpose: a descriptor a pipeline never
// reads is harmless and unbound, and the pre-existing fp16 module already
// advertises these two numbers, so every shared pipeline stays at seven
// bound descriptors.
//
// The contractions are silu(x . Wg) * (x . Wu) over the whole K_out, i.e. one
// contraction, because silu is not linear and cannot be folded per k. What the
// down kernel saves either way is the M*N_up activation tensor -- its write,
// its read-out and its allocation -- plus the two standalone up dispatches.
layout(set = 0, binding = 7) readonly buffer InB2 {
    uint data[];
} uInputB2;
layout(set = 0, binding = 8) readonly buffer InAct {
    uint data[];
} uInputAct;
#endif

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;
    int transB; // 1 = B is laid out as [batch, N, K] (transposed); read B[j*K+k]
    int tile;   // 1 = shared-memory tiled GEMM (grid is x=N/64, y=M/64, z=batch);
                // 2 = the 128x128 tile (x=N/128, y=M/128)
    int weight_int8; // 1 = B is one byte per quantized value, dequant via
                     // uScale[j]; fp8 when uPC.fp8, int8 otherwise
    int w8_quad;     // 1 = a byte-quantized B, N % 4 == 0 and B is [batch, K, N]:
                     // one thread owns four columns (the host sizes the grid to
                     // match)
    int ksplit; // 1 = split-K GEMV: a block covers ksplit_q column quads and
                // splits K over the lanes the single A row leaves idle (grid is
                // x = N/4/ksplit_q, y = batch*M). Host picks it, see
                // MatMulBuffer.
    int ksplit_q; // column quads per block for the split-K GEMV. The block's
                // 256 lanes are laid out flat as quad = lane % ksplit_q, k
                // slice = lane / ksplit_q, so ksplit_q trades column coverage
                // for K parallelism: a narrow-N layer (down_proj N=896) put only
                // 14 blocks on the device at q=16 and ran at 21 GB/s, while
                // lm_head (2374 blocks) reached 25. Host sets it; 16 reproduces
                // the original layout.
    int w4;     // 1 = B is a packed 4-bit weight (two nibbles per byte, low one
                // first) with a per-group scale: N % 8 == 0, transB == 0 and
                // K % group == 0 are all host-checked (see MatMulBuffer).
    int nf4;    // 1 = the nibble is an unsigned index into the NF4 codebook
                // instead of a signed int4 value. Only meaningful with w4.
    int group;  // with w4: values of K sharing one scale row (K / n_groups),
                // even and a divisor of K. Unused otherwise.
    int fp8;    // 1 = the weight_int8 bytes are fp8, not two's complement: one
                // value per byte, decoded by reassembling its exponent and
                // mantissa (uPC.e5m2 picks the layout). Same per-column scale
                // and same kernels as int8.
    int e5m2;   // 1 = the fp8 bytes are E5M2 (5 exponent, 2 mantissa bits)
                // instead of E4M3. Only meaningful with fp8.
    int nvfp4;  // 1 = a w4 payload whose nibble is an E2M1 code, scaled by an
                // e4m3 byte per (16-value K block, column) at binding 4 and one
                // fp32 per-tensor factor at binding 5. Also fixes group to 16.
    int uint4;  // 1 = the w4 nibble is an unsigned value in [0, 15] scaled by
                // the group scale (the unsigned counterpart of the signed int4
                // grid), instead of a signed [-8, 7] two's-complement nibble.
                // Only meaningful with w4; nvfp4/nf4 take precedence over it.
    int wide;   // 1 = fp16 split-K GEMV uses the 16-byte-load variant: each
                // lane owns eight CONTIGUOUS columns and reads them with one
                // uvec4 load per k (two independent vec4 accumulator chains).
                // Host checks N % 8 == 0; ksplit_q then counts 8-column
                // groups per block instead of 4-column quads.
    int rep;        // >1: exactly one leading axis of A is rep consecutive
                    // copies of B's axis (repeat_kv folded into this MatMul by
                    // the converter), so B's flat batch is rep times smaller
                    // than the dispatch's. 0/1 = identity bmap().
    int rep_stride; // product of A's leading dims after the grouped axis (1
                    // when it is the last leading axis, the repeat_kv case).
    int a_dim;      // A's dim on the grouped axis (= b_dim * rep).
    int b_dim;      // B's dim on the grouped axis.
    float epi_scale; // attention epilogue: multiply every output by this (the
                     // 1/sqrt(head_dim) scale) before adding epi_bias.
    int epi_bias;   // 1 = apply uEpiBias[out_idx] after the scale. 0 = off.
    int K_act;      // x's column count (K_out) in the SwiGLU down fold (see
                    // GpuMatMulParam): K counts the weight rows (the up width
                    // N_up), K_act x's columns. Set only by that route, 0
                    // elsewhere.
    int mind_k;     // the down fold's deposit grid-x extent GX = ceil(K / 512);
                    // the fold pass sums GX partials. Set only by that route,
                    // 0 elsewhere.
    int epi_bias_batch; // when epi_bias: the bias tensor's flat batch count
                        // (the down fold reuses this slot as `ks`, the padded
                        // lane-major group width of its Wg/Wu)
                        // (== total batch / broadcast ratio over the head axis).
                        // bias_idx = (n / (batch / epi_bias_batch)) * M * N + ...
    int attn_softmax; // 1 = fuse the trailing Softmax into this MatMul: after
                      // the scale+bias epilogue, normalize each row over N
                      // (online softmax: per-thread max/sum + workgroup reduce)
                      // and store exp(x-max)/sum directly. The host gates this
                      // on epi_bias && M small (decode) and routes a dedicated
                      // one-workgroup-per-row kernel.
    int b_shared; // 1 = B is broadcast over the batch axes (a [K, N] weight
                  // shared by every output slice): bmap() folds B's slice
                  // index to 0. See GpuMatMulParam.
    int ks_part; // The split-K GEMV's fold pass -- see GpuMatMulParam. In the
                 // -DDOWN_ACT module this is also the entry-point selector:
                 // its two passes (deposit, fold) share one build, so the
                 // host's flag picks which one runs.
    int bf16;    // 1 = B is a bfloat16 weight (raw bf16 bits, two per word,
                 // element 0 low -- fp16's packing, bf16's encoding). Every
                 // fp16-B read goes through unpackB2 / stageB2 below, so the
                 // kernels' index math is shared with fp16 unchanged. Offset
                 // 124: the last int of the 128-byte block. See GpuMatMulParam.
} uPC;

// ---------------------------------------------------------------------------
// Tile-split-K: the tiled GEMM's K dimension, split across workgroups.
//
// The tiled kernel's grid is (N/64, M/64, batch): every K tile of a block runs
// inside that one workgroup. When M is small -- decode, or a short prefill --
// there are barely any blocks, so most of the device idles while each one walks
// the whole K. Splitting K multiplies the grid by ks_n and leaves the reduction
// to a second pass.
//
// The two passes are two ENTRY POINTS over this one source (-DTILED_KS_SPLIT
// deposits, -DTILED_KS_FOLD reduces), because a pipeline binds exactly one
// entry point: a single kernel would need a grid-wide barrier between deposit
// and reduce, and a barrier() that orders storage across workgroups is
// undefined -- it measured 1-in-8 wrong at ks_n=2 and 3-of-3 at ks_n=4.
//
// The range rides in the scratch header (KS_HDR above), not in push constants:
// the constant block sits at the 128-byte device floor and everything past ~108
// reads as zero on this driver (sizeof(GpuMatMulParam) == 128 zeroed every field
// from offset 108 on). The host writes ks_n/k0/kstop once per dispatch and both
// passes read them back, so the two cannot disagree about the split.
// ---------------------------------------------------------------------------

// Tile geometry of the shared-memory GEMM in matmul16_tiled, and of the fold
// pass that reads the partials it deposits. Declared here, outside the fp16
// kernel set, because the fold pass is a separate entry point over the same
// source and needs the identical layout.
#define TILE_M 64
#define TILE_N 64
#define TILE_K 16
// Words per [tile-row][k-pair] shared row: TILE_K/2 packed halves + 1 pad. The
// pad breaks the 32-bank aliasing a power-of-2 stride causes across the 16 lane
// threads (each thread's 4 columns start 4 words apart).
#define SROW (TILE_K / 2 + 1)
// Words per [k][column-pair] shared row, used when B is [batch, K, N].
#define SBROW (TILE_N / 2)
// The grid is (ceil(N/64), ceil(M/64), ...), so the tile->partial index has to
// count tiles the same way the host sized the dispatch.
#define TILES_N ((uPC.N + TILE_N - 1) / TILE_N)
#define TILES_M ((uPC.M + TILE_M - 1) / TILE_M)
// 1 when this module's tiled kernel is the deposit half of a tile-split-K pair.
// Constant, so the other builds compile the K-range code away entirely and the
// general tiled kernel stays the per-tile nest it was.
#ifdef TILED_KS_SPLIT
#define KSPLIT_BY 1
#else
#define KSPLIT_BY 0
#endif

struct KRange {
    int n;    // number of K slices (1 = unsplit)
    int k0;   // this slice's first K, a multiple of TILE_K
    int stop; // one past this slice's last K
};

KRange load_krange() {
    KRange kr;
    kr.n = int(uScratch.data[1]);
    kr.k0 = int(uScratch.data[2]);
    kr.stop = int(uScratch.data[3]);
    return kr;
}

// The slice table entry `s`: where the partials begin in words, and slice s's
// [lo, hi) in K. The deposit pass looks its own slice up from gid.z and the
// fold pass reads the same entries, so the range one writes under is the range
// the other reduces -- no per-dispatch state can make them disagree.
#define KS_TABLE(s) (KS_HDR + 2 * (s))
int ks_part_off() { return KS_HDR + 2 * max(load_krange().n, 1); }
int ks_lo(int s) { return int(uScratch.data[KS_TABLE(s)]); }
int ks_hi(int s) { return int(uScratch.data[KS_TABLE(s) + 1]); }

// Partial index of output tile (b, ty, tx), slice s. The host sizes the
// deposit grid as z = b*ks_n + s, so the inverse of that is the layout both
// passes must agree on. Every slice stores only its tile's VALID rows and
// columns, packed at the output's own M*N stride: (row, col) lives at
// row*N + col. Padding rows (M < 64) and columns (N % 64 != 0) are never
// touched -- a padded 64x64 slot moved 16x the real output at M=4, and that
// scratch traffic cancelled the extra parallelism split-K bought.
int ks_tile_slot(int b, int ty, int tx, int s, int ks) {
    return ks_part_off() + (b * ks + s) * (uPC.M * uPC.N) +
           (ty * TILE_M) * uPC.N + tx * TILE_N;
}

// Deposit-only tail of the tiled kernel: this block owns K slice rk of its
// 64x64 output tile, so its accumulator is a PARTIAL C, not C. The fold pass
// stores. Only rows/columns inside the real MxN output are written.
void ks_deposit(int rk, in float acc[4][4], int lr, int lc) {
    int ks = max(load_krange().n, 1);
    int b = int(gl_WorkGroupID.z) / ks;
    int row0 = int(gl_WorkGroupID.y) * TILE_M;
    int col0 = int(gl_WorkGroupID.x) * TILE_N;
    int base = ks_tile_slot(b, int(gl_WorkGroupID.y), int(gl_WorkGroupID.x),
                            rk, ks);
    for (int r = 0; r < 4; ++r) {
        if (row0 + lr + r >= uPC.M) break;
        int at = base + (lr + r) * uPC.N + lc;
        for (int c = 0; c < 4; ++c) {
            if (col0 + lc + c >= uPC.N) break;
            uScratch.data[at + c] = floatBitsToUint(acc[r][c]);
        }
    }
}

// Fold pass (-DTILED_KS_FOLD): one block per output tile, summing the ks_n
// partials the deposit pass left. Same grid as the unsplit tiled kernel and the
// same epilogue, so the two agree on every element.
void ks_fold_tiles() {
    int b = int(gl_WorkGroupID.z);
    int ty = int(gl_WorkGroupID.y);
    int tx = int(gl_WorkGroupID.x);
    int row0 = ty * TILE_M;
    int col0 = tx * TILE_N;
    if (row0 >= uPC.M || col0 >= uPC.N) return;
    int lr = int(gl_LocalInvocationID.y) * 4;
    int lc = int(gl_LocalInvocationID.x) * 4;

    // Refuse a cut that does not tile [0, K) in order: the host builds it, so
    // a mismatch means the header was not staged for this dispatch, and a
    // partial sum over the wrong ranges is worse than no store at all.
    int ks = max(load_krange().n, 1);
    int at = 0;
    for (int s = 0; s < ks; ++s) {
        if (ks_lo(s) != at || ks_hi(s) <= at) return;
        at = ks_hi(s);
    }
    if (at != uPC.K) return;

    float acc[4][4];
    for (int r = 0; r < 4; ++r)
        for (int c = 0; c < 4; ++c)
            acc[r][c] = 0.0;
    // Compact partial layout: slice s of this tile starts at the same offset
    // the output would have, and each slice is one M*N fp32 plane. Only the
    // tile's valid rows/columns exist, so a small-M tile never pays for the
    // padding the deposit no longer writes.
    int slot0 = ks_tile_slot(b, ty, tx, 0, ks);
    int stride = uPC.M * uPC.N;
    for (int r = 0; r < 4; ++r) {
        int grow = row0 + lr + r;
        if (grow >= uPC.M) break;
        int at = slot0 + (lr + r) * uPC.N + lc;
        for (int c = 0; c < 4; ++c) {
            if (col0 + lc + c >= uPC.N) break;
            float v = 0.0;
            for (int s = 0; s < ks; ++s)
                v += uintBitsToFloat(uScratch.data[at + c + s * stride]);
            acc[r][c] = v;
        }
    }
    for (int r = 0; r < 4; ++r) {
        int grow = row0 + lr + r;
        if (grow >= uPC.M) break;
        int base = (b * uPC.M + grow) * uPC.N + col0 + lc;
        vec2 v0 = vec2(acc[r][0], acc[r][1]);
        vec2 v1 = vec2(acc[r][2], acc[r][3]);
        if (uPC.weight_int8 != 0) {
            int c = col0 + lc;
            v0 *= vec2(scale1(c), scale1(c + 1));
            v1 *= vec2(scale1(c + 2), scale1(c + 3));
        }
        if (col0 + lc + 1 < uPC.N)
            uOutput.data[base >> 1] = packHalf2x16(v0);
        if (col0 + lc + 3 < uPC.N)
            uOutput.data[(base + 2) >> 1] = packHalf2x16(v1);
    }
}

// A flat batch index -> B's slice, when the host detected a grouped leading
// axis (uPC.rep > 1): the grouped axis repeats each B slice rep times
// consecutively (repeat_kv interleave), and any outer leading axes are shared.
// A fully broadcast B (a [K, N] weight shared by every output slice) is not a
// grouped axis at all -- the host raises uPC.b_shared instead, and the
// early-out below folds B's slice index to 0 for every n.
// Decomposing n over A's leading dims gives n = prefix*(rep*rep_stride*b_dim)
// + h*rep_stride + tail, and B's slice is prefix*(rep_stride*b_dim) +
// (h/rep)*rep_stride + tail; the two divisions below fold that out of (n, the
// strides and the dims) directly. With rep <= 1 this is the identity -- and
// the early return is what keeps a_span = 0 out of the div/mod when the host
// leaves the grouped fields unset.
int bmap(int n) {
    if (uPC.b_shared != 0) {
        return 0;
    }
    if (uPC.rep <= 1) {
        return n;
    }
    int a_span = uPC.rep_stride * uPC.a_dim;
    int rest = n % a_span;
    int prefix = n / a_span;
    int b_span = uPC.rep_stride * uPC.b_dim;
    return prefix * b_span + (rest / (uPC.rep * uPC.rep_stride)) * uPC.rep_stride +
           (rest % uPC.rep_stride);
}

// Attention QK^T epilogue: the bias is laid out [epi_bias_batch, M, N] (the
// causal attention_bias broadcast over the head axis), while this kernel's flat
// batch is `batch` = epi_bias_batch * heads. So output row n maps to bias batch
// n / (batch / epi_bias_batch). Returns the bias value for output element
// (n, i, j). fp16 build: bias is half2-packed like the output.
float epi_bias_at(int n, int i, int j) {
    int ratio = uPC.batch / max(uPC.epi_bias_batch, 1);
    int bn = n / max(ratio, 1);
    int idx = bn * uPC.M * uPC.N + i * uPC.N + j;
#ifdef FP16
    return unpackHalf2x16(uEpiBias.data[idx >> 1])[idx & 1];
#else
    return uintBitsToFloat(uEpiBias.data[idx]);
#endif
}

// ---- 16-bit float weights: fp16 or bf16 --------------------------------
// A bf16 B has fp16's storage layout (two values per word, element 0 low), so
// it shares every fp16 kernel; only the word -> float step differs. The flag
// is push-constant uniform, so the branch below is one predicate per dispatch
// in practice, not a divergent one.
//   unpackB2  -- a B word straight to fp32 (the GEMVs and the scalar paths).
//   stageB2/8 -- a B word into an fp16 shared-memory stage (the SIMT tile):
//                bf16 is re-encoded as half there, see bf16x2_to_half2.
#include "../common/bf16.comp"

vec2 unpackB2(uint w) {
    return uPC.bf16 != 0 ? unpackBF16x2(w) : unpackHalf2x16(w);
}
uint stageB2(uint w) { return uPC.bf16 != 0 ? bf16x2_to_half2(w) : w; }
uvec4 stageB8(uvec4 w) { return uPC.bf16 != 0 ? bf16x8_to_half8(w) : w; }

#ifdef FP16
float load_a(int idx) {
    return unpackHalf2x16(uInputA.data[idx >> 1])[idx & 1];
}
float load_b(int idx) {
    return unpackB2(uInputB.data[idx >> 1])[idx & 1];
}
#endif

// ---- byte-per-value quantized weights ---------------------------------
// int8 and fp8 share everything below: one byte per weight, one fp32 scale per
// output column, and therefore a scale that folds out of the K loop. Only the
// byte-to-float step differs, and it is the whole of both kernels' difference,
// so the four byte-shaped paths (quad, split-K, even-N and the fp32 build's
// per-element one) stay single implementations.

// The int8/fp8 byte-to-float step lives in shaders/common/fp8_decode.comp,
// shared with buffer/conv2d.comp: both kernels carry one byte per weight and
// one fp32 scale per output column, so the decode is identical and only the
// surrounding index math differs. Keep it shared -- a second copy is how the
// two drift into decoding slightly different grids.
#include "../common/fp8_decode.comp"

float f8_val(uint b) { return f8_byte(b, uPC.e5m2 != 0); }

float w_val(uint b) { return uPC.fp8 != 0 ? f8_val(b) : w8_val(b); }

// One quantized weight by its index in the logical [K, N] matrix.
float load_w8(int idx) {
    return w_val((uInputB.data[idx >> 2] >> ((idx & 3) * 8)) & 0xFFu);
}

// The four weights of one word, low byte first.
vec4 unpack_w8(uint word) {
#ifdef FP8_HW
    // One vector conversion over the 32-bit load (see f8_vec4).
    if (uPC.fp8 != 0) {
        return f8_vec4(word, uPC.e5m2 != 0);
    }
#else
    if (uPC.fp8 != 0) {
        return vec4(f8_val(word & 0xFFu), f8_val((word >> 8) & 0xFFu),
                    f8_val((word >> 16) & 0xFFu), f8_val(word >> 24));
    }
#endif
    return vec4(w8_val(word & 0xFFu), w8_val((word >> 8) & 0xFFu),
                w8_val((word >> 16) & 0xFFu), w8_val(word >> 24));
}

// ---- 4-bit weight-only payloads ---------------------------------------
// Two values per byte, the even element in the low nibble, so one 32-bit word
// holds the eight columns of one K row that a pair of threads splits.

// The NF4 codebook: the 16 quantiles of a unit-normal distribution, as
// published for bitsandbytes' NF4 and normalized so the extreme codes are
// exactly -1 and +1. A weight is codebook[q] * group_absmax, so the fp32 scale
// table holds the group absmax itself (not absmax/7 like int4/int8).
float nf4_code(int q) {
    const float cb[16] = float[16](
        -1.0, -0.6961928009986877, -0.5250730514526367, -0.39491748809814453,
        -0.28444138169288635, -0.18477343022823334, -0.09105003625154495, 0.0,
        0.07958029955625534, 0.16093020141124725, 0.24611230194568634,
        0.33791524171829224, 0.44070982933044434, 0.5626170039176941,
        0.7229568362236023, 1.0);
    return cb[q];
}

// One signed 4-bit value: bitfieldExtract with a signed result sign-extends the
// nibble, which is the two's-complement conversion without a compare.
float w4_val(uint word, int e) {
    return float(bitfieldExtract(int(word), e * 4, 4));
}

// One UNSIGNED 4-bit value in [0, 15]. Same bits as w4_val, read without the
// sign extension -- the grid is 16 levels below the group absmax rather than a
// symmetric +-7, so the zero point is 0 and the scale carries absmax/15.
float w4u_val(uint word, int e) {
    return float((word >> uint(e * 4)) & 15u);
}

// One E2M1 nibble -- sign, 2 exponent bits, 1 mantissa bit -- so its eight
// magnitudes are 0, .5, 1, 1.5, 2, 3, 4, 6, and the sign bit gives the other
// eight (code 8 is -0.0). There is no Inf or NaN encoding: all 16 nibbles are
// values, so the decode is a 16-entry table exactly like nf4_code.
//
// A table, not the fp32 field slide (exponent (m >> 1) - 1, mantissa m & 1,
// a separate subnormal arm, then a sign select): that arithmetic is ~8 ALU ops
// per nibble, and on the WIDE GEMV -- eight nibbles per 32-bit load -- it made
// NVFP4 ALU-bound on Apple M5 Max: 2048x59264 0.271 ms (224 GB/s) against
// 0.172 ms (353 GB/s) through the table, which is int4's rate. Metal keeps the
// constant table in registers / the constant cache, the same as nf4_code's.
float e2m1_val(uint c) {
    const float cb[16] = float[16](0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
                                   -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0,
                                   -6.0);
    return cb[c & 15u];
}

// Single-nibble decoders for the non-int4 payloads, in w4_val's (word, e)
// shape so the WIDE group walk and W4_QUAD can take any of them as a macro
// argument. e is the nibble position 0..7, low nibble first.
float w4_nf4(uint word, int e) {
    return nf4_code(int((word >> uint(e * 4)) & 15u));
}
float w4_e2m1(uint word, int e) { return e2m1_val((word >> uint(e * 4)) & 15u); }

// One nibble of `word` at position `e` (0..7), decoded by the payload's
// meaning. The single-value form of unpack_w4, split out because the WIDE GEMV
// reads one word and decodes eight columns from it: before this existed that
// kernel called w4_val directly, which is the SIGNED nibble only -- so an nf4
// or uint4 weight on the WIDE route (n >= wide_thr_fp16, i.e. every large
// projection by default) was decoded as if it were int4. The nibble grid still
// has plausible magnitudes, so the mismatch surfaced only as a wrong answer:
// measured N=2048 on ARL, nf4 460.5 vs -25.5 expected, uint4 -8.16 vs -10.41.
//
// w4_at tests the format PER NIBBLE, and Metal via MoltenVK does not hoist
// those uniform tests out of a K loop. No hot loop may call it: the WIDE GEMV
// decodes through a workgroup table built from it once (w4_lut), the other
// kernels pick the decoder once per word (unpack_w4). It is left for that
// table fill and the fp32 build's per-element path.
//
// True when the 4-bit payload is the plain signed int4 grid -- the one case
// where w4_at reduces to w4_val. Uniform over a dispatch, so a hot loop can
// test it ONCE and run a w4_val body (Qwen3-VL-2B int4 decode was 11.7 -> 21.5
// ms/token while the WIDE loop called w4_at for every format).
bool w4_plain() {
    return uPC.nvfp4 == 0 && uPC.uint4 == 0 && uPC.nf4 == 0;
}

float w4_at(uint word, int e) {
    if (uPC.nvfp4 != 0) return w4_e2m1(word, e);
    if (uPC.uint4 != 0) return w4u_val(word, e);
    if (uPC.nf4 != 0) return w4_nf4(word, e);
    return w4_val(word, e);
}

// Four consecutive 4-bit weights starting at nibble `base` (0 or 4) of a word.
// The format is tested once per call, each arm decoding all four nibbles with
// its own decoder -- never w4_at, whose three tests would run per nibble.
#define W4_QUAD(DEC, word, base) \
    vec4(DEC(word, base), DEC(word, base + 1), DEC(word, base + 2), \
         DEC(word, base + 3))
vec4 unpack_w4(uint word, int base) {
    if (w4_plain()) return W4_QUAD(w4_val, word, base);
    if (uPC.nf4 != 0) return W4_QUAD(w4_nf4, word, base);
    if (uPC.uint4 != 0) return W4_QUAD(w4u_val, word, base);
    return W4_QUAD(w4_e2m1, word, base);
}

// One weight by its index in the logical [K, N] matrix.
float unpack_w4_at(int idx) {
    uint word = uInputB.data[idx >> 3];
    return w4_at(word, idx & 7);
}

// The fp32 factor NVFP4 multiplies every block scale by: the one level the
// format carries per tensor rather than per block.
float global_scale() { return uintBitsToFloat(uGlobal.data[0]); }

// This thread's four column scales of one K group.
vec4 scale4(int sw) {
    if (uPC.nvfp4 != 0) {
        // Four adjacent columns' e4m3 block scales are one word: sw is a
        // multiple of 4 because a thread's column start is, and every group row
        // starts 4-aligned because N % 8 == 0.
        uint w = uScale.data[sw >> 2];
        return vec4(e4m3_val(w & 0xFFu), e4m3_val((w >> 8) & 0xFFu),
                    e4m3_val((w >> 16) & 0xFFu), e4m3_val(w >> 24)) *
               global_scale();
    }
    return vec4(uintBitsToFloat(uScale.data[sw]),
                uintBitsToFloat(uScale.data[sw + 1]),
                uintBitsToFloat(uScale.data[sw + 2]),
                uintBitsToFloat(uScale.data[sw + 3]));
}

// One column's group scale. The fp32 build's per-element path and the
// tile-split-K fold epilogue both read it.
float scale1(int sw) {
    if (uPC.nvfp4 != 0) {
        return e4m3_val((uScale.data[sw >> 2] >> ((sw & 3) * 8)) & 0xFFu) *
               global_scale();
    }
    return uintBitsToFloat(uScale.data[sw]);
}

#ifdef FP16
// Odd-N int8 lands in the fp32 scratch and matmul_pack.comp halves it; the
// fused even-N path below writes the output word itself.
#define W8_STORE(idx, val) uScratch.data[idx] = floatBitsToUint(val)

// int8 weight-only, N % 4 == 0 and B is [batch, K, N] (transB == 0): one thread
// per output DWORD, i.e. four adjacent columns of one row. For this layout the
// four columns of a given K are the four bytes of one word, so a single 32-bit
// weight load feeds four FMAs and successive threads read successive words of
// the same row (coalesced) while the A element broadcasts. That is the LLM
// decode shape: A is one row, the weight stream is the whole cost, and the
// byte-by-byte walk it replaces was one load plus one unpack per tap, which
// made int8 read half the bytes yet run slower than fp16.
void matmul16_w8_quad() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 4;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    // N % 4 == 0 makes every row start 4-aligned, so (k*N + ja) is 4-aligned for
    // every k: the quad needs no per-tap alignment test.
    int b_row = bmap(n) * uPC.K * uPC.N + ja;

    vec4 wsc = vec4(uintBitsToFloat(uScale.data[ja]),
                    uintBitsToFloat(uScale.data[ja + 1]),
                    uintBitsToFloat(uScale.data[ja + 2]),
                    uintBitsToFloat(uScale.data[ja + 3]));

    vec4 s = vec4(0.0);
    // K even => a_off is even, so two consecutive A elements are one word.
    if ((uPC.K & 1) == 0) {
        for (int k = 0; k < uPC.K; k += 2) {
            vec4 w0 = unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
            vec4 w1 =
                unpack_w8(uInputB.data[(b_row + (k + 1) * uPC.N) >> 2]);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            s += load_a(a_off + k) *
                 unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
        }
    }

    vec4 v = s * wsc;
    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

// 4-bit weight-only (int4 or nf4), N % 8 == 0, B is [batch, K, N]: one thread
// per four output columns, same ownership as the int8 quad kernel. N % 8 == 0
// makes every K row start on an 8-nibble boundary, so a thread's four columns
// are half of one word at a fixed nibble offset (consecutive threads share a
// word, which the load broadcasts). Unlike int8 the scale is not constant along
// K, so it cannot be folded out of the loop: the nest walks one K group at a
// time, dequantizes that group's partial sum, and accumulates the result. The
// group's taps are still summed in fp32 before any rounding, which is the
// numerical property group quantization exists for.
void matmul16_w4_quad() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 4;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int b_row = bmap(n) * uPC.K * uPC.N + ja;
    int nib = ja & 7; // 0 or 4, fixed along K

    vec4 s = vec4(0.0);
    int ngroups = uPC.K / uPC.group;
    for (int g = 0; g < ngroups; ++g) {
        vec4 acc = vec4(0.0);
        int kend = (g + 1) * uPC.group;
        // group even (host-checked) keeps the A pairs word-aligned.
        for (int k = g * uPC.group; k < kend; k += 2) {
            vec4 w0 = unpack_w4(uInputB.data[(b_row + k * uPC.N) >> 3], nib);
            vec4 w1 =
                unpack_w4(uInputB.data[(b_row + (k + 1) * uPC.N) >> 3], nib);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            acc += a.x * w0 + a.y * w1;
        }
        s += acc * scale4(g * uPC.N + ja);
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(s.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(s.zw);
}

#ifndef DOWN_ACT
// ---- split-K GEMV -------------------------------------------------------
// At decode time A has a single row, so the column-parallel kernels launch a
// 16x16 workgroup in which only the yi == 0 lane survives: 15/16 of every
// workgroup idles, and the surviving threads each walk the whole K serially.
// That is why neither precision gets near the machine's bandwidth (measured on
// GLM-Edge: int8 13.9 GB/s, fp16 26.8 GB/s) -- it is latency-bound, not
// bandwidth-bound. Here the idle lanes take slices of K instead: a workgroup
// covers 16 column quads x 16 K slices, each lane accumulating one vec4 over
// its slice, and the partials fold through shared memory. Total weight bytes
// read are unchanged; what changes is that 16x more lanes are in flight per
// column at any instant, which is what the load has to have to stream.
#define KS 16
// One vec4 per (K slice, column quad) = 4 KB of shared, next to the tiled
// path's staging arrays.
shared vec4 ks_part[KS][16];

// Both variants need K even: it makes a_off = row*K even (so two consecutive A
// elements are one word) and, with the slice length rounded up to an even
// chunk, k0 even as well. The host only selects this path under that condition.
int ks_chunk() { return ((uPC.K + KS - 1) / KS + 1) & ~1; }

void ks_store(vec4 s, int row, int ja) {
    int lx = int(gl_LocalInvocationID.x);
    int ly = int(gl_LocalInvocationID.y);
    ks_part[ly][lx] = s;
    barrier();
    if (ly != 0) return;
    vec4 v = ks_part[0][lx];
    for (int t = 1; t < KS; ++t) v += ks_part[t][lx];
    if (ja >= uPC.N) return;
    int out_idx = row * uPC.N + ja;
    if (uPC.weight_int8 != 0) {
        v *= vec4(uintBitsToFloat(uScale.data[ja]),
                  uintBitsToFloat(uScale.data[ja + 1]),
                  uintBitsToFloat(uScale.data[ja + 2]),
                  uintBitsToFloat(uScale.data[ja + 3]));
    }
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

// int8 weight-only, B is [batch, K, N], N % 4 == 0.
//
// Flat split-K GEMV. The block's 256 lanes are laid out as
//   quad  = lane % ksplit_q        (which column quad this lane owns)
//   slice = lane / ksplit_q        (which slice of K it accumulates)
// so ksplit_q is a pure occupancy knob: it sets both how many column quads a
// block covers (grid x = N/4/ksplit_q) and how deep K is cut (ksplit_q *
// n_slice == KS_LANES: 256 lanes, or 512 in the -DKSPLIT512 build -- see the
// VKOP_KSPLIT512 note in ops/Matmul.hpp). The original 16x16 form is
// ksplit_q == 16. Decode is one A
// row, so the column-parallel kernels leave 15 of every 16 lanes idle; putting
// them on K is the whole point, and the narrow-N projections need the extra
// blocks more than they need the extra K depth -- at q = 16 down_proj (N=896)
// launched 14 blocks and ran at 21 GB/s against lm_head's 25 GB/s at 2374.
//
// The partials fold through one flat shared array indexed slice*ksplit_q +
// quad; a runtime stride into shared is legal, and it keeps the fold code
// identical for every q (the array is sized for the KS_LANES-lane block, so
// the q == 4 case uses it exactly).
//
// A transB (weight [batch, N, K]) dispatch runs the SAME slot convention but
// derives (quad, slice) from the lane the other way round -- slice = lane %
// n_slice, quad = lane / n_slice -- so that consecutive lanes walk K instead of
// columns. That is a property of the DEPOSIT's lane math, not of the fold; it
// enters through ks_store_flat_at below, which takes the pair explicitly.
shared vec4 ks_flat[KS_LANES];

// Deposit one lane's partial into slot `slice * q + quad` and let one lane per
// column quad fold. The (quad, slice) pair is a parameter because the two
// weight layouts derive it differently (see the transB branch of
// matmul16_w8_ksplit); the slot convention, the fold order and the epilogue are
// shared, so both forms reduce identically.
//
// The folding lanes are the slice == 0 lanes, which under EITHER mapping are
// exactly q lanes with q distinct quads: the blocked form (slice = lane / q)
// picks lanes 0..q-1, the interleaved form (slice = lane % n_slice) picks
// lanes j * n_slice. Taking the pair from the caller keeps this fold blind to
// how the deposit laid its lanes out -- the only thing that must agree is the
// slot formula.
void ks_store_flat_at(vec4 s, int row, int ja, int quad, int slice) {
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    ks_flat[slice * q + quad] = s;
    barrier();
    // One folding lane per column quad; the rest of the block is done.
    if (slice != 0) return;
    vec4 v = ks_flat[quad];
    for (int t = 1; t < n_slice; ++t) v += ks_flat[t * q + quad];
    int cja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    if (cja >= uPC.N) return;
    int out_idx = row * uPC.N + cja;
    if (uPC.weight_int8 != 0) {
        v *= vec4(uintBitsToFloat(uScale.data[cja]),
                  uintBitsToFloat(uScale.data[cja + 1]),
                  uintBitsToFloat(uScale.data[cja + 2]),
                  uintBitsToFloat(uScale.data[cja + 3]));
    }
    uOutput.data[out_idx >> 1] = packHalf2x16(v.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v.zw);
}

void ks_store_flat(vec4 s, int row, int ja) {
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    ks_store_flat_at(s, row, ja, lane % q, lane / q);
}

// Split-K GEMV for a byte weight stored [batch, N, K] (uPC.transB != 0).
//
// This is the only split-K form an ONNX-exported weight reaches: the exporter
// keeps the checkpoint's [OC, K] layout and sets transB=1 rather than
// materializing a transpose, and every gate that used to admit a byte weight
// demanded !transB -- so the GEMV fell through to matmul16_w8_even_n, whose y
// grid is UP_DIV(batch*m, 16) and therefore uses 16 of 256 lanes at decode.
// That 6.25% occupancy is what an earlier 20 GB/s measurement was made of.
//
// LANE MAPPING -- K-contiguous instead of column-contiguous.
//
//   slice = lane % n_slice    (which interleaved K slice this lane carries)
//   quad  = lane / n_slice    (which column quad it owns)
//
// The [K, N] form maps quad = lane % q, slice = lane / q, which in a 32-lane
// warp gives q different COLUMNS and one slice. In [N, K] a column's K bytes
// are contiguous, but a column is K bytes away from its neighbour, so each
// lane's 4-byte word lands in a different cache line: a warp touches q lines
// and uses 4 bytes of each. Swapping the roles makes consecutive lanes differ
// in K instead, and K is the axis [N, K] packs contiguously.
//
// INTERLEAVED K. Lane `slice` walks whole words
//
//     w_t = slice + n_slice * t,     t = 0, 1, ... ,  w < K/4
//     byte k = 4 * w_t
//
// rather than a blocked [slice*chunk, (slice+1)*chunk). A block's lanes read
// words 0..n_slice-1 on trip 0, n_slice..2*n_slice-1 on trip 1, ..., so the
// n_slice consecutive lanes are one contiguous n_slice*4-byte run. At
// n_slice >= 32 (q <= 8) a full warp covers exactly 128 B: one cache line, all
// of it used, and the warp's successive trips stream the next lines.
//
// COVERAGE. The word indices lane `slice` reads are {slice + n_slice*t}. Every
// integer w in [0, K/4) has the unique decomposition w = slice + n_slice*t with
// slice = w mod n_slice, t = w / n_slice, so the union over the block's lanes
// is exactly [0, K/4): no word is read by two lanes (no double-counting in the
// fold) and none is skipped. Per-lane trip counts differ by at most one -- the
// (K/4) mod n_slice lanes with the smallest slice take one extra word -- which
// is why the loop bound is per-lane (w < kw) rather than per-block.
//
// q <= 8: THE MAPPING DOES NOT NEED IT, THE BANDWIDTH DOES.
// The mapping alone already puts consecutive lanes on consecutive words for
// every q, so the kernel is correct for any q the host sends and degrades
// gracefully: n_slice = 16 (q = 16) splits a warp into two 64-byte runs,
// n_slice = 8 (q = 32) into four 32-byte runs. A 32-byte DRAM sector is the
// real granularity of a miss, so even q = 32 wastes nothing at DRAM -- what it
// loses is that one 128-byte line now arrives as four separate segments. q > 32
// is where runs drop below a sector and the access pattern genuinely
// disintegrates. The host therefore clamps this route to q <= 8 (see q_plain in
// core/KernelSelect.cpp): that buys the full line AND the largest block count,
// and it costs nothing because a smaller q is strictly more blocks -- which is
// the only reason this kernel splits K at all.
//
// q = 8 is the exact value that makes one WARP one QUAD: the 256-lane block is
// 8 warps, n_slice = 32, so quad = lane / 32 is the warp index and slice =
// lane % 32 is the lane within it. Every issue of every warp is therefore one
// 32-word = 128-byte run of one column group -- the cleanest shape this mapping
// has. (In the 512-lane build the block is 16 warps and q = 8 puts two warps
// per quad, each still issuing its own 128-byte run.) The run starts at
// b_c0 + 4*slice, so it is line-aligned only when the column base is; K % 32 ==
// 0 would guarantee that, and where it does not hold a run straddles two lines
// -- still one contiguous span, and nothing on the DRAM side is lost.
//
// TAIL. K need not be a multiple of n_slice*4: the per-lane bound `w < K/4`
// gives each lane ceil-or-floor(K/4 / n_slice) words, so the last trip is
// ragged across lanes by construction and no block-wide padding exists to
// trim. What it does need is K % 4 == 0, so the last word is whole.
//
// HOST PRECONDITIONS: K % 4 == 0 (word loads, and the A half2 alignment: an
// even K makes a_off even and k = 4w even), N % 4 == 0 (the quad), N even (the
// half2 store in the fold), K >= 256, batch*m <= 8.
void matmul16_w8_ksplit_transb(int row, int lane, int q, int n_slice) {
    int quad = lane / n_slice;
    int slice = lane % n_slice;
    int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    vec4 s = vec4(0.0);
    // A quad past the last column reads nothing, but still publishes the zero
    // the fold expects in its slot.
    if (ja >= uPC.N) {
        ks_store_flat_at(s, row, ja, quad, slice);
        return;
    }
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_c0 = bmap(n) * uPC.K * uPC.N + ja * uPC.K;

    // Two words per trip: word w and word w + n_slice, i.e. eight k. Eight
    // weight words -- two per column -- plus the trip's four A words all issue
    // before any is consumed, the same eight-loads-in-flight budget the [K, N]
    // form settled on (the two-at-a-time form it replaced stalled on DRAM
    // latency near 21 GB/s). Within a warp the first word of every lane is one
    // contiguous n_slice*4-byte run and the second word is the next one, so a
    // trip touches two adjacent lines rather than one -- still fully coalesced.
    //
    // 4-BYTE LOADS ARE ENOUGH, and the measurement says so: the [K, N] sibling
    // reaches 213 GB/s (memcpy ceiling 259) with the same 4 bytes per lane. A
    // warp of 32 lanes times 4 B is 128 B -- one full line per issue -- which
    // is Little's law satisfied at the miss granularity that matters. A uvec4
    // load (uInputB4, binding 2) would cut the instruction count 4x and widen
    // the warp's run to 512 B, but 16 B per lane buys no additional bytes in
    // flight per warp beyond what the issue rate already sustains, while it
    // quadruples the live weight registers in the FMA loop and raises the
    // precondition from K % 4 == 0 to K % 16 == 0 plus 16 B column alignment.
    // Not worth it until something shows the issue rate binding.
    int kw = uPC.K >> 2;
    int w = slice;
    for (; w + n_slice < kw; w += 2 * n_slice) {
        int k = w << 2;
        int k2 = (w + n_slice) << 2;
        uint r0 = uInputB.data[(b_c0 + k) >> 2];          // col ja+0, k..k+3
        uint r1 = uInputB.data[(b_c0 + k2) >> 2];         // col ja+0, k2..k2+3
        uint r2 = uInputB.data[(b_c0 + uPC.K + k) >> 2];  // col ja+1
        uint r3 = uInputB.data[(b_c0 + uPC.K + k2) >> 2];
        uint r4 = uInputB.data[(b_c0 + 2 * uPC.K + k) >> 2];  // col ja+2
        uint r5 = uInputB.data[(b_c0 + 2 * uPC.K + k2) >> 2];
        uint r6 = uInputB.data[(b_c0 + 3 * uPC.K + k) >> 2];  // col ja+3
        uint r7 = uInputB.data[(b_c0 + 3 * uPC.K + k2) >> 2];
        uint aw = (a_off + k) >> 1;
        uint aw2 = (a_off + k2) >> 1;
        vec2 a0 = unpackHalf2x16(uInputA.data[aw]);
        vec2 a1 = unpackHalf2x16(uInputA.data[aw + 1]);
        vec2 a2 = unpackHalf2x16(uInputA.data[aw2]);
        vec2 a3 = unpackHalf2x16(uInputA.data[aw2 + 1]);
        // unpack_w8 is low byte first: .x is k, .w is k+3.
        vec4 w0 = unpack_w8(r0);
        vec4 w1 = unpack_w8(r1);
        s.x += a0.x * w0.x + a0.y * w0.y + a1.x * w0.z + a1.y * w0.w +
               a2.x * w1.x + a2.y * w1.y + a3.x * w1.z + a3.y * w1.w;
        vec4 w2 = unpack_w8(r2);
        vec4 w3 = unpack_w8(r3);
        s.y += a0.x * w2.x + a0.y * w2.y + a1.x * w2.z + a1.y * w2.w +
               a2.x * w3.x + a2.y * w3.y + a3.x * w3.z + a3.y * w3.w;
        vec4 w4 = unpack_w8(r4);
        vec4 w5 = unpack_w8(r5);
        s.z += a0.x * w4.x + a0.y * w4.y + a1.x * w4.z + a1.y * w4.w +
               a2.x * w5.x + a2.y * w5.y + a3.x * w5.z + a3.y * w5.w;
        vec4 w6 = unpack_w8(r6);
        vec4 w7 = unpack_w8(r7);
        s.w += a0.x * w6.x + a0.y * w6.y + a1.x * w6.z + a1.y * w6.w +
               a2.x * w7.x + a2.y * w7.y + a3.x * w7.z + a3.y * w7.w;
    }
    // The lanes whose slice < (K/4) mod n_slice have one word left.
    // This loop runs 0 or 1 times per lane: it consumes the ragged remainder
    // when K/4 is not a multiple of n_slice. The lanes whose slice <
    // (K/4) mod n_slice each own exactly one more word.
    for (; w < kw; w += n_slice) {
        int k = w << 2;
        uint r0 = uInputB.data[(b_c0 + k) >> 2];
        uint r1 = uInputB.data[(b_c0 + uPC.K + k) >> 2];
        uint r2 = uInputB.data[(b_c0 + 2 * uPC.K + k) >> 2];
        uint r3 = uInputB.data[(b_c0 + 3 * uPC.K + k) >> 2];
        uint aw = (a_off + k) >> 1;
        vec2 a0 = unpackHalf2x16(uInputA.data[aw]);
        vec2 a1 = unpackHalf2x16(uInputA.data[aw + 1]);
        vec4 w0 = unpack_w8(r0);
        s.x += a0.x * w0.x + a0.y * w0.y + a1.x * w0.z + a1.y * w0.w;
        vec4 w1 = unpack_w8(r1);
        s.y += a0.x * w1.x + a0.y * w1.y + a1.x * w1.z + a1.y * w1.w;
        vec4 w2 = unpack_w8(r2);
        s.z += a0.x * w2.x + a0.y * w2.y + a1.x * w2.z + a1.y * w2.w;
        vec4 w3 = unpack_w8(r3);
        s.w += a0.x * w3.x + a0.y * w3.y + a1.x * w3.z + a1.y * w3.w;
    }
    // K % 4 == 0 is a HARD host precondition of this route (it is what admits
    // the shape, see transb_byte_ok in core/KernelSelect.cpp), so the word walk
    // above covers all of [0, K) and there is no scalar tail. A shape that
    // slipped through would lose its last (K & 3) k, not corrupt the rest --
    // and there is nowhere correct to put them anyway: under the interleaved
    // mapping a lane's k set is not a contiguous range.
    ks_store_flat_at(s, row, ja, quad, slice);
}

void matmul16_w8_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    // A [batch, N, K] weight takes the K-contiguous lane mapping, which is a
    // different lane decomposition and a different fold lane set. It is a
    // whole separate body rather than a branch in the loop below: the two
    // mappings disagree on which of the block's lanes own which column, so
    // sharing the preamble would mean sharing `ja` too and neither kernel
    // would be readable.
    if (uPC.transB != 0) {
        matmul16_w8_ksplit_transb(row, lane, q, n_slice);
        return;
    }
    int quad = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = bmap(n) * uPC.K * uPC.N + ja;

    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s = vec4(0.0);
    // A quad past the last column reads nothing; ks_store_flat still publishes
    // its zero so the reduction never sees an uninitialized slot.
    if (ja < uPC.N) {
        // Eight k's per trip: every weight word (and the trip's A half2 words)
        // is issued before any is consumed, so the trip's loads are all in
        // flight together. The two-at-a-time form kept only two loads in flight
        // per lane and stalled on DRAM latency -- measured on Qwen2.5-0.5B int8
        // it capped the large projections near 21 GB/s. The addresses within a
        // trip are independent (K rows are N bytes apart), so this is pure
        // memory-level parallelism with identical arithmetic: the same FMAs in
        // the same order, just scheduled wider.
        int k = k0;
        for (; k + 7 < kend; k += 8) {
            uint r0 = uInputB.data[(b_row + (k + 0) * uPC.N) >> 2];
            uint r1 = uInputB.data[(b_row + (k + 1) * uPC.N) >> 2];
            uint r2 = uInputB.data[(b_row + (k + 2) * uPC.N) >> 2];
            uint r3 = uInputB.data[(b_row + (k + 3) * uPC.N) >> 2];
            uint r4 = uInputB.data[(b_row + (k + 4) * uPC.N) >> 2];
            uint r5 = uInputB.data[(b_row + (k + 5) * uPC.N) >> 2];
            uint r6 = uInputB.data[(b_row + (k + 6) * uPC.N) >> 2];
            uint r7 = uInputB.data[(b_row + (k + 7) * uPC.N) >> 2];
            uint aw = (a_off + k) >> 1;
            vec2 a0 = unpackHalf2x16(uInputA.data[aw]);
            vec2 a1 = unpackHalf2x16(uInputA.data[aw + 1]);
            vec2 a2 = unpackHalf2x16(uInputA.data[aw + 2]);
            vec2 a3 = unpackHalf2x16(uInputA.data[aw + 3]);
            s += a0.x * unpack_w8(r0) + a0.y * unpack_w8(r1) +
                 a1.x * unpack_w8(r2) + a1.y * unpack_w8(r3) +
                 a2.x * unpack_w8(r4) + a2.y * unpack_w8(r5) +
                 a3.x * unpack_w8(r6) + a3.y * unpack_w8(r7);
        }
        for (; k + 1 < kend; k += 2) {
            vec4 w0 = unpack_w8(uInputB.data[(b_row + k * uPC.N) >> 2]);
            vec4 w1 = unpack_w8(uInputB.data[(b_row + (k + 1) * uPC.N) >> 2]);
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    }
    ks_store_flat(s, row, ja);
}

// ---- packed 4x8 integer dot product (-DDP4A module) --------------------
#ifdef DP4A
// int8 activation x int8 weight split-K GEMV, inner loop = dotPacked4x8EXT.
//
// WHY IT IS WORTH A SECOND KERNEL AT ALL. The weight-only byte GEMV reads one
// 32-bit word (four int8 weights) per k step and spends, per word, four byte
// extracts, four int->float converts, four subtracts and four FMAs. DP4A
// replaces that whole sequence with ONE instruction per weight word, plus one
// for the paired A word amortized over the four columns: eight bytes of weight
// and four MACs per dot. The per-byte instruction count drops roughly an order
// of magnitude. That only matters when the kernel is issue-bound rather than
// bandwidth-bound, which is the regime this route exists for: a model whose
// weights do not fit VRAM streams them over PCIe, and there the fetch -- not
// the ALU -- is the wall, so nothing is gained; a model that fits is
// issue-bound and the reduction is real. Both are plausible deployments, which
// is why VKOP_DP4A is opt-in and the byte GEMV stays the default.
//
// THE BYTE PAIRING DECIDES THE LAYOUT. dotPacked4x8EXT(x, y) is
//   sum over t in 0..3 of x.byte[t] * y.byte[t]
// so the four bytes of one operand must be four CONSECUTIVE k of the SAME
// output column. Whether that is free depends entirely on the weight layout:
//
//   [batch, N, K] (transB != 0): column j's K values are contiguous, so a
//     word at j*K+k IS four consecutive k. One A word pairs with four column
//     words: four dots, no data movement. This is the layout DP4A wants.
//
//   [batch, K, N] (transB == 0): the word at k*N+j holds four ADJACENT
//     COLUMNS at one k, i.e. exactly the wrong axis. The k values of one
//     column sit N bytes apart, so no load can pair them. They have to be
//     gathered in registers: read the four words for k..k+3 and transpose the
//     4x4 byte block, which costs ~24 integer ops per 16 MACs (see w8_col4
//     below) against the ~64 the float path spends. Still a clear instruction
//     win, though half the win the transB form gets.
//
// The converter now ships byte weights as [K, N] (KnWeightLayout, commit
// "store int8 weights as [K, N], dropping transB"), so the transB form below
// is the rare one -- but it is a third of the kernel and it is the form a
// [OC, K] checkpoint reaches when the layout pass declines (symbolic K, more
// than one consumer), so both are here. They share the fold: the lane mapping
// differs exactly as it does between matmul16_w8_ksplit and its _transb
// sibling, and ks_store_flat_at already takes (quad, slice) explicitly for
// that reason.
//
// INT32 EXACTNESS (a hard precondition, enforced on the host, not here). The
// accumulator is 32-bit: every term is at most 128*128 = 16384 (int8 reaches
// -128, whose magnitude squared is 128^2), so the sum stays inside 2^31 while
// K < 131071. The host gate fails closed at that bound; a shape that slipped
// past would wrap silently and return plausible garbage rather than faulting.
//
// ACTIVATION SCALE. A is a quantized int8 tensor, so the result needs
// acc * scale_a * scale_b[col]. scale_b is the existing per-column table at
// binding 4 and is applied by the fold as usual. scale_a is a per-tensor
// scalar and rides in uPC.epi_scale (an otherwise unused float in the push
// constant): the partial is pre-multiplied by it BEFORE the fold, which is
// algebraically the same as scaling the final sum and needs no extra
// uniform. uPC.epi_scale defaults to 1.0, so a host that forgets to set it
// gets a result that is off by exactly scale_a -- it must be set.

// The 4x4 byte transpose [K, N] forces: w0..w3 are the words holding four
// adjacent columns at k, k+1, k+2, k+3 respectively (low byte first), and
// c0..c3 come back as those four columns' four CONSECUTIVE k, which is what
// dotPacked4x8EXT needs. Two interleave steps; masking so each shift lands
// whole bytes, and the second step joins the low/high halves. 24 integer ops
// for 16 MACs' worth of weights.
void w8_col4(uint w0, uint w1, uint w2, uint w3, out int c0, out int c1,
             out int c2, out int c3) {
    // Step 1: pair rows (k0,k1) and (k2,k3), splitting even/odd columns.
    // a0/a2 keep columns 0 and 2, a1/a3 keep columns 1 and 3.
    uint a0 = (w0 & 0x00FF00FFu) | ((w1 & 0x00FF00FFu) << 8);
    uint a1 = ((w0 >> 8) & 0x00FF00FFu) | (((w1 >> 8) & 0x00FF00FFu) << 8);
    uint a2 = (w2 & 0x00FF00FFu) | ((w3 & 0x00FF00FFu) << 8);
    uint a3 = ((w2 >> 8) & 0x00FF00FFu) | (((w3 >> 8) & 0x00FF00FFu) << 8);
    // Step 2: join the k pairs into the four whole k of each column.
    c0 = int((a0 & 0x0000FFFFu) | ((a2 & 0x0000FFFFu) << 16));
    c1 = int((a1 & 0x0000FFFFu) | ((a3 & 0x0000FFFFu) << 16));
    c2 = int((a0 >> 16) | (a2 & 0xFFFF0000u));
    c3 = int((a1 >> 16) | (a3 & 0xFFFF0000u));
}

// One A word (four consecutive k) dotted against four columns' words. The
// weight words must already be k-tetrads, which is true by construction in
// the [N, K] path and after w8_col4 in the [K, N] one. Returns int32, not
// float: the sum of a lane's dots stays exact in the integer domain and is
// converted ONCE on the way out, which is both cheaper (no per-dot int->float
// convert) and the reason the K bound in the header is meaningful.
ivec4 dp4a_cols(int aw, int c0, int c1, int c2, int c3) {
    return ivec4(dotPacked4x8EXT(aw, c0), dotPacked4x8EXT(aw, c1),
                 dotPacked4x8EXT(aw, c2), dotPacked4x8EXT(aw, c3));
}

void matmul16_w8a8_dp4a() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int n = row / uPC.M;
    // A is int8 too, so its element index is a byte index and four of them are
    // one word. K % 4 == 0 (host gate) keeps a_off a whole word and every k
    // tetrad inside one load.
    int a_off = row * uPC.K;
    // scale_a, the activation's per-tensor quant scale. See the header: the
    // host carries it in epi_scale, which is 1.0 unless it is set.
    float a_mul = uPC.epi_scale;

    // The K slice each lane owns. Rounded up to a whole number of k tetrads so
    // every lane's range starts and ends on a word boundary: a lane that began
    // mid-tetrad could not form a packed operand without reading its
    // neighbour's k. The stride is the rounded chunk, so the slices still tile
    // [0, K) with no double count; the last one is clipped by kend.
    int chunk = ((uPC.K + n_slice - 1) / n_slice + 3) & ~3;
    ivec4 s = ivec4(0);

    if (uPC.transB != 0) {
        // [N, K]: K-contiguous lane mapping (slice = lane % n_slice,
        // quad = lane / n_slice). Consecutive lanes walk consecutive k, which
        // is what the layout packs contiguously -- the same reasoning as
        // matmul16_w8_ksplit_transb.
        int quad = lane / n_slice;
        int slice = lane % n_slice;
        int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
        if (ja >= uPC.N) {
            ks_store_flat_at(vec4(s), row, ja, quad, slice);
            return;
        }
        int b_c0 = bmap(n) * uPC.K * uPC.N + ja * uPC.K;
        int k0 = slice * chunk;
        int kend = min(k0 + chunk, uPC.K);
        for (int k = k0; k < kend; k += 4) {
            // Four columns x one k tetrad = four words, four dots. No
            // transposition: [N, K] already stores the tetrad contiguously.
            int aw = int(uInputA.data[(a_off + k) >> 2]);
            s += dp4a_cols(
                aw, int(uInputB.data[(b_c0 + k) >> 2]),
                int(uInputB.data[(b_c0 + uPC.K + k) >> 2]),
                int(uInputB.data[(b_c0 + 2 * uPC.K + k) >> 2]),
                int(uInputB.data[(b_c0 + 3 * uPC.K + k) >> 2]));
        }
        ks_store_flat_at(vec4(s) * a_mul, row, ja, quad, slice);
        return;
    }

    // [K, N]: quad = lane % q, slice = lane / q -- the column-quad mapping the
    // non-transB sibling uses, so a warp's lanes read one contiguous
    // q*4-byte run per k row. Each lane owns four columns and gathers their k
    // tetrads with w8_col4.
    int quad = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    if (ja >= uPC.N) {
        ks_store_flat(s, row, ja);
        return;
    }
    int b_row = bmap(n) * uPC.K * uPC.N + ja;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    for (int k = k0; k < kend; k += 4) {
        // One word per k, four adjacent columns in each: transpose the 4x4
        // byte block into four per-column k tetrads, then four dots.
        uint w0 = uInputB.data[(b_row + (k + 0) * uPC.N) >> 2];
        uint w1 = uInputB.data[(b_row + (k + 1) * uPC.N) >> 2];
        uint w2 = uInputB.data[(b_row + (k + 2) * uPC.N) >> 2];
        uint w3 = uInputB.data[(b_row + (k + 3) * uPC.N) >> 2];
        int c0, c1, c2, c3;
        w8_col4(w0, w1, w2, w3, c0, c1, c2, c3);
        int aw = int(uInputA.data[(a_off + k) >> 2]);
        s += dp4a_cols(aw, c0, c1, c2, c3);
    }
    ks_store_flat(vec4(s) * a_mul, row, ja);
}
#endif  // DP4A

// 4-bit weight-only, B is [batch, K, N], N % 8 == 0: decode slicing over K, but
// the units are whole scale GROUPS, not single k steps — a lane that stopped
// mid-group would have to remember which group its partial belongs to. With
// K = ngroups * group the workgroup's 16 lanes take ceil(ngroups/16) groups
// each, so a small ngroups leaves lanes idle (they still publish their zero).
// Each lane's partial is already dequantized, so ks_store just adds them.
void matmul16_w4_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int ja = (int(gl_WorkGroupID.x) * 16 + int(gl_LocalInvocationID.x)) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = bmap(n) * uPC.K * uPC.N + ja;
    int nib = ja & 7;

    int ngroups = uPC.K / uPC.group;
    int gps = (ngroups + KS - 1) / KS;
    int g0 = int(gl_LocalInvocationID.y) * gps;
    int gend = min(g0 + gps, ngroups);
    vec4 s = vec4(0.0);
    if (ja < uPC.N) {
        for (int g = g0; g < gend; ++g) {
            vec4 acc = vec4(0.0);
            int kend = (g + 1) * uPC.group;
            for (int k = g * uPC.group; k < kend; k += 2) {
                vec4 w0 = unpack_w4(uInputB.data[(b_row + k * uPC.N) >> 3], nib);
                vec4 w1 =
                    unpack_w4(uInputB.data[(b_row + (k + 1) * uPC.N) >> 3], nib);
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                acc += a.x * w0 + a.y * w1;
            }
            s += acc * scale4(g * uPC.N + ja);
        }
    }
    ks_store(s, row, ja);
}

// fp16 weight, B is [batch, K, N], N % 4 == 0: a quad is two half2 words per K
// row instead of one int8 word. Flat split-K layout (quad = lane % ksplit_q,
// slice = lane / ksplit_q) shared with the int8 kernel so the host's
// occupancy knob is live here too; folding goes through ks_flat.
void matmul16_ksplit() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int quad = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + quad) * 4;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_row = bmap(n) * uPC.K * uPC.N + ja;

    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s = vec4(0.0);
    if (ja < uPC.N) {
        // Eight k's per trip, matching the int8 ksplit kernel below: all 16 of
        // the trip's B words (8 rows x the row's 2 fp16 words) are issued
        // before any is consumed. The former 2-at-a-time trip kept only 4
        // uints in flight per lane and stalled on DRAM latency -- measured on
        // Qwen3-2B fp16 decode shapes (Radeon Pro 560X) it held lm_head at
        // 37.8 GB/s and the N=2048 projections at 13.5-19.7 GB/s. Addresses
        // within a trip are independent (K rows are N*2 bytes apart), so this
        // is pure memory-level parallelism with identical arithmetic.
        int k = k0;
        for (; k + 7 < kend; k += 8) {
            int bw0 = (b_row + (k + 0) * uPC.N) >> 1;
            int bw1 = (b_row + (k + 1) * uPC.N) >> 1;
            int bw2 = (b_row + (k + 2) * uPC.N) >> 1;
            int bw3 = (b_row + (k + 3) * uPC.N) >> 1;
            int bw4 = (b_row + (k + 4) * uPC.N) >> 1;
            int bw5 = (b_row + (k + 5) * uPC.N) >> 1;
            int bw6 = (b_row + (k + 6) * uPC.N) >> 1;
            int bw7 = (b_row + (k + 7) * uPC.N) >> 1;
            vec2 a0 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a1 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            vec2 a2 = unpackHalf2x16(uInputA.data[(a_off + k + 4) >> 1]);
            vec2 a3 = unpackHalf2x16(uInputA.data[(a_off + k + 6) >> 1]);
            s += a0.x * vec4(unpackB2(uInputB.data[bw0]),
                             unpackB2(uInputB.data[bw0 + 1])) +
                 a0.y * vec4(unpackB2(uInputB.data[bw1]),
                             unpackB2(uInputB.data[bw1 + 1])) +
                 a1.x * vec4(unpackB2(uInputB.data[bw2]),
                             unpackB2(uInputB.data[bw2 + 1])) +
                 a1.y * vec4(unpackB2(uInputB.data[bw3]),
                             unpackB2(uInputB.data[bw3 + 1])) +
                 a2.x * vec4(unpackB2(uInputB.data[bw4]),
                             unpackB2(uInputB.data[bw4 + 1])) +
                 a2.y * vec4(unpackB2(uInputB.data[bw5]),
                             unpackB2(uInputB.data[bw5 + 1])) +
                 a3.x * vec4(unpackB2(uInputB.data[bw6]),
                             unpackB2(uInputB.data[bw6 + 1])) +
                 a3.y * vec4(unpackB2(uInputB.data[bw7]),
                             unpackB2(uInputB.data[bw7 + 1]));
        }
        for (; k + 1 < kend; k += 2) {
            int bw = (b_row + k * uPC.N) >> 1;
            vec4 w0 = vec4(unpackB2(uInputB.data[bw]),
                           unpackB2(uInputB.data[bw + 1]));
            vec4 w1 = vec4(unpackB2(uInputB.data[bw + uPC.N / 2]),
                           unpackB2(uInputB.data[bw + uPC.N / 2 + 1]));
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s += a.x * w0 + a.y * w1;
        }
    }
    ks_store_flat(s, row, ja);
}

// fp16 wide-load split-K GEMV, N % 8 == 0 (host-checked). Same lane budget as
// the quad kernel but each lane owns eight CONTIGUOUS columns: one uvec4
// weight load per k instead of two word loads, twice the bytes per issued
// load at half the load count, and two independent vec4 accumulator chains so
// the extra bytes stay independent FMAs. Block layout:
//   oct   = lane % ksplit_q      (which 8-column group this lane owns)
//   slice = lane / ksplit_q      (which slice of K it accumulates)
// so a block covers ksplit_q * 8 columns and 256 / ksplit_q K slices.
#ifdef W8_WIDE
// The -DW8_WIDE module's one entry reaches both this store (the int4 WIDE
// GEMV) and ks_store_wide_w8, and Metal sums every threadgroup array the entry
// can reach: separate arrays were 16 + 32 KB at 512 lanes, over Apple's 32 KB,
// so MoltenVK refused the -DKSPLIT512 build. A dispatch runs only one of the
// two kernels, so they share the int8 scratch (4 * KS_LANES >= 2 * KS_LANES).
shared vec4 ks_w_w8[4 * KS_LANES];
#define ks_w ks_w_w8
#else
shared vec4 ks_w[2 * KS_LANES];
#endif

void ks_store_wide(vec4 s0, vec4 s1, int row, int c) {
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int oct = lane % q;
    int slice = lane / q;
    ks_w[slice * q + oct] = s0;
    ks_w[KS_LANES + slice * q + oct] = s1;
    barrier();
    if (lane >= q) return;
    vec4 v0 = ks_w[oct];
    vec4 v1 = ks_w[KS_LANES + oct];
    for (int t = 1; t < n_slice; ++t) {
        v0 += ks_w[t * q + oct];
        v1 += ks_w[KS_LANES + t * q + oct];
    }
    if (c >= uPC.N) return;
    if (uPC.wide == 2) {
        // SwiGLU gate/up fold: B interleaves Wg and Wu four columns at a time,
        // so this lane's octet is gate columns c/2 .. c/2+3 (v0) and the same
        // up columns (v1). The output is [rows, N/2].
        vec4 h = v0 / (1.0 + exp(-v0)) * v1;
        int o = row * (uPC.N >> 1) + (c >> 1);
        uOutput.data[o >> 1] = packHalf2x16(h.xy);
        uOutput.data[(o >> 1) + 1] = packHalf2x16(h.zw);
        return;
    }
    int out_idx = row * uPC.N + c;
    uOutput.data[out_idx >> 1] = packHalf2x16(v0.xy);
    uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v0.zw);
    uOutput.data[(out_idx + 4) >> 1] = packHalf2x16(v1.xy);
    uOutput.data[(out_idx + 6) >> 1] = packHalf2x16(v1.zw);
}

// int4 weight-only WIDE GEMV: eight columns per lane, one uint32 per k.
//
// The nibble packing makes this the natural density for a 4-bit weight: one
// uint32 holds eight int4 values of the SAME k across eight ADJACENT columns
// (weight_stream._pack_nibbles packs along the column axis, and
// matmul16_w4_ksplit's `b_row + k * N` addressing confirms it). That is
// exactly the octet this kernel already owns per lane, so the whole 4-bit
// weight load is a single 32-bit word instead of the 16-byte uvec4 an fp16
// weight needs -- four times fewer bytes for the same eight columns.
//
// Why this exists: the shipped 4-bit route is matmul16_w4_ksplit, which the
// selector reaches through the plain ksplit entry (that module is the only one
// whose main() tests uPC.w4). It runs 4 columns per lane over 2 k at a time.
// Instruction counts measured from the compiled SPIR-V put it at 8.00 ops/MAC
// against 4.30 for this 8-column, 8-deep shape -- a 46% cut available without
// changing the payload layout, the activation dtype, or the converter.
//
// The nibble order within the word is low-first and column-ascending, which is
// what w4_val / w4_at(word, e) decode: e == 0 is the lowest column of the octet.
// ks_store_wide (eight columns, no column scale) is reused; the per-group
// scale is applied where the group boundary falls, see the two loops.
// The K walk of matmul16_w4_ksplit_wide over this lane's groups, with the
// nibble decoder as a parameter. The kernel passes w4_lutv (the workgroup's
// decoded 16-entry table, see w4_lut) for every format -- never w4_at. A w4_at
// expansion (which served nf4 / uint4 / nvfp4 before) kept its uniform format
// tests inside the loop on Metal, three per nibble and eight nibbles per word:
// nf4 ran 2048x59264 at 0.58 ms (105 GB/s) against int4's 0.16 ms, and
// GLM-Edge-1.5B nf4 decoded at 18.3 ms/token vs fp16's 12.7.
// Eight k's per trip, the shape the int8 WIDE GEMV uses: the two-at-a-time form
// kept only two loads in flight per lane and stalled on DRAM latency. The group
// boundary bounds the trip -- a scale covers `uPC.group` consecutive k, so the
// accumulators are flushed and scaled once per group; group is even
// (host-checked) and the tail loop takes the last few k of each group. DEC(w, e)
// is column e of the lane's octet (low nibble first, column-ascending), so the
// four low columns feed acc and the four high ones acc2. Two scale quads, not
// one: a column's group scale is its own, and reusing the ja..ja+3 quad for the
// upper half is silently wrong whenever the two differ.
#define W4_WIDE_GROUPS(DEC) \
        for (int g = k0 / group; g < ngroups && g * group < kend; ++g) {      \
            int gk0 = max(k0, g * group);                                     \
            int gk1 = min(kend, (g + 1) * group);                             \
            vec4 acc = vec4(0.0);                                             \
            vec4 acc2 = vec4(0.0);                                            \
            int k = gk0;                                                      \
            for (; k + 7 < gk1; k += 8) {                                     \
                uint w0 = uInputB.data[(b_base + (k + 0) * uPC.N) >> 3];      \
                uint w1 = uInputB.data[(b_base + (k + 1) * uPC.N) >> 3];      \
                uint w2 = uInputB.data[(b_base + (k + 2) * uPC.N) >> 3];      \
                uint w3 = uInputB.data[(b_base + (k + 3) * uPC.N) >> 3];      \
                uint w4 = uInputB.data[(b_base + (k + 4) * uPC.N) >> 3];      \
                uint w5 = uInputB.data[(b_base + (k + 5) * uPC.N) >> 3];      \
                uint w6 = uInputB.data[(b_base + (k + 6) * uPC.N) >> 3];      \
                uint w7 = uInputB.data[(b_base + (k + 7) * uPC.N) >> 3];      \
                vec2 a0 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);     \
                vec2 a1 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]); \
                vec2 a2 = unpackHalf2x16(uInputA.data[(a_off + k + 4) >> 1]); \
                vec2 a3 = unpackHalf2x16(uInputA.data[(a_off + k + 6) >> 1]); \
                acc += a0.x * vec4(DEC(w0, 0), DEC(w0, 1), DEC(w0, 2),        \
                                   DEC(w0, 3)) +                              \
                       a0.y * vec4(DEC(w1, 0), DEC(w1, 1), DEC(w1, 2),        \
                                   DEC(w1, 3)) +                              \
                       a1.x * vec4(DEC(w2, 0), DEC(w2, 1), DEC(w2, 2),        \
                                   DEC(w2, 3)) +                              \
                       a1.y * vec4(DEC(w3, 0), DEC(w3, 1), DEC(w3, 2),        \
                                   DEC(w3, 3)) +                              \
                       a2.x * vec4(DEC(w4, 0), DEC(w4, 1), DEC(w4, 2),        \
                                   DEC(w4, 3)) +                              \
                       a2.y * vec4(DEC(w5, 0), DEC(w5, 1), DEC(w5, 2),        \
                                   DEC(w5, 3)) +                              \
                       a3.x * vec4(DEC(w6, 0), DEC(w6, 1), DEC(w6, 2),        \
                                   DEC(w6, 3)) +                              \
                       a3.y * vec4(DEC(w7, 0), DEC(w7, 1), DEC(w7, 2),        \
                                   DEC(w7, 3));                               \
                acc2 += a0.x * vec4(DEC(w0, 4), DEC(w0, 5), DEC(w0, 6),       \
                                    DEC(w0, 7)) +                             \
                        a0.y * vec4(DEC(w1, 4), DEC(w1, 5), DEC(w1, 6),       \
                                    DEC(w1, 7)) +                             \
                        a1.x * vec4(DEC(w2, 4), DEC(w2, 5), DEC(w2, 6),       \
                                    DEC(w2, 7)) +                             \
                        a1.y * vec4(DEC(w3, 4), DEC(w3, 5), DEC(w3, 6),       \
                                    DEC(w3, 7)) +                             \
                        a2.x * vec4(DEC(w4, 4), DEC(w4, 5), DEC(w4, 6),       \
                                    DEC(w4, 7)) +                             \
                        a2.y * vec4(DEC(w5, 4), DEC(w5, 5), DEC(w5, 6),       \
                                    DEC(w5, 7)) +                             \
                        a3.x * vec4(DEC(w6, 4), DEC(w6, 5), DEC(w6, 6),       \
                                    DEC(w6, 7)) +                             \
                        a3.y * vec4(DEC(w7, 4), DEC(w7, 5), DEC(w7, 6),       \
                                    DEC(w7, 7));                              \
            }                                                                 \
            for (; k < gk1; ++k) {                                            \
                uint w = uInputB.data[(b_base + k * uPC.N) >> 3];             \
                float a = load_a(a_off + k);                                  \
                acc += a * vec4(DEC(w, 0), DEC(w, 1), DEC(w, 2),              \
                                DEC(w, 3));                                   \
                acc2 += a * vec4(DEC(w, 4), DEC(w, 5), DEC(w, 6),             \
                                 DEC(w, 7));                                  \
            }                                                                 \
            s0 += acc * scale4(g * uPC.N + ja);                               \
            s1 += acc2 * scale4(g * uPC.N + ja + 4);                          \
        }

// The 16 values a nibble decodes to under this dispatch's format (int4 -8..7,
// uint4 0..15, the nf4 codebook, or E2M1), staged once per workgroup by
// matmul16_w4_ksplit_wide from w4_at itself, so the table is bit-identical to
// the per-format decoders. One expansion of the WIDE group walk then serves
// every 4-bit format, with no format test inside the K loop at all.
//
// Shared memory rather than the decoders' own constant tables: with those
// (one W4_WIDE_GROUPS expansion per format) the large shapes matched int4, but
// a latency-bound small N did not -- M5 Max K=2048 N=512 nf4 / uint4 / nvfp4
// 0.032-0.034 ms vs int4 0.011-0.016 ms; through this table 0.010-0.016. It
// also beats int4's own bitfieldExtract + convert: K=2048 N=12288 0.034 ->
// 0.027 ms, N=59264 0.163 -> 0.155 ms.
shared float w4_lut[16];
float w4_lutv(uint word, int e) { return w4_lut[(word >> uint(e * 4)) & 15u]; }

void matmul16_w4_ksplit_wide() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    // Before any lane can leave (the ja >= N octets still reach ks_store_wide's
    // barrier, so this one is in uniform control flow too).
    if (lane < 16) w4_lut[lane] = w4_at(uint(lane), 0);
    barrier();
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int oct = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + oct) * 8;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N + ja;

    // A group's scale covers `uPC.group` consecutive k of one column, so the K
    // walk accumulates per group and scales once at its boundary -- the same
    // shape as matmul16_w4_ksplit's outer loop. Group is even (host-checked),
    // so a two-deep trip never straddles a group.
    int group = uPC.group;
    int ngroups = (uPC.K + group - 1) / group;
    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s0 = vec4(0.0);  // cols ja .. ja+3
    vec4 s1 = vec4(0.0);  // cols ja+4 .. ja+7
    if (ja < uPC.N) {
        W4_WIDE_GROUPS(w4_lutv)
    }
    ks_store_wide(s0, s1, row, ja);
}

void matmul16_ksplit_wide() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int oct = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + oct) * 8;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N + ja;

    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s0 = vec4(0.0);
    vec4 s1 = vec4(0.0);
    // An octet past the last column reads nothing; ks_store_wide still
    // publishes its zeros so the fold never sees an uninitialized slot.
    if (ja < uPC.N) {
        // Eight k's per trip: eight uvec4 weights (128 weight bytes per lane)
        // plus the trip's four A words all in flight together. One uvec4 = the
        // lane's whole k-row slice, so each weight load feeds BOTH chains.
        int k = k0;
        for (; k + 7 < kend; k += 8) {
            uvec4 w0 = uInputB4.data4[(b_base + (k + 0) * uPC.N) >> 3];
            uvec4 w1 = uInputB4.data4[(b_base + (k + 1) * uPC.N) >> 3];
            uvec4 w2 = uInputB4.data4[(b_base + (k + 2) * uPC.N) >> 3];
            uvec4 w3 = uInputB4.data4[(b_base + (k + 3) * uPC.N) >> 3];
            uvec4 w4 = uInputB4.data4[(b_base + (k + 4) * uPC.N) >> 3];
            uvec4 w5 = uInputB4.data4[(b_base + (k + 5) * uPC.N) >> 3];
            uvec4 w6 = uInputB4.data4[(b_base + (k + 6) * uPC.N) >> 3];
            uvec4 w7 = uInputB4.data4[(b_base + (k + 7) * uPC.N) >> 3];
            vec2 a0 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a1 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            vec2 a2 = unpackHalf2x16(uInputA.data[(a_off + k + 4) >> 1]);
            vec2 a3 = unpackHalf2x16(uInputA.data[(a_off + k + 6) >> 1]);
            s0 += a0.x * vec4(unpackB2(w0.x), unpackB2(w0.y)) +
                  a0.y * vec4(unpackB2(w1.x), unpackB2(w1.y)) +
                  a1.x * vec4(unpackB2(w2.x), unpackB2(w2.y)) +
                  a1.y * vec4(unpackB2(w3.x), unpackB2(w3.y)) +
                  a2.x * vec4(unpackB2(w4.x), unpackB2(w4.y)) +
                  a2.y * vec4(unpackB2(w5.x), unpackB2(w5.y)) +
                  a3.x * vec4(unpackB2(w6.x), unpackB2(w6.y)) +
                  a3.y * vec4(unpackB2(w7.x), unpackB2(w7.y));
            s1 += a0.x * vec4(unpackB2(w0.z), unpackB2(w0.w)) +
                  a0.y * vec4(unpackB2(w1.z), unpackB2(w1.w)) +
                  a1.x * vec4(unpackB2(w2.z), unpackB2(w2.w)) +
                  a1.y * vec4(unpackB2(w3.z), unpackB2(w3.w)) +
                  a2.x * vec4(unpackB2(w4.z), unpackB2(w4.w)) +
                  a2.y * vec4(unpackB2(w5.z), unpackB2(w5.w)) +
                  a3.x * vec4(unpackB2(w6.z), unpackB2(w6.w)) +
                  a3.y * vec4(unpackB2(w7.z), unpackB2(w7.w));
        }
        for (; k + 1 < kend; k += 2) {
            uvec4 w0 = uInputB4.data4[(b_base + k * uPC.N) >> 3];
            uvec4 w1 = uInputB4.data4[(b_base + (k + 1) * uPC.N) >> 3];
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s0 += a.x * vec4(unpackB2(w0.x), unpackB2(w0.y)) +
                  a.y * vec4(unpackB2(w1.x), unpackB2(w1.y));
            s1 += a.x * vec4(unpackB2(w0.z), unpackB2(w0.w)) +
                  a.y * vec4(unpackB2(w1.z), unpackB2(w1.w));
        }
    }
    ks_store_wide(s0, s1, row, ja);
}

// int8 weight-only WIDE GEMV: each lane owns SIXTEEN contiguous columns and
// loads one uvec4 (16 bytes = 16 int8 columns) per k -- twice the column
// density of the fp16 WIDE kernel, because a byte is half a fp16. Four vec4
// accumulator chains keep the 16 columns independent (one vec4 per 4 cols):
//   s0 = cols [ja .. ja+3]    (w.x low..high)
//   s1 = cols [ja+4 .. ja+7]  (w.y)
//   s2 = cols [ja+8 .. ja+11] (w.z)
//   s3 = cols [ja+12 .. ja+15](w.w)
// The host picks this only when N % 16 == 0 and dispatches UP_DIV(n/16, q)
// blocks. ks_store_wide_w8 applies the per-column int8 scale before packing.
#ifndef W8_WIDE  // declared next to ks_w in that build
shared vec4 ks_w_w8[4 * KS_LANES];
#endif

void ks_store_wide_w8(vec4 s0, vec4 s1, vec4 s2, vec4 s3, int row, int c) {
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int oct = lane % q;
    int slice = lane / q;
    int base = slice * q + oct;
    ks_w_w8[base] = s0;
    ks_w_w8[KS_LANES + base] = s1;
    ks_w_w8[2 * KS_LANES + base] = s2;
    ks_w_w8[3 * KS_LANES + base] = s3;
    barrier();
    if (lane >= q) return;
    vec4 v0 = ks_w_w8[oct];
    vec4 v1 = ks_w_w8[KS_LANES + oct];
    vec4 v2 = ks_w_w8[2 * KS_LANES + oct];
    vec4 v3 = ks_w_w8[3 * KS_LANES + oct];
    for (int t = 1; t < n_slice; ++t) {
        v0 += ks_w_w8[t * q + oct];
        v1 += ks_w_w8[KS_LANES + t * q + oct];
        v2 += ks_w_w8[2 * KS_LANES + t * q + oct];
        v3 += ks_w_w8[3 * KS_LANES + t * q + oct];
    }
    if (c >= uPC.N) return;
    // Per-column int8 dequant scale, applied after the K-reduction (scales
    // distribute over the sum). Each vec4 owns 4 consecutive columns.
    v0 *= vec4(uintBitsToFloat(uScale.data[c]),
               uintBitsToFloat(uScale.data[c + 1]),
               uintBitsToFloat(uScale.data[c + 2]),
               uintBitsToFloat(uScale.data[c + 3]));
    if (c + 7 < uPC.N)
        v1 *= vec4(uintBitsToFloat(uScale.data[c + 4]),
                   uintBitsToFloat(uScale.data[c + 5]),
                   uintBitsToFloat(uScale.data[c + 6]),
                   uintBitsToFloat(uScale.data[c + 7]));
    if (c + 11 < uPC.N)
        v2 *= vec4(uintBitsToFloat(uScale.data[c + 8]),
                   uintBitsToFloat(uScale.data[c + 9]),
                   uintBitsToFloat(uScale.data[c + 10]),
                   uintBitsToFloat(uScale.data[c + 11]));
    if (c + 15 < uPC.N)
        v3 *= vec4(uintBitsToFloat(uScale.data[c + 12]),
                   uintBitsToFloat(uScale.data[c + 13]),
                   uintBitsToFloat(uScale.data[c + 14]),
                   uintBitsToFloat(uScale.data[c + 15]));
    int out_idx = row * uPC.N + c;
    uOutput.data[out_idx >> 1] = packHalf2x16(v0.xy);
    if (c + 3 < uPC.N) uOutput.data[(out_idx + 2) >> 1] = packHalf2x16(v0.zw);
    if (c + 5 < uPC.N) uOutput.data[(out_idx + 4) >> 1] = packHalf2x16(v1.xy);
    if (c + 7 < uPC.N) uOutput.data[(out_idx + 6) >> 1] = packHalf2x16(v1.zw);
    if (c + 9 < uPC.N) uOutput.data[(out_idx + 8) >> 1] = packHalf2x16(v2.xy);
    if (c + 11 < uPC.N) uOutput.data[(out_idx + 10) >> 1] = packHalf2x16(v2.zw);
    if (c + 13 < uPC.N) uOutput.data[(out_idx + 12) >> 1] = packHalf2x16(v3.xy);
    if (c + 15 < uPC.N) uOutput.data[(out_idx + 14) >> 1] = packHalf2x16(v3.zw);
}

// Reached only from the -DW8_WIDE module build's entry at the end of this file;
// the general fp16 module never calls it, so SPIR-V DCE drops it there and
// MoltenVK never sees it.
void matmul16_w8_ksplit_wide() {
    int row = int(gl_WorkGroupID.y);
    if (row >= uPC.batch * uPC.M) return;
    int lane = int(gl_LocalInvocationID.y) * KSG + int(gl_LocalInvocationID.x);
    int q = uPC.ksplit_q;
    int n_slice = KS_LANES / q;
    int oct = lane % q;
    int ja = (int(gl_WorkGroupID.x) * q + oct) * 16;
    int n = row / uPC.M;
    int a_off = row * uPC.K;
    int b_base = bmap(n) * uPC.K * uPC.N + ja;

    int chunk = ((uPC.K + n_slice - 1) / n_slice + 1) & ~1;
    int slice = lane / q;
    int k0 = slice * chunk;
    int kend = min(k0 + chunk, uPC.K);
    vec4 s0 = vec4(0.0);  // cols ja .. ja+3
    vec4 s1 = vec4(0.0);  // cols ja+4 .. ja+7
    vec4 s2 = vec4(0.0);  // cols ja+8 .. ja+11
    vec4 s3 = vec4(0.0);  // cols ja+12 .. ja+15
    // A 16-column group past the last column reads nothing; ks_store_wide_w8
    // still publishes its zeros so the fold never sees an uninitialized slot.
    if (ja < uPC.N) {
        // Eight k's per trip: eight uvec4 weight loads (128 weight bytes per
        // lane) plus the trip's four A words all in flight together. Each
        // uvec4 is the lane's whole 16-column k-row, feeding all four chains.
        int k = k0;
        for (; k + 7 < kend; k += 8) {
            uvec4 w0 = uInputB4.data4[(b_base + (k + 0) * uPC.N) >> 4];
            uvec4 w1 = uInputB4.data4[(b_base + (k + 1) * uPC.N) >> 4];
            uvec4 w2 = uInputB4.data4[(b_base + (k + 2) * uPC.N) >> 4];
            uvec4 w3 = uInputB4.data4[(b_base + (k + 3) * uPC.N) >> 4];
            uvec4 w4 = uInputB4.data4[(b_base + (k + 4) * uPC.N) >> 4];
            uvec4 w5 = uInputB4.data4[(b_base + (k + 5) * uPC.N) >> 4];
            uvec4 w6 = uInputB4.data4[(b_base + (k + 6) * uPC.N) >> 4];
            uvec4 w7 = uInputB4.data4[(b_base + (k + 7) * uPC.N) >> 4];
            vec2 a0 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a1 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            vec2 a2 = unpackHalf2x16(uInputA.data[(a_off + k + 4) >> 1]);
            vec2 a3 = unpackHalf2x16(uInputA.data[(a_off + k + 6) >> 1]);
            s0 += a0.x * unpack_w8(w0.x) + a0.y * unpack_w8(w1.x) +
                  a1.x * unpack_w8(w2.x) + a1.y * unpack_w8(w3.x) +
                  a2.x * unpack_w8(w4.x) + a2.y * unpack_w8(w5.x) +
                  a3.x * unpack_w8(w6.x) + a3.y * unpack_w8(w7.x);
            s1 += a0.x * unpack_w8(w0.y) + a0.y * unpack_w8(w1.y) +
                  a1.x * unpack_w8(w2.y) + a1.y * unpack_w8(w3.y) +
                  a2.x * unpack_w8(w4.y) + a2.y * unpack_w8(w5.y) +
                  a3.x * unpack_w8(w6.y) + a3.y * unpack_w8(w7.y);
            s2 += a0.x * unpack_w8(w0.z) + a0.y * unpack_w8(w1.z) +
                  a1.x * unpack_w8(w2.z) + a1.y * unpack_w8(w3.z) +
                  a2.x * unpack_w8(w4.z) + a2.y * unpack_w8(w5.z) +
                  a3.x * unpack_w8(w6.z) + a3.y * unpack_w8(w7.z);
            s3 += a0.x * unpack_w8(w0.w) + a0.y * unpack_w8(w1.w) +
                  a1.x * unpack_w8(w2.w) + a1.y * unpack_w8(w3.w) +
                  a2.x * unpack_w8(w4.w) + a2.y * unpack_w8(w5.w) +
                  a3.x * unpack_w8(w6.w) + a3.y * unpack_w8(w7.w);
        }
        for (; k + 1 < kend; k += 2) {
            uvec4 w0 = uInputB4.data4[(b_base + k * uPC.N) >> 4];
            uvec4 w1 = uInputB4.data4[(b_base + (k + 1) * uPC.N) >> 4];
            vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            s0 += a.x * unpack_w8(w0.x) + a.y * unpack_w8(w1.x);
            s1 += a.x * unpack_w8(w0.y) + a.y * unpack_w8(w1.y);
            s2 += a.x * unpack_w8(w0.z) + a.y * unpack_w8(w1.z);
            s3 += a.x * unpack_w8(w0.w) + a.y * unpack_w8(w1.w);
        }
    }
    ks_store_wide_w8(s0, s1, s2, s3, row, ja);
}

// int8 weight-only, even N, two columns per thread: single pass straight into
// the output half2 word, same ownership as the fp16 even-N kernel. Nothing
// about a byte-packed weight touches the OUTPUT alignment (the column pair
// ja, ja+1 is word-aligned because N is even), only how B gets read, so int8
// keeps the fused store instead of paying a second dispatch per GEMM.
// Under transB a weight column is contiguous, so with K % 4 == 0 four taps of a
// column come out of one 32-bit word: one B load per four FMAs.
void matmul16_w8_even_n() {
    int p = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    int b_base = bmap(n) * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // Constant along K, so both column scales leave the loop.
    float wsc0 = uintBitsToFloat(uScale.data[ja]);
    float wsc1 = uintBitsToFloat(uScale.data[jb]);

    float s0 = 0.0, s1 = 0.0;
    // b0 (and therefore every b0 + k) is 4-aligned when K % 4 == 0, because
    // b_base = n*K*N and ja*K are multiples of K then.
    if (uPC.transB != 0 && (uPC.K & 3) == 0) {
        for (int k = 0; k < uPC.K; k += 4) {
            vec4 w0 = unpack_w8(uInputB.data[(b0 + k) >> 2]);
            vec4 w1 = unpack_w8(uInputB.data[(b1 + k) >> 2]);
            vec2 a01 = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
            vec2 a23 = unpackHalf2x16(uInputA.data[(a_off + k + 2) >> 1]);
            s0 += a01.x * w0.x + a01.y * w0.y + a23.x * w0.z + a23.y * w0.w;
            s1 += a01.x * w1.x + a01.y * w1.y + a23.x * w1.z + a23.y * w1.w;
        }
    } else {
        for (int k = 0; k < uPC.K; ++k) {
            float a = load_a(a_off + k);
            s0 += a * load_w8(b0);
            s1 += a * load_w8(b1);
            b0 += b_step;
            b1 += b_step;
        }
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    uOutput.data[out_idx >> 1] = packHalf2x16(vec2(s0 * wsc0, s1 * wsc1));
}

// One thread owns output word (n, i, {ja, ja+1}) of an even-N C. ja is even
// and n*M*N + i*N is even when N is even, so the pair is word-aligned.
void matmul16_even_n() {
    int p = int(gl_GlobalInvocationID.x); // column-pair (= word) index in a row
    int yi = int(gl_GlobalInvocationID.y);
    int ja = p * 2;
    if (ja >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    int jb = ja + 1;
    // transB: B is [batch, N, K] so element (n, col, k) is at col*K + k
    // (k-step 1); otherwise B is [batch, K, N], element (n, k, col) is at
    // k*N + col (k-step N). Hoisting this out of the K loop removes the
    // per-iteration branch and keeps both column walks linear. bmap: A and
    // the output are dispatch-batch-sized; only B's batch shrinks when the
    // host folded a repeat_kv into this MatMul.
    int b_base = bmap(n) * uPC.K * uPC.N;
    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
    int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);

    // K even => a_off, b0 and b1 are even element indices (K even makes every
    // row start word-aligned; under transB the B rows are contiguous too), so
    // each k-pair is one 32-bit word per stream. Four accumulators break the
    // serial FMA dependency chains.
    float s0a = 0.0, s0b = 0.0, s1a = 0.0, s1b = 0.0;
    int k = 0;
    if ((uPC.K & 1) == 0) {
        if (uPC.transB != 0) {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                vec2 v0 = unpackB2(uInputB.data[(b0 + k) >> 1]);
                vec2 v1 = unpackB2(uInputB.data[(b1 + k) >> 1]);
                s0a += a.x * v0.x;
                s0b += a.y * v0.y;
                s1a += a.x * v1.x;
                s1b += a.y * v1.y;
            }
        } else {
            for (; k < uPC.K; k += 2) {
                vec2 a = unpackHalf2x16(uInputA.data[(a_off + k) >> 1]);
                s0a += a.x * load_b(b0);
                s0b += a.y * load_b(b0 + uPC.N);
                s1a += a.x * load_b(b1);
                s1b += a.y * load_b(b1 + uPC.N);
                b0 += 2 * uPC.N;
                b1 += 2 * uPC.N;
            }
        }
    }
    // Odd-K tail: scalar walk (also covers K == 0 -> nothing).
    for (; k < uPC.K; ++k) {
        float a = load_a(a_off + k);
        s0a += a * load_b(b0);
        s1a += a * load_b(b1);
        b0 += b_step;
        b1 += b_step;
    }

    int out_idx = n * uPC.M * uPC.N + i * uPC.N + ja;
    float r0 = s0a + s0b;
    float r1 = s1a + s1b;
    if (uPC.epi_bias != 0) {
        r0 = r0 * uPC.epi_scale + epi_bias_at(n, i, ja);
        r1 = r1 * uPC.epi_scale + epi_bias_at(n, i, ja + 1);
    }
    uOutput.data[out_idx >> 1] = packHalf2x16(vec2(r0, r1));
}

// Fused MatMul + scale/bias epilogue + Softmax for attention QK^T. One
// workgroup reduces one output row (n, i) over all N columns: each lane owns
// a strided set of columns, computes the K-dot for each, applies scale+bias,
// then a two-pass workgroup reduction (max, then sum-of-exp) normalizes the
// row and stores exp(x-max)/sum. Replaces MatMul(QK^T) + FusedElemwise +
// Softmax(reduce+pack) = 4 dispatches with 1. The A row (K values) is staged
// in shared memory once per workgroup.
//
// Constraints (host-checked): N even (half2 store), one workgroup covers a
// full row so N <= SOFTMAX_WG * SOFTMAX_COLS (else the host falls back to the
// unfused path). Decode M is small so batch*M workgroups is a reasonable grid.
#define SOFTMAX_WG 256
#define SOFTMAX_COLS 2   // columns per lane per trip (half2)
shared float sA_row[1024];        // A row staging (K <= 1024; head_dim is 128)
shared float s_red[SOFTMAX_WG];   // reduction scratch
void matmul16_softmax() {
    int yi = int(gl_WorkGroupID.x);   // row index (n*M + i)
    // The pipeline's workgroup is 16x16 = 256 lanes (2D, set at the top of this
    // file); flatten to a 1D lane index so the reduction and strided column
    // ownership below see all 256 lanes.
    int lid = int(gl_LocalInvocationID.y) * 16 + int(gl_LocalInvocationID.x);
    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_off = (n * uPC.M + i) * uPC.K;
    // Stage the A row into shared memory (K values, K <= 1024 for head_dim).
    for (int k = lid; k < uPC.K; k += SOFTMAX_WG) {
        sA_row[k] = load_a(a_off + k);
    }
    barrier();

    int b_base = bmap(n) * uPC.K * uPC.N;
    // Each lane owns column pairs [lid*2, lid*2+1, +SOFTMAX_WG*2, ...].
    // Compute the dot product for this lane's first owned pair, then stride.
    // We need the full row in registers for the softmax passes, but N can be
    // large — so we do online softmax: one pass for max, one for sum, a third
    // for the store, recomputing or caching the dot products. To avoid
    // recomputing the K-dot three times, cache this lane's owned columns in
    // a local array (bounded by SOFTMAX_COLS * ceil(N/SOFTMAX_WG)).
    // MAX_OWNED holds 2 cols per stride trip: 2 * ceil(N / (SOFTMAX_WG*
    // SOFTMAX_COLS)). At N=16384 that is 64, which the host gate enforces
    // (n <= 16384). Larger N would need more registers than fit comfortably
    // in the 16x16 workgroup's file, so the host falls back to the unfused
    // path beyond it. Realistic decode kv_len is well under this.
    const int MAX_OWNED = 64;
    float owned[MAX_OWNED];
    int n_owned = 0;

    int b_step = (uPC.transB != 0) ? 1 : uPC.N;
    for (int ja = lid * SOFTMAX_COLS; ja < uPC.N && n_owned < MAX_OWNED;
         ja += SOFTMAX_WG * SOFTMAX_COLS) {
        float s0 = 0.0, s1 = 0.0;
        int jb = ja + 1;
        int b0 = (uPC.transB != 0) ? (b_base + ja * uPC.K) : (b_base + ja);
        int b1 = (uPC.transB != 0) ? (b_base + jb * uPC.K) : (b_base + jb);
        for (int k = 0; k < uPC.K; ++k) {
            float a = sA_row[k];
            s0 += a * load_b(b0);
            s1 += a * load_b(b1);
            b0 += b_step;
            b1 += b_step;
        }
        if (uPC.epi_bias != 0) {
            s0 = s0 * uPC.epi_scale + epi_bias_at(n, i, ja);
            s1 = s1 * uPC.epi_scale + epi_bias_at(n, i, jb);
        }
        owned[n_owned++] = s0;
        if (jb < uPC.N) {
            owned[n_owned++] = s1;
        }
    }

    // ---- pass 1: row max (online) ----
    float local_max = -1e30f;
    for (int t = 0; t < n_owned; ++t) {
        local_max = max(local_max, owned[t]);
    }
#ifdef SUBGROUP
    VKOP_WG_REDUCE_MAX(s_red, local_max);
#else
    s_red[lid] = local_max;
    barrier();
    for (uint s = SOFTMAX_WG / 2; s > 0; s >>= 1) {
        if (lid < s) {
            s_red[lid] = max(s_red[lid], s_red[lid + s]);
        }
        barrier();
    }
#endif // SUBGROUP
    float row_max = s_red[0];

    // ---- pass 2: sum of exp(x - row_max) ----
    float local_sum = 0.0;
    for (int t = 0; t < n_owned; ++t) {
        local_sum += exp(owned[t] - row_max);
    }
#ifdef SUBGROUP
    VKOP_WG_REDUCE_SUM(s_red, local_sum);
#else
    s_red[lid] = local_sum;
    barrier();
    for (uint s = SOFTMAX_WG / 2; s > 0; s >>= 1) {
        if (lid < s) {
            s_red[lid] += s_red[lid + s];
        }
        barrier();
    }
#endif // SUBGROUP
    float row_sum = s_red[0] + 1e-30f;

    // ---- pass 3: store normalized ----
    int idx = 0;
    for (int ja = lid * SOFTMAX_COLS; ja < uPC.N && idx < n_owned;
         ja += SOFTMAX_WG * SOFTMAX_COLS) {
        float r0 = exp(owned[idx] - row_max) / row_sum;
        idx++;
        if (ja + 1 < uPC.N && idx < n_owned) {
            float r1 = exp(owned[idx] - row_max) / row_sum;
            idx++;
            uOutput.data[(n * uPC.M * uPC.N + i * uPC.N + ja) >> 1] =
                packHalf2x16(vec2(r0, r1));
        } else {
            // odd tail column (N even should avoid this, but be safe)
            uOutput.data[(n * uPC.M * uPC.N + i * uPC.N + ja) >> 1] =
                packHalf2x16(vec2(r0, 0.0));
        }
    }
}

// Tiled GEMM for the compute-bound regime (M big enough that the naive path
// stops being bandwidth-bound). A 16x16 workgroup stages 64x64 A/B tiles in
// shared memory and every thread owns a 4x4 sub-tile, so each global element
// read feeds 4x4 outputs instead of ~2: the naive path re-reads the weight
// rows for every output row, which is what caps it at ~2.7 TFLOP/s.
// Both B layouts are covered; K % TILE_K == 0 keeps every tile word aligned
// and removes all in-loop bounds tests. Grid: x = N/64, y = M/64, z = batch,
// so a block never straddles a batch boundary.
#define TILE_M 64
#define TILE_N 64
#define TILE_K 16
// Words per [tile-row][k-pair] shared row: TILE_K/2 packed halves + 1 pad.
// The pad breaks the 32-bank aliasing a power-of-2 stride causes across the
// 16 lane threads (each thread's 4 columns start 4 words apart).
#define SROW (TILE_K / 2 + 1)
// Words per [k][column-pair] shared row, used when B is [batch, K, N].
#define SBROW (TILE_N / 2)
// Words per [k][column] shared row for the 4-bit loader, which stages fp32
// rather than packed halves (see tile_load_b_w4). Padded by one word for the
// same bank-aliasing reason as SROW. 16 * 65 = 1040 words fits inside the
// 2048 sB already reserves, so the two layouts share storage -- one entry
// point runs per dispatch, so they are never live at the same time.
#define SBROW_F32 (TILE_N + 1)

// glslang only accepts `shared` at global scope; the tiled path is the sole
// user, and the naive paths never touch these.
shared uint sA[TILE_M * SROW];
// Sized for the wider of the stagings: transB keeps [col][k-pair] (9 words per
// row, 64 rows), [batch,K,N] keeps [k][col-pair] (32 words per row, 64 k-rows),
// and the 4-bit loader's fp32 [k][column] needs 16 * 65 = 1040. 2048 words
// covers all three.
shared uint sB[TILE_N * SBROW];

int tile_tid() {
    return int(gl_LocalInvocationID.x) + int(gl_LocalInvocationID.y) * 16;
}

// A tile: 64 rows x 8 k-pair words, packed along K. Identical for both B
// layouts, and always coalesced (consecutive threads walk one row).
//
// 64 rows x 8 words = 512 words to stage with 256 threads, so every thread
// takes TWO words: `l = tid` covers rows 0..31, `l = tid + 256` rows 32..63.
// Both iterations are unconditional -- an unrolled `for (t = 0; t < 2)` with a
// tid-derived index is not, because the compiler cannot prove the guard is
// false for half the threads and the two-iteration form is exactly what let
// this read as a 512-thread loop next to a 256-thread module.
void tile_load_a(int b, int row0, int kw, int halfK) {
    int l = tile_tid();
    int row = l >> 3;
    int kt = l & 7;
    sA[row * SROW + kt] = (row0 + row < uPC.M)
                              ? uInputA.data[(b * uPC.M + row0 + row) *
                                                 halfK + kw + kt]
                              : 0u;
    int row2 = row + 32;
    sA[row2 * SROW + kt] = (row0 + row2 < uPC.M)
                               ? uInputA.data[(b * uPC.M + row0 + row2) *
                                                  halfK + kw + kt]
                               : 0u;
}

// transB: B is [batch, N, K], so a weight column is a contiguous row and the
// tile keeps the same [row][k-pair] packing as A. Same 64x8 staging as A.
void tile_load_b_t(int b, int col0, int kw, int halfK) {
    int l = tile_tid();
    int row = l >> 3;
    int kt = l & 7;
    sB[row * SROW + kt] = (col0 + row < uPC.N)
                              ? stageB2(uInputB.data[(b * uPC.N + col0 + row) *
                                                         halfK + kw + kt])
                              : 0u;
    int row2 = row + 32;
    sB[row2 * SROW + kt] = (col0 + row2 < uPC.N)
                               ? stageB2(uInputB.data[(b * uPC.N + col0 + row2) *
                                                          halfK + kw + kt])
                               : 0u;
}

// Register-staged form of the A and [batch,K,N] B staging. The global words
// land in registers, the FMA nest on the tile already in shared runs while
// they are in flight, and only then are they written out. Storing straight
// from the load makes every warp stall on its own load before it can reach
// the FMA, so the memory pipe sits idle for most of a K tile.
//
// A is still staged by tile_load_a in the other two B layouts, where the word
// count per thread differs and the fetch/store split measured no gain.
void fetch_a(int b, int row0, int kw, int halfK, out uint va0, out uint va1) {
    int l = tile_tid();
    int row = l >> 3;
    int kt = l & 7;
    va0 = (row0 + row < uPC.M)
              ? uInputA.data[(b * uPC.M + row0 + row) * halfK + kw + kt] : 0u;
    int row2 = row + 32;
    va1 = (row0 + row2 < uPC.M)
              ? uInputA.data[(b * uPC.M + row0 + row2) * halfK + kw + kt] : 0u;
}

void store_a(uint va0, uint va1) {
    int l = tile_tid();
    int row = l >> 3;
    int kt = l & 7;
    sA[row * SROW + kt] = va0;
    sA[(row + 32) * SROW + kt] = va1;
}

// B is [batch, K, N]: keep global's [k][column-pair] packing so the copy is a
// straight word-for-word transfer (N even => every column pair is one word).
// 16 k-rows x 32 column-pairs = 512 words with 256 threads: `l = tid` takes
// k-rows 0..7, and k-rows 8..15 come from the same `cp` at l + 256.
void fetch_b_n(int b, int col0, int kk, int halfN, out uint vb0, out uint vb1) {
    int l = tile_tid();
    int kr = l >> 5;
    int cp = l & 31;
    bool ok = (col0 + cp * 2 + 1 < uPC.N);
    vb0 = ok ? uInputB.data[(b * uPC.K + kk + kr) * halfN + (col0 >> 1) + cp] : 0u;
    vb1 = ok ? uInputB.data[(b * uPC.K + kk + kr + 8) * halfN + (col0 >> 1) + cp]
             : 0u;
}

void store_b_n(uint vb0, uint vb1) {
    int l = tile_tid();
    int kr = l >> 5;
    int cp = l & 31;
    sB[kr * SBROW + cp] = stageB2(vb0);
    sB[(kr + 8) * SBROW + cp] = stageB2(vb1);
}

// Byte-quantized weight, B is [batch, K, N] (the only layout a quantizer can
// emit). One thread stages the four columns of one K row that a single 32-bit
// weight word holds, decodes them, and writes the two half2 words the tile's
// FMA nest already reads -- 256 threads x 2 words exactly cover TILE_K x TILE_N.
// The decode is the whole point: in the column-parallel quad kernel it runs once
// per output element (M*N*K times), here once per weight per 64-row block.
// Nothing about it is approximate: int8 magnitudes are integers up to 128 and
// both fp8 formats sit inside the half range, so the staged tile holds the same
// values the naive kernel accumulates. The column scale is deliberately NOT
// folded in here -- it is constant along K, so the epilogue applies it with one
// multiply per output instead of one per tap.
void tile_load_b_w8(int b, int col0, int kk) {
    int l = tile_tid();
    int kr = l >> 4;        // 16 K rows of the tile
    int quad = l & 15;      // 16 four-column groups = TILE_N columns
    int col = col0 + quad * 4;
    // N % 4 == 0 (host-checked) makes every K row start 4-aligned, so a
    // 4-aligned column always owns its whole byte word.
    vec4 w = vec4(0.0);
    if (col < uPC.N) {
        w = unpack_w8(uInputB.data[((b * uPC.K + kk + kr) * uPC.N + col) >> 2]);
    }
    sB[kr * SBROW + 2 * quad] = (col + 1 < uPC.N) ? packHalf2x16(w.xy) : 0u;
    sB[kr * SBROW + 2 * quad + 1] = (col + 3 < uPC.N) ? packHalf2x16(w.zw) : 0u;
}

// 4-bit weight (int4 / uint4 / nf4 / nvfp4), B is [batch, K, N] nibble-packed.
// Same thread map as tile_load_b_w8: one thread decodes the four columns of
// one K row -- half of one 32-bit word, at nibble 0 or 4. Unlike a byte weight
// the scale changes along K (one row per group), so it cannot wait for the
// epilogue: it is folded in here, giving the tile the value an fp16 checkpoint
// of the dequantized weight would hold. The column-parallel w4 kernel this
// replaces for M > 8 decoded every weight once per output ROW and walked K
// serially per thread, which made an 800-token int4 prefill ~7x slower than
// int8.
//
// The staged value is fp32, NOT the packed half2 tile_load_b_w8 writes. A byte
// weight's codes are integers <= 128 (int8) or values an fp16 holds exactly
// (fp8 e4m3/e5m2), so a half2 tile is lossless for them. A 4-bit weight's
// staged value is `code * group_scale`, and that product has no such property:
// rounding it to half costs ~5e-4 relative PER WEIGHT, and a K-deep dot then
// carries ~sqrt(K) of it. That is small enough to vanish on a plain product
// (the abs floor absorbs it) but not under SwiGLU, where silu's slope around
// g == 0 magnifies a near-zero gate: the same weights through this tile
// reported elements 12-56% off the split-K GEMV, while the GEMV -- which
// accumulates in fp32 and applies the scale after -- was exact.
// Proof, and the regression test: with the group scale snapped to a power of
// two (so `code * 2^n` is exact in fp16) the half2 tile becomes lossless and
// the error disappears, which is what identified the rounding rather than a
// decode or layout defect. Reading the width from the FMA nest's [k][column]
// words means this loader no longer shares tile_fma_n's packing, so it has its
// own SBROW_F32 row stride and the nest that consumes it is tile_fma_n_w4.
void tile_load_b_w4(int b, int col0, int kk) {
    int l = tile_tid();
    int kr = l >> 4;
    int quad = l & 15;
    int col = col0 + quad * 4;
    int k = kk + kr;
    vec4 w = vec4(0.0);
    // N % 8 == 0 (host-checked) puts every K row on a word boundary, so a
    // 4-aligned column owns half a word at a fixed nibble.
    if (col < uPC.N) {
        int idx = (b * uPC.K + k) * uPC.N + col;
        w = unpack_w4(uInputB.data[idx >> 3], idx & 7) *
            scale4((k / uPC.group) * uPC.N + col);
    }
    int row = kr * SBROW_F32;
    sB[row + quad * 4 + 0] = (col + 0 < uPC.N) ? floatBitsToUint(w.x) : 0u;
    sB[row + quad * 4 + 1] = (col + 1 < uPC.N) ? floatBitsToUint(w.y) : 0u;
    sB[row + quad * 4 + 2] = (col + 2 < uPC.N) ? floatBitsToUint(w.z) : 0u;
    sB[row + quad * 4 + 3] = (col + 3 < uPC.N) ? floatBitsToUint(w.w) : 0u;
}

// The 4-bit nest's FMA: same 4x4 register tile and [k][column] staging as
// tile_fma_n, but the staged words are fp32 rather than packed half2, so each
// tap loads four words and unpacks nothing. Kept separate from tile_fma_n
// because the two read different layouts out of the same sB.
void tile_fma_n_w4(inout float acc[4][4], int lr, int lc) {
#pragma unroll
    for (int kt = 0; kt < TILE_K; ++kt) {
        // sA holds two k per word; take the half this kt selects.
        int aw = kt >> 1;
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + aw]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + aw]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + aw]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + aw]);
        bool hi = (kt & 1) != 0;
        float av0 = hi ? a0.y : a0.x;
        float av1 = hi ? a1.y : a1.x;
        float av2 = hi ? a2.y : a2.x;
        float av3 = hi ? a3.y : a3.x;
        int w0 = kt * SBROW_F32 + lc;
        vec4 b = vec4(uintBitsToFloat(sB[w0 + 0]),
                      uintBitsToFloat(sB[w0 + 1]),
                      uintBitsToFloat(sB[w0 + 2]),
                      uintBitsToFloat(sB[w0 + 3]));
        acc[0][0] += av0 * b.x;
        acc[0][1] += av0 * b.y;
        acc[0][2] += av0 * b.z;
        acc[0][3] += av0 * b.w;
        acc[1][0] += av1 * b.x;
        acc[1][1] += av1 * b.y;
        acc[1][2] += av1 * b.z;
        acc[1][3] += av1 * b.w;
        acc[2][0] += av2 * b.x;
        acc[2][1] += av2 * b.y;
        acc[2][2] += av2 * b.z;
        acc[2][3] += av2 * b.w;
        acc[3][0] += av3 * b.x;
        acc[3][1] += av3 * b.y;
        acc[3][2] += av3 * b.z;
        acc[3][3] += av3 * b.w;
    }
}

// One k-pair per thread, transB: a B word carries the two K values of one
// column.
void tile_fma_t(inout float acc[4][4], int lr, int lc) {
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        vec2 b0 = unpackHalf2x16(sB[(lc + 0) * SROW + kt]);
        vec2 b1 = unpackHalf2x16(sB[(lc + 1) * SROW + kt]);
        vec2 b2 = unpackHalf2x16(sB[(lc + 2) * SROW + kt]);
        vec2 b3 = unpackHalf2x16(sB[(lc + 3) * SROW + kt]);
#pragma unroll
        for (int c = 0; c < 4; ++c) {
            vec2 bv = c == 0 ? b0 : (c == 1 ? b1 : (c == 2 ? b2 : b3));
            acc[0][c] += a0.x * bv.x + a0.y * bv.y;
            acc[1][c] += a1.x * bv.x + a1.y * bv.y;
            acc[2][c] += a2.x * bv.x + a2.y * bv.y;
            acc[3][c] += a3.x * bv.x + a3.y * bv.y;
        }
    }
}

// B is [batch, K, N]: a B word carries two adjacent columns at one K, so the
// thread's 4 columns come from 2 words per K.
void tile_fma_n(inout float acc[4][4], int lr, int lc) {
    int cp = lc >> 1;
#pragma unroll
    for (int kt = 0; kt < TILE_K / 2; ++kt) {
        vec2 a0 = unpackHalf2x16(sA[(lr + 0) * SROW + kt]);
        vec2 a1 = unpackHalf2x16(sA[(lr + 1) * SROW + kt]);
        vec2 a2 = unpackHalf2x16(sA[(lr + 2) * SROW + kt]);
        vec2 a3 = unpackHalf2x16(sA[(lr + 3) * SROW + kt]);
        int w0 = (2 * kt) * SBROW + cp;
        int w1 = (2 * kt + 1) * SBROW + cp;
        vec2 p0 = unpackHalf2x16(sB[w0]);
        vec2 p1 = unpackHalf2x16(sB[w0 + 1]);
        vec2 q0 = unpackHalf2x16(sB[w1]);
        vec2 q1 = unpackHalf2x16(sB[w1 + 1]);
#pragma unroll
        for (int r = 0; r < 4; ++r) {
            vec2 av = r == 0 ? a0 : (r == 1 ? a1 : (r == 2 ? a2 : a3));
            acc[r][0] += av.x * p0.x + av.y * q0.x;
            acc[r][1] += av.x * p0.y + av.y * q0.y;
            acc[r][2] += av.x * p1.x + av.y * q1.x;
            acc[r][3] += av.x * p1.y + av.y * q1.y;
        }
    }
}

void matmul16_tiled() {
    // Workgroup (not invocation) ids: each block owns one 64x64 tile, so the
    // local offset must not be folded into the tile origin.
    //
    // Under the tile-split-K dispatch this kernel is launched with
    // z = b*ks_n + rk, so the batch index and this block's K slice both come
    // out of z. In every other build KSPLIT_BY is 0, the range is the whole K,
    // and the prologue folds away.
    const bool KSPLIT = KSPLIT_BY != 0;
    int rk = 0;
    int b = int(gl_WorkGroupID.z);
    int k0 = 0;
    int kstop = uPC.K;
    if (KSPLIT) {
        // z is b*ks_n + rk, and the K cut is a function of the shape alone --
        // it rides in the slice table, not in per-dispatch state, so every
        // block of a dispatch and the fold pass that follows read the same
        // cut. This block takes slice rk; the fold pass reduces them all.
        const int ks = max(load_krange().n, 1);
        rk = b % ks;
        b = b / ks;
        k0 = ks_lo(rk);
        kstop = ks_hi(rk);
        if (kstop <= k0 || kstop > uPC.K) return;
    }
    int row0 = int(gl_WorkGroupID.y) * TILE_M;
    int col0 = int(gl_WorkGroupID.x) * TILE_N;
    if (row0 >= uPC.M || col0 >= uPC.N) return;

    // A and the output are dispatch-batch-sized; B's batch shrinks when the
    // host folded a repeat_kv into this MatMul, so the B loaders walk bmap(b).
    int bb = bmap(b);
    int lr = int(gl_LocalInvocationID.y) * 4; // this thread's tile origin
    int lc = int(gl_LocalInvocationID.x) * 4;
    int halfK = uPC.K >> 1;
    int halfN = uPC.N >> 1;

    float acc[4][4];
    for (int r = 0; r < 4; ++r)
        for (int c = 0; c < 4; ++c)
            acc[r][c] = 0.0;

    // The two layouts differ only in how B is staged and read, so each gets
    // its own loop nest instead of a branch per k-step. transB is
    // workgroup-uniform, so the barriers stay convergent.
    // Every nest walks the block's K range [k0, kstop), which under the unsplit
    // dispatch is the whole [0, K). Under the tile-split-K dispatch it is one
    // slice, and a nest that walked [0, K) instead would deposit a partial over
    // the wrong K for every block above rk = 0.
    if (uPC.transB != 0) {
        for (int kk = k0; kk < kstop; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_t(bb, col0, kk >> 1, halfK);
            barrier();
            tile_fma_t(acc, lr, lc);
            barrier();
        }
    } else if (uPC.w4 != 0) {
        for (int kk = k0; kk < kstop; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_w4(bb, col0, kk);
            barrier();
            tile_fma_n_w4(acc, lr, lc);
            barrier();
        }
    } else if (uPC.weight_int8 != 0) {
        for (int kk = k0; kk < kstop; kk += TILE_K) {
            tile_load_a(b, row0, kk >> 1, halfK);
            tile_load_b_w8(bb, col0, kk);
            barrier();
            tile_fma_n(acc, lr, lc);
            barrier();
        }
    } else {
        // Two-deep split: the fetch for tile t+1 is issued before tile t is
        // computed, so its loads are in flight for the whole FMA nest. The
        // store then runs after the barrier that retires tile t's readers.
        // The K walk is [k0, kstop); the fetch offsets stay the original
        // expressions.
        const int klo = k0;
        int ntile = (kstop - k0) / TILE_K;
        uint va0, va1, vb0, vb1;
        if (ntile > 0) {
            fetch_a(b, row0, klo >> 1, halfK, va0, va1);
            fetch_b_n(bb, col0, klo, halfN, vb0, vb1);
            store_a(va0, va1);
            store_b_n(vb0, vb1);
        }
        barrier();
        for (int t = 0; t < ntile; ++t) {
            if (t + 1 < ntile) {
                fetch_a(b, row0, (klo + (t + 1) * TILE_K) >> 1, halfK, va0, va1);
                fetch_b_n(bb, col0, klo + (t + 1) * TILE_K, halfN, vb0, vb1);
            }
            tile_fma_n(acc, lr, lc);
            barrier();
            if (t + 1 < ntile) {
                store_a(va0, va1);
                store_b_n(vb0, vb1);
            }
            barrier();
        }
    }

    // This block holds one K slice of the tile, so what it accumulated is a
    // partial. The fold pass stores it; every other build falls through.
    if (KSPLIT) {
        ks_deposit(rk, acc, lr, lc);
        return;
    }

    // N even => col0 + lc is even, so each column pair is one word; the pair
    // can never straddle the row end (that only happens with odd N).
    for (int r = 0; r < 4; ++r) {
        int grow = row0 + lr + r;
        if (grow >= uPC.M) break;
        int base = (b * uPC.M + grow) * uPC.N + col0 + lc;
        vec2 v0 = vec2(acc[r][0], acc[r][1]);
        vec2 v1 = vec2(acc[r][2], acc[r][3]);
        // A byte weight's dequant scale is per output column and constant along
        // K, so it leaves the accumulation entirely: one multiply per output, in
        // fp32, before the half pack -- the same shape the quad kernel uses.
        if (uPC.weight_int8 != 0) {
            int c = col0 + lc;
            v0 *= vec2(scale1(c), scale1(c + 1));
            v1 *= vec2(scale1(c + 2), scale1(c + 3));
        }
        if (col0 + lc + 1 < uPC.N)
            uOutput.data[base >> 1] = packHalf2x16(v0);
        if (col0 + lc + 3 < uPC.N)
            uOutput.data[(base + 2) >> 1] = packHalf2x16(v1);
    }
}

#ifdef FP16
// 128x128 tile GEMM (uPC.tile == 2) for the plain fp16 [batch, K, N] shape:
// no byte weight, no epilogue, N % 8 == 0 (uvec4 B loads), K % 16 == 0. Same
// 16x16 workgroup and 16-deep K step as matmul16_tiled, but every thread owns
// an 8x8 sub-tile -- rows {ty*4..+3, 64+ty*4..+3}, columns {tx*4..+3,
// 64+tx*4..+3} -- so each k-pair costs 16 shared words for 128 FMAs instead of
// 8 for 32. The two-group split keeps a SIMD's 16 column lanes on 32
// contiguous words. Measured on the M5 Max at M=1024: 4096x12288 10.9 -> 9.6
// ms, 12288x4096 11.1 -> 9.8 ms.
//
// Both stages live in the 64x64 kernel's sB (uint[2048], 8 KB): the module
// already sits at ~32000 of Apple's 32768 B of threadgroup memory (MoltenVK
// refuses the pipeline past that), and one entry point runs per dispatch, so
// the two kernels never hold data in it at once.
//   A: words [0, 1024)    = [row][k-pair], 128 rows x 8 words. Staged with 8
//      lanes per row so each global read is 32 contiguous bytes; a SIMD's A
//      reads are broadcasts (two distinct rows), so no padding is needed.
//   B: words [1024, 2048) = [k][column-pair], global's own packing.
// Grid: x = N/128, y = M/128, z = batch.
void matmul16_tiled128() {
    int tid = tile_tid();
    int tx = int(gl_LocalInvocationID.x);
    int ty = int(gl_LocalInvocationID.y);
    int b = int(gl_WorkGroupID.z);
    int bb = bmap(b);
    int row0 = int(gl_WorkGroupID.y) * 128;
    int col0 = int(gl_WorkGroupID.x) * 128;
    if (row0 >= uPC.M || col0 >= uPC.N) return;
    int halfK = uPC.K >> 1;
    int ar = tid >> 3;
    int akt = tid & 7;
    int a_base = (b * uPC.M + row0 + ar) * halfK + akt;
    int a_rs = 32 * halfK;
    bool a_ok0 = row0 + ar + 0 < uPC.M;
    bool a_ok1 = row0 + ar + 32 < uPC.M;
    bool a_ok2 = row0 + ar + 64 < uPC.M;
    bool a_ok3 = row0 + ar + 96 < uPC.M;
    int bk = tid >> 4;
    int bo = tid & 15;
    bool b_ok = col0 + bo * 8 + 7 < uPC.N;
    int b_base = ((bb * uPC.K + bk) * uPC.N + col0 + bo * 8) >> 3;
    int b_step = (16 * uPC.N) >> 3;
    uvec4 wb = uvec4(0u);
    vec4 acc[8][2];
    acc[0][0] = vec4(0.0);
    acc[0][1] = vec4(0.0);
    acc[1][0] = vec4(0.0);
    acc[1][1] = vec4(0.0);
    acc[2][0] = vec4(0.0);
    acc[2][1] = vec4(0.0);
    acc[3][0] = vec4(0.0);
    acc[3][1] = vec4(0.0);
    acc[4][0] = vec4(0.0);
    acc[4][1] = vec4(0.0);
    acc[5][0] = vec4(0.0);
    acc[5][1] = vec4(0.0);
    acc[6][0] = vec4(0.0);
    acc[6][1] = vec4(0.0);
    acc[7][0] = vec4(0.0);
    acc[7][1] = vec4(0.0);
    int ntile = uPC.K >> 4;
    uint wa0 = 0u;
    uint wa1 = 0u;
    uint wa2 = 0u;
    uint wa3 = 0u;
    if (a_ok0) wa0 = uInputA.data[a_base + 0 * a_rs];
    if (a_ok1) wa1 = uInputA.data[a_base + 1 * a_rs];
    if (a_ok2) wa2 = uInputA.data[a_base + 2 * a_rs];
    if (a_ok3) wa3 = uInputA.data[a_base + 3 * a_rs];
    if (b_ok) wb = uInputB4.data4[b_base + 0];
    for (int t = 0; t < ntile; ++t) {
        barrier();
        sB[(ar + 0) * 8 + akt] = wa0;
        sB[(ar + 32) * 8 + akt] = wa1;
        sB[(ar + 64) * 8 + akt] = wa2;
        sB[(ar + 96) * 8 + akt] = wa3;
        int bw = 1024 + bk * 64 + bo * 4;
        uvec4 wbs = stageB8(wb);
        sB[bw + 0] = wbs.x;
        sB[bw + 1] = wbs.y;
        sB[bw + 2] = wbs.z;
        sB[bw + 3] = wbs.w;
        barrier();
        if (t + 1 < ntile) {
            int ao = a_base + (t + 1) * 8;
            if (a_ok0) wa0 = uInputA.data[ao + 0 * a_rs];
            if (a_ok1) wa1 = uInputA.data[ao + 1 * a_rs];
            if (a_ok2) wa2 = uInputA.data[ao + 2 * a_rs];
            if (a_ok3) wa3 = uInputA.data[ao + 3 * a_rs];
            if (b_ok) wb = uInputB4.data4[b_base + (t + 1) * b_step];
        }
#pragma unroll
        for (int kt = 0; kt < 8; ++kt) {
            vec2 a00 = unpackHalf2x16(sB[(0 + ty * 4 + 0) * 8 + kt]);
            vec2 a01 = unpackHalf2x16(sB[(0 + ty * 4 + 1) * 8 + kt]);
            vec2 a02 = unpackHalf2x16(sB[(0 + ty * 4 + 2) * 8 + kt]);
            vec2 a03 = unpackHalf2x16(sB[(0 + ty * 4 + 3) * 8 + kt]);
            vec2 a10 = unpackHalf2x16(sB[(64 + ty * 4 + 0) * 8 + kt]);
            vec2 a11 = unpackHalf2x16(sB[(64 + ty * 4 + 1) * 8 + kt]);
            vec2 a12 = unpackHalf2x16(sB[(64 + ty * 4 + 2) * 8 + kt]);
            vec2 a13 = unpackHalf2x16(sB[(64 + ty * 4 + 3) * 8 + kt]);
            int bw0_0 = 1024 + (2 * kt) * 64 + 0 + tx * 2;
            vec4 p0 = vec4(unpackHalf2x16(sB[bw0_0]), unpackHalf2x16(sB[bw0_0 + 1]));
            vec4 q0 = vec4(unpackHalf2x16(sB[bw0_0 + 64]), unpackHalf2x16(sB[bw0_0 + 64 + 1]));
            int bw0_1 = 1024 + (2 * kt) * 64 + 32 + tx * 2;
            vec4 p1 = vec4(unpackHalf2x16(sB[bw0_1]), unpackHalf2x16(sB[bw0_1 + 1]));
            vec4 q1 = vec4(unpackHalf2x16(sB[bw0_1 + 64]), unpackHalf2x16(sB[bw0_1 + 64 + 1]));
            acc[0][0] += a00.x * p0 + a00.y * q0;
            acc[0][1] += a00.x * p1 + a00.y * q1;
            acc[1][0] += a01.x * p0 + a01.y * q0;
            acc[1][1] += a01.x * p1 + a01.y * q1;
            acc[2][0] += a02.x * p0 + a02.y * q0;
            acc[2][1] += a02.x * p1 + a02.y * q1;
            acc[3][0] += a03.x * p0 + a03.y * q0;
            acc[3][1] += a03.x * p1 + a03.y * q1;
            acc[4][0] += a10.x * p0 + a10.y * q0;
            acc[4][1] += a10.x * p1 + a10.y * q1;
            acc[5][0] += a11.x * p0 + a11.y * q0;
            acc[5][1] += a11.x * p1 + a11.y * q1;
            acc[6][0] += a12.x * p0 + a12.y * q0;
            acc[6][1] += a12.x * p1 + a12.y * q1;
            acc[7][0] += a13.x * p0 + a13.y * q0;
            acc[7][1] += a13.x * p1 + a13.y * q1;
        }
    }
    { int grow = row0 + 0 + ty * 4 + 0;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[0][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[0][0].zw);
        }
        int gcol1 = col0 + 64 + tx * 4;
        if (gcol1 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol1) >> 1;
            uOutput.data[base] = packHalf2x16(acc[0][1].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[0][1].zw);
        }
      }
    }
    { int grow = row0 + 0 + ty * 4 + 1;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[1][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[1][0].zw);
        }
        int gcol1 = col0 + 64 + tx * 4;
        if (gcol1 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol1) >> 1;
            uOutput.data[base] = packHalf2x16(acc[1][1].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[1][1].zw);
        }
      }
    }
    { int grow = row0 + 0 + ty * 4 + 2;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[2][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[2][0].zw);
        }
        int gcol1 = col0 + 64 + tx * 4;
        if (gcol1 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol1) >> 1;
            uOutput.data[base] = packHalf2x16(acc[2][1].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[2][1].zw);
        }
      }
    }
    { int grow = row0 + 0 + ty * 4 + 3;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[3][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[3][0].zw);
        }
        int gcol1 = col0 + 64 + tx * 4;
        if (gcol1 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol1) >> 1;
            uOutput.data[base] = packHalf2x16(acc[3][1].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[3][1].zw);
        }
      }
    }
    { int grow = row0 + 64 + ty * 4 + 0;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[4][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[4][0].zw);
        }
        int gcol1 = col0 + 64 + tx * 4;
        if (gcol1 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol1) >> 1;
            uOutput.data[base] = packHalf2x16(acc[4][1].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[4][1].zw);
        }
      }
    }
    { int grow = row0 + 64 + ty * 4 + 1;
      if (grow < uPC.M) {
        int gcol0 = col0 + 0 + tx * 4;
        if (gcol0 + 3 < uPC.N) {
            int base = ((b * uPC.M + grow) * uPC.N + gcol0) >> 1;
            uOutput.data[base] = packHalf2x16(acc[5][0].xy);
            uOutput.data[base + 1] = packHalf2x16(acc[5][0].zw);
