#version 450 core

// MatMul SSBO reduce pass (fp32 + fp16). Computes C = A @ B, writing fp32
// results to uOutput (fp32) or uScratch (fp16, for the pack pass).
// The pack pass is a SEPARATE shader (buffer/matmul_pack.comp) to avoid
// Intel ANV push-constant interference between dispatches of the same pipeline.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;
} uPC;

#ifdef FP16
float load_a(int idx) {
    return unpackHalf2x16(uInputA.data[idx >> 1])[idx & 1];
}
float load_b(int idx) {
    return unpackHalf2x16(uInputB.data[idx >> 1])[idx & 1];
}
#endif

void main() {
    int j = int(gl_GlobalInvocationID.x);
    int yi = int(gl_GlobalInvocationID.y);
    if (j >= uPC.N) return;

    int n = yi / uPC.M;
    int i = yi % uPC.M;
    if (n >= uPC.batch) return;

    int a_base = n * uPC.M * uPC.K;
    int b_base = n * uPC.K * uPC.N;
    int c_base = n * uPC.M * uPC.N;

    float sum = 0.0;
    for (int k = 0; k < uPC.K; ++k) {
#ifdef FP16
        float a = load_a(a_base + i * uPC.K + k);
        float b = load_b(b_base + k * uPC.N + j);
#else
        float a = uintBitsToFloat(uInputA.data[a_base + i * uPC.K + k]);
        float b = uintBitsToFloat(uInputB.data[b_base + k * uPC.N + j]);
#endif
        sum += a * b;
    }

    int out_idx = c_base + i * uPC.N + j;
#ifdef FP16
    uScratch.data[out_idx] = floatBitsToUint(sum);
#else
    uOutput.data[out_idx] = floatBitsToUint(sum);
#endif
}
