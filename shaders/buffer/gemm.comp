#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Matrix multiplication
// A' = transpose(A) if transA else A
// B' = transpose(B) if transB else B
// Compute Y = alpha * A' * B' + beta * C,
//
// The K loop carries NO data-dependent branches: transA/transB are
// hoisted into walk start + stride, and each (A dtype x B dtype) pair
// gets its own specialized loop instance via macro expansion.
// fp16a/fp16b/fp16c/fp16o are 0 (fp32) or 1 (fp16) only, and B's format
// is picked once by weight_int8: 0 = float/half, 1 = int8 weight-only.
// Gemm::execute rejects anything else, because reading a quantized
// payload through LDF would reinterpret its bytes as exponents and
// return a wrong answer with no error.


#define FLOAT float
#define FLOAT2 vec2
#define FLOAT4 vec4

#include "../common/activation.comp"

layout(set=0, binding = 0) writeonly buffer BufferY {
    uint data[];
} bufferY;

layout(set=0, binding = 1) readonly buffer BufferA {
    uint data[];
} bufferA;

layout(set=0, binding = 2) readonly buffer BufferB {
    uint data[];
} bufferB;

layout(set=0, binding = 3) readonly buffer BufferC {
    uint data[];
} bufferC;

// Per-output-column dequant scale for int8 weight-only B (binding 4), inert
// when weight_int8 == 0. The optimizer stores scale = amax/127 per column of
// Y as fp32; Gemm::execute refuses any other scale format, so this reads the
// word as a float unconditionally.
layout(set=0, binding = 4) readonly buffer BufferScale {
    uint data[];
} bufferS;

layout(push_constant) uniform paraBuffer {
    int M; // 行数
    int N; // 列数
    int K; // 共同维度
    int has_bias;
    int transA;
    int transB;
    float alpha;
    float beta;
    int fp16a;
    int fp16b;
    int fp16c;
    int fp16o;
    int activation;
    int weight_int8; // 1 = B is packed int8 bytes, dequant via bufferS[j]
} uParams;

#define A16 (uParams.fp16a == 1)
#define B16 (uParams.fp16b == 1)

// Element loaders parameterized by the walk-index variable.
#define LDF(buf, idx) uintBitsToFloat(buf.data[idx])
#define LDH(buf, idx) unpackHalf2x16(buf.data[idx >> 1])[idx & 1]

// int8 weight-only payload: four signed bytes per uint word. Same decode as
// buffer/conv2d.comp's int8 nest — mask the byte, then fold the sign bit by
// hand, since an arithmetic right shift of a signed int is not something to
// bet a kernel on across drivers.
float w8(uint word, int lane) {
    int b = int(word >> (lane * 8)) & 0xFF;
    return float(b >= 128 ? b - 256 : b);
}
#define LD8(buf, idx) w8(buf.data[idx >> 2], idx & 3)

// Specialized K loops. ai/a_step walk A; the caller's bi* variables walk B.
#define KLOOP1(LA, LB, SUM)                                \
    for (int k = 0; k < uParams.K; ++k) {                  \
        SUM += (LA) * (LB);                                \
        ai += a_step;                                      \
        bi += b_step;                                      \
    }

#define KLOOP2(LA, LBX, LBY, SUM)                          \
    for (int k = 0; k < uParams.K; ++k) {                  \
        float av = (LA);                                   \
        SUM.x += av * (LBX);                               \
        SUM.y += av * (LBY);                               \
        ai += a_step;                                      \
        b0i += b_step;                                     \
        b1i += b_step;                                     \
    }

// Y = alpha * A' * B' (+ bias), fp32 output, one thread per element.
void gemm32()
{
    int j = int(gl_GlobalInvocationID.x); // column index in Y
    int i = int(gl_GlobalInvocationID.y); // row index in Y

    if (i >= uParams.M || j >= uParams.N) return;

    // transA: A is stored K x M, row i of A' is the strided walk i + k*M.
    // transB: B is stored N x K, column j of B' is the contiguous walk j*K + k.
    int ai = (uParams.transA == 1) ? i : i * uParams.K;
    int a_step = (uParams.transA == 1) ? uParams.M : 1;
    int bi = (uParams.transB == 1) ? j * uParams.K : j;
    int b_step = (uParams.transB == 1) ? 1 : uParams.N;

    float sum = 0.0;
    if (uParams.weight_int8 == 1) {
        // The scale is per output column, so it is constant along K: fold the
        // dot product over the raw bytes and dequantize once at the end. That
        // is both cheaper than a per-tap multiply and rounding-wise no worse —
        // one multiply instead of K of them.
        float wsc = LDF(bufferS, j);
        if (A16) { KLOOP1(LDH(bufferA, ai), LD8(bufferB, bi), sum) }
        else     { KLOOP1(LDF(bufferA, ai), LD8(bufferB, bi), sum) }
        sum *= wsc;
    } else if (A16) {
        if (B16) { KLOOP1(LDH(bufferA, ai), LDH(bufferB, bi), sum) }
        else     { KLOOP1(LDH(bufferA, ai), LDF(bufferB, bi), sum) }
    } else {
        if (B16) { KLOOP1(LDF(bufferA, ai), LDH(bufferB, bi), sum) }
        else     { KLOOP1(LDF(bufferA, ai), LDF(bufferB, bi), sum) }
    }

    sum *= uParams.alpha;
    if (uParams.has_bias == 1) {
        // Bias C is 1-D [N], broadcast across all M rows: element is C[j].
        float c_val = (uParams.fp16c == 1)
                          ? unpackHalf2x16(bufferC.data[j / 2])[j % 2]
                          : uintBitsToFloat(bufferC.data[j]);
        sum += c_val * uParams.beta;
    }

    sum = activation(sum, uParams.activation);
    bufferY.data[i * uParams.N + j] = floatBitsToUint(sum);
}

// fp16 output: one thread owns the half2 word of two adjacent columns
// (j*2, j*2+1). NOTE (pre-existing): word-aligned stores assume even N;
// odd N would race across row boundaries.
void gemm16() {
    int j = int(gl_GlobalInvocationID.x); // column-pair index in Y
    int i = int(gl_GlobalInvocationID.y); // row index in Y
    int j0 = j * 2;

    if (i >= uParams.M || j0 >= uParams.N) return;

    int ai = (uParams.transA == 1) ? i : i * uParams.K;
    int a_step = (uParams.transA == 1) ? uParams.M : 1;
    int b_step = (uParams.transB == 1) ? 1 : uParams.N;
    int b0i, b1i;
    if (uParams.transB == 1) {
        b0i = j0 * uParams.K;
        // Last column when N is odd: b1i aliases b0i; sum.y is computed from
        // valid memory then masked out on store.
        b1i = (j0 + 1 < uParams.N) ? (j0 + 1) * uParams.K : b0i;
    } else {
        b0i = j0;
        b1i = (j0 + 1 < uParams.N) ? j0 + 1 : b0i;
    }

    vec2 sum = vec2(0.0);
    if (uParams.weight_int8 == 1) {
        // One scale per column; the odd-N tail aliases b1i onto b0i, so its
        // scale index is clamped to stay inside bufferS (the value is dropped
        // on store anyway).
        vec2 wsc = vec2(LDF(bufferS, j0),
                        j0 + 1 < uParams.N ? LDF(bufferS, j0 + 1) : 0.0);
        if (A16) {
            KLOOP2(LDH(bufferA, ai), LD8(bufferB, b0i), LD8(bufferB, b1i), sum)
        } else {
            KLOOP2(LDF(bufferA, ai), LD8(bufferB, b0i), LD8(bufferB, b1i), sum)
        }
        sum *= wsc;
    } else if (A16) {
        if (B16) {
            KLOOP2(LDH(bufferA, ai), LDH(bufferB, b0i), LDH(bufferB, b1i), sum)
        } else {
            KLOOP2(LDH(bufferA, ai), LDF(bufferB, b0i), LDF(bufferB, b1i), sum)
        }
    } else {
        if (B16) {
            KLOOP2(LDF(bufferA, ai), LDH(bufferB, b0i), LDH(bufferB, b1i), sum)
        } else {
            KLOOP2(LDF(bufferA, ai), LDF(bufferB, b0i), LDF(bufferB, b1i), sum)
        }
    }

    sum *= uParams.alpha;
    if (uParams.has_bias == 1) {
        // Bias C is 1-D [N], broadcast across all M rows: C[j0], C[j0+1].
        int bcol1 = j0 + 1;
        vec2 c_val;
        c_val.x = (uParams.fp16c == 1)
                      ? unpackHalf2x16(bufferC.data[j0 / 2])[j0 % 2]
                      : uintBitsToFloat(bufferC.data[j0]);
        if (bcol1 < uParams.N) {
            c_val.y = (uParams.fp16c == 1)
                          ? unpackHalf2x16(bufferC.data[bcol1 / 2])[bcol1 % 2]
                          : uintBitsToFloat(bufferC.data[bcol1]);
        } else {
            c_val.y = 0.0;
        }
        sum += c_val * uParams.beta;
    }

    sum = activation(sum, uParams.activation);

    if (j0 + 1 >= uParams.N) {
        sum.y = 0.0; // odd-N tail: drop the aliased column
    }
    bufferY.data[(i * uParams.N + j0) / 2] = packHalf2x16(sum);
}

void main() {
    if (uParams.fp16o == 1) {
        gemm16();
    } else {
        gemm32();
    }
}
