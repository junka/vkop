#version 450 core

// Equal SSBO op: C[i] = (A[i] == B[i]) ? 1 : 0.
// One thread per output element. Supports broadcasting (right-aligned).
// Output: uint (1 = true, 0 = false), matching the Where op's condition
// buffer convention (bool in GLSL, uint in SSBO).

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;

// Phase 3 GPU-driven shape-meta: optional shape-SSBO bindings (out/in0/in1).
// Declared to match the shared 6-binding descriptor layout; bound only when an
// input carries shape_ssbo_ (Equal currently always uses CPU-known shapes, so
// these stay unbound — legal under UPDATE_AFTER_BIND).
layout(set = 0, binding = 3) readonly buffer ShapeOut {
    ivec2 data[];
} uShapeOut;
layout(set = 0, binding = 4) readonly buffer ShapeIn0 {
    ivec2 data[];
} uShapeIn0;
layout(set = 0, binding = 5) readonly buffer ShapeIn1 {
    ivec2 data[];
} uShapeIn1;

layout(push_constant) uniform PC {
    int rank;
    IArr8 outDims;
    IArr8 in0Dims;
    IArr8 in1Dims;
    int activation;  // unused, kept for layout parity with BinaryElemPC
    int broadcast;
    int total;
    int _pad;
} uPC;

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= uPC.total) return;

    int ia, ib;
    if (uPC.broadcast == 0) {
        ia = gid;
        ib = gid;
    } else {
        ia = broadcast_index(gid, uPC.outDims, uPC.in0Dims, uPC.rank);
        ib = broadcast_index(gid, uPC.outDims, uPC.in1Dims, uPC.rank);
    }

    float a = uintBitsToFloat(uInputA.data[ia]);
    float b = uintBitsToFloat(uInputB.data[ib]);
    uOutput.data[gid] = floatBitsToUint((a == b) ? 1.0 : 0.0);
}
