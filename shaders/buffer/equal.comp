#version 450 core

// Equal SSBO op: C[i] = (A[i] == B[i]) ? 1 : 0.
// One thread per output element. Supports broadcasting (right-aligned).
// Output: uint (1 = true, 0 = false), matching the Where op's condition
// buffer convention (bool in GLSL, uint in SSBO).

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;

layout(push_constant) uniform PC {
    int rank;
    IArr8 outDims;
    IArr8 in0Dims;
    IArr8 in1Dims;
    int activation;  // unused, kept for layout parity with BinaryElemPC
    int broadcast;
    int total;
    int _pad;
} uPC;

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= uPC.total) return;

    int ia, ib;
    if (uPC.broadcast == 0) {
        ia = gid;
        ib = gid;
    } else {
        ia = broadcast_index(gid, uPC.outDims, uPC.in0Dims, uPC.rank);
        ib = broadcast_index(gid, uPC.outDims, uPC.in1Dims, uPC.rank);
    }

    float a = uintBitsToFloat(uInputA.data[ia]);
    float b = uintBitsToFloat(uInputB.data[ib]);
    uOutput.data[gid] = floatBitsToUint((a == b) ? 1.0 : 0.0);
}
