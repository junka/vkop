#version 450 core

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

// SSBO cooperative-matrix MatMul (fp16 A/B, fp32 accumulate -> half2 output).
// Replaces the naive 1-thread-per-output reduce (matmul.comp) for the fp16
// LLM path. Intel ARL supports exactly one fp16 coopmat combo:
//   coopmat<float16_t, gl_ScopeSubgroup, 8, 16, A>
//   coopmat<float16_t, gl_ScopeSubgroup, 16, 8, B>
//   coopmat<float,       gl_ScopeSubgroup, 8,  8, Acc>   (fp16 in -> fp32 acc)
// subgroupSize=32. One MMA does C[8x8] += A[8x16]*B[16x8].
//
// Workgroup = 16x16 = 256 threads = 8 subgroups. Subgroup grid 2(M) x 4(N)
// => workgroup output footprint BM=16, BN=32. Each K-tile's shared A/B feeds
// 8 MMAs (2 M-subgroups x 4 N-subgroups), amortizing the SSBO loads.
//
// Macroized build:
//   CM / CN / CK  — MMA tile M/N/K  (ARL fp16 always 8/8/16)
//   SG_M / SG_N   — subgroup grid   (SG_M*SG_N == 8, fixed)
//   BM = SG_M * CM,  BN = SG_N * CN — workgroup output footprint
// ShA / ShB loads are uniformized via a thread-loop so any CM/CN/SG_M/SG_N
// combo that keeps local_size_x*y=256 (fixed) compiles.
//
// Build variants (compile-time, one entry per pipeline):
//
//   DEFAULT (no -D)       — fused K walk + half2 epilogue. coop_split <= 1
//                           (the default). No scratch write, no pack pass.
//                           Grid: x = ceil(N/BN), y = ceil(M/BM), z = batch.
//                           K range [0, K).
//
//   -DSPLITK_INWG         — in-workgroup split-K. Single dispatch (grid =
//                           DEFAULT). coop_split = min(max(ksplit,1),8)
//                           serial passes, each pass runs run_mma_slice() over
//                           one K-slice [p*k_per, min((p+1)*k_per, K)).
//                           Partials reduced inside shared memory — NO
//                           global scratch round-trip, NO fold dispatch, NO
//                           pack dispatch.  coop_split=1 is functionally
//                           identical to DEFAULT (slightly more barriers,
//                           host should route cs<=1 to DEFAULT pipeline).
//
//   -DSPLITK_DEPOSIT      — K-split deposit (cross-dispatch). z =
//                           batch*coop_split + slice. Each workgroup owns
//                           [k0, k_end). Writes fp32 partials to binding 3.
//
//   -DSPLITK_FOLD         — K-split fold (cross-dispatch). z = batch. One
//                           workgroup per [BM, BN] tile, reduces all split
//                           planes, packs half2 to binding 0.

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_16bit_storage : enable

// --- Macroized build parameters (host supplies -D; defaults match original).
#ifndef CM
#define CM 8
#endif
#ifndef CN
#define CN 8
#endif
#ifndef CK
#define CK 16
#endif
#ifndef SG_M
#define SG_M 2
#endif
#ifndef SG_N
#define SG_N 4
#endif
#define M_BLOCK CM
#define N_BLOCK CN
#define K_BLOCK CK
#define BM (SG_M * CM)
#define BN (SG_N * CN)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#ifdef BDA
#include "../common/matmul_coop_bda_table.comp"
#else
layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
// binding 3 (Scratch) holds fp32 partials in SPLITK_DEPOSIT (deposit writes
// here) and SPLITK_FOLD (fold reads here). The DEFAULT build does NOT touch it.
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;
layout(set = 0, binding = 4) readonly buffer ScaleTab {
    uint data[];
} uScaleTab;
layout(set = 0, binding = 5) readonly buffer GlobalFac {
    uint data[];
} uGlobalFac;
#endif

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;
    int transB;
    int tile;
    int weight_int8;
    int w8_quad;
    int ksplit;   // coop_split when SPLITK_DEPOSIT/FOLD; DEFAULT ignores it
    int ksplit_q;
    int w4;
    int nf4;
    int group;
    int fp8;
    int fp8_e5m2;
    int nvfp4;
    int uint4;
    int wide;
    int rep;
    int rep_stride;
    int a_dim;
    int b_dim;
    float epi_scale;
    int epi_bias;
    int K_act;
    int mind_k;
    int epi_bias_batch;
    int attn_softmax;
    int b_shared;
} uPC;

int bmap(int n) {
    if (uPC.b_shared != 0) {
        return 0;
    }
    if (uPC.rep <= 1) {
        return n;
    }
    int a_span = uPC.rep_stride * uPC.a_dim;
    int rest = n % a_span;
    int prefix = n / a_span;
    int b_span = uPC.rep_stride * uPC.b_dim;
    return prefix * b_span +
           (rest / (uPC.rep * uPC.rep_stride)) * uPC.rep_stride +
           (rest % uPC.rep_stride);
}

float16_t loadA(int elem) {
    return float16_t(unpackHalf2x16(uInputA.data[elem >> 1])[elem & 1]);
}
float16_t loadB(int elem) {
    return float16_t(unpackHalf2x16(uInputB.data[elem >> 1])[elem & 1]);
}

shared float16_t shA[BM * K_BLOCK];  // [BM x K_BLOCK]
shared float16_t shB[K_BLOCK * BN];  // [K_BLOCK x BN]
shared float     shC[SG_M * SG_N][M_BLOCK * N_BLOCK]; // [sg][64] fp32 staging
// SPLITK_INWG-only: cross-pass K-slice accumulator + per-pass partial tmp.
// [sg][64] × 2 × 4B = 4096B. DEPOSIT/FOLD/DEFAULT don't touch these.
shared float     shC_acc[SG_M * SG_N][M_BLOCK * N_BLOCK]; // cross-pass sum
shared float     shC_tmp[SG_M * SG_N][M_BLOCK * N_BLOCK]; // per-pass partial

// --------------------------------------------------------------------------
// K split helpers. Shared by DEPOSIT and FOLD builds.
// --------------------------------------------------------------------------
struct KRange { int k0; int k_end; };

KRange krange_for(int s, int coop_split) {
    KRange r;
    r.k0 = 0;
    r.k_end = uPC.K;
    if (coop_split > 1) {
        int k_per = (uPC.K + coop_split - 1) / coop_split;
        r.k0 = s * k_per;
        r.k_end = min(r.k0 + k_per, uPC.K);
    }
    return r;
}

int splitk_plane_slot(int b, int s, int coop_split) {
    return (b * coop_split + s) * (uPC.M * uPC.N);
}

// --------------------------------------------------------------------------
// Common MMA loop over slice [k0, k_end). Called by DEFAULT and
// SPLITK_DEPOSIT; SPLITK_FOLD does no MMA.
// --------------------------------------------------------------------------
void run_mma_slice(int m0, int n0, int a_base, int b_base,
                   KRange kr,
                   inout coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
                                 gl_MatrixUseAccumulator> matC) {
    uint sg  = gl_SubgroupID;
    uint tid = gl_LocalInvocationIndex;
    int  sgx = int(sg % SG_N);
    int  sgy = int(sg / SG_N);

    int M = uPC.M, N = uPC.N, K = uPC.K;
    // Slice-local tile iteration. Align kr.k0 DOWN and kr.k_end UP to K_BLOCK
    // boundaries, so the loop only iterates tiles that [partially] cover the
    // slice.  Fully-outside tiles are SKIPPED (their coopmat MMA would feed
    // all-zero A/B and contribute zero — skipping avoids paying MMA cost).
    // Tiles straddling the slice boundary still enter the loop and rely on
    // the per-element in_slice check below for the exact partial coverage.
    // This ensures total MMA count across all passes = ceil(K/K_BLOCK)
    // (identical to the single-pass DEFAULT), no matter how coop_split
    // slices land relative to K_BLOCK.
    int k0_tile_aligned = (kr.k0 / K_BLOCK) * K_BLOCK;
    int k_end_tile_aligned = ((kr.k_end + K_BLOCK - 1) / K_BLOCK) * K_BLOCK;
    int k_tiles_local = max((k_end_tile_aligned - k0_tile_aligned) / K_BLOCK, 0);

    const int A_SZ = BM * K_BLOCK;
    const int B_SZ = K_BLOCK * BN;

    for (int i = 0; i < k_tiles_local; i++) {
        int k_base = k0_tile_aligned + i * K_BLOCK;

        // A[BM x K_BLOCK]
        {
#if BM == 16 && BN == 32 && SG_M == 2 && SG_N == 4
            // Fast path for the DEFAULT workgroup (identical to original):
            // 256 threads cover 256 fp16s exactly, no loop needed.
            int row = int(tid) / K_BLOCK;
            int col = int(tid) % K_BLOCK;
            int h  = m0 + row;
            int kk = k_base + col;
            bool in_slice = (kk >= kr.k0 && kk < kr.k_end);
            float16_t v = (h < M && kk < K && in_slice) ? loadA(a_base + h * K + kk)
                                                        : float16_t(0.0);
            shA[int(tid)] = v;
#else
            int A_SZ = BM * K_BLOCK;
            for (int e = 0; e < (A_SZ + 255) / 256; e++) {
                int idx = int(tid) + e * 256;
                if (idx < A_SZ) {
                    int row = idx / K_BLOCK;
                    int col = idx % K_BLOCK;
                    int h  = m0 + row;
                    int kk = k_base + col;
                    bool in_slice = (kk >= kr.k0 && kk < kr.k_end);
                    float16_t v = (h < M && kk < K && in_slice) ?
                        loadA(a_base + h * K + kk) : float16_t(0.0);
                    shA[idx] = v;
                }
            }
#endif
        }
        // B[K_BLOCK x BN]
#if BM == 16 && BN == 32 && SG_M == 2 && SG_N == 4
        // Fast path for DEFAULT: 256 threads × 2 = 512 fp16s.
        for (int e = 0; e < 2; e++) {
            int idx = int(tid) * 2 + e;
            int row = idx / BN;
            int col = idx % BN;
            int kk = k_base + row;
            int w = n0 + col;
            bool in_slice = (kk >= kr.k0 && kk < kr.k_end);
            float16_t v;
            if (kk < K && w < N && in_slice) {
                if (uPC.transB != 0) {
                    v = loadB(b_base + w * K + kk);
                } else {
                    v = loadB(b_base + kk * N + w);
                }
            } else {
                v = float16_t(0.0);
            }
            shB[idx] = v;
        }
#else
        {
            int B_SZ = K_BLOCK * BN;
            for (int e = 0; e < (B_SZ + 255) / 256; e++) {
                int idx = int(tid) + e * 256;
                if (idx < B_SZ) {
                    int row = idx / BN;
                    int col = idx % BN;
                    int kk = k_base + row;
                    int w = n0 + col;
                    bool in_slice = (kk >= kr.k0 && kk < kr.k_end);
                    float16_t v;
                    if (kk < K && w < N && in_slice) {
                        if (uPC.transB != 0) {
                            v = loadB(b_base + w * K + kk);
                        } else {
                            v = loadB(b_base + kk * N + w);
                        }
                    } else {
                        v = float16_t(0.0);
                    }
                    shB[idx] = v;
                }
            }
        }
#endif

        barrier();

        coopmat<float16_t, gl_ScopeSubgroup, M_BLOCK, K_BLOCK, gl_MatrixUseA>
            matA;
        coopmat<float16_t, gl_ScopeSubgroup, K_BLOCK, N_BLOCK, gl_MatrixUseB>
            matB;
        coopMatLoad(matA, shA, sgy * M_BLOCK * K_BLOCK, K_BLOCK,
                    gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB, shB, sgx * N_BLOCK, BN,
                    gl_CooperativeMatrixLayoutRowMajor);

        matC = coopMatMulAdd(matA, matB, matC);

        barrier();
    }
}

// --------------------------------------------------------------------------
// Build variant dispatch (mutually exclusive -D macros).
// --------------------------------------------------------------------------

#if defined(SPLITK_INWG)
// --------------------------------------------------------------------------
// SPLITK_INWG: split-K inside one workgroup via cross-pass shared-memory
// reduction. Single dispatch, grid = DEFAULT (x,y,z), NO global scratch.
//
// Why a new path?  Previous SPLITK_DEPOSIT/SPLITK_FOLD incurred a round-trip
// through global memory (write fp32 partial -> read back -> write half2 out)
// on ARL (unified memory). That round-trip was the measured bottleneck.
//
// This variant keeps K slicing but reduces inside the workgroup:
//   coop_split (= min(max(ksplit,1),8)) serial passes, each pass p owns
//   K-range [p*k_per, min((p+1)*k_per, K)).  Each pass runs the same
//   run_mma_slice() with in-slice zero-fill (verified correct in the last
//   session for non-K_BLOCK-aligned boundaries), stores the per-pass partial
//   into shC_tmp[sg], then adds into shC_acc[sg] (fp32).  Final epilogue
//   reads shC_acc and packs half2 — exactly the DEFAULT epilogue mapping.
//
// Math note: total MMA count is identical to DEFAULT (K/K_BLOCK tiles ×
// 8 subgroups).  SSBO read count is also identical because we skip loading
// tiles whose K-range is fully outside the current pass.  The ONLY overhead
// over DEFAULT is 2 extra barriers per pass (after the store and after the
// fp32 add) plus the tiny fp32 cross-pass add.  coop_split=1 degenerates
// to a single pass and is therefore functionally identical to DEFAULT —
// we still run the extra barriers, so host SHOULD route coop_split<=1 to
// the DEFAULT pipeline instead of this one.
//
// Shared memory usage (this build only):
//   shA       [256] fp16  =   512B
//   shB       [512] fp16  =  1024B
//   shC_acc   [512] fp32  =  2048B
//   shC_tmp   [512] fp32  =  2048B
//   total                 =  5632B  (ARL upper bound 64KB, well under)
// --------------------------------------------------------------------------
void main() {
    int  b    = int(gl_WorkGroupID.z);
    int  m0   = int(gl_WorkGroupID.y) * BM;
    int  n0   = int(gl_WorkGroupID.x) * BN;
    uint sg   = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;

    int M = uPC.M, N = uPC.N, K = uPC.K;
    int coop = min(max(uPC.ksplit, 1), 8);   // in-workgroup max 8 passes
    int a_base = b * M * K;
    int b_base = bmap(b) * K * N;
    int sgy = int(sg) / SG_N;
    int sgx = int(sg) % SG_N;

    // Cross-pass accumulator init: 2 fp32 per lane (lane owns idx=2l, 2l+1).
    for (int e = 0; e < 2; e++) {
        int idx = int(lane) * 2 + e;
        shC_acc[sg][idx] = 0.0;
    }

    for (int p = 0; p < coop; p++) {
        KRange kr = krange_for(p, coop);
        if (kr.k0 >= kr.k_end) continue;   // empty tail

        coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
                gl_MatrixUseAccumulator> matC =
            coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
                    gl_MatrixUseAccumulator>(0.0);

        run_mma_slice(m0, n0, a_base, b_base, kr, matC);

        // Store pass partial to shC_tmp[sg] and cross-pass accumulate.
        coopMatStore(matC, shC_tmp[sg], 0, N_BLOCK,
                     gl_CooperativeMatrixLayoutRowMajor);
        barrier();                        // make shC_tmp visible to all lanes

        for (int e = 0; e < 2; e++) {
            int idx = int(lane) * 2 + e;
            shC_acc[sg][idx] += shC_tmp[sg][idx];
        }
        barrier();                        // acc done before next pass reads shC_acc
    }

    barrier();                             // all passes done before epilogue
    int c_base = b * M * N;
    for (int e = 0; e < 2; e++) {
        int idx = int(lane) * 2 + e;
        int row = idx / N_BLOCK;
        int col = idx % N_BLOCK;
        if ((col & 1) != 0) continue;
        int hg        = m0 + sgy * M_BLOCK + row;
        int wg_even   = n0 + sgx * N_BLOCK + col;
        int wg_odd    = wg_even + 1;
        if (hg < M && wg_even < N) {
            float v0 = shC_acc[sg][idx];
            float v1 = (wg_odd < N) ? shC_acc[sg][idx + 1] : 0.0;
            int out_word = (c_base + hg * N + wg_even) >> 1;
            uOutput.data[out_word] = packHalf2x16(vec2(v0, v1));
        }
    }
}

#elif defined(SPLITK_DEPOSIT)
void main() {
    int  b    = int(gl_WorkGroupID.z) / uPC.ksplit;
    int  s    = int(gl_WorkGroupID.z) % uPC.ksplit;
    int  m0   = int(gl_WorkGroupID.y) * BM;
    int  n0   = int(gl_WorkGroupID.x) * BN;
    uint sg   = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;

    KRange kr = krange_for(s, uPC.ksplit);
    if (kr.k0 >= kr.k_end) return;

    coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
            gl_MatrixUseAccumulator> matC =
        coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
                gl_MatrixUseAccumulator>(0.0);

    int M = uPC.M, N = uPC.N;
    int a_base = b * M * uPC.K;
    int b_base = bmap(b) * uPC.K * N;

    run_mma_slice(m0, n0, a_base, b_base, kr, matC);

    coopMatStore(matC, shC[sg], 0, N_BLOCK,
                 gl_CooperativeMatrixLayoutRowMajor);
    barrier();

    int slot = splitk_plane_slot(b, s, uPC.ksplit);
    int sgy  = int(sg) / SG_N;
    int sgx  = int(sg) % SG_N;
    for (int e = 0; e < 2; e++) {
        int idx = int(lane) * 2 + e;
        int row = idx / N_BLOCK;
        int col = idx % N_BLOCK;
        int hg  = m0 + sgy * M_BLOCK + row;
        int wg  = n0 + sgx * N_BLOCK + col;
        if (hg < M && wg < N) {
            uScratch.data[slot + hg * N + wg] = floatBitsToUint(shC[sg][idx]);
        }
    }
}

#elif defined(SPLITK_FOLD)
void main() {
    // This pass issues no coopMatMulAdd, so the driver's subgroup geometry is
    // not tied to the MMA (Intel compiles a 256-thread workgroup with no
    // coopmat as subgroup 16). Map the SG_M*SG_N tiles onto the workgroup's
    // threads explicitly instead: tile t owns threads [32t, 32t+32), and lane
    // l owns the even/odd column pair (2l, 2l+1). That is independent of the
    // hardware subgroup size, and one lane owns both members of its pair, so
    // no cross-lane barrier is needed.
#if (M_BLOCK * N_BLOCK) != 64
#error "SPLITK_FOLD assumes one 32-lane pair per 8x8 tile"
#endif
#if (SG_M * SG_N) != 8
#error "SPLITK_FOLD maps exactly 8 tiles onto the 256-thread workgroup"
#endif
    int t    = int(gl_LocalInvocationIndex) / 32;
    int lane = int(gl_LocalInvocationIndex) % 32;
    if (t >= SG_M * SG_N) return;

    int b    = int(gl_WorkGroupID.z);
    int m0   = int(gl_WorkGroupID.y) * BM;
    int n0   = int(gl_WorkGroupID.x) * BN;
    int M    = uPC.M, N = uPC.N;
    int coop = max(uPC.ksplit, 1);
    int sgy  = t / SG_N;
    int sgx  = t % SG_N;

    int idx = 2 * lane;
    int row = idx / N_BLOCK;
    int col = idx % N_BLOCK;
    int hg  = m0 + sgy * M_BLOCK + row;
    int wg  = n0 + sgx * N_BLOCK + col;
    int c_base = b * M * N;

    float v0 = 0.0;
    float v1 = 0.0;
    for (int s = 0; s < coop; ++s) {
        int slot = splitk_plane_slot(b, s, coop);
        if (hg < M && wg < N) {
            v0 += uintBitsToFloat(uScratch.data[slot + hg * N + wg]);
        }
        if (hg < M && wg + 1 < N) {
            v1 += uintBitsToFloat(uScratch.data[slot + hg * N + wg + 1]);
        }
    }
    if (hg < M && wg < N) {
        uOutput.data[(c_base + hg * N + wg) >> 1] = packHalf2x16(vec2(v0, v1));
    }
}

#else  // DEFAULT: fused K walk + in-shader half2 epilogue
void main() {
    int  b    = int(gl_WorkGroupID.z);
    int  m0   = int(gl_WorkGroupID.y) * BM;
    int  n0   = int(gl_WorkGroupID.x) * BN;
    uint sg   = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;

    int M = uPC.M, N = uPC.N;
    int a_base = b * M * uPC.K;
    int b_base = bmap(b) * uPC.K * N;

    coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
            gl_MatrixUseAccumulator> matC =
        coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,
                gl_MatrixUseAccumulator>(0.0);

    KRange whole; whole.k0 = 0; whole.k_end = uPC.K;
    run_mma_slice(m0, n0, a_base, b_base, whole, matC);

    coopMatStore(matC, shC[sg], 0, N_BLOCK,
                 gl_CooperativeMatrixLayoutRowMajor);
    barrier();

    int c_base = b * M * N;
    int sgy = int(sg) / SG_N;
    int sgx = int(sg) % SG_N;
    for (int e = 0; e < 2; e++) {
        int idx = int(lane) * 2 + e;            // 0..63
        int row = idx / N_BLOCK;                // 0..7
        int col = idx % N_BLOCK;                // 0..7
        if ((col & 1) != 0) continue;           // odd col handled by neighbor
        int hg        = m0 + sgy * M_BLOCK + row;
        int wg_even   = n0 + sgx * N_BLOCK + col;
        int wg_odd    = wg_even + 1;
        if (hg < M && wg_even < N) {
            float v0 = shC[sg][idx];
            float v1 = (wg_odd < N) ? shC[sg][idx + 1] : 0.0;
            int out_word = (c_base + hg * N + wg_even) >> 1;
            uOutput.data[out_word] = packHalf2x16(vec2(v0, v1));
        }
    }
}
#endif
