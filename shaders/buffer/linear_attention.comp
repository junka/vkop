#version 450 core

// Gated delta rule (linear attention), the recurrent form. One workgroup per
// value head; lane t owns value-column t of that head's state matrix.
//
// Per token the recurrence is (HF `torch_recurrent_gated_delta_rule`):
//     qn = l2norm(q) / sqrt(Dk)          kn = l2norm(k)
//     S  = S * exp(g)                    (g <= 0, the decay)
//     kv = (S * kn).sum(dk)              [Dv]
//     delta = (v - kv) * beta           [Dv]
//     S  = S + kn (x) delta             (a rank-1 update)
//     out = (S * qn).sum(dk)            [Dv]
//
// S is [Dk, Dv]. Column dv of S depends only on kn[:], qn[:], v[dv], g, beta
// and itself, so a lane that owns one column needs no cross-lane reduction:
// it walks dk twice (once for kv, once for out) over its own column. That is
// what makes the state update race-free per lane and lets present alias past
// (the store at the end rewrites exactly the lane's own column).
//
// The l2 norms are shared by every column, so the workgroup computes them once
// into LDS (qn[Dk], kn[Dk]); lane 0..Dk-1 fills them, then a barrier releases
// the column lanes.
//
// DTYPES. q/k/v/g/beta and `out` follow the tensor dtype. Three builds:
//   (base)                 fp32
//   -DFP16                 float16_t data[]  -- NATIVE half storage
//   -DFP16 -DPACKED_FP16   two halves per uint word, unpack/pack per access
// The recurrent STATE is fp32 in every build: HF converts the whole recurrence
// to fp32 and keeps it there, and a half state would drift over a long decode.
// All arithmetic is fp32.
//
// The native build lets each lane write its own column directly. The packed
// build cannot: two lanes' columns share a uint word, so the lanes deposit
// their fp32 results in LDS and a barrier-separated step packs pairs -- one
// writer per word, no race.
//
// Sequence: the lanes walk `seq` tokens in order, because the state carries
// from token to token. For decode (seq == 1) this is one iteration.

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

#define MAX_HEAD_DIM 128

// Reading q/k/v/g/beta: identical in both fp16 layouts (BUF_LOAD handles the
// packed one, a plain array read serves the native one).
#if defined(FP16) && !defined(PACKED_FP16)
#define ACC_LOAD(data, idx) float((data)[(idx)])
#else
#define ACC_LOAD(data, idx) BUF_LOAD((data), (idx))
#endif

#ifdef BDA
layout(buffer_reference, std430, buffer_reference_align = 4) buffer DataBuf {
#if defined(FP16) && !defined(PACKED_FP16)
    float16_t data[];
#else
    uint data[];
#endif
};
// The recurrent state is fp32 in every build, so it needs its own reference
// type: DataBuf's element type follows the data dtype and would be half here.
layout(buffer_reference, std430, buffer_reference_align = 4) buffer StateBuf {
    uint data[];
};
#endif

#ifndef BDA
#if defined(FP16) && !defined(PACKED_FP16)
layout(set = 0, binding = 0) writeonly buffer Out {
    float16_t data[];
} uOut;
layout(set = 0, binding = 1) readonly buffer Q {
    float16_t data[];
} uQ;
layout(set = 0, binding = 2) readonly buffer K {
    float16_t data[];
} uK;
layout(set = 0, binding = 3) readonly buffer V {
    float16_t data[];
} uV;
layout(set = 0, binding = 4) readonly buffer G {
    float16_t data[];
} uG;
layout(set = 0, binding = 5) readonly buffer Beta {
    float16_t data[];
} uBeta;
#else
layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOut;
layout(set = 0, binding = 1) readonly buffer Q {
    uint data[];
} uQ;
layout(set = 0, binding = 2) readonly buffer K {
    uint data[];
} uK;
layout(set = 0, binding = 3) readonly buffer V {
    uint data[];
} uV;
layout(set = 0, binding = 4) readonly buffer G {
    uint data[];
} uG;
layout(set = 0, binding = 5) readonly buffer Beta {
    uint data[];
} uBeta;
#endif
layout(set = 0, binding = 6) readonly buffer StateIn {
    uint data[];
} uStateIn;
layout(set = 0, binding = 7) writeonly buffer StateOut {
    uint data[];
} uStateOut;
#endif

layout(push_constant) uniform PC_uLinAttn {
    int heads;    // Hv, value heads (== workgroup count)
    int kv_heads; // Hk, key/query heads; value head h reads q/k head h/rep
    int seq;      // tokens this round
    int dk;       // key head dim
    int dv;       // value head dim
    int eps_bits; // l2norm epsilon, as float bits
    int _pad0;
    int _pad1;
#ifdef BDA
    DataBuf uOutBda;
    DataBuf uQBda;
    DataBuf uKBda;
    DataBuf uVBda;
    DataBuf uGBda;
    DataBuf uBetaBda;
    StateBuf uStateInBda;
    StateBuf uStateOutBda;
#endif
} uLinAttn;

#ifdef BDA
#define uOut uLinAttn.uOutBda
#define uQ uLinAttn.uQBda
#define uK uLinAttn.uKBda
#define uV uLinAttn.uVBda
#define uG uLinAttn.uGBda
#define uBeta uLinAttn.uBetaBda
#define uStateIn uLinAttn.uStateInBda
#define uStateOut uLinAttn.uStateOutBda
#endif

// The recurrent state is fp32 in every build (see the header note).
#define STATE_LOAD(idx) uintBitsToFloat(uStateIn.data[(idx)])
#define STATE_STORE(idx, v) (uStateOut.data[(idx)] = floatBitsToUint(float(v)))

shared float s_qn[MAX_HEAD_DIM];
shared float s_kn[MAX_HEAD_DIM];
// fp32 output of this token, deposited by the column lanes so one writer can
// pack a whole half2 word in the fp16 build.
shared float s_out[MAX_HEAD_DIM];
shared float s_qscale;

void main() {
    const int h = int(gl_WorkGroupID.x);
    const int lane = int(gl_LocalInvocationID.x);
    const int dk = uLinAttn.dk;
    const int dv = uLinAttn.dv;
    const int seq = uLinAttn.seq;

    if (h >= uLinAttn.heads) {
        return;
    }
    const int col = lane;
    const bool col_ok = col < dv;

    const float eps = uintBitsToFloat(uLinAttn.eps_bits);
    // q is normalized then scaled by 1/sqrt(dk); fold both into one factor.
    if (lane == 0) {
        s_qscale = inversesqrt(float(dk));
    }
    barrier();

    // Running state column, private to this lane (fp32).
    float s_col[MAX_HEAD_DIM];
    if (col_ok) {
        const uint sbase = uint(h) * uint(dk) * uint(dv);
        for (int i = 0; i < dk; i++) {
            s_col[i] = STATE_LOAD(sbase + uint(i) * uint(dv) + uint(col));
        }
    }

    // HF expands q/k to Hv heads with repeat_interleave, which the exporter
    // would have to spell as a Tile -- a per-token copy of the whole key tensor
    // (96 x ~50 MB at prefill). Folding the expansion into the index costs one
    // divide and no memory: value head h reads q/k head (h / rep).
    const int kh = (uLinAttn.kv_heads > 0 && uLinAttn.heads >= uLinAttn.kv_heads)
                       ? h / (uLinAttn.heads / uLinAttn.kv_heads)
                       : h;

    for (int t = 0; t < seq; t++) {
        const uint qbase = (uint(kh) * uint(seq) + uint(t)) * uint(dk);
        // --- shared l2 input for this token -----------------------------
        if (lane < dk) {
            s_qn[lane] = ACC_LOAD(uQ.data, qbase + uint(lane));
            s_kn[lane] = ACC_LOAD(uK.data, qbase + uint(lane));
        }
        barrier();
        if (lane == 0) {
            float qss = 0.0, kss = 0.0;
            for (int i = 0; i < dk; i++) {
                qss += s_qn[i] * s_qn[i];
                kss += s_kn[i] * s_kn[i];
            }
            const float qinv = inversesqrt(qss + eps) * s_qscale;
            const float kinv = inversesqrt(kss + eps);
            for (int i = 0; i < dk; i++) {
                s_qn[i] *= qinv;
                s_kn[i] *= kinv;
            }
        }
        barrier();

        // Every lane reaches every barrier in every iteration: the column work
        // is skipped with a branch, never a `continue` (a divergent barrier
        // operand is undefined).
        if (col_ok) {
            const uint gt = uint(h) * uint(seq) + uint(t);
            const float decay = exp(ACC_LOAD(uG.data, gt));
            const float beta = ACC_LOAD(uBeta.data, gt);

            for (int i = 0; i < dk; i++) {
                s_col[i] *= decay;
            }
            float kv = 0.0;
            for (int i = 0; i < dk; i++) {
                kv += s_col[i] * s_kn[i];
            }
            const float v =
                ACC_LOAD(uV.data, (uint(h) * uint(seq) + uint(t)) * uint(dv) +
                                      uint(col));
            const float delta = (v - kv) * beta;

            float acc = 0.0;
            for (int i = 0; i < dk; i++) {
                s_col[i] += s_kn[i] * delta;
                acc += s_col[i] * s_qn[i];
            }
            s_out[col] = acc;
        }
        barrier();

#if defined(FP16) && !defined(PACKED_FP16)
        if (col_ok) {
            uOut.data[(uint(h) * uint(seq) + uint(t)) * uint(dv) + uint(col)] =
                float16_t(s_out[col]);
        }
#elif defined(FP16)
        // One writer per uint word: lane w packs columns 2w and 2w+1. dv is
        // even for every real head dim, so a word never straddles heads.
        if (lane < (dv + 1) / 2) {
            const int c0 = 2 * lane;
            const int c1 = c0 + 1;
            vec2 p = vec2(s_out[c0], c1 < dv ? s_out[c1] : 0.0);
            uOut.data[(uint(h) * uint(seq) + uint(t)) * uint(dv) / 2u +
                      uint(lane)] = packHalf2x16(p);
        }
#else
        if (col_ok) {
            uOut.data[(uint(h) * uint(seq) + uint(t)) * uint(dv) + uint(col)] =
                floatBitsToUint(s_out[col]);
        }
#endif
        // The next iteration overwrites s_qn/s_kn/s_out, so this barrier keeps
        // the writers above from racing the next token's l2 pass.
        barrier();
    }

    // Write the final state column back (present may alias past; this lane
    // rewrites only its own column, which it has already read).
    if (col_ok) {
        const uint sbase = uint(h) * uint(dk) * uint(dv);
        for (int i = 0; i < dk; i++) {
            STATE_STORE(sbase + uint(i) * uint(dv) + uint(col), s_col[i]);
        }
    }
}
