#version 450 core

// ScatterElements SSBO op, general axis. Scatters updates into data along
// `axis`; supports reduction none / add / mul / max / min.
//
// ONNX requires indices and updates to have the same shape and data to share
// the rank. For index element i, every coordinate of its data destination equals
// i's own coordinate except along `axis`, where it is indices[i]. With
//   inner     = product(data.shape[axis+1:])   (trailing width)
//   idx_axis  = indices.shape[axis]
//   data_axis = data.shape[axis]
// one thread handles one index/update element:
//   inner_i = i % inner
//   outer   = (i / inner) / idx_axis
//   dst = (outer * data_axis + indices[i]) * inner + inner_i
//
// Dispatch: n_idx threads (n_idx = indices.numel() = updates.numel()).
//
// FP16 packing: data/updates are packed two fp16 per uint word. Two adjacent
// elements (col, col+1) share a word, so a thread updating one half MUST use a
// CAS on the whole word to avoid clobbering the other half (which a sibling
// thread may be updating concurrently). This is the fp16 word-CAS variant —
// it replaces the hostScatter CPU fallback (3x copyToCPU + host loop + reupload)
// that cost ~16ms/call (48ms/round, the single biggest per-op readback cost).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    uint data[];
} uData;
layout(set = 0, binding = 1) readonly buffer Indices {
    ivec2 data[];
} uIndices;
layout(set = 0, binding = 2) readonly buffer Updates {
    uint data[];
} uUpdates;

layout(push_constant) uniform PC {
    int n_threads; // n_idx = indices.numel() == updates.numel()
    int inner;     // product of dims after `axis` (trailing width)
    int idx_axis;  // indices.shape[axis]
    int data_axis; // data.shape[axis] — the coordinate the index selects
    int reduction; // 0=none 1=add 2=mul 3=max 4=min
    int data_total; // elements in data / output, for the target bounds check
    int _pad0;
    int _pad1;
} uPC;

// Merge an existing destination value `a` with the incoming `u`.
float combine(float a, float u) {
    if (uPC.reduction == 0) return u;         // none: overwrite
    if (uPC.reduction == 2) return a * u;     // mul
    if (uPC.reduction == 3) return max(a, u); // max
    if (uPC.reduction == 4) return min(a, u); // min
    return a + u;                             // add (1, the default)
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= uPC.n_threads) return;

    int inner_i = gid % uPC.inner;
    int outer = (gid / uPC.inner) / uPC.idx_axis;
    // int64 indices (bound as ivec2[], low 32 bits = value): gid is the flat
    // index-element position, so no row/col decomposition of the index itself
    // is needed here.
    int row = uIndices.data[gid].x; // target coordinate along `axis`
    int target = (outer * uPC.data_axis + row) * uPC.inner + inner_i;
    // Out-of-range here is a write into whatever memory neighbours the data
    // buffer (another tensor's bytes, or the weight blob), so drop it: a
    // dropped scatter is a wrong value in this op's own output. data_axis <= 0
    // means the host had no concrete data shape (dynamic dims) — skip the row
    // check and fall back to the flat target bound. data_total == 0 likewise.
    if (uPC.data_axis > 0 && (row < 0 || row >= uPC.data_axis)) return;
    if (uPC.data_total > 0 && (target < 0 || target >= uPC.data_total)) return;

#ifdef FP16
    // fp16: packed two-per-uint-word. target element index -> word + slot.
    // updates[gid] is also packed; read the correct half from its word.
    uint target_word = uint(target) >> 1;
    int target_slot = target & 1;
    uint upd_word = uUpdates.data[uint(gid) >> 1];
    float update = unpackHalf2x16(upd_word)[gid & 1];

    // Word-level CAS: read the whole word, modify only our half, CAS. Every
    // reduction (including 'none') uses CAS because a sibling thread may own
    // the other half of the same word (adjacent columns share a word).
    uint old_w = uData.data[target_word];
    for (;;) {
        vec2 p = unpackHalf2x16(old_w);
        p[target_slot] = combine(p[target_slot], update);
        uint new_w = packHalf2x16(p);
        uint result = atomicCompSwap(uData.data[target_word], old_w, new_w);
        if (result == old_w) break;
        old_w = result;
    }
#else
    float update = uintBitsToFloat(uUpdates.data[gid]);

    if (uPC.reduction == 0) {
        uData.data[target] = floatBitsToUint(update);
    } else {
        // CAS loop for a float atomic combine (GLSL has no float atomics).
        uint old = uData.data[target];
        for (;;) {
            uint expected = old;
            float new_val = combine(uintBitsToFloat(expected), update);
            uint new_bits = floatBitsToUint(new_val);
            uint result = atomicCompSwap(uData.data[target], expected, new_bits);
            if (result == expected) break;
            old = result;
        }
    }
#endif
}
