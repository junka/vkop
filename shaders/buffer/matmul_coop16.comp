#version 450 core

// SSBO cooperative-matrix MatMul, fp16 in / fp32 accumulate. The cooperative
// matrix tile is a build parameter (-DCM/-DCN/-DCK), so this one source covers
// the fp16 f32-accumulate shapes a device can list:
//   NVIDIA Ada:  16x16x16 / 16x8x16 / 16x8x8  (16x16x16 is the default build)
// Intel ARL lists 8x8x16, but that tile stays on matmul_coop.comp: with a
// single 8x8 MMA per K tile there is nothing for the double-buffered loads
// below to hide behind, and this source measured 10-36% slower there
// (m=16..63, k=2048, min-of-3, interleaved).
//
// The host probes VkCooperativeMatrixPropertiesKHR and builds the module for the
// largest M*N*K the device lists; a shape the driver does not list must never
// be dispatched (on Ada an unlisted shape still creates a pipeline but
// coopMatMulAdd produces garbage -> all-zero logits, seen with 8x8x16).
//
// Workgroup = 16x16 = 256 threads = 8 subgroups (sg size 32). Subgroup grid
// SG_M x SG_N (default 2 x 4) and ACC_M x ACC_N accumulator tiles per subgroup,
// so the workgroup output footprint is BM = SG_M*ACC_M*CM by
// BN = SG_N*ACC_N*CN. Each K-tile's shared A/B feeds SG_M*SG_N*ACC_M*ACC_N
// MMAs, amortizing the SSBO loads. The default 16x16x16 1x1 build is the
// original 32x64 footprint; -DACC_M=2 -DACC_N=2 covers 64x128 with the same 256
// threads, which is what makes the traffic per FLOP competitive:
//   traffic per FLOP = (1/BM + 1/BN)  ->  0.0469 (32x64) vs 0.0234 (64x128)
// and gives each subgroup four MMAs per K tile instead of one, which is the
// window the next tile's global loads hide behind.
//
// K loop: the shared tiles are double buffered and the global loads for tile
// t+1 are issued into registers *before* tile t's fragments load and MMAs run,
// then stored after them. The read/write rotation of two buffers needs one
// workgroup barrier per K tile. Storing straight from a load instead -- what
// this shader did before -- leaves the memory pipe idle until every warp's own
// load returns, with a barrier on both sides of it.
//
// Semantics (scratch + pack) are identical to matmul_coop.comp: fp32 results
// go to the flat scratch buffer (binding 3), then buffer_matmul_pack.comp
// repacks half2 words (odd-N safe). Descriptor layout (6 bindings) matches.

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_16bit_storage : enable

// Workgroup shape. The host's footprint constants for a variant must match the
// ACC_* values its SPIR-V was built with.
#ifndef ACC_M
#define ACC_M 1
#endif
#ifndef ACC_N
#define ACC_N 1
#endif
#ifndef SG_M
#define SG_M 2
#endif
#ifndef SG_N
#define SG_N 4
#endif
// Cooperative-matrix tile. -DCM/-DCN/-DCK let one source serve every fp16
// f32-accumulate shape a device may list (16x16x16, 16x8x16, 16x8x8, 8x8x16):
// the kernel body below is written in terms of the tile, so the only per-shape
// host-side constants are BM/BN. The device's K is fixed per shape, so CK is
// the same as the properties' KSize.
#ifndef CM
#define CM 16
#endif
#ifndef CN
#define CN 16
#endif
#ifndef CK
#define CK 16
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InA {
    uint data[];
} uInputA;
layout(set = 0, binding = 2) readonly buffer InB {
    uint data[];
} uInputB;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;
layout(set = 0, binding = 4) readonly buffer ScaleTab {
    uint data[];
} uScaleTab;
layout(set = 0, binding = 5) readonly buffer GlobalFac {
    uint data[];
} uGlobalFac;

layout(push_constant) uniform PC {
    int M;
    int N;
    int K;
    int batch;
    int fp32;   // unused (fp16-in only); kept for PC compat
    int transB; // 1 = B is [batch, N, K] (transposed); read B[j*K+k]
    // Tail of the host's GpuMatMulParam, declared so the offsets below match
    // it exactly and only b_shared + the grouped fields (via bmap) are read;
    // see matmul.comp / ops/Matmul.hpp for what each field means.
    int tile;
    int weight_int8;
    int w8_quad;
    int ksplit;
    int ksplit_q;
    int w4;
    int nf4;
    int group;
    int fp8;
    int fp8_e5m2;
    int nvfp4;
    int uint4;
    int wide;
    int rep;
    int rep_stride;
    int a_dim;
    int b_dim;
    float epi_scale;
    int epi_bias;
    int epi_bias_batch;
    int attn_softmax;
    int b_shared; // 1 = B is broadcast over the batch axes: B's slice index
                  // folds to 0 (a [K, N] weight shared by every output slice)
} uPC;

// Cooperative-matrix tile, as selected by the host from the device properties.
const int M_BLOCK = CM;
const int N_BLOCK = CN;
const int K_BLOCK = CK;

const int NTHREADS = SG_M * SG_N * 32;
const int BM = SG_M * ACC_M * M_BLOCK; // workgroup M footprint
const int BN = SG_N * ACC_N * N_BLOCK; // workgroup N footprint

// Per-thread staging: the whole workgroup's A[BM x K_BLOCK] and B[K_BLOCK x BN]
// split evenly. Every shape the host builds divides exactly, and a shape that
// did not would silently leave part of a tile unloaded, so it is a build error.
#if ((SG_M * SG_N) != 8)
#error "matmul_coop16: SG_M * SG_N must be 8 subgroups (256 threads)"
#endif
#if ((((SG_M * ACC_M * CM) * CK) % (SG_M * SG_N * 32)) != 0) || \
    (((CK * SG_N * ACC_N * CN) % (SG_M * SG_N * 32)) != 0)
#error "matmul_coop16: staging does not divide evenly over 256 threads"
#endif
const int A_ELEMS = (BM * K_BLOCK) / NTHREADS;
const int B_ELEMS = (K_BLOCK * BN) / NTHREADS;

// A flat batch index -> B's slice, when the host detected a grouped leading
// axis (uPC.rep > 1): the grouped axis repeats each B slice rep times
// consecutively (repeat_kv interleave), and any outer leading axes are shared.
// A fully broadcast B (a [K, N] weight shared by every output slice) is not a
// grouped axis at all -- the host raises uPC.b_shared instead, and the
// early-out below folds B's slice index to 0 for every n.
// Identical to the bmap() in matmul.comp (which see for the decomposition);
// the coop kernel maps the workgroup's z index through it once per tile.
int bmap(int n) {
    if (uPC.b_shared != 0) {
        return 0;
    }
    if (uPC.rep <= 1) {
        return n;
    }
    int a_span = uPC.rep_stride * uPC.a_dim;
    int rest = n % a_span;
    int prefix = n / a_span;
    int b_span = uPC.rep_stride * uPC.b_dim;
    return prefix * b_span +
           (rest / (uPC.rep * uPC.rep_stride)) * uPC.rep_stride +
           (rest % uPC.rep_stride);
}

// Load a fp16 element from a packed-half2 uint SSBO.
float16_t loadA(int elem) {
    return float16_t(unpackHalf2x16(uInputA.data[elem >> 1])[elem & 1]);
}
float16_t loadB(int elem) {
    return float16_t(unpackHalf2x16(uInputB.data[elem >> 1])[elem & 1]);
}

// Shared tiles laid out as float16_t, row-major, two buffers.
shared float16_t shA[2][BM * K_BLOCK]; // [BM x 16]
shared float16_t shB[2][K_BLOCK * BN]; // [16 x BN]
// Each subgroup stores its 16x16 fp32 result tile here before scattering.
// [sg][256] — one private 256-fp32 region per subgroup (no races). Reused by
// every accumulator tile in turn, so it does not scale with ACC_M*ACC_N.
shared float shC[SG_M * SG_N][M_BLOCK * N_BLOCK];

// Stage the workgroup's A slice for K tile t into registers. The flat
// thread-major walk keeps each thread's elements contiguous, so a warp reads
// contiguous 32-byte runs of a row instead of one strided element per lane.
void fetch_a(int a_base, int m0, int k_base, int M, int K,
             out float16_t va[A_ELEMS]) {
    int e0 = int(gl_LocalInvocationIndex) * A_ELEMS;
    for (int i = 0; i < A_ELEMS; ++i) {
        int e = e0 + i;
        int h = m0 + e / K_BLOCK;
        int kk = k_base + e % K_BLOCK;
        va[i] = (h < M && kk < K) ? loadA(a_base + h * K + kk) : float16_t(0.0);
    }
}

void fetch_b(int b_base, int n0, int k_base, int N, int K,
             out float16_t vb[B_ELEMS]) {
    int e0 = int(gl_LocalInvocationIndex) * B_ELEMS;
    for (int i = 0; i < B_ELEMS; ++i) {
        int e = e0 + i;
        int kk = k_base + e / BN;
        int w = n0 + e % BN;
        float16_t v = float16_t(0.0);
        if (kk < K && w < N) {
            if (uPC.transB != 0) {
                // B is [batch, N, K]: element (b, w, kk) at b_base + w*K + kk
                v = loadB(b_base + w * K + kk);
            } else {
                // B is [batch, K, N]: element (b, kk, w) at b_base + kk*N + w
                v = loadB(b_base + kk * N + w);
            }
        }
        vb[i] = v;
    }
}

void store_a(in float16_t va[A_ELEMS], int buf) {
    int e0 = int(gl_LocalInvocationIndex) * A_ELEMS;
    for (int i = 0; i < A_ELEMS; ++i) {
        shA[buf][e0 + i] = va[i];
    }
}

void store_b(in float16_t vb[B_ELEMS], int buf) {
    int e0 = int(gl_LocalInvocationIndex) * B_ELEMS;
    for (int i = 0; i < B_ELEMS; ++i) {
        shB[buf][e0 + i] = vb[i];
    }
}

// Scatter one accumulator tile from the subgroup's private shC slot to the flat
// fp32 scratch buffer. Global element index:
//   C[batch, m0 + (sgy*ACC_M+ai)*16 + row, n0 + (sgx*ACC_N+aj)*16 + col]
void scatter_tile(uint sg, uint lane, int sgy, int sgx, int ai, int aj, int m0,
                  int n0, int M, int N, int c_base) {
    const int ELEMS = (M_BLOCK * N_BLOCK) / 32;
    for (int e = 0; e < ELEMS; ++e) {
        int idx = int(lane) * ELEMS + e;
        int row = idx / N_BLOCK;
        int col = idx % N_BLOCK;
        int hg = m0 + (sgy * ACC_M + ai) * M_BLOCK + row;
        int wg = n0 + (sgx * ACC_N + aj) * N_BLOCK + col;
        if (hg < M && wg < N) {
            int out_elem = c_base + hg * N + wg;
            uScratch.data[out_elem] = floatBitsToUint(shC[sg][idx]);
        }
    }
}

// Accumulator tiles are written out by the preprocessor rather than held in an
// array: a GLSL array of cooperative matrices lowers to an OpTypeArray in
// Function storage, and a dynamic index keeps the value there (the driver
// cannot SROA an index it does not know), so the accumulator would round-trip
// through private memory once per K tile. One named tile per (ai, aj) keeps
// every cooperative matrix an SSA value.
#if ACC_M == 1 && ACC_N == 1
#define ACC_TILES(F) F(0, 0)
#elif ACC_M == 2 && ACC_N == 1
#define ACC_TILES(F) F(0, 0) F(1, 0)
#elif ACC_M == 1 && ACC_N == 2
#define ACC_TILES(F) F(0, 0) F(0, 1)
#elif ACC_M == 2 && ACC_N == 2
#define ACC_TILES(F) F(0, 0) F(0, 1) F(1, 0) F(1, 1)
#else
#error "matmul_coop16: unsupported ACC_M/ACC_N"
#endif

#define DECL_C(ai, aj)                                                      \
    coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,                      \
             gl_MatrixUseAccumulator>                                       \
        matC##ai##aj =                                                      \
            coopmat<float, gl_ScopeSubgroup, M_BLOCK, N_BLOCK,              \
                    gl_MatrixUseAccumulator>(0.0);

#define DECL_A(ai)                                                          \
    coopmat<float16_t, gl_ScopeSubgroup, M_BLOCK, K_BLOCK, gl_MatrixUseA>   \
        matA##ai;
#define LOAD_A(ai)                                                          \
    coopMatLoad(matA##ai, shA[buf],                                         \
                (sgy * ACC_M + ai) * M_BLOCK * K_BLOCK, K_BLOCK,            \
                gl_CooperativeMatrixLayoutRowMajor);
#define DECL_B(aj)                                                          \
    coopmat<float16_t, gl_ScopeSubgroup, K_BLOCK, N_BLOCK, gl_MatrixUseB>   \
        matB##aj;
#define LOAD_B(aj)                                                          \
    coopMatLoad(matB##aj, shB[buf], (sgx * ACC_N + aj) * N_BLOCK, BN,       \
                gl_CooperativeMatrixLayoutRowMajor);
#define MMA(ai, aj)                                                         \
    matC##ai##aj = coopMatMulAdd(matA##ai, matB##aj, matC##ai##aj);
#define STORE_C(ai, aj)                                                     \
    coopMatStore(matC##ai##aj, shC[sg], 0, N_BLOCK,                         \
                 gl_CooperativeMatrixLayoutRowMajor);                        \
    barrier();                                                              \
    scatter_tile(sg, lane, sgy, sgx, ai, aj, m0, n0, M, N, c_base);         \
    barrier();

void main() {
    int  b    = int(gl_WorkGroupID.z);     // batch index
    int  m0   = int(gl_WorkGroupID.y) * BM;
    int  n0   = int(gl_WorkGroupID.x) * BN;
    uint sg   = gl_SubgroupID;             // 0..SG_M*SG_N-1
    uint lane = gl_SubgroupInvocationID;   // 0..31
    int  sgx  = int(sg % SG_N);            // subgroup col (N)
    int  sgy  = int(sg / SG_N);            // subgroup row (M)

    int M = uPC.M;
    int N = uPC.N;
    int K = uPC.K;

    int a_base = b * M * K; // A[batch, :, :]
    int b_base = bmap(b) * K * N; // B[batch, :, :] (row-major K x N)
    int c_base = b * M * N;

    ACC_TILES(DECL_C)

    int k_tiles = (K + K_BLOCK - 1) / K_BLOCK;

    float16_t va[A_ELEMS];
    float16_t vb[B_ELEMS];

    // Prologue: tile 0 straight into buffer 0, then start rotating.
    fetch_a(a_base, m0, 0, M, K, va);
    fetch_b(b_base, n0, 0, N, K, vb);
    store_a(va, 0);
    store_b(vb, 0);
    barrier();

    int buf = 0;
    for (int t = 0; t < k_tiles; t++) {
        if (t + 1 < k_tiles) {
            // In flight while this tile's fragments load and MMAs run.
            fetch_a(a_base, m0, (t + 1) * K_BLOCK, M, K, va);
            fetch_b(b_base, n0, (t + 1) * K_BLOCK, N, K, vb);
        }

#if ACC_M == 1
        DECL_A(0) LOAD_A(0)
#else
        DECL_A(0) LOAD_A(0) DECL_A(1) LOAD_A(1)
#endif
#if ACC_N == 1
        DECL_B(0) LOAD_B(0)
#else
        DECL_B(0) LOAD_B(0) DECL_B(1) LOAD_B(1)
#endif
        ACC_TILES(MMA)

        if (t + 1 < k_tiles) {
            store_a(va, buf ^ 1);
            store_b(vb, buf ^ 1);
        }
        // Separates this tile's reads of shX[buf] and its writes to
        // shX[buf^1] from the next iteration's swap of both roles.
        barrier();
        buf ^= 1;
    }

    // fp32 results land in the flat scratch buffer; the pack pass
    // (buffer_matmul_pack.comp) reinterprets them as adjacent element pairs and
    // packs half2 words — correct for odd N, where a single output word can
    // straddle two rows (element 2w+1 of word w may belong to the next row's
    // col 0). In-shader packing would zero-fill the straddling half and clobber
    // the next row's first element; the flat scratch + dedicated
    // word-per-thread pack avoids that race and the cross-subgroup read it
    // would otherwise require.
    ACC_TILES(STORE_C)
}
