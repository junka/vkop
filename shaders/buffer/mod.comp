#version 450 core

// Elementwise binary SSBO op: Mod. One thread per output element (fp32) or per
// uint word (fp16 packed half2).
//
// `a - b * floor(a / b)` is ONNX's fmod: the C-style remainder, taking the
// sign of the dividend. GLSL's built-in `mod` takes the sign of the divisor
// instead, so it cannot be used here.
//
// No activation, same as min/max: the descriptor build has always ignored
// uPC.activation for this op.

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

float bin_op(float a, float b) { return a - b * floor(a / b); }

#include "../common/binary_elementwise_body.comp"
