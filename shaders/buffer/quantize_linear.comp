#version 450 core

// QuantizeLinear / DequantizeLinear SSBO op.
//
// Two use sites share this shader:
//
//   1. fp8 KV cache (internal). The LLM stores each layer's past/present
//      key_values as E4M3 (or E5M2) fp8 bytes (1 B/elem) to shrink KV-cache
//      VRAM; attention computes in fp16, so the graph wraps the cache boundary
//      with QuantizeLinear (fp16->fp8) and DequantizeLinear (fp8->fp16).
//
//   2. External QDQ int8/uint8 quantization. A model whose ONNX graph already
//      carries QuantizeLinear/DequantizeLinear nodes (e.g. ORT
//      quantize_dynamic output) is imported as-is; this shader runs those
//      nodes. int8/uint8 are asymmetric: scale + zero_point.
//
// Push constant `fmt` selects the byte format:
//   0 = fp8 E4M3 (sign|4 exp|3 mant, bias 7, +-448 finite, no zero_point)
//   1 = fp8 E5M2 (sign|5 exp|2 mant, bias 15, +-57344 finite, no zero_point)
//   2 = int8     (two's complement; x = (q - zp) * scale)
//   3 = uint8    (unsigned;        x = (q - zp) * scale)
//   4 = int4     (two's complement nibble; x = q * scale, symmetric)
//   5 = nf4      (4-bit codebook; x = codebook[q] * scale)
//
// `mode` selects direction: 0 = quantize (float->byte), 1 = dequant (byte->
// float). `scale` and `zp` are per-tensor scalars (per-axis is a later phase).
//
// The float side is fp16 (in_fp32=0) or fp32 (in_fp32=1 / out_fp32=1).
//
// Word packing: the byte side packs 4 values per uint word for the byte formats
// (0..3) and 8 for the 4-bit formats (4..5, two values per byte). The float side
// packs 2 values per uint word (fp16) or 1 (fp32). One thread per BYTE-WORD; the
// thread reads/writes the corresponding float word(s):
//   - byte formats: 4 values = 2 fp16 words / 4 fp32 words.
//   - 4-bit formats: 8 values = 4 fp16 words / 8 fp32 words.
// `total` is the element count (== byte count on the byte side for the byte
// formats; == 2x byte count for the 4-bit formats; == element count on the
// float side either way).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer OutBuf { uint data[]; } uOut;
layout(set = 0, binding = 1) readonly buffer InBuf { uint data[]; } uIn;

layout(push_constant) uniform PC {
    int mode;     // 0 = quantize, 1 = dequantize
    int total;    // element count
    float scale;  // per-tensor fp32 scale
    int zp;       // per-tensor zero_point (int); 0 for fp8
    int fmt;      // 0=e4m3, 1=e5m2, 2=int8, 3=uint8
    int out_fp32; // dequant: 1 = fp32 output
    int in_fp32;  // quant:   1 = fp32 input
    int _pad;
} uPC;

// ---- fp8 E4M3 decode (mirrors matmul.comp e4m3_val) ----------------------
float e4m3_decode(uint b) {
    uint m = b & 0x7Fu;
    float v = m > 7u
        ? uintBitsToFloat((m + 960u) << 20u)
        : float(m) * 0.001953125;  // subnormal: step 2^-9
    return (b & 0x80u) != 0u ? -v : v;
}

// ---- fp8 E5M2 decode (mirrors matmul.comp e5m2_val) ----------------------
float e5m2_decode(uint b) {
    uint m = b & 0x7Fu;
    float v = m > 3u
        ? uintBitsToFloat((m + 448u) << 21u)
        : float(m) * 1.52587890625e-05;  // subnormal: step 2^-16
    return (b & 0x80u) != 0u ? -v : v;
}

// ---- fp8 E4M3 encode (fp32 -> byte, round-to-nearest-even) ---------------
// Input is assumed already scaled (divided by uPC.scale). Returns the 8-bit
// code; sign in bit 7, 4 exp + 3 mant (bias 7). Saturates at 0x7e (never
// 0x7f Inf/NaN). Exact inverse of e4m3_decode on the finite grid.
uint e4m3_encode(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0x00u;
    float a = abs(x);
    const float min_normal = 0.015625;
    const float sub_step = 0.001953125;
    uint code;
    if (a >= min_normal) {
        uint bits = floatBitsToUint(a);
        int e32 = int((bits >> 23u) & 0xFFu) - 127;
        float frac = a / uintBitsToFloat(uint(e32 + 127) << 23u) - 1.0;
        int m_i = int(roundEven(frac * 8.0));
        if (m_i >= 8) { m_i = 0; e32 += 1; }
        int e_code = e32 + 7;
        if (e_code >= 15) {
            code = 0x7Eu;
        } else {
            code = (uint(e_code) << 3u) | uint(m_i);
        }
    } else {
        code = uint(roundEven(a / sub_step));
    }
    code = min(code, 0x7Eu);
    return sign | code;
}

// ---- fp8 E5M2 encode (fp32 -> byte, round-to-nearest-even) ---------------
// sign | 5 exp | 2 mant (bias 15), +-57344 finite, saturates at 0x7b (the
// largest finite magnitude; 0x7c..0x7f are Inf/NaN).
uint e5m2_encode(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0x00u;
    float a = abs(x);
    const float min_normal = 6.103515625e-05;  // 2^-14
    const float sub_step = 1.52587890625e-05;  // 2^-16
    uint code;
    if (a >= min_normal) {
        uint bits = floatBitsToUint(a);
        int e32 = int((bits >> 23u) & 0xFFu) - 127;
        float frac = a / uintBitsToFloat(uint(e32 + 127) << 23u) - 1.0;
        int m_i = int(roundEven(frac * 4.0));
        if (m_i >= 4) { m_i = 0; e32 += 1; }
        int e_code = e32 + 15;
        if (e_code >= 30) {
            code = 0x7Bu;  // largest finite E5M2 magnitude
        } else {
            code = (uint(e_code) << 2u) | uint(m_i);
        }
    } else {
        code = uint(roundEven(a / sub_step));
    }
    code = min(code, 0x7Bu);
    return sign | code;
}

// ---- int8 / uint8 encode (fp32 -> byte, round-to-nearest-even) -----------
// Input is the raw value (NOT pre-scaled): q = round(x / scale) + zp, then
// clamp to the format's range. zp is added in the integer domain so the
// decode (q - zp) * scale is an exact inverse on the grid.
uint int_encode(float x, bool is_uint) {
    float q = roundEven(x / uPC.scale) + float(uPC.zp);
    float lo = is_uint ? 0.0 : -128.0;
    float hi = is_uint ? 255.0 : 127.0;
    q = clamp(q, lo, hi);
    return uint(int(q)) & 0xFFu;
}

// ---- 4-bit formats (fmt 4 = int4, 5 = nf4) -------------------------------
// The NF4 codebook: the 16 quantiles of a unit-normal distribution, normalized
// so the extreme codes are exactly -1 and +1. A value is codebook[q] * scale,
// so the per-tensor scale holds the group absmax itself -- NOT absmax/7 as the
// symmetric int4 grid does. Byte-identical to matmul.comp's nf4_code, which is
// what makes a Q(4-bit)/DQ round-trip a pure quantization with no format drift.
float nf4_code(int q) {
    const float cb[16] = float[16](
        -1.0, -0.6961928009986877, -0.5250730514526367, -0.3949174189567566,
        -0.2844413814544678, -0.1847814998626709, -0.0910967006323811, 0.0,
        0.0795802986717224, 0.1601973110246658, 0.2447470557689667,
        0.3361703515052795, 0.4407098295211792, 0.5626170039176941,
        0.7229568369388580, 1.0);
    return cb[q];
}

// The nearest NF4 code for x (already divided by the scale). Unlike the int4
// grid this is not roundEven: the codebook is hand-tuned, so the closest of its
// 16 levels is chosen by an explicit sweep (16 compares, and only on the
// quantize side).
uint nf4_encode(float x) {
    uint best = 0u;
    float bd = abs(x - nf4_code(0));
    for (uint q = 1u; q < 16u; ++q) {
        float d = abs(x - nf4_code(int(q)));
        if (d < bd) { bd = d; best = q; }
    }
    return best;
}

// One 4-bit code -> float (value only; the caller applies the scale).
float nibble_decode(uint q) {
    if (uPC.fmt == 5) return nf4_code(int(q & 15u));
    // int4: bitfieldExtract with a signed result sign-extends the nibble into
    // [-8, 7] -- the two's-complement conversion without a compare.
    return float(bitfieldExtract(int(q) & 15, 0, 4));
}

// One float -> 4-bit code. The value is NOT pre-scaled: int4 divides by the
// scale and rounds to [-8, 7]; nf4 picks the nearest codebook entry of x/scale.
uint nibble_encode(float x) {
    if (uPC.fmt == 5) return nf4_encode(x / uPC.scale);
    float q = roundEven(x / uPC.scale);
    q = clamp(q, -8.0, 7.0);
    return uint(int(q)) & 0xFu;
}

// ---- decode dispatch -----------------------------------------------------
float decode_byte(uint b) {
    if (uPC.fmt == 0) return e4m3_decode(b) * uPC.scale;
    if (uPC.fmt == 1) return e5m2_decode(b) * uPC.scale;
    // int8 / uint8: (q - zp) * scale. uint8 reads the byte as unsigned
    // [0,255]; int8 sign-extends the byte's top bit into [-128,127].
    int q;
    if (uPC.fmt == 3) {
        q = int(b);                 // uint8: unsigned
    } else {
        uint raw = b & 0xFFu;
        q = (raw & 0x80u) != 0u     // int8: sign-extend
                ? int(raw | 0xFFFFFF00u)
                : int(raw);
    }
    return (float(q) - float(uPC.zp)) * uPC.scale;
}

uint encode_val(float x) {
    if (uPC.fmt == 0) return e4m3_encode(x / uPC.scale);
    if (uPC.fmt == 1) return e5m2_encode(x / uPC.scale);
    if (uPC.fmt >= 4) return nibble_encode(x);
    return int_encode(x, uPC.fmt == 3);
}

// ---- one float element on the float side ---------------------------------
// fp32: 1 value per word. fp16: 2 values per word. Bounds-clamped (an OOB read
// returns 0, an OOB write is skipped).
float load_float_at(int i) {
    if (uPC.in_fp32 != 0) {
        return (i < uPC.total) ? uintBitsToFloat(uIn.data[i]) : 0.0;
    }
    uint w = uIn.data[i / 2];
    vec2 a = unpackHalf2x16(w);
    return (i & 1) != 0 ? a.y : a.x;
}

void store_float_at(int i, float x) {
    if (i >= uPC.total) return;
    if (uPC.out_fp32 != 0) {
        uOut.data[i] = floatBitsToUint(x);
        return;
    }
    int w = i / 2;
    vec2 a = unpackHalf2x16(uOut.data[w]);
    // Read-modify-write: a thread owns a whole number of fp16 words (4 values
    // for the byte formats, 8 for the 4-bit ones), so the other half of this
    // word belongs to the same thread and no cross-invocation race exists.
    a[(i & 1)] = x;
    uOut.data[w] = packHalf2x16(a);
}

void main() {
    // Byte formats (0..3) pack 4 values per word; the 4-bit formats (4,5) pack 8.
    const int group = (uPC.fmt >= 4) ? 8 : 4;
    const int shift = (uPC.fmt >= 4) ? 4 : 8;

    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= (uPC.total + group - 1) / group) return;

    int i0 = group * gid;  // first element index this thread owns

    if (uPC.mode == 0) {
        // Quantize: float input -> packed output.
        uint packed = 0u;
        for (int k = 0; k < group; ++k) {
            if (i0 + k >= uPC.total) break;
            packed |= (encode_val(load_float_at(i0 + k)) << (k * shift));
        }
        uOut.data[gid] = packed;
    } else {
        // Dequantize: packed input -> float output.
        uint w = uIn.data[gid];
        const uint mask = (uint(1) << uint(shift)) - 1u;
        for (int k = 0; k < group; ++k) {
            if (i0 + k >= uPC.total) break;
            uint q = (w >> (k * shift)) & mask;
            float v = (uPC.fmt >= 4) ? nibble_decode(q) * uPC.scale
                                     : decode_byte(q);
            store_float_at(i0 + k, v);
        }
    }
}
