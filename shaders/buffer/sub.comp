#version 450 core

// Elementwise binary SSBO op: Sub, with ONNX right-aligned broadcasting +
// optional post-fuse activation. One thread per output element (fp32) or
// per uint word (fp16 packed half2).

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

#define BINARY_HAS_ACTIVATION 1

float bin_op(float a, float b) { return a - b; }

#include "../common/binary_elementwise_body.comp"
