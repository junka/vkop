#version 450 core

// Slice SSBO op (fp32). For each output element, map output nd-coords back
// to input via starts[i] + out[i]*steps[i], bounds-checked, then copy.
// 6-D cap (push-constant budget: rank + 5×IArr6 = 124 bytes ≤ 128).
// fp32-only (gather pattern would race on a shared half2 word).
//
// NB: this op uses IArr6/int[6] (NOT the IArr8/int[8] convention of the other
// buffer ops) so the push constant fits in 128 bytes — 5 full 8-int dim
// arrays (164 B) would overflow the 128 B PC budget. The nd<->linear math is
// the 6-D analogue of buffer_common.comp's linear_to_nd8/nd_to_linear8
// (row-major, left-aligned dims.v[0..rank-1]).

struct IArr6 { int v[6]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;

layout(push_constant) uniform PC_uSlice {
    int rank;
    IArr6 inDims;
    IArr6 outDims;
    IArr6 starts;
    IArr6 ends;
    IArr6 steps;
} uSlice;

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int rank = uSlice.rank;
    int total = 1;
    for (int i = 0; i < rank; ++i) total *= uSlice.outDims.v[i];
    if (gid >= total) return;

    // Decompose gid into an output nd-coordinate (row-major, dims.v[0] outer).
    int rem = gid;
    IArr6 out_coord;
    for (int i = 0; i < 6; ++i) out_coord.v[i] = 0;
    for (int i = rank - 1; i >= 0; --i) {
        out_coord.v[i] = rem % uSlice.outDims.v[i];
        rem /= uSlice.outDims.v[i];
    }

    // Map output coord → input coord via starts[i] + out[i]*steps[i], with a
    // bounds check against inDims.v[i].
    IArr6 in_coord;
    for (int i = 0; i < 6; ++i) in_coord.v[i] = 0;
    bool ok = true;
    for (int i = 0; i < rank; ++i) {
        int c = uSlice.starts.v[i] + out_coord.v[i] * uSlice.steps.v[i];
        if (c < 0 || c >= uSlice.inDims.v[i]) { ok = false; break; }
        in_coord.v[i] = c;
    }
    if (!ok) {
        uOutput.data[gid] = 0u;
        return;
    }

    // Re-compose the input nd-coordinate into a row-major linear index.
    int in_linear = 0;
    int stride = 1;
    for (int i = rank - 1; i >= 0; --i) {
        in_linear += in_coord.v[i] * stride;
        stride *= uSlice.inDims.v[i];
    }
    // uInput/uOutput are uint-word SSBOs holding fp32 bit patterns; copy the
    // raw word (NOT float(uint) which would numerically reinterpret the bit
    // pattern as an integer value and corrupt the data).
    uOutput.data[gid] = uInput.data[in_linear];
}
