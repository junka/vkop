#version 450 core

// Slice SSBO op. For each output element, map output nd-coords back to input
// via starts[i] + out[i]*steps[i], bounds-checked, then copy.
// 6-D cap (push-constant budget: rank + 5×IArr6 = 124 bytes ≤ 128).
//
// fp32 build: one thread per output element; words carry fp32 bit patterns and
// copy raw (NOT float(uint) which would numerically reinterpret the bit pattern
// as an integer value and corrupt the data). fp16 build (-DFP16): words pack two
// halfs, so one thread owns a whole output word (elements 2*gid, 2*gid+1) to
// avoid a read-modify-write race, and each half is extracted as raw bits —
// a Slice copies, so it must not round-trip through fp32.
//
// NB: this op uses IArr6/int[6] (NOT the IArr8/int[8] convention of the other
// buffer ops) so the push constant fits in 128 bytes — 5 full 8-int dim
// arrays (164 B) would overflow the 128 B PC budget. The nd<->linear math is
// the 6-D analogue of buffer_common.comp's linear_to_nd8/nd_to_linear8
// (row-major, left-aligned dims.v[0..rank-1]).

struct IArr6 { int v[6]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;

layout(push_constant) uniform PC_uSlice {
    int rank;
    IArr6 inDims;
    IArr6 outDims;
    IArr6 starts;
    IArr6 ends;
    IArr6 steps;
} uSlice;

// Linear input index of output element `e`, or -1 if any of its coordinates
// falls outside inDims (the caller zero-fills those).
int in_linear_of(int e) {
    int rem = e;
    IArr6 out_coord;
    for (int i = 0; i < 6; ++i) out_coord.v[i] = 0;
    for (int i = uSlice.rank - 1; i >= 0; --i) {
        out_coord.v[i] = rem % uSlice.outDims.v[i];
        rem /= uSlice.outDims.v[i];
    }

    int in_linear = 0;
    int stride = 1;
    for (int i = uSlice.rank - 1; i >= 0; --i) {
        int c = uSlice.starts.v[i] + out_coord.v[i] * uSlice.steps.v[i];
        if (c < 0 || c >= uSlice.inDims.v[i]) return -1;
        in_linear += c * stride;
        stride *= uSlice.inDims.v[i];
    }
    return in_linear;
}

#ifdef FP16
// The 16 bits of fp16 input element `e`, or 0 when e is past the input.
uint in_half(int e) {
    int lin = in_linear_of(e);
    if (lin < 0) return 0u;
    uint w = uInput.data[lin / 2];
    return (lin & 1) == 0 ? (w & 0xFFFFu) : (w >> 16);
}
#endif

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int total = 1;
    for (int i = 0; i < uSlice.rank; ++i) total *= uSlice.outDims.v[i];

#ifdef FP16
    int nwords = (total + 1) / 2;
    if (gid >= nwords) return;
    // Odd total: the last word's high half is past the tensor, and a coordinate
    // decomposition of element `total` would wrap to a valid one instead of
    // reading as out-of-range.
    uint hi = (2 * gid + 1 < total) ? in_half(2 * gid + 1) : 0u;
    uOutput.data[gid] = in_half(2 * gid) | (hi << 16);
#else
    if (gid >= total) return;
    int in_linear = in_linear_of(gid);
    uOutput.data[gid] = in_linear < 0 ? 0u : uInput.data[in_linear];
#endif
}
