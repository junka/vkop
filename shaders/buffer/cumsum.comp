#version 450 core

// Cumulative sum along one axis (ONNX CumSum). One workgroup owns one
// "line": every lane group fixed by the non-axis dims. Within a line the
// elements are strided by `axis_stride` in linear index space, and the
// workgroup walks them in order, carrying a running sum.
//
// Layout: the tensor is [outer, axis_len, axis_stride] -- the product of the
// dims before the axis, the axis itself, and the product after it. There are
// outer*axis_stride lines, which is exactly the workgroup count; line L is
// outer slice (L / axis_stride) at lane (L % axis_stride).
//
// fp32 only: the accumulation is order-dependent across lanes, and the fp16
// packed-word convention (two elements per uint) cannot carry a half2 sum
// without a cross-lane reduction. An fp16 tensor therefore runs this shader
// on its fp32 container (the converter keeps CumSum's input fp32).

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef BDA
layout(buffer_reference, std430, buffer_reference_align = 4) buffer DataBuf {
    uint data[];
};
#endif

#ifndef BDA
layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;
#endif

layout(push_constant) uniform PC_uCumsum {
    int axis;        // diagnostic only
    int axis_len;    // dims[axis]
    int axis_stride; // product of dims after the axis
    int lines;       // outer * axis_stride == workgroup count
    int exclusive;   // 1 = exclusive prefix
    int reverse;     // 1 = walk the line backwards
    int _pad0;
    int _pad1;
#ifdef BDA
    DataBuf uOutput;
    DataBuf uInput;
#endif
} uCumsum;

#ifdef BDA
#define uOutput uCumsum.uOutput
#define uInput uCumsum.uInput
#endif

void main() {
    // One workgroup per LINE. The tensor is [outer, len, stride] in the order
    // (dims before the axis, the axis, dims after it), so there are
    // outer*stride lines and line L belongs to outer slice (L / stride) at
    // lane (L % stride) within each axis step.
    const int line = int(gl_WorkGroupID.x);
    if (line >= uCumsum.lines) {
        return;
    }
    const int stride = uCumsum.axis_stride;
    const int len = uCumsum.axis_len;
    const int o = line / stride;
    const int s = line % stride;
    const uint base = uint(o) * uint(len) * uint(stride) + uint(s);

    // One workgroup walks the line sequentially. `len` is the sequence axis of
    // a decoder (thousands of tokens in prefill), so the loop is workgroup-
    // serial rather than lane-parallel: a prefix sum needs the running total,
    // and the extra parallelism would buy nothing on a memory-bound line.
    float acc = 0.0;
    for (int i = 0; i < len; i++) {
        const int j = uCumsum.reverse != 0 ? (len - 1 - i) : i;
        const uint idx = base + uint(j) * uint(stride);
        const float x = uintBitsToFloat(uInput.data[idx]);
        if (uCumsum.exclusive != 0) {
            uOutput.data[idx] = floatBitsToUint(acc);
            acc += x;
        } else {
            acc += x;
            uOutput.data[idx] = floatBitsToUint(acc);
        }
    }
}
