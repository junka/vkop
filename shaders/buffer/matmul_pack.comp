#version 450 core

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

// MatMul SSBO pack pass. Reads fp32 results from scratch, packs two values
// per output word -- half2, or bf16x2 when uPC.swiglu bit 1 is set (a bf16
// ACTIVATION MatMul, whose output is bf16: odd N lands here through the
// reduce kernel). One thread per output WORD.
// Separate shader to avoid Intel ANV push-constant interference between
// reduce and pack dispatches of the same pipeline.
//
// SwiGLU mode (uPC.swiglu != 0): the MatMul computed the plain product of x
// and the interleaved [K, 2*N_up] weight -- four gate columns then the same
// four up columns per octet -- so a thread reads four g and four u fp32 values
// and emits silu(g) * u as four halves. This is what the generic
// cooperative-matrix route uses: its epilogue has no activation, but it always
// deposits fp32 into the same flat scratch, so the activation folds in here.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef BDA
layout(buffer_reference, std430, buffer_reference_align = 4) buffer DataBuf {
    uint data[];
};
#endif

#ifndef BDA
layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 3) readonly buffer Scratch {
    uint data[];
} uScratch;
#endif

#include "../common/bf16.comp"

layout(push_constant) uniform PC {
    int total;   // output element count (the packed [.., N] result)
    // Flags. bit 0: scratch holds [rows, 2*N]; apply silu(g)*u while packing.
    //        bit 1: the output is bf16 (pack with packBF16x2, not half).
    int swiglu;
    int rows;    // swiglu only: batch * m
    int n_up;    // swiglu only: output columns (== total / rows)
#ifdef BDA
    DataBuf uOutput;
    DataBuf uScratch;
#endif
} uPC;

#ifdef BDA
#define uOutput uPC.uOutput
#define uScratch uPC.uScratch
#endif

uint pack2(vec2 v) {
    return (uPC.swiglu & 2) != 0 ? packBF16x2(v) : packHalf2x16(v);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    if ((uPC.swiglu & 1) != 0) {
        // One thread per four output halves. The weight interleaves gate and up
        // four columns at a time, so a row of the plain [rows, 2*n_up] product
        // reads g0 g1 g2 g3 u0 u1 u2 u3 g4 g5 g6 g7 u4 ..., i.e. within each
        // octet the four gate values sit at cols 0..3 and the matching four up
        // values at cols 4..7.
        int per_row = uPC.n_up >> 2;
        if (gid >= uPC.rows * per_row) return;
        int row = gid / per_row;
        int oct = gid % per_row;
        int in_base = row * (uPC.n_up * 2) + oct * 8;
        vec4 g = vec4(uintBitsToFloat(uScratch.data[in_base + 0]),
                      uintBitsToFloat(uScratch.data[in_base + 1]),
                      uintBitsToFloat(uScratch.data[in_base + 2]),
                      uintBitsToFloat(uScratch.data[in_base + 3]));
        vec4 u = vec4(uintBitsToFloat(uScratch.data[in_base + 4]),
                      uintBitsToFloat(uScratch.data[in_base + 5]),
                      uintBitsToFloat(uScratch.data[in_base + 6]),
                      uintBitsToFloat(uScratch.data[in_base + 7]));
        vec4 h = g / (1.0 + exp(-g)) * u;
        uOutput.data[2 * gid + 0] = pack2(h.xy);
        uOutput.data[2 * gid + 1] = pack2(h.zw);
        return;
    }
    int nwords = (uPC.total + 1) / 2;
    if (gid >= nwords) return;
    int e0 = 2 * gid;
    int e1 = e0 + 1;
    float v0 = uintBitsToFloat(uScratch.data[e0]);
    float v1 = (e1 < uPC.total) ? uintBitsToFloat(uScratch.data[e1]) : 0.0;
    uOutput.data[gid] = pack2(vec2(v0, v1));
}
