#version 450 core

// Conv2d SSBO (buffer backend). Naive direct convolution: one thread per
// output element Y[n,oc,oh,ow]. Compact row-major NCHW (no RGBA packing).
//
// fp32: single pass. Each thread reads X/W via uintBitsToFloat, accumulates
// in fp32, writes Y via floatBitsToUint.
//
// fp16: two-pass (mirrors buffer/matmul.comp). The reduce pass (THIS shader,
// built with -DFP16) reads X/W via unpackHalf2x16, accumulates in fp32 for
// precision, and writes the fp32 result to uScratch (one uint per output
// element — no half2 word race). A SEPARATE pack pass (buffer/matmul_pack.comp,
// reused) reads two adjacent fp32 scratch values and packs them as half2 into
// uOutput. bias is added in the reduce pass (into the fp32 sum) so the pack
// pass stays a pure repack.
//
// Bindings match MatMul (out=0, A=1, B=2, scratch=3) plus bias=4. The pack
// pass reuses buffer_matmul_pack which uses bindings 0 (out) and 3
// (scratch); the extra bias binding is inert there.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#endif

// Hardware fp8 weight decode (VK_EXT_shader_float8), the -DFP8_HW build only.
// OpCapability Float8EXT is a MODULE-wide capability, so this can never be a
// runtime branch in the portable module: a device without the extension
// rejects the whole module at pipeline creation. The host therefore builds a
// separate _fp8_hw module (Conv2dBuffer::fp8_hw_pipeline) and keeps the
// software decode as the fallback.
//
// The directives have to sit here, before any declaration: #extension is only
// legal at the top of the shader, and shaders/common/fp8_decode.comp (which
// defines the decode functions) is included further down.
#ifdef FP8_HW
#extension GL_EXT_float_e4m3 : require
#extension GL_EXT_float_e5m2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#endif

#include "../common/buffer_common.comp"

// Conv accumulates in fp32 (sum) and fuses activation in the fp32 domain too,
// so force activation.comp's FLOAT macros to fp32 regardless of the fp16 build
// (mirrors buffer/gemm.comp). BUF_LOAD returns float in both builds, so it is
// unaffected by redefining FLOAT here.
#undef FLOAT
#undef FLOAT2
#undef FLOAT4
#define FLOAT  float
#define FLOAT2 vec2
#define FLOAT4 vec4
#include "../common/activation.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaUintBuf {
    uint data[];
};
layout(set = 0, binding = 0) readonly buffer BdaTable {
    BdaUintBuf b0;
    BdaUintBuf b1;
    BdaUintBuf b2;
    BdaUintBuf b3;
    BdaUintBuf b4;
    BdaUintBuf b5;
} uBdaTable;
#define uOutput (uBdaTable.b0)
#define uInputX (uBdaTable.b1)
#define uInputW (uBdaTable.b2)
#define uScratch (uBdaTable.b3)
#define uBias (uBdaTable.b4)
#define uScale (uBdaTable.b5)
#else
layout(set = 0, binding = 0) writeonly buffer Out {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer InX {
    uint data[];
} uInputX;
layout(set = 0, binding = 2) readonly buffer InW {
    uint data[];
} uInputW;
layout(set = 0, binding = 3) buffer Scratch {
    uint data[];
} uScratch;
layout(set = 0, binding = 4) readonly buffer Bias {
    uint data[];
} uBias;
// Per-output-channel dequant scale for int8 weight-only quantization
// (binding 5). Inert when weight_int8 == 0. Optimizer stores
// scale = amax/127 per output channel, so dequant is w = int8_val * scale
// (NO extra *127 — that is the image path's convention, not the optimizer's).
layout(set = 0, binding = 5) readonly buffer Scale {
    uint data[];
} uScale;
#endif

layout(push_constant) uniform PC {
    int N, IC, ID, IH, IW;
    int OC, OD, OH, OW;
    int KD, KH, KW;
    int stride_d, stride_h, stride_w;
    int pad_d, pad_h, pad_w;
    int dil_d, dil_h, dil_w;
    int groups;
    int has_bias;
    int fp32; // 1 = fp32 single-pass (write uOutput); 0 = fp16 reduce (write uScratch)
    int activation; // ACTIVATION_* from activation.comp (0 = NONE)
    int weight_int8; // 1 = weights are byte-per-value (int8, or fp8 when fp8=1),
                     // dequantized via uScale; 0 = fp32/fp16
    int fp8;         // 1 = the byte payload is fp8 rather than two's complement
                     // int8. Rides on weight_int8 being set, exactly like
                     // GpuMatMulParam::fp8 -- same kernels, same scale table,
                     // only the byte-to-float step differs.
    int fp8_e5m2;    // 1 = the fp8 grid is E5M2 (5 exp, 2 mantissa) instead of
                     // E4M3. Only meaningful with fp8.
    int ow_blk; // output columns per thread: 1 = conv_fp element path,
                 // RW = conv_row3 register-blocked path (host gates the shape)
    int igemm;  // 0 = direct paths above; else the fp16 implicit-GEMM route:
                // the 3x3 tile width TW, or 128 for 1x1 (see conv_igemm3)
} uPC;

// fp32/fp16-weight convolution — the hot path. Same math as the int8 nest
// below, but the per-tap kernel-x bounds test is replaced by a clamped tap
// window: ix = offw + kx*dil_w must land in [0, IW), i.e.
// kx in [ceil(-offw/dil_w), floor((IW-1-offw)/dil_w)] intersected with [0, KW).
// Both numerators are non-negative where the divide runs, so the window is
// exact regardless of the integer-division rounding rule. Dropping the
// out-of-range taps up front removes three branches and the per-tap index
// recompute from the innermost loop; with dil_w == 1 the kx run becomes a
// straight FMA walk over two contiguous streams — the shape the naive GEMM
// reaches ~2.7 TFLOP/s on while this kernel was stuck at 0.385.
float conv_fp(int x_base_n, int w_base, int ic_base, int icg, int od, int oh,
              int ow) {
    const int HW = uPC.IH * uPC.IW;
    const int IDHW = uPC.ID * HW;
    const int KHW = uPC.KH * uPC.KW;
    const int dilw = uPC.dil_w;

    const int offw = ow * uPC.stride_w - uPC.pad_w;
    int kx0 = 0;
    int kx1 = 0;
    const int hi = uPC.IW - 1 - offw;
    if (hi >= 0) {
        const int lo = -offw;
        kx0 = lo > 0 ? (lo + dilw - 1) / dilw : 0;
        kx1 = min(hi / dilw + 1, uPC.KW);
    }

    float sum = 0.0;
    for (int kic = 0; kic < icg; ++kic) {
        const int xch = x_base_n + (ic_base + kic) * IDHW;
        int wk = w_base + kic * uPC.KD * KHW;
        for (int kd = 0; kd < uPC.KD; ++kd, wk += KHW) {
            const int idd = od * uPC.stride_d + kd * uPC.dil_d - uPC.pad_d;
            if (idd < 0 || idd >= uPC.ID) continue;
            const int xdp = xch + idd * HW;
            for (int ky = 0; ky < uPC.KH; ++ky) {
                const int iy = oh * uPC.stride_h + ky * uPC.dil_h - uPC.pad_h;
                if (iy < 0 || iy >= uPC.IH) continue;
                const int xrow = xdp + iy * uPC.IW + offw;
                const int wrow = wk + ky * uPC.KW;
                if (dilw == 1) {
                    for (int kx = kx0; kx < kx1; ++kx)
                        sum += BUF_LOAD(uInputX.data, xrow + kx) *
                               BUF_LOAD(uInputW.data, wrow + kx);
                } else {
                    for (int kx = kx0; kx < kx1; ++kx)
                        sum += BUF_LOAD(uInputX.data, xrow + kx * dilw) *
                               BUF_LOAD(uInputW.data, wrow + kx);
                }
            }
        }
    }
    return sum;
}

// One packed int8 weight byte, sign-extended. Byte-per-value payload: the
// container is a uint word holding four consecutive taps, low byte first, so
// the index math is widx>>2 / (widx&3)*8 and never goes through BUF_LOAD (which
// in the fp16 build strides two values per word -- the wrong layout here).
//
// Kept as its own function so the element path and the register-blocked path
// decode identically; a difference between them would show up as a tiny
// numeric drift that only the int8 3x3 case would ever hit.
int w8_at(int widx) {
    int b = int((uInputW.data[widx >> 2] >> ((widx & 3) * 8)) & 0xFF);
    // Sign-extend 8-bit to int (reinterpret as signed).
    return b >= 128 ? b - 256 : b;
}

// The byte-to-float decode for whichever quantized format the weight uses,
// shared with buffer/matmul.comp. Included here rather than copied: both
// kernels carry one byte per weight and one fp32 scale per output channel, so
// a second copy is how the two drift into decoding slightly different grids.
#include "../common/fp8_decode.comp"

// One quantized weight byte at a byte index, as a float BEFORE the per-channel
// scale. int8 weights come back as the sign-extended value (scale applied by
// the caller, matching matmul's convention); fp8 weights are decoded by f8_byte.
//
// uPC.weight_int8 is 1 for both int8 and fp8 payloads -- they share every gate
// and every kernel -- and uPC.fp8_e5m2 picks the fp8 grid. That mirrors
// GpuMatMulParam's fp8/fp8_e5m2 pair, so the two weight-only paths are driven
// by the same two flags.
float w_byte_at(int widx) {
    uint b = (uInputW.data[widx >> 2] >> ((widx & 3) * 8)) & 0xFFu;
    if (uPC.fp8 != 0) {
        return f8_byte(b, uPC.fp8_e5m2 != 0);
    }
    return float(w8_at(widx));
}

// Columns per thread in the register-blocked 3x3 path.
#define RW 8

// Register-blocked 3x3 convolution (stride_w == dil_w == 1): one thread computes
// RW contiguous output columns of one output row.
//
// The element path above reloads every input pixel KW times (once per output it
// feeds), which is what kept it at ~0.6 TFLOP/s: 2 loads per FMA. Here the
// RW+KW-1 = RW+2 input columns a chunk touches are staged once per (channel,
// kernel row) into scalars x0..x(RW+1) together with the 3 weights, so a chunk
// row costs RW+2+3 = 13 loads for RW*KW = 24 FMA instead of 48 — 0.54 loads per
// FMA. All indices are literal constants (no local arrays): a variable index
// would push the staging into thread-private memory and cost more than it saves.
//
// Accumulation order is exactly conv_fp's (ascending kic, kernel row, then kx),
// and out-of-range taps multiply a staged 0.0 rather than being skipped, so the
// result is bit-identical to the element path for finite weights.
void conv_row3(int x_base_n, int w_base, int ic_base, int icg, int od, int oh,
               int oc, int ow0, int out_lin) {
    const int HW = uPC.IH * uPC.IW;
    const int IDHW = uPC.ID * HW;
    const int KHW = uPC.KH * uPC.KW;
    const int IW = uPC.IW;
    // Column of tap (r, kx) is ow0 + r + kx - pad_w, i.e. x slot index r + kx.
    const int bw = ow0 - uPC.pad_w;
    // int8 weight: decode the three taps as signed bytes and apply the single
    // per-output-channel scale ONCE to the finished row sum, instead of once
    // per tap. The element path folds w_scale into every product; multiplying
    // a linear sum by a constant is the same value with one rounding instead
    // of 24, so this is both cheaper and slightly more accurate. Everything
    // else (tap order, staged x slots, masked-out taps multiplying 0.0) is
    // shared with the float path, so the two stay comparable.
    const bool w8 = uPC.weight_int8 != 0;
    const float w_scale = w8 ? BUF_LOAD(uScale.data, oc) : 1.0;

    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    float s4 = 0.0, s5 = 0.0, s6 = 0.0, s7 = 0.0;
    for (int kic = 0; kic < icg; ++kic) {
        const int xch = x_base_n + (ic_base + kic) * IDHW;
        int wk = w_base + kic * uPC.KD * KHW;
        for (int kd = 0; kd < uPC.KD; ++kd, wk += KHW) {
            const int idd = od * uPC.stride_d + kd * uPC.dil_d - uPC.pad_d;
            if (idd < 0 || idd >= uPC.ID) continue;
            const int xdp = xch + idd * HW;
            for (int ky = 0; ky < uPC.KH; ++ky) {
                const int iy = oh * uPC.stride_h + ky * uPC.dil_h - uPC.pad_h;
                if (iy < 0 || iy >= uPC.IH) continue;
                const int xrow = xdp + iy * IW + bw;
                const int wrow = wk + ky * uPC.KW;
                float x0 = (bw >= 0 && bw < IW) ? BUF_LOAD(uInputX.data, xrow) : 0.0;
                float x1 = (bw + 1 >= 0 && bw + 1 < IW) ? BUF_LOAD(uInputX.data, xrow + 1) : 0.0;
                float x2 = (bw + 2 >= 0 && bw + 2 < IW) ? BUF_LOAD(uInputX.data, xrow + 2) : 0.0;
                float x3 = (bw + 3 >= 0 && bw + 3 < IW) ? BUF_LOAD(uInputX.data, xrow + 3) : 0.0;
                float x4 = (bw + 4 >= 0 && bw + 4 < IW) ? BUF_LOAD(uInputX.data, xrow + 4) : 0.0;
                float x5 = (bw + 5 >= 0 && bw + 5 < IW) ? BUF_LOAD(uInputX.data, xrow + 5) : 0.0;
                float x6 = (bw + 6 >= 0 && bw + 6 < IW) ? BUF_LOAD(uInputX.data, xrow + 6) : 0.0;
                float x7 = (bw + 7 >= 0 && bw + 7 < IW) ? BUF_LOAD(uInputX.data, xrow + 7) : 0.0;
                float x8 = (bw + 8 >= 0 && bw + 8 < IW) ? BUF_LOAD(uInputX.data, xrow + 8) : 0.0;
                float x9 = (bw + 9 >= 0 && bw + 9 < IW) ? BUF_LOAD(uInputX.data, xrow + 9) : 0.0;
                // Three taps of one kernel row. Float weights come through
                // BUF_LOAD (which is dtype-aware); byte weights (int8 or fp8)
                // are three consecutive BYTES, so they decode with w_byte_at
                // and the scale stays out of the loop.
                float w0, w1, w2;
                if (w8) {
                    // w_byte_at handles int8 and both fp8 grids; the scale
                    // stays out of the loop and is applied once below.
                    w0 = w_byte_at(wrow);
                    w1 = w_byte_at(wrow + 1);
                    w2 = w_byte_at(wrow + 2);
                } else {
                    w0 = BUF_LOAD(uInputW.data, wrow);
                    w1 = BUF_LOAD(uInputW.data, wrow + 1);
                    w2 = BUF_LOAD(uInputW.data, wrow + 2);
                }
                s0 += x0 * w0; s0 += x1 * w1; s0 += x2 * w2;
                s1 += x1 * w0; s1 += x2 * w1; s1 += x3 * w2;
                s2 += x2 * w0; s2 += x3 * w1; s2 += x4 * w2;
                s3 += x3 * w0; s3 += x4 * w1; s3 += x5 * w2;
                s4 += x4 * w0; s4 += x5 * w1; s4 += x6 * w2;
                s5 += x5 * w0; s5 += x6 * w1; s5 += x7 * w2;
                s6 += x6 * w0; s6 += x7 * w1; s6 += x8 * w2;
                s7 += x7 * w0; s7 += x8 * w1; s7 += x9 * w2;
            }
        }
    }

    const float bias =
        (uPC.has_bias != 0) ? BUF_LOAD(uBias.data, oc) : 0.0;
    const int cnt = min(RW, uPC.OW - ow0); // tail chunk: fewer than RW columns
    for (int r = 0; r < cnt; ++r) {
        float v = (r == 0 ? s0 : (r == 1 ? s1 : (r == 2 ? s2 : (r == 3 ? s3
                    : (r == 4 ? s4 : (r == 5 ? s5 : (r == 6 ? s6 : s7)))))));
        // The int8 scale applies to the accumulated sum, before the bias (bias
        // is fp32 in the model, not scaled) -- same order as the element path.
        v = v * w_scale + bias;
        v = activation(v, uPC.activation);
        // fp32 single pass writes the output; the fp16 reduce pass writes fp32
        // scratch for the separate pack dispatch.
        if (uPC.fp32 != 0) {
            uOutput.data[out_lin + r] = floatBitsToUint(v);
        } else {
            uScratch.data[out_lin + r] = floatBitsToUint(v);
        }
    }
}

#ifndef FP8_HW
// ---------------------------------------------------------------------------
// Implicit-GEMM convolution (uPC.igemm != 0), fp32 accumulation. Built into
// both the fp32 and the fp16 module; only global staging and the final store
// differ between them.
//
// A KxK stride-1 dilation-1 ungrouped conv is the GEMM
//   Y[oc, p] = sum_k W[oc, k] * B[k, p],   k = (ic, ky, kx), p = (oh, ow)
// with W the weight in its own [OC, IC*KH*KW] layout (no reorder) and B the
// im2col of X -- which is never materialized: each K step stages the input
// patch its output pixels touch into shared memory, and the FMA loop reads
// the KH*KW taps out of that patch.
//
// Tile: TM output channels x TN output pixels per 256-lane workgroup, either
// 128 x 128 or 64 x 256 (3x3 only; uPC.igemm bit 8). Either way a lane owns an
// 8x8 block -- rows {ty*4..+3, TM/2+ty*4..+3}, pixels {tx*4..+3,
// TN/2+tx*4..+3} -- the matmul16_tiled128 geometry. For 3x3 the TN pixels are
// TR rows of TW = uPC.igemm & 0xFF columns (TW*TR = TN, TW in
// {16,32,64,128}), so each lane's two 4-pixel groups lie inside one output row
// each. For 1x1 (always 128 x 128) the pixels are simply 128 consecutive
// flattened positions.
//
// Shared layout (one K step):
//   sIgA: [k][row/4] vec4 -- the weight tile transposed to k-major, so a lane
//         fetches its 4 rows of one k as a single vec4 (2 per k for 8 rows).
//   sIgX: the fp32 input patch: [c][TR+2][TW+2] for 3x3 (a 1-pixel halo on
//         every side; positions outside the image hold 0), [c][128] for 1x1.
// 3x3: 2 input channels (18 k) per step; a lane reads 6 patch values per
// (channel, kernel row) and reuses them across the 3 kx taps, so each
// (channel, ky) costs 6 vec4 A + 12 scalar X reads for 192 FMAs.
// 1x1: 16 input channels per step, 2 vec4 A + 8 X reads per 64 FMAs.
// Threadgroup memory: 9216 + 8192 B; nothing else in this module uses any.
//
// Measured on the M5 Max (MoltenVK), fp32 VAE decoder shapes: 7.8-8.6
// TFLOP/s on full tiles (1152/576/288 channels), ~6.5 on 144 channels. What
// did not help: 4 input channels per step (more staging registers, -14%),
// fully unrolling the six (channel, ky) iterations (-20%).
//
// Global staging is register double-buffered (loads for step s+1 are issued
// before step s's FMA nest), as in matmul16_tiled128. A staging "word" is one
// uint of the SSBO: two halves in the fp16 build (IG_EPW = 2), one float in
// the fp32 build. The epilogue adds bias, applies the fused activation and
// writes the output directly -- in the fp16 build that means no fp32 scratch
// and no separate pack pass (pixel pairs are word-aligned because the host
// requires an even OW, resp. an even OH*OW for 1x1).
//
// Host gate (Conv2dBuffer::execute): float weights, groups == 1, stride 1,
// dilation 1, D == 1, 3x3 or 1x1 (pad 0). The fp16 build additionally needs
// even IC (weight rows word-aligned) and even IW/OW (3x3) or even OH*OW (1x1).
#ifdef FP16
#define IG_EPW 2
#else
#define IG_EPW 1
#endif
#define IG_ICB1 16  // input channels per K step, 1x1 path (3x3 uses 2)
// Staging slots per lane (ceil(words / 256)), sized for the larger geometry
// (conv_igemm3 loops over the ones its tile shape uses).
#define IG_NA3 ((128 * 18 / IG_EPW + 255) / 256)   // 5 (fp16) / 9 (fp32)
#define IG_NX3 (IG_EPW == 2 ? 3 : 5)               // patch words, see below
#define IG_NA1 (128 * IG_ICB1 / IG_EPW / 256)      // 4 / 8
#define IG_NX1 (IG_ICB1 * 128 / IG_EPW / 256)      // 4 / 8
shared vec4 sIgA[2 * 9 * 32];   // 576 vec4 = 9216 B (1x1 uses 512)
shared float sIgX[2048];        // 8192 B (3x3 uses <= 2 * 520)

// Accumulate one k: 8 rows (A0 = rows r..r+3, A1 = rows rh+r..+3) times 8
// pixels (BA = pixels p..p+3, BB = pixels nh+p..+3).
#define IG_FMA8R(A0, A1, BA, BB) { \
    acc00 += (A0).x * (BA); acc01 += (A0).x * (BB); \
    acc10 += (A0).y * (BA); acc11 += (A0).y * (BB); \
    acc20 += (A0).z * (BA); acc21 += (A0).z * (BB); \
    acc30 += (A0).w * (BA); acc31 += (A0).w * (BB); \
    acc40 += (A1).x * (BA); acc41 += (A1).x * (BB); \
    acc50 += (A1).y * (BA); acc51 += (A1).y * (BB); \
    acc60 += (A1).z * (BA); acc61 += (A1).z * (BB); \
    acc70 += (A1).w * (BA); acc71 += (A1).w * (BB); }

// Sixteen named accumulators rather than an array: the epilogue walks them
// with literal names, so nothing can be demoted to thread-private memory.
#define IG_ACC_DECL \
    vec4 acc00 = vec4(0.0), acc01 = vec4(0.0), acc10 = vec4(0.0), acc11 = vec4(0.0); \
    vec4 acc20 = vec4(0.0), acc21 = vec4(0.0), acc30 = vec4(0.0), acc31 = vec4(0.0); \
    vec4 acc40 = vec4(0.0), acc41 = vec4(0.0), acc50 = vec4(0.0), acc51 = vec4(0.0); \
    vec4 acc60 = vec4(0.0), acc61 = vec4(0.0), acc70 = vec4(0.0), acc71 = vec4(0.0);

// Bias + activation + store of one 4-pixel group. base is the linear output
// index of the group's first pixel, cnt how many of its 4 pixels exist (the
// fp16 build only ever sees 0, 2 or 4: pixel pairs are all-in or all-out).
void ig_store4(vec4 v, float bias, int base, int cnt) {
    if (cnt <= 0) return;
    v += bias;
    v.x = activation(v.x, uPC.activation);
    v.y = activation(v.y, uPC.activation);
    v.z = activation(v.z, uPC.activation);
    v.w = activation(v.w, uPC.activation);
#ifdef FP16
    uOutput.data[base >> 1] = packHalf2x16(v.xy);
    if (cnt >= 4) uOutput.data[(base >> 1) + 1] = packHalf2x16(v.zw);
#else
    uOutput.data[base] = floatBitsToUint(v.x);
    if (cnt >= 2) uOutput.data[base + 1] = floatBitsToUint(v.y);
    if (cnt >= 3) uOutput.data[base + 2] = floatBitsToUint(v.z);
    if (cnt >= 4) uOutput.data[base + 3] = floatBitsToUint(v.w);
#endif
}

#define IG_EPI_ROW(R, ACC0, ACC1) { \
    int _oc = oc0 + (R); \
    if (_oc < uPC.OC) { \
        float _b = (uPC.has_bias != 0) ? BUF_LOAD(uBias.data, _oc) : 0.0; \
        int _cb = (n * uPC.OC + _oc) * ostride; \
        ig_store4(ACC0, _b, _cb + o0, cnt0); \
        ig_store4(ACC1, _b, _cb + o1, cnt1); \
    } }

// rh = half the tile's row count: a lane's rows are ty*4..+3 and rh+ty*4..+3.
#define IG_EPILOGUE \
    IG_EPI_ROW(ty * 4 + 0, acc00, acc01) \
    IG_EPI_ROW(ty * 4 + 1, acc10, acc11) \
    IG_EPI_ROW(ty * 4 + 2, acc20, acc21) \
    IG_EPI_ROW(ty * 4 + 3, acc30, acc31) \
    IG_EPI_ROW(rh + ty * 4 + 0, acc40, acc41) \
    IG_EPI_ROW(rh + ty * 4 + 1, acc50, acc51) \
    IG_EPI_ROW(rh + ty * 4 + 2, acc60, acc61) \
    IG_EPI_ROW(rh + ty * 4 + 3, acc70, acc71)

// One weight word (IG_EPW consecutive k of one tile row) -> the transposed A
// tile, whose k stride is KS vec4 (TM / 4).
void ig_put_a(int k, int row, uint w, int KS) {
#ifdef FP16
    vec2 h = unpackHalf2x16(w);
    sIgA[k * KS + (row >> 2)][row & 3] = h.x;
    sIgA[(k + 1) * KS + (row >> 2)][row & 3] = h.y;
#else
    sIgA[k * KS + (row >> 2)][row & 3] = uintBitsToFloat(w);
#endif
}

// 3x3 tile geometry, from uPC.igemm: bits 0..7 = TW, bit 8 = the 64-channel x
// 256-pixel tile (else 128 x 128); main() passes bit 8 as a literal so the
// tile constants fold. Both give every lane the same 8x8 block; the 64-row
// tile wastes less on an output-channel count just past a multiple of 128
// (144, 288, 576 = 1.125, 2.25, 4.5 tiles of 128 but 2.25, 4.5, 9 tiles of
// 64), and a SIMD's 32 lanes share one tile row, so each A fetch is a single
// broadcast -- it was faster even where both grids are full.
void conv_igemm3(const bool m64) {
    const int tid = int(gl_LocalInvocationID.x);
    const int TM = m64 ? 64 : 128;      // output channels per tile
    const int TN = m64 ? 256 : 128;     // output pixels per tile
    const int TXN = TN >> 3;            // lanes across pixels (16 / 32)
    const int tx = tid % TXN;
    const int ty = tid / TXN;
    const int rh = TM >> 1;
    const int nh = TN >> 1;
    const int KS = TM >> 2;             // sIgA vec4 per k
    const int TW = uPC.igemm & 0xFF;
    const int TR = TN / TW;
    const int PW = TW + 2;
    const int PR = TR + 2;
    const int PCH = PR * PW;
    const int tiles_w = (uPC.OW + TW - 1) / TW;
    const int gx = int(gl_WorkGroupID.x);
    const int ow0 = (gx % tiles_w) * TW;
    const int oh0 = (gx / tiles_w) * TR;
    const int oc0 = int(gl_WorkGroupID.y) * TM;
    const int n = int(gl_WorkGroupID.z);
    const int IC = uPC.IC;
    const int IH = uPC.IH;
    const int IW = uPC.IW;

    // A staging: TM rows x 18 k (2 channels x 9 taps) per step = RWD words
    // per row. Row oc's words for channel pair ic0 start at (oc*IC*9 +
    // ic0*9) / IG_EPW; in the fp16 build IC and ic0 are even, so that start is
    // word-aligned. Slots whose row is past OC (or past the tile) read 0.
    const int RWD = 18 / IG_EPW;
    const int AW = TM * RWD;
    // Slots actually used by this tile shape. Both fold to constants once m64
    // is a literal, so the 64-row tile does not carry the 128-row tile's
    // staging registers (fp32: 5 + 5 instead of 9 + 5).
    const int NA = (AW + 255) / 256;
    const int NX = m64 ? IG_NX3 : (IG_EPW == 2 ? 2 : 4);
    const int kwords = (IC * 9) / IG_EPW;
    int a_off[IG_NA3];
    for (int j = 0; j < NA; ++j) {
        int w = tid + 256 * j;
        int row = w / RWD;
        bool ok = w < AW && oc0 + row < uPC.OC;
        a_off[j] = ok ? (oc0 + row) * kwords + (w - row * RWD) : -1;
    }
    // X staging: 2 channels x PR rows x NWR words of the TW+2-column patch.
    // fp32: one word per patch column, starting at the patch origin
    //   xs = ow0 - pad_w. fp16: the words start at the even column e0 at or
    //   below xs (IW even keeps every input row word-aligned and makes each
    //   word all-in or all-out of the image); the low half of word w is patch
    //   column (e0 - xs) + 2w, which is -1 for w = 0 when xs is odd, and the
    //   last word overhangs the patch by one column (xs odd) or entirely (xs
    //   even, e.g. pad 0): halves outside [0, PW) are dropped, never spilled
    //   into the next row.
    // Words per step: fp16 2*PR*(TW/2+2) <= 528, fp32 2*PR*(TW+2) <= 1040,
    // hence IG_NX3 = 3 / 5 slots.
    const int xs = ow0 - uPC.pad_w;
#ifdef FP16
    const int e0 = xs & ~1;
    const int NWR = (TW >> 1) + 2;
#else
    const int e0 = xs;
    const int NWR = PW;
#endif
    const int XW = 2 * PR * NWR;
    int x_off[IG_NX3];
    int x_dst[IG_NX3];
    int x_pc[IG_NX3];
    for (int j = 0; j < NX; ++j) {
        int e = tid + 256 * j;
        int c = e / (PR * NWR);
        int rem = e - c * PR * NWR;
        int r = rem / NWR;
        int w = rem - r * NWR;
        int iy = oh0 + r - uPC.pad_h;
        int col = e0 + IG_EPW * w;
        bool ok = e < XW && iy >= 0 && iy < IH && col >= 0 && col < IW;
        x_off[j] = ok ? (((n * IC + c) * IH + iy) * IW + col) / IG_EPW : -1;
        x_pc[j] = e < XW ? col - xs : -1000;   // -1000: slot unused
        x_dst[j] = c * PCH + r * PW + (col - xs);
    }

    // Channel 1 of a step exists unless IC is odd (fp32 build only) and this
    // is the last step; its words are then masked to 0 so it adds nothing.
    const bool c1_ok0 = IC > 1;
    uint ra[IG_NA3];
    uint rx[IG_NX3];
    for (int j = 0; j < NA; ++j) {
        bool ok = a_off[j] >= 0 && (c1_ok0 || ((tid + 256 * j) % RWD) * IG_EPW < 9);
        ra[j] = ok ? uInputW.data[a_off[j]] : 0u;
    }
    for (int j = 0; j < NX; ++j) {
        bool ok = x_off[j] >= 0 && (c1_ok0 || x_dst[j] < PCH);
        rx[j] = ok ? uInputX.data[x_off[j]] : 0u;
    }

    // This lane's two pixel groups inside the tile, as patch offsets.
    const int p0 = tx * 4;
    const int p1 = nh + tx * 4;
    const int pr0 = p0 / TW;
    const int pc0 = p0 - pr0 * TW;
    const int pr1 = p1 / TW;
    const int pc1 = p1 - pr1 * TW;
    const int xb0 = pr0 * PW + pc0;
    const int xb1 = pr1 * PW + pc1;
    const int x_step = 2 * IH * IW / IG_EPW;  // two channels, in words

    IG_ACC_DECL

    const int nsteps = (IC + 1) >> 1;
    for (int s = 0; s < nsteps; ++s) {
        barrier();
        for (int j = 0; j < NA; ++j) {
            int w = tid + 256 * j;
            if (w < AW) {
                int row = w / RWD;
                ig_put_a(IG_EPW * (w - row * RWD), row, ra[j], KS);
            }
        }
        for (int j = 0; j < NX; ++j) {
            int pc = x_pc[j];
#ifdef FP16
            vec2 h = unpackHalf2x16(rx[j]);
            if (pc >= 0 && pc < PW) sIgX[x_dst[j]] = h.x;
            if (pc + 1 >= 0 && pc + 1 < PW) sIgX[x_dst[j] + 1] = h.y;
#else
            if (pc >= 0) sIgX[x_dst[j]] = uintBitsToFloat(rx[j]);
#endif
        }
        barrier();
        if (s + 1 < nsteps) {
            const bool c1_ok = 2 * (s + 1) + 1 < IC;
            for (int j = 0; j < NA; ++j) {
                if (a_off[j] >= 0) a_off[j] += RWD;
                bool ok = a_off[j] >= 0;
#ifndef FP16
                ok = ok && (c1_ok || ((tid + 256 * j) % RWD) < 9);
#endif
                ra[j] = ok ? uInputW.data[a_off[j]] : 0u;
            }
            for (int j = 0; j < NX; ++j) {
                if (x_off[j] >= 0) x_off[j] += x_step;
                bool ok = x_off[j] >= 0;
#ifndef FP16
                ok = ok && (c1_ok || x_dst[j] < PCH);
#endif
                rx[j] = ok ? uInputX.data[x_off[j]] : 0u;
            }
        }
        // One (channel, kernel row) per iteration: 6 patch values per pixel
        // group, reused across the 3 kx taps, and all six A fetches issued
        // before the first FMA (interleaving them with the FMAs cost ~25%).
        // Fully unrolling these six iterations was slower still.
        for (int c = 0; c < 2; ++c) {
            for (int ky = 0; ky < 3; ++ky) {
                int q0 = c * PCH + ky * PW + xb0;
                int q1 = c * PCH + ky * PW + xb1;
                float u0 = sIgX[q0], u1 = sIgX[q0 + 1], u2 = sIgX[q0 + 2];
                float u3 = sIgX[q0 + 3], u4 = sIgX[q0 + 4], u5 = sIgX[q0 + 5];
                float v0 = sIgX[q1], v1 = sIgX[q1 + 1], v2 = sIgX[q1 + 2];
                float v3 = sIgX[q1 + 3], v4 = sIgX[q1 + 4], v5 = sIgX[q1 + 5];
                int kb = (c * 9 + ky * 3) * KS + ty;
                vec4 a00 = sIgA[kb], a01 = sIgA[kb + (KS >> 1)];
                vec4 a10 = sIgA[kb + KS], a11 = sIgA[kb + KS + (KS >> 1)];
                vec4 a20 = sIgA[kb + 2 * KS], a21 = sIgA[kb + 2 * KS + (KS >> 1)];
                IG_FMA8R(a00, a01, vec4(u0, u1, u2, u3), vec4(v0, v1, v2, v3))
                IG_FMA8R(a10, a11, vec4(u1, u2, u3, u4), vec4(v1, v2, v3, v4))
                IG_FMA8R(a20, a21, vec4(u2, u3, u4, u5), vec4(v2, v3, v4, v5))
            }
        }
    }

    const int ostride = uPC.OH * uPC.OW;
    const int oh_0 = oh0 + pr0;
    const int ow_0 = ow0 + pc0;
    const int oh_1 = oh0 + pr1;
    const int ow_1 = ow0 + pc1;
    const int cnt0 = oh_0 < uPC.OH ? clamp(uPC.OW - ow_0, 0, 4) : 0;
    const int cnt1 = oh_1 < uPC.OH ? clamp(uPC.OW - ow_1, 0, 4) : 0;
    const int o0 = oh_0 * uPC.OW + ow_0;
    const int o1 = oh_1 * uPC.OW + ow_1;
    IG_EPILOGUE
}

// 1x1: always the 128 x 128 tile.
void conv_igemm1() {
    const int tid = int(gl_LocalInvocationID.x);
    const int tx = tid & 15;
    const int ty = tid >> 4;
    const int rh = 64;
    const int P = uPC.OH * uPC.OW;  // == IH*IW (stride 1, pad 0)
    const int pix0 = int(gl_WorkGroupID.x) * 128;
    const int oc0 = int(gl_WorkGroupID.y) * 128;
    const int n = int(gl_WorkGroupID.z);
    const int IC = uPC.IC;

    // A: 128 rows x 16 channels per step (AWR words per row); X: 16 channels
    // x 128 pixels (XWR words per channel). A word is IG_EPW channels (A) or
    // pixels (X); in the fp16 build even IC / even P make it all-in or all-out.
    const int AWR = IG_ICB1 / IG_EPW;
    const int XWR = 128 / IG_EPW;
    int a_off[IG_NA1];
    int x_off[IG_NX1];
    for (int j = 0; j < IG_NA1; ++j) {
        int w = tid + 256 * j;
        int row = w / AWR;
        a_off[j] = oc0 + row < uPC.OC ? (oc0 + row) * (IC / IG_EPW) + (w - row * AWR) : -1;
    }
    for (int j = 0; j < IG_NX1; ++j) {
        int w = tid + 256 * j;
        int c = w / XWR;
        int px = pix0 + IG_EPW * (w - c * XWR);
        x_off[j] = px < P ? ((n * IC + c) * P + px) / IG_EPW : -1;
    }
    uint ra[IG_NA1];
    uint rx[IG_NX1];
    for (int j = 0; j < IG_NA1; ++j) {
        int k = IG_EPW * ((tid + 256 * j) % AWR);
        ra[j] = (a_off[j] >= 0 && k < IC) ? uInputW.data[a_off[j]] : 0u;
    }
    for (int j = 0; j < IG_NX1; ++j) {
        int c = (tid + 256 * j) / XWR;
        rx[j] = (x_off[j] >= 0 && c < IC) ? uInputX.data[x_off[j]] : 0u;
    }

    IG_ACC_DECL

    const int nsteps = (IC + IG_ICB1 - 1) / IG_ICB1;
    for (int s = 0; s < nsteps; ++s) {
        barrier();
        for (int j = 0; j < IG_NA1; ++j) {
            int w = tid + 256 * j;
            int row = w / AWR;
            ig_put_a(IG_EPW * (w - row * AWR), row, ra[j], 32);
        }
        for (int j = 0; j < IG_NX1; ++j) {
            int w = tid + 256 * j;
            int c = w / XWR;
            int d = c * 128 + IG_EPW * (w - c * XWR);
#ifdef FP16
            vec2 h = unpackHalf2x16(rx[j]);
            sIgX[d] = h.x;
            sIgX[d + 1] = h.y;
#else
            sIgX[d] = uintBitsToFloat(rx[j]);
#endif
        }
        barrier();
        if (s + 1 < nsteps) {
            int ic1 = (s + 1) * IG_ICB1;
            for (int j = 0; j < IG_NA1; ++j) {
                int k = IG_EPW * ((tid + 256 * j) % AWR);
                if (a_off[j] >= 0) a_off[j] += AWR;
                ra[j] = (a_off[j] >= 0 && ic1 + k < IC) ? uInputW.data[a_off[j]] : 0u;
            }
            for (int j = 0; j < IG_NX1; ++j) {
                int c = (tid + 256 * j) / XWR;
                if (x_off[j] >= 0) x_off[j] += (IG_ICB1 / IG_EPW) * P;
                rx[j] = (x_off[j] >= 0 && ic1 + c < IC) ? uInputX.data[x_off[j]] : 0u;
            }
        }
        // Two k per iteration, every shared read issued before the FMAs.
        for (int k = 0; k < IG_ICB1; k += 2) {
            int xb = k * 128 + tx * 4;
            vec4 b0 = vec4(sIgX[xb], sIgX[xb + 1], sIgX[xb + 2], sIgX[xb + 3]);
            vec4 b1 = vec4(sIgX[xb + 64], sIgX[xb + 65], sIgX[xb + 66], sIgX[xb + 67]);
            vec4 b2 = vec4(sIgX[xb + 128], sIgX[xb + 129], sIgX[xb + 130], sIgX[xb + 131]);
            vec4 b3 = vec4(sIgX[xb + 192], sIgX[xb + 193], sIgX[xb + 194], sIgX[xb + 195]);
            int kb = k * 32 + ty;
            vec4 a00 = sIgA[kb], a01 = sIgA[kb + 16];
            vec4 a10 = sIgA[kb + 32], a11 = sIgA[kb + 48];
            IG_FMA8R(a00, a01, b0, b1)
            IG_FMA8R(a10, a11, b2, b3)
        }
    }

    const int ostride = P;
    const int o0 = pix0 + tx * 4;
    const int o1 = pix0 + 64 + tx * 4;
    const int cnt0 = clamp(P - o0, 0, 4);
    const int cnt1 = clamp(P - o1, 0, 4);
    IG_EPILOGUE
}
#endif  // !FP8_HW

void main() {
#ifndef FP8_HW
    // Implicit-GEMM route (host-gated; the grid is tiles, not elements).
    if (uPC.igemm != 0) {
        if (uPC.KW == 1) {
            conv_igemm1();
        } else if ((uPC.igemm & 0x100) != 0) {
            conv_igemm3(true);  // literal arguments: the tile constants fold
        } else {
            conv_igemm3(false);
        }
        return;
    }
#endif
    int gid = int(gl_GlobalInvocationID.x);
    // 3D-convolution layout: input [N,IC,ID,IH,IW], weight [OC,icg,KD,KH,KW],
    // output [N,OC,OD,OH,OW]. A 2-D conv is the special case ID=OD=KD=1,
    // stride_d=pad_d=dil_d=0 (the host sets these so the D-loop runs once).
    //
    // Register-blocked dispatch: gid then indexes (output row, RW-column
    // chunk) instead of a single output element. The host only sets ow_blk for
    // 3x3 stride-1 dilution-1 fp32/fp16-weight shapes.
    if (uPC.ow_blk > 1) {
        const int chunks = (uPC.OW + RW - 1) / RW;
        const int row = gid / chunks; // [((n*OC + oc)*OD + od)*OH + oh]
        if (row >= uPC.N * uPC.OC * uPC.OD * uPC.OH) return;
        const int oh = row % uPC.OH;
        const int od = (row / uPC.OH) % uPC.OD;
        const int oc = (row / (uPC.OH * uPC.OD)) % uPC.OC;
        const int n = row / (uPC.OH * uPC.OD * uPC.OC);
        const int ocg = uPC.OC / uPC.groups;
        const int icg = uPC.IC / uPC.groups;
        conv_row3(n * uPC.IC * uPC.ID * uPC.IH * uPC.IW,
                  oc * (icg * uPC.KD * uPC.KH * uPC.KW), (oc / ocg) * icg, icg,
                  od, oh, oc, (gid - row * chunks) * RW,
                  row * uPC.OW + (gid - row * chunks) * RW);
        return;
    }

    int total = uPC.N * uPC.OC * uPC.OD * uPC.OH * uPC.OW;
    if (gid >= total) return;

    // Decode gid -> (n, oc, od, oh, ow) under row-major [N, OC, OD, OH, OW].
    int ow = gid % uPC.OW;
    int oh = (gid / uPC.OW) % uPC.OH;
    int od = (gid / (uPC.OW * uPC.OH)) % uPC.OD;
    int oc = (gid / (uPC.OW * uPC.OH * uPC.OD)) % uPC.OC;
    int n = gid / (uPC.OW * uPC.OH * uPC.OD * uPC.OC);

    int ocg = uPC.OC / uPC.groups; // output channels per group
    int icg = uPC.IC / uPC.groups; // input channels per group
    int g = oc / ocg;
    int ic_base = g * icg;
    // Weight is [OC, icg, KD, KH, KW] row-major.
    int w_base = oc * (icg * uPC.KD * uPC.KH * uPC.KW);
    // Input is [N, IC, ID, IH, IW] row-major.
    int x_base_n = n * uPC.IC * uPC.ID * uPC.IH * uPC.IW;

    // int8 weights: one dequant scale per output channel (read once).
    float w_scale = (uPC.weight_int8 != 0) ? BUF_LOAD(uScale.data, oc) : 0.0;

    float sum = 0.0;
    if (uPC.weight_int8 != 0) {
        // Byte-packed weights need per-tap index math, and no model runs int8
        // conv on the buffer hot path, so this branch keeps the original
        // general nest (test every tap, dequant inline).
        for (int kic = 0; kic < icg; ++kic) {
            for (int kd = 0; kd < uPC.KD; ++kd) {
                int idd = od * uPC.stride_d + kd * uPC.dil_d - uPC.pad_d;
                if (idd < 0 || idd >= uPC.ID) continue;
                for (int ky = 0; ky < uPC.KH; ++ky) {
                    int iy = oh * uPC.stride_h + ky * uPC.dil_h - uPC.pad_h;
                    if (iy < 0 || iy >= uPC.IH) continue;
                    for (int kx = 0; kx < uPC.KW; ++kx) {
                        int ix = ow * uPC.stride_w + kx * uPC.dil_w - uPC.pad_w;
                        if (ix < 0 || ix >= uPC.IW) continue;
                        int xidx = x_base_n +
                                   (ic_base + kic) * uPC.ID * uPC.IH * uPC.IW +
                                   idd * uPC.IH * uPC.IW + iy * uPC.IW + ix;
                        int widx = w_base +
                                   ((kic * uPC.KD + kd) * uPC.KH + ky) * uPC.KW +
                                   kx;
                        float wb = w_byte_at(widx);
                        sum += BUF_LOAD(uInputX.data, xidx) * (wb * w_scale);
                    }
                }
            }
        }
    } else {
        sum = conv_fp(x_base_n, w_base, ic_base, icg, od, oh, ow);
    }

    if (uPC.has_bias != 0) {
        sum += BUF_LOAD(uBias.data, oc);
    }

    // Fused activation (applied in the fp32 reduce domain, before pack).
    sum = activation(sum, uPC.activation);

    if (uPC.fp32 != 0) {
        uOutput.data[gid] = floatBitsToUint(sum);
    } else {
        // fp16 reduce pass: fp32 result to scratch (one uint per element).
        uScratch.data[gid] = floatBitsToUint(sum);
    }
}
