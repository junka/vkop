#version 450 core

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#define DTYPE float16_t
#else
#define DTYPE float
#endif

// -DBF16_TABLE: the data (table) input is a bfloat16 weight -- the embedding
// lookup of a bf16 checkpoint -- while the output stays in the activation
// dtype (fp32, or fp16 under -DFP16). The table is read as raw uint words,
// two bf16 per word with element 0 low, and each gathered value is widened to
// fp32 (exact) and then stored as DTYPE. Built as buffer_gather_bf16 /
// buffer_gather_bf16_fp16; ops/Gather.hpp binds it on its own pipeline. There
// is no -DBDA form of this build.
//
// -DBF16_OUT: the OUTPUT is a bfloat16 activation (--act bf16), stored as
// uint16_t bits (16-bit storage, one element per thread, so no two threads
// share a word). The table is bf16 (-DBF16_TABLE: a raw 16-bit copy, bit
// exact), fp16 (-DFP16) or fp32 (neither), the latter two narrowed with
// float_to_bf16 (RNE). Keys buffer_gather_bf16_out_bf16 /
// buffer_gather_fp16_out_bf16 / buffer_gather_fp32_out_bf16.
#if defined(BF16_TABLE) || defined(BF16_OUT)
#include "../common/bf16.comp"
#endif
#ifdef BF16_OUT
#extension GL_EXT_shader_16bit_storage : require
#ifdef BDA
#error "buffer/gather.comp has no -DBDA -DBF16_OUT build"
#endif
#endif

#ifdef BDA
#ifdef BF16_TABLE
#error "buffer/gather.comp has no -DBDA -DBF16_TABLE build"
#endif
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
// The data buffer is float16_t under -DFP16 and float otherwise; 4 covers the
// stricter fp32 case and is still satisfied by the 16-byte-aligned addresses
// the host hands out.
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaDataBuf {
    DTYPE data[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) buffer BdaIndexBuf {
    ivec2 data[];
};
layout(set=0, binding=0) readonly buffer BdaTable {
    BdaDataBuf b0;
    BdaDataBuf b1;
    BdaIndexBuf b2;
} uBdaTable;
#define uOutput (uBdaTable.b0)
#define uInput (uBdaTable.b1)
#define uIndex (uBdaTable.b2)
#else
#ifdef BF16_OUT
layout(set=0, binding=0) writeonly buffer outputBuffer { uint16_t data[]; } uOutput;
#else
layout(set=0, binding=0) writeonly buffer outputBuffer { DTYPE data[]; } uOutput;
#endif
#ifdef BF16_TABLE
layout(set=0, binding=1) readonly buffer inputBuffer { uint data[]; } uInput;
#else
layout(set=0, binding=1) readonly buffer inputBuffer { DTYPE data[]; } uInput;
#endif
// int64 indices: each element is 8 bytes; bound as ivec2[] and only the low
// 32 bits (.x) are read — correct for the model's small non-negative index
// values (reading as int[] would stride by 4 bytes and misread every element).
layout(set=0, binding=2) readonly buffer indexBuffer { ivec2 data[]; } uIndex;
#if defined(BF16_OUT) && defined(BF16_TABLE)
layout(set=0, binding=0) writeonly buffer outputVec { uvec4 data[]; } uOutputV;
layout(set=0, binding=1) readonly buffer inputVec { uvec4 data[]; } uInputV;
#define GATHER_ROW_FAST 1
#endif
#endif

// 8-int struct for shapes/coords (matches buffer_common.comp's IArr8 layout).
// Defined locally (not via #include) so this shader keeps its own DTYPE
// selection distinct from buffer_common.comp's macros.
struct IArr8 { int v[8]; };

// Push constant (std430). Up to 8-D shapes (left-aligned dims.v[0..rank-1],
// padded with 1). The old ivec4 layout (4-D cap) overflowed 5-D KV-cache
// gathers (inShape[4] bled into indicesShape); the IArr8 fields fix that.
layout(push_constant) uniform gatherBuffer {
    IArr8 inShape;       // data shape (idims valid entries)
    IArr8 indicesShape;  // indices tensor shape (nindex valid entries)
    IArr8 outShape;      // output shape (odims valid entries)
    int axis;
    int idims;
    int odims;
    int nindex; // rank of the indices tensor (NOT element count)
    // > 0: row fast path (axis 0, same 16-bit format in and out, row bytes a
    // multiple of 16): one thread per 16-byte chunk, row_vec chunks per row,
    // grid = indices count * row_vec. 0: the general per-element path.
    int row_vec;
} uGatherPara;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Row-major product of dims.v[0..rank-1].
int gather_total_size(IArr8 shape, int rank) {
    int size = 1;
    for (int i = 0; i < rank; ++i) size *= shape.v[i];
    return size;
}

// Row-major nd<->linear (left-aligned v[0..rank-1]); the 8-D analogue of
// buffer_common.comp's linear_to_nd8/nd_to_linear8.
int gather_nd_to_linear(IArr8 coord, IArr8 dims, int rank) {
    int linear = 0;
    int stride = 1;
    for (int i = rank - 1; i >= 0; --i) {
        linear += coord.v[i] * stride;
        stride *= dims.v[i];
    }
    return linear;
}

IArr8 gather_linear_to_nd(int linear, IArr8 dims, int rank) {
    IArr8 coord;
    for (int i = 0; i < 8; ++i) coord.v[i] = 0;
    for (int i = rank - 1; i >= 0; --i) {
        coord.v[i] = linear % dims.v[i];
        linear /= dims.v[i];
    }
    return coord;
}

void main()
{
#ifdef GATHER_ROW_FAST
    // Row copy (the adaLN modulation gathers of a DiT: [rows, C] tables
    // indexed per token): ~10x the per-element path's bandwidth.
    if (uGatherPara.row_vec > 0) {
        const int rv = uGatherPara.row_vec;
        const int g = int(gl_GlobalInvocationID.x);
        const int nidx = gather_total_size(uGatherPara.indicesShape,
                                           uGatherPara.nindex);
        if (g >= nidx * rv) return;
        const int r = g / rv;
        const int c = g - r * rv;
        const int axis_size = uGatherPara.inShape.v[0];
        int gi = uIndex.data[r].x;
        if (gi < 0) gi += axis_size;
        uOutputV.data[g] = (gi < 0 || gi >= axis_size)
                               ? uvec4(0u)
                               : uInputV.data[gi * rv + c];
        return;
    }
#endif
    int odims = uGatherPara.odims;
    int total_output_size = gather_total_size(uGatherPara.outShape, odims);
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= total_output_size) return;

    // 1. Linear output id -> row-major nd coordinate.
    IArr8 out_coord = gather_linear_to_nd(gid, uGatherPara.outShape, odims);

    // 2. Extract the indices sub-coordinate: output dims [axis, axis+nindex)
    //    carry the indices coordinate.
    IArr8 indices_coord;
    for (int i = 0; i < 8; ++i) indices_coord.v[i] = 0;
    for (int i = 0; i < uGatherPara.nindex; ++i) {
        indices_coord.v[i] = out_coord.v[uGatherPara.axis + i];
    }

    // 3. Read the gathered index value (low 32 bits of the int64 element).
    int indices_linear_idx =
        gather_nd_to_linear(indices_coord, uGatherPara.indicesShape,
                            uGatherPara.nindex);
    int total_indices_size =
        gather_total_size(uGatherPara.indicesShape, uGatherPara.nindex);
    if (indices_linear_idx >= total_indices_size || indices_linear_idx < 0) return;
    int gather_idx = uIndex.data[indices_linear_idx].x;

    // 4. Negative-index wrap, then the ONNX range requirement. A negative
    //    index wraps ONCE; anything still outside [0, axis_size) is invalid.
    //    Skip it and write a defined 0 rather than reading an arbitrary
    //    element — the host int64 path (Gather::cpuComputeInt64) makes the same
    //    choice, so a model cannot change behaviour with VKOP_HOST_SHAPE.
    int axis_size = uGatherPara.inShape.v[uGatherPara.axis];
    if (gather_idx < 0) gather_idx += axis_size;
    if (gather_idx < 0 || gather_idx >= axis_size) {
#ifdef BF16_OUT
        uOutput.data[gid] = uint16_t(0u);
#else
        uOutput.data[gid] = DTYPE(0.0);
#endif
        return;
    }

    // 5. Build the input coordinate: data dims [0,axis) and [axis+1,idims)
    //    come from the output coordinate (shifted past the indices block for
    //    the suffix), with the gathered index placed at `axis`.
    IArr8 in_coord;
    for (int i = 0; i < 8; ++i) in_coord.v[i] = 0;
    for (int i = 0; i < uGatherPara.axis; ++i) {
        in_coord.v[i] = out_coord.v[i];
    }
    in_coord.v[uGatherPara.axis] = gather_idx;
    int out_src_dim = uGatherPara.axis + uGatherPara.nindex;
    for (int i = uGatherPara.axis + 1; i < uGatherPara.idims; ++i) {
        in_coord.v[i] = out_coord.v[out_src_dim];
        ++out_src_dim;
    }

    // 6. Map to input linear index and copy the element (direct DTYPE copy —
    //    for fp16 each element is its own 16-bit slot, so no half2 word race).
    int input_linear_idx =
        gather_nd_to_linear(in_coord, uGatherPara.inShape, uGatherPara.idims);
    if (input_linear_idx >= 0) {
#if defined(BF16_OUT) && defined(BF16_TABLE)
        // bf16 -> bf16: move the 16 bits untouched.
        uOutput.data[gid] = uint16_t(
            (uInput.data[input_linear_idx >> 1] >> ((input_linear_idx & 1) * 16)) &
            0xFFFFu);
#elif defined(BF16_OUT)
        uOutput.data[gid] =
            uint16_t(float_to_bf16(float(uInput.data[input_linear_idx])));
#elif defined(BF16_TABLE)
        uOutput.data[gid] = DTYPE(bf16_to_float(
            uInput.data[input_linear_idx >> 1] >> ((input_linear_idx & 1) * 16)));
#else
        uOutput.data[gid] = uInput.data[input_linear_idx];
#endif
    }
}
