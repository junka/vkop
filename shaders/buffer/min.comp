#version 450 core

// Elementwise binary SSBO op: Min (element-wise minimum), with ONNX
// right-aligned broadcasting. One thread per output element (fp32) or per uint
// word (fp16 packed half2).
//
// No activation: this op's descriptor build has always ignored uPC.activation,
// so BINARY_HAS_ACTIVATION stays undefined and the shared body returns the raw
// result. The PC still carries the field (one layout for every binary op).

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

float bin_op(float a, float b) { return min(a, b); }

#include "../common/binary_elementwise_body.comp"
