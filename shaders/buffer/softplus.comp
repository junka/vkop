#version 450 core

// Elementwise unary SSBO op: Softplus. One thread per output element (fp32)
// or per uint word (fp16 packed half2). Self-contained (no op_code switch).

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

// max(x, 0) + log(1 + exp(-|x|)): the same function, but exp never sees a
// positive argument, so x > ~88 no longer overflows exp to Inf (the naive
// log(exp(x) + 1) returned +Inf there, where softplus(x) == x). bf16 carries
// fp32's range, so such inputs are ordinary activations, not corner cases.
float apply(float x) { return max(x, 0.0) + log(1.0 + exp(-abs(x))); }

#include "../common/unary_elementwise_body.comp"
