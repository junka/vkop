#version 450 core
#extension GL_EXT_scalar_block_layout : enable

// Concat SSBO op (fp32). Per-input submit (host binds this input + the
// output and dispatches UP_DIV(in_total,256)). For each input element,
// map its nd-coords and copy to out_nd with out_nd[axis] += offset.
//
// Push constant shapes are flat int arrays (not a struct) — the image-path
// shaders use the same convention and it avoids GLSL/struct-in-PC quirks.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "../common/buffer_common.comp"

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaUintBuf {
    uint data[];
};
layout(set = 0, binding = 0) readonly buffer BdaTable {
    BdaUintBuf b0;
    BdaUintBuf b1;
} uBdaTable;
#define uOutput (uBdaTable.b0)
#define uInput (uBdaTable.b1)
#else
layout(set = 0, binding = 0) buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;
#endif

layout(push_constant) uniform PC_uConcat {
    int axis;
    int rank;
    IArr8 inDims;
    IArr8 outDims;
    int offset;
    int _pad0;
    int _pad1;
    int _pad2;
} uConcat;

// Map an input element index to the output element index (axis offset added).
// Concat only shifts the axis coordinate, so with inner = prod(dims after
// axis) an input element e lands at
//   (e / blk_in) * blk_out + offset * inner + e % blk_in
// where blk_in = inDims[axis] * inner and blk_out = outDims[axis] * inner:
// one div/mod instead of a full N-d decomposition per element.
// Dims are copied out of the push constant before being indexed by the
// runtime axis: indexing the push-constant array directly reads wrong values
// once SPIRV-Cross lowers it to MSL (every input landed at offset 0).
int concat_inner(IArr8 od, int axis, int rank) {
    int inner = 1;
    for (int i = axis + 1; i < rank; ++i) inner *= od.v[i];
    return inner;
}

int concat_elem(int e, int blk_in, int blk_out, int base) {
    int q = e / blk_in;
    return q * blk_out + base + (e - q * blk_in);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int rank = uConcat.rank;
    int in_total = 1;
    for (int i = 0; i < rank; ++i) in_total *= uConcat.inDims.v[i];
    IArr8 id = uConcat.inDims;
    IArr8 od = uConcat.outDims;
    int axis = uConcat.axis;
    int inner = concat_inner(od, axis, rank);
    int blk_in = id.v[axis] * inner;
    int blk_out = od.v[axis] * inner;
    int base = uConcat.offset * inner;
#ifdef FP16
    // Word-aligned case: both blocks and the shift are even, so every input
    // word maps whole onto one output word.
    if (((blk_in | blk_out | base) & 1) == 0) {
        int nw = in_total >> 1;
        if (gid >= nw) return;
        int hb_in = blk_in >> 1;
        int q = gid / hb_in;
        uOutput.data[q * (blk_out >> 1) + (base >> 1) + (gid - q * hb_in)] =
            uInput.data[gid];
        return;
    }
    // Odd blocks: an output word can straddle two inputs, which are written
    // by separate dispatches, so a whole-word store would clobber the half
    // that belongs to the neighbouring input. Write each half on its own with
    // atomics (clear our half, then set it); the other half is never touched.
    int nwords = (in_total + 1) / 2;
    if (gid >= nwords) return;
    uint w = uInput.data[gid];
    for (int h = 0; h < 2; ++h) {
        int e = 2 * gid + h;
        if (e >= in_total) break;
        int o = concat_elem(e, blk_in, blk_out, base);
        uint sh = uint(o & 1) * 16u;
        uint bits = ((w >> (uint(h) * 16u)) & 0xFFFFu) << sh;
        atomicAnd(uOutput.data[o >> 1], ~(0xFFFFu << sh));
        atomicOr(uOutput.data[o >> 1], bits);
    }
#else
    if (gid >= in_total) return;
    uOutput.data[concat_elem(gid, blk_in, blk_out, base)] = uInput.data[gid];
#endif
}
