#version 450 core

// Elementwise unary SSBO op: Tanh. One thread per output element (fp32)
// or per uint word (fp16 packed half2). Self-contained (no op_code switch).

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

#include "../common/buffer_common.comp"

float apply(float x) { return tanh(x); }

#include "../common/unary_elementwise_body.comp"
