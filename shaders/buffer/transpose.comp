#version 450 core

// Transpose SSBO op (fp32). Arbitrary perm up to 8-D. For each output
// element, out_nd -> in_nd via in_nd[perm[i]] = out_nd[i], then copy.
// perm is a permutation of [0..rank-1].

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;

layout(push_constant) uniform PC_uTrans {
    int rank;
    IArr8 inDims;
    IArr8 outDims;
    IArr8 perm;
} uTrans;

// Map an output element index to the input element index via the perm:
// out_coord -> in_coord[perm[i]] = out_coord[i].
int transpose_elem(int gid) {
    IArr8 out_coord = linear_to_nd8(gid, uTrans.outDims, uTrans.rank);
    IArr8 in_coord;
    for (int i = 0; i < 8; ++i) in_coord.v[i] = 0;
    for (int i = 0; i < uTrans.rank; ++i) {
        in_coord.v[uTrans.perm.v[i]] = out_coord.v[i];
    }
    return nd_to_linear8(in_coord, uTrans.inDims, uTrans.rank);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int rank = uTrans.rank;
    int out_total = 1;
    for (int i = 0; i < rank; ++i) out_total *= uTrans.outDims.v[i];

#ifdef FP16
    // fp16 packs two halfs per uint word. One thread per output word: elements
    // 2*gid (lo half) and 2*gid+1 (hi half). Each output element reads its own
    // (non-contiguous under transpose) input element via BUF_LOAD (which
    // unpacks the source half2), and the two results are packed into one word
    // written once — no read-modify-write race.
    int nwords = (out_total + 1) / 2;
    if (gid >= nwords) return;
    int e0 = 2 * gid;
    int e1 = 2 * gid + 1;
    float v0 = BUF_LOAD(uInput.data, transpose_elem(e0));
    if (e1 >= out_total) {
        uOutput.data[gid] = packHalf2x16(vec2(v0, 0.0));
    } else {
        float v1 = BUF_LOAD(uInput.data, transpose_elem(e1));
        uOutput.data[gid] = packHalf2x16(vec2(v0, v1));
    }
#else
    if (gid >= out_total) return;
    uOutput.data[gid] = floatBitsToUint(float(BUF_LOAD(uInput.data, transpose_elem(gid))));
#endif
}
