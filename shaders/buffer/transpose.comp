#version 450 core

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#endif

// Transpose SSBO op (fp32). Arbitrary perm up to 8-D. For each output
// element, out_nd -> in_nd via in_nd[perm[i]] = out_nd[i], then copy.
// perm is a permutation of [0..rank-1].

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef BDA
layout(buffer_reference, std430, buffer_reference_align = 4) buffer DataBuf {
    uint data[];
};
#endif

#ifndef BDA
layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;
#endif

layout(push_constant) uniform PC_uTrans {
    int rank;
    IArr8 inDims;
    IArr8 outDims;
    IArr8 perm;
    int chunk;  // fp16: words per thread (4 = kept innermost dim, % 8 == 0)
#ifdef BDA
    // Matches ops::TransposeBdaPC: 104-byte scalar prefix (chunk at 100),
    // pointers at 104/112 (120 B total).
    DataBuf uOutput;
    DataBuf uInput;
#endif
} uTrans;

#ifdef BDA
#define uOutput uTrans.uOutput
#define uInput uTrans.uInput
#endif

// Map an output element index to the input element index via the perm:
// out_coord -> in_coord[perm[i]] = out_coord[i].
int transpose_elem(int gid) {
    IArr8 out_coord = linear_to_nd8(gid, uTrans.outDims, uTrans.rank);
    IArr8 in_coord;
    for (int i = 0; i < 8; ++i) in_coord.v[i] = 0;
    for (int i = 0; i < uTrans.rank; ++i) {
        in_coord.v[uTrans.perm.v[i]] = out_coord.v[i];
    }
    return nd_to_linear8(in_coord, uTrans.inDims, uTrans.rank);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    int rank = uTrans.rank;
    int out_total = 1;
    for (int i = 0; i < rank; ++i) out_total *= uTrans.outDims.v[i];

#ifdef FP16
    if (uTrans.chunk == 4) {
        // 8 halves = 4 words, contiguous in both tensors: one decomposition.
        if (gid >= out_total / 8) return;
        int w = transpose_elem(8 * gid) >> 1;
        for (int j = 0; j < 4; ++j) {
            uOutput.data[4 * gid + j] = uInput.data[w + j];
        }
        return;
    }
    // fp16 packs two halfs per uint word. One thread per output word: elements
    // 2*gid (lo half) and 2*gid+1 (hi half). Each output element reads its own
    // (non-contiguous under transpose) input element via BUF_LOAD (which
    // unpacks the source half2), and the two results are packed into one word
    // written once — no read-modify-write race.
    int nwords = (out_total + 1) / 2;
    if (gid >= nwords) return;
    int e0 = 2 * gid;
    int e1 = 2 * gid + 1;
    const int last = rank - 1;
    if ((uTrans.outDims.v[last] & 1) == 0) {
        // Even output rows: e1 is e0's neighbour along the last output axis,
        // one input stride of that axis further -- decode once.
        int ax = uTrans.perm.v[last];
        int stride = 1;
        for (int i = ax + 1; i < rank; ++i) stride *= uTrans.inDims.v[i];
        int i0 = transpose_elem(e0);
        uOutput.data[gid] = packHalf2x16(vec2(BUF_LOAD(uInput.data, i0),
                                              BUF_LOAD(uInput.data, i0 + stride)));
        return;
    }
    float v0 = float(BUF_LOAD(uInput.data, transpose_elem(e0)));
    if (e1 >= out_total) {
        uOutput.data[gid] = packHalf2x16(vec2(v0, 0.0));
    } else {
        float v1 = float(BUF_LOAD(uInput.data, transpose_elem(e1)));
        uOutput.data[gid] = packHalf2x16(vec2(v0, v1));
    }
#else
    if (gid >= out_total) return;
    uOutput.data[gid] = floatBitsToUint(float(BUF_LOAD(uInput.data, transpose_elem(gid))));
#endif
}
