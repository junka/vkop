#version 450 core
#extension GL_EXT_scalar_block_layout : enable

// Expand (SSBO): broadcast the input tensor to the output shape using ONNX
// right-aligned broadcasting. The output shape (already the element-wise max of
// the input shape and the ONNX target shape, so an input dim larger than the
// target dim is kept) and the input shape are passed in the push constant as
// 8-int dim arrays (left-aligned: dims[0..rank-1]); the host computes them so
// the shader does not have to decode the int64 shape buffer (which the runtime
// emits as 64-bit ints). Supports up to rank 8 (was rank 4 — the LLM attention
// key/value Expand broadcasts a 5-D [1,8,1,1,128] -> [1,8,8,1,128]).
//
// fp16 packs two halfs per uint word. To stay race-free each thread owns a
// whole output word (elements 2*gid and 2*gid+1) and writes it once — no
// read-modify-write. The fp32 path is one element per thread.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "../common/buffer_common.comp"

layout(set = 0, binding = 0) buffer outputBuffer {
    uint data[];
} uOutput;

layout(set = 0, binding = 1) readonly buffer inputBuffer {
    uint data[];
} uInput;

// Shape buffer is still bound (binding 2) for descriptor-set compatibility but
// is not read by the shader — the output shape comes from the push constant.
layout(set = 0, binding = 2) readonly buffer shapeBuffer {
    uint data[];
} uShape;

layout(push_constant) uniform paraBuffer {
    int rank;          // number of valid dims (1..8)
    int fp16;          // 1 = fp16 packed, 0 = fp32
    IArr8 inDims;      // input dims (left-aligned, padded with 1)
    IArr8 outDims;     // output dims (left-aligned, padded with 1)
    int _pad0;
    int _pad1;
} uParam;

// Broadcast a linear output element index to a linear input index.
int expand_elem(int gid) {
    IArr8 out_coord = linear_to_nd8(gid, uParam.outDims, uParam.rank);
    IArr8 in_coord;
    for (int i = 0; i < uParam.rank; ++i) {
        in_coord.v[i] = (uParam.inDims.v[i] == 1) ? 0 : out_coord.v[i];
    }
    return nd_to_linear8(in_coord, uParam.inDims, uParam.rank);
}

void main() {
    int gid = int(gl_GlobalInvocationID.x);

    int out_total = 1;
    for (int i = 0; i < uParam.rank; ++i) out_total *= uParam.outDims.v[i];

#ifdef FP16
    // One thread per uint word: elements 2*gid (lo half) and 2*gid+1 (hi half).
    int nwords = (out_total + 1) / 2;
    if (gid >= nwords) return;
    int e0 = 2 * gid;
    int e1 = 2 * gid + 1;
    float v0 = BUF_LOAD(uInput.data, expand_elem(e0));
    if (e1 >= out_total) {
        // Odd tail element: keep the high half at 0 (no element to write).
        uOutput.data[gid] = packHalf2x16(vec2(v0, 0.0));
    } else {
        float v1 = BUF_LOAD(uInput.data, expand_elem(e1));
        uOutput.data[gid] = packHalf2x16(vec2(v0, v1));
    }
#else
    if (gid >= out_total) return;
    BUF_STORE(uOutput.data, gid, BUF_LOAD(uInput.data, expand_elem(gid)));
#endif
}
