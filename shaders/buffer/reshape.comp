#version 450 core

// Reshape SSBO op. On the buffer path data is flat row-major, so a reshape
// is a pure 1:1 copy of `total` contiguous scalars.
//
// fp16: one thread per uint word (two elements) — see unary.comp.

#include "../common/buffer_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer BdaUintBuf {
    uint data[];
};
layout(set = 0, binding = 0) readonly buffer BdaTable {
    BdaUintBuf b0;
    BdaUintBuf b1;
} uBdaTable;
#define uOutput (uBdaTable.b0)
#define uInput (uBdaTable.b1)
#else
layout(set = 0, binding = 0) writeonly buffer Output {
    uint data[];
} uOutput;
layout(set = 0, binding = 1) readonly buffer Input {
    uint data[];
} uInput;
#endif

layout(push_constant) uniform PC_uPC {
    int rank_in;
    IArr8 inDims;
    int rank_out;
    IArr8 outDims;
    int total;
} uPC;

void main() {
    int gid = int(gl_GlobalInvocationID.x);
#ifdef FP16
    int nwords = (uPC.total + 1) / 2;
    if (gid >= nwords) return;
    uOutput.data[gid] = uInput.data[gid];
#else
    if (gid >= uPC.total) return;
    uOutput.data[gid] = uInput.data[gid];
#endif
}
