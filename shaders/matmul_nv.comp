/*

https://github.com/KhronosGroup/GLSL/blob/main/extensions/nv/GLSL_NV_cooperative_matrix.txt

Section 8.X, Cooperative Matrix Functions


fcoopmatNV<PRECISION_BITS, gl_ScopeSubgroup, ROWS, COLS> variable;
// fcoopmatNV<16, gl_ScopeSubgroup, 16, 8> mat2; //  fp16, subgroup, 16 rows, 8 columns


void coopMatLoadNV(out fcoopmatNV m,
                   volatile coherent float16_t[] buf, // ssbo or shared memory array variable
                   uint element, // starting index into buf to load from
                   uint stride, // element stride for one column or row
                   bool colMajor) // compile-time constant
Load a cooperative matrix from buf. colMajor indicates
whether the values loaded from memory are arranged in column-major or
row-major order. It must be a constant expression, with false
indicating row major and true indicating column major.

If colMajor is false, then elements (row,*) of the result are taken in
order from contiguous locations starting at buf[element + row*stride].
If colMajor is true, then elements (*,col) of the result are taken in
order from contiguous locations starting at buf[element + col*stride].



fcoopmatNV coopMatMulAddNV(fcoopmatNV A, fcoopmatNV B, fcoopmatNV C)


void coopMatStoreNV(fcoopmatNV m, volatile coherent out float[] buf, uint element, uint stride, bool colMajor);


*/

#version 450 core

#extension GL_NV_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_NV_shader_subgroup_partitioned : enable
#extension GL_KHR_memory_scope_semantics: enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16: enable

#ifdef FP16
#extension GL_AMD_gpu_shader_half_float: enable
#extension GL_EXT_shader_16bit_storage : enable
#define FLOAT float16_t
#define FLOAT4 f16vec4
#define FLOAT2 f16vec2
#else
#define FLOAT float
#define FLOAT4 vec4
#define FLOAT2 vec2
#endif


// 16x16 workgroup = 256 threads = 8 subgroups (assumes subgroupSize = 32).
// Each subgroup owns one 8x8 fcoopmatNV tile (8x8x16, fp16 -> fp32).
// Subgroup grid: 2 (M) x 4 (N)  =>  workgroup output footprint = 16 (M) x 32 (N).
// A[16x16] shared across the 4 N-subgroups; B[16x32] shared across the 2 M-subgroups,
// so each K-tile's image fetch feeds 8 MMA ops.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0) writeonly uniform image2DArray uOutput;
layout(binding = 1) uniform sampler2DArray uInputA;
layout(binding = 2) uniform sampler2DArray uInputB;

const int M_BLOCK = 8;
const int N_BLOCK = 8;
const int K_BLOCK = 16;

// Workgroup footprint (2 subgroup rows x 4 subgroup cols)
const int BM = 16;   // = 2 * M_BLOCK
const int BN = 32;   // = 4 * N_BLOCK

// Cooperative matrix: [M=8, N=8, K=16]
fcoopmatNV<16, gl_ScopeSubgroup, M_BLOCK, K_BLOCK> matA[4];
fcoopmatNV<16, gl_ScopeSubgroup, K_BLOCK, N_BLOCK> matB[4];
fcoopmatNV<32, gl_ScopeSubgroup, M_BLOCK, N_BLOCK> matC[4];

layout(push_constant) uniform PushConsts {
    int M; // rows of A
    int N; // cols of B
    int K; // common dim
    int C;
    int fp32;
} uMatMulParams;

shared float16_t shA[4][BM * K_BLOCK];           // 4 x 16x16, shared across N-subgroups
shared float16_t shB[4][K_BLOCK * BN];           // 4 x 16x32, shared across M-subgroups
shared float     shC[4][8][M_BLOCK * N_BLOCK];   // 4 ch x 8 subgroups x 64, per-subgroup store (no races)

void main() {
    int  c4   = int(gl_WorkGroupID.z);
    int  m0   = int(gl_WorkGroupID.y) * BM;
    int  n0   = int(gl_WorkGroupID.x) * BN;
    uint sg   = gl_SubgroupID;                   // 0..7
    uint lane = gl_SubgroupInvocationID;         // 0..31
    uint tid  = gl_LocalInvocationIndex;         // 0..255
    int  sgx  = int(sg % 4);                     // subgroup col (N) in 2x4 grid
    int  sgy  = int(sg / 4);                     // subgroup row (M) in 2x4 grid

    int M = uMatMulParams.M;
    int K = uMatMulParams.K;
    int N = uMatMulParams.N;
    int C = uMatMulParams.C;

    for (int b = 0; b < 4; b++) {
        matC[b] = fcoopmatNV<32, gl_ScopeSubgroup, M_BLOCK, N_BLOCK>(0.0);
    }

    int k_tiles = (K + K_BLOCK - 1) / K_BLOCK;

    for (int t = 0; t < k_tiles; t++) {
        int k_base = t * K_BLOCK;

        // 256 threads load A[16x16] (256 elems/ch => 1/thread)
        {
            int row = int(tid) / K_BLOCK, col = int(tid) % K_BLOCK;
            int h = m0 + row, kk = k_base + col;
            vec4 val = (h < M && kk < K) ? texelFetch(uInputA, ivec3(kk, h, c4), 0) : vec4(0.0);
            shA[0][tid] = float16_t(val.x);
            shA[1][tid] = (c4 * 4 + 1 < C) ? float16_t(val.y) : float16_t(0.0);
            shA[2][tid] = (c4 * 4 + 2 < C) ? float16_t(val.z) : float16_t(0.0);
            shA[3][tid] = (c4 * 4 + 3 < C) ? float16_t(val.w) : float16_t(0.0);
        }

        // 256 threads load B[16x32] (512 elems/ch => 2/thread)
        for (int e = 0; e < 2; e++) {
            int idx = int(tid) * 2 + e;                  // 0..511
            int row = idx / BN, col = idx % BN;          // row=K, col=N
            int kk = k_base + row, w = n0 + col;
            vec4 val = (kk < K && w < N) ? texelFetch(uInputB, ivec3(w, kk, c4), 0) : vec4(0.0);
            shB[0][idx] = float16_t(val.x);
            shB[1][idx] = (c4 * 4 + 1 < C) ? float16_t(val.y) : float16_t(0.0);
            shB[2][idx] = (c4 * 4 + 2 < C) ? float16_t(val.z) : float16_t(0.0);
            shB[3][idx] = (c4 * 4 + 3 < C) ? float16_t(val.w) : float16_t(0.0);
        }

        barrier();

        // Each subgroup loads its own 8x16 / 16x8 slice from the shared A/B tiles.
        // shA is [16x16] row-major; sgy selects rows [sgy*8 .. +7] => offset = sgy*M_BLOCK*K_BLOCK, stride = K_BLOCK.
        coopMatLoadNV(matA[0], shA[0], sgy * M_BLOCK * K_BLOCK, K_BLOCK, false);
        coopMatLoadNV(matA[1], shA[1], sgy * M_BLOCK * K_BLOCK, K_BLOCK, false);
        coopMatLoadNV(matA[2], shA[2], sgy * M_BLOCK * K_BLOCK, K_BLOCK, false);
        coopMatLoadNV(matA[3], shA[3], sgy * M_BLOCK * K_BLOCK, K_BLOCK, false);
        // shB is [16x32] row-major; sgx selects cols [sgx*8 .. +7] => offset = sgx*N_BLOCK, stride = BN.
        coopMatLoadNV(matB[0], shB[0], sgx * N_BLOCK, BN, false);
        coopMatLoadNV(matB[1], shB[1], sgx * N_BLOCK, BN, false);
        coopMatLoadNV(matB[2], shB[2], sgx * N_BLOCK, BN, false);
        coopMatLoadNV(matB[3], shB[3], sgx * N_BLOCK, BN, false);

        // C = A * B + C
        matC[0] = coopMatMulAddNV(matA[0], matB[0], matC[0]);
        matC[1] = coopMatMulAddNV(matA[1], matB[1], matC[1]);
        matC[2] = coopMatMulAddNV(matA[2], matB[2], matC[2]);
        matC[3] = coopMatMulAddNV(matA[3], matB[3], matC[3]);
        barrier();
    }

    // --- Step 4: CoopMat Register -> Shared Memory -> Image ---
    // Each subgroup stores into its own shC partition (no write races).
    coopMatStoreNV(matC[0], shC[0][sg], 0, N_BLOCK, false);
    coopMatStoreNV(matC[1], shC[1][sg], 0, N_BLOCK, false);
    coopMatStoreNV(matC[2], shC[2][sg], 0, N_BLOCK, false);
    coopMatStoreNV(matC[3], shC[3][sg], 0, N_BLOCK, false);

    barrier();

    // 32 threads write 64 output texels (2/thread) for this subgroup's 8x8 tile.
    for (int e = 0; e < 2; e++) {
        int idx = int(lane) * 2 + e;               // 0..63
        int row = idx / N_BLOCK, col = idx % N_BLOCK;
        uint out_h_global = uint(m0 + sgy * M_BLOCK + row);
        uint out_w_global = uint(n0 + sgx * N_BLOCK + col);

        if (out_h_global < uint(M) && out_w_global < uint(N)) {
            vec4 result;
            result.x = float(shC[0][sg][idx]);
            result.y = float(shC[1][sg][idx]);
            result.z = float(shC[2][sg][idx]);
            result.w = float(shC[3][sg][idx]);
            imageStore(uOutput, ivec3(out_w_global, out_h_global, c4), vec4(result));
        }
    }
}
