#ifndef BUFFER_COMMON_COMP
#define BUFFER_COMMON_COMP

// Shared infrastructure for shaders/buffer/*.comp SSBO operators.
//
// Buffer ops treat tensors as compact row-major contiguous data of arbitrary
// rank (NCHW or higher/lower — dense in dim order), as opposed to the image
// path's NCHW -> RGBA image2DArray packing. Shapes are passed via push
// constants as `int rank; int dims[8];` (right-aligned: dims[8-rank .. 7]).
//
// Built twice: base build is fp32 (one element per uint word); -DFP16 build
// is fp16 (two elements packed per uint word via packHalf2x16/unpackHalf2x16
// — same convention as image/gemm.comp and image/gather.comp).
//
// fp16 load/store: element `idx` lives in uint word `idx/2`, lane `idx%2`.
// Each thread owns ONE logical element and reads/writes its word via a
// read-modify-write of the half2 pair. This is safe only when no two
// threads target the same output word — i.e. one thread per output element
// on a contiguous index range (elementwise/reshape). Reduction/structural
// buffer shaders (softmax, layernorm, reduce, slice, concat, split,
// transpose) are fp32-only because their gather/scatter patterns can race
// on the shared half2 word.
//
// GLSL forbids bare arrays as function parameters, so dims/coords use a
// struct (IArr8). Unsized buffer arrays cannot be passed by value, so
// buf_load/buf_store are macros taking the SSBO member expression.

#ifdef FP16
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_AMD_gpu_shader_half_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#define DTYPE   float16_t
#define DTYPE2  f16vec2
#define DTYPE4  f16vec4
#define FLOAT   float16_t
#define FLOAT2  f16vec2
#define FLOAT4  f16vec4
#else
#define DTYPE   float
#define DTYPE2  vec2
#define DTYPE4  vec4
#define FLOAT   float
#define FLOAT2  vec2
#define FLOAT4  vec4
#endif

// ---- bfloat16 as a drop-in replacement for fp16 storage ------------------
//
// A bf16 build is the FP16 build with a different 16-bit float in the same
// two-per-word slots: same packing, same strides, same dispatch geometry, same
// arithmetic -- 16-bit storage and 32-bit compute, exactly like fp16. Only the
// bit layout differs, so this shadows the two built-ins the whole shader tree
// already calls rather than teaching 371 call sites a second format.
//
// Why it is worth the second format: fp16's five exponent bits cap it at
// 65504, and MiniMax-H3 overflows that. Its hidden states reach ~4200 and a
// 14336-wide FFN accumulation crosses the ceiling on a handful of elements,
// which then poison the whole graph (measured: `MatMul_5969 out ne=860160
// inf=4` at seq=160, and NaN in the output while the fp32 artifact on the same
// weights and shape is finite). bf16 spends the mantissa instead of the
// exponent -- 8 exponent bits, fp32's range, ~3 decimal digits of precision --
// which is what the checkpoint itself uses (626 of its 638 tensors are bf16).
//
// Rounding: round-to-nearest-even on the 16 dropped mantissa bits. Truncation
// would be one instruction cheaper and biased, and the converter's own bf16
// path (converter._bf16_bytes_to_fp32) is used only in the widening direction,
// so this is the only place a rounding choice is made.
//
// Inf/NaN survive the round trip: 0x7F80/0x7FC0 in and out, because the
// exponent field is copied verbatim and only the mantissa is rounded.
#ifdef BF16
uint bf16_bits(float v) {
    uint u = floatBitsToUint(v);
    // NaN must stay NaN rather than round its mantissa into the exponent.
    if ((u & 0x7F800000u) == 0x7F800000u) return u >> 16;
    uint lsb = (u >> 16) & 1u;
    return (u + 0x7FFFu + lsb) >> 16;
}
float bf16_to_float(uint h) { return uintBitsToFloat(h << 16); }
vec2 unpackBf16x2(uint w) {
    return vec2(bf16_to_float(w & 0xFFFFu), bf16_to_float(w >> 16));
}
uint packBf16x2(vec2 v) {
    return (bf16_bits(v.x) & 0xFFFFu) | (bf16_bits(v.y) << 16);
}
#define unpackHalf2x16(w) unpackBf16x2(w)
#define packHalf2x16(v)   packBf16x2(v)
#endif


// 8-int struct used for dims/coords in push constants and local helpers.
struct IArr8 { int v[8]; };

#ifdef FP16
// fp16: element idx is lane (idx&1) of the half2 in word (idx>>1).
#define BUF_LOAD(data, idx) (unpackHalf2x16((data)[(idx) >> 1])[(idx) & 1])
#define BUF_STORE(data, idx, v) do { \
        uint _w = (idx) >> 1; \
        vec2 _p = unpackHalf2x16((data)[_w]); \
        _p[(idx) & 1] = float(v); \
        (data)[_w] = packHalf2x16(_p); \
    } while (false)
#else
#define BUF_LOAD(data, idx)  uintBitsToFloat((data)[(idx)])
#define BUF_STORE(data, idx, v) (data)[(idx)] = floatBitsToUint(float(v))
#endif

// ---- nd <-> linear helpers (row-major, right-aligned dims.v[8-rank..7]) ----

int nd_to_linear8(IArr8 coord, IArr8 dims, int rank) {
    int linear = 0;
    int stride = 1;
    for (int i = rank - 1; i >= 0; --i) {
        linear += coord.v[i] * stride;
        stride *= dims.v[i];
    }
    return linear;
}

IArr8 linear_to_nd8(int linear, IArr8 dims, int rank) {
    IArr8 coord;
    for (int i = 0; i < 8; ++i) coord.v[i] = 0;
    for (int i = rank - 1; i >= 0; --i) {
        coord.v[i] = linear % dims.v[i];
        linear /= dims.v[i];
    }
    return coord;
}

// ---- Broadcasting ----
// Map an output linear index to an input linear index, applying ONNX-style
// right-aligned broadcast: for each axis where the input dim is 1, the
// input coordinate is forced to 0. Both shapes use the same rank (the
// host right-aligns the input shape to the output rank).
// One pass, innermost dim first: peel each output coordinate off with one
// div/mod and add it at the input stride unless the input broadcasts that
// dim. No coordinate arrays (the old form built two IArr8 per element).
// Hosts pass coalesced dims (fill_dims_coalesced), so rank is usually 1-3.
int broadcast_index(int out_linear, IArr8 out_dims, IArr8 in_dims, int rank) {
    int idx = 0;
    int stride = 1;
    for (int i = rank - 1; i >= 0; --i) {
        int od = out_dims.v[i];
        int q = out_linear / od;
        if (in_dims.v[i] != 1) idx += (out_linear - q * od) * stride;
        stride *= in_dims.v[i];
        out_linear = q;
    }
    return idx;
}

// ---- Erf (Abramowitz & Stegun 7.1.26, max abs error 1.5e-7) ----
// Lives here because two shaders need the SAME erf: the standalone Erf op
// (shaders/buffer/erf.comp) and the fused-elementwise chain, which needs it as
// the GELU primitive (0.5*x*(1+erf(x/sqrt(2)))). GLSL's built-in erf() is not
// available on this toolchain (glslang rejects it at `#version 450`), and two
// hand-copied polynomials would let a fused chain and an unfused one disagree
// on the same model.
float buffer_erf(float x) {
    const float a1 =  0.254829592;
    const float a2 = -0.284496736;
    const float a3 =  1.421413741;
    const float a4 = -1.453152027;
    const float a5 =  1.061405429;
    const float p  =  0.3275911;
    float sign = sign(x);
    x = abs(x);
    float t = 1.0 / (1.0 + p * x);
    float y = 1.0 - ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t * exp(-x * x);
    return sign * y;
}

// ---- GPU-driven shape-meta (Phase 3): load dims from a bound int64 SSBO ----
// When a tensor carries shape_ssbo_ (its producing shape as an int64 SSBO),
// downstream consumers read the REAL dims from the SSBO instead of the
// push_constant dims (which become a placeholder once Phase 4 retires the
// copyToCPU readback). The shape SSBO is int64 bound as ivec2[] (.x = dim
// value, small non-negative). `rank` is CPU-known (shape-input element count).
// Shapes are left-aligned into IArr8 (trailing 1s).
//
// GLSL forbids passing unsized arrays by value, so each shader defines a
// per-SSBO loader via LOAD_DIMS_INIT(name, ssbo_array_expr). The shader calls
// name(rank) once in main() and threads the IArr8 through broadcast_index.
#define LOAD_DIMS_INIT(name, ssbo)                                \
    IArr8 name(int rank) {                                        \
        IArr8 d;                                                  \
        for (int i = 0; i < 8; ++i) d.v[i] = 1;                   \
        for (int i = 0; i < rank && i < 8; ++i) {                 \
            d.v[i] = ssbo[i].x;                                   \
        }                                                         \
        return d;                                                 \
    }

#endif // BUFFER_COMMON_COMP
